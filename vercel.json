{
  "crons": [
    {
      "path": "/retail-os/api/cron/reports",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/settle",
      "schedule": "30 6 * * 1"
    },
    {
      "path": "/api/cron/outbox",
      "schedule": "35 3 * * *"
    },
    {
      "path": "/api/cron/lead-mail",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/retail-os/api/cron/lead-access",
      "schedule": "40 4 * * *"
    },
    {
      "path": "/api/cron/team-digest",
      "schedule": "0 4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/devshop/ceremonykitchen/:path*",
      "destination": "https://ceremony-os.vercel.app/devshop/ceremonykitchen/:path*"
    }
  ]
}
