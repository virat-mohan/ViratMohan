{
  "name": "viratmohan-com",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check:brand": "node scripts/check-brand-tokens.mjs",
    "test": "vitest run tests/unit retail-os-brands/freshforpaws/tests",
    "test:watch": "vitest tests/unit",
    "test:node": "esbuild $(find tests/unit -name '*.node.test.ts') --bundle --platform=node --format=esm --outdir=.tmp-test/node --outbase=tests/unit --out-extension:.js=.mjs --log-level=warning && node --test \".tmp-test/node/**/*.node.test.mjs\"",
    "test:ceo": "esbuild src/lib/ceo/*.test.ts --bundle --platform=node --format=esm --outdir=.tmp-test/ceo --out-extension:.js=.mjs --log-level=warning && node --test \".tmp-test/ceo/*.test.mjs\"",
    "test:integration": "vitest run tests/integration --testTimeout=120000 --hookTimeout=180000",
    "verify:ceo-live": "esbuild scripts/verify/ceo-live.ts --bundle --platform=node --format=esm --outfile=.tmp-test/ceo-live.mjs --log-level=warning && node .tmp-test/ceo-live.mjs",
    "verify:live-concurrency": "esbuild scripts/verify/live-concurrency.ts --bundle --platform=node --format=esm --outfile=.tmp-test/live-concurrency.mjs --log-level=warning && node .tmp-test/live-concurrency.mjs",
    "verify:release": "esbuild scripts/verify/release-gate.ts --bundle --platform=node --format=esm --outfile=.tmp-test/release-gate.mjs --log-level=warning && node .tmp-test/release-gate.mjs",
    "test:live": "vitest run tests/benchmarks"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/vercel": "^8.2.11",
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/instrument-serif": "^5.1.0",
    "@supabase/supabase-js": "^2.115.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vercel/functions": "^3.9.5",
    "astro": "^5.1.0",
    "svix": "^2.3.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "vitest": "^5.0.0"
  }
}
