---
import Base from '../layouts/Base.astro';
const ways = [
  ['Responsible business', 'Profit is how I measure, not why I exist. People and the planet come first.'],
  ['Fair practice', 'Standard terms, published openly. No hidden fees.'],
  ['Transparency', 'Every number visible. Every claim sourced.'],
  ['Collective growth', 'Founders, customers, partners and staff all win together.'],
  ['Positive impact', 'Small makers become real brands. Local jobs grow.'],
  ['Efficiency', 'Machines do the routine. People do what needs people.'],
  ['Plain language', 'Anyone understands me in one read.'],
  ['Keep promises', 'Live in 7 days. Honest numbers. Always.'],
];
---
<Base title="Mission, vision & how I work · Virat Mohan" description="Why I build, what I'm building towards, and the fundamentals I won't compromise on." path="/mission">
  <section class="mv">
    <p class="mv-k">Passion</p>
    <h1 class="mv-p">I love taking something good that someone made, and building the machine that gets it to the world.</h1>
    <p class="mv-s">120+ kitchens, a newspaper at metro stations, brands online in days. Every time, the product was the easy part. Making it run is what I live for.</p>

    <hr />
    <p class="mv-k">Mission</p>
    <h2 class="mv-h">Give any founder a working online business in 7 days, run for them.</h2>
    <p class="mv-s">With results they can see every Monday, proven in public with real numbers.</p>

    <hr />
    <p class="mv-k">Vision</p>
    <h2 class="mv-h mv-t">A new, more efficient way for the world to do business.</h2>
    <p class="mv-s">One operating system running thousands of brands better than a full team each, paid only from the value it creates, and sharing that value with everyone who helps.</p>

    <hr />
    <p class="mv-k">Ambition</p>
    <h2 class="mv-h">The biggest AI company for businesses in the world.</h2>
    <p class="mv-s">Built the responsible way. AI is changing how every business runs. I want that change to lift small makers, not just the giants. I'll get there by keeping every promise below, one brand at a time.</p>

    <hr />
    <p class="mv-k">How I work</p>
    <ol class="mv-ways">
      {ways.map(([t, d], i) => (
        <li><img src={`/icons/values/${t.toLowerCase().replace(/ /g, '-')}.svg`} alt="" width="40" height="40" /><div><h3><span class="mv-n">{String(i + 1).padStart(2, '0')}</span> {t}</h3><p>{d}</p></div></li>
      ))}
    </ol>
    <hr />
    <p class="mv-k">How the machine thinks</p>
    <ul class="mv-beliefs">
      <li><h3>Always learning</h3><p>Every mistake becomes a rule. The same mistake never happens twice.</p></li>
      <li><h3>Always auditing</h3><p>The system checks its own work, all the time, not once a quarter.</p></li>
      <li><h3>Better every time</h3><p>Each run starts from what the last one learned.</p></li>
      <li><h3>Ideal state</h3><p>Know what perfect looks like, measure the gap, close it a little every day.</p></li>
      <li><h3>Humans decide</h3><p>Machines do the work. Money, people and promises stay with me.</p></li>
    </ul>
    <p class="mv-cta"><a href="/retail-os/">See Retail OS →</a></p>
  </section>
</Base>

<style>
  .mv { max-width: 980px; margin: 0 auto; padding: 7rem 16px 5rem; }
  .mv-k { font: 700 12px/1 var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--terracotta); margin: 0 0 12px; }
  .mv-p { font-family: var(--serif); font-style: italic; font-weight: 400; font-size: clamp(2rem, 5vw, 3.4rem); line-height: 1.1; margin: 0 0 16px; }
  .mv-h { font-family: var(--display); text-transform: uppercase; font-weight: 400; font-size: clamp(2rem, 5.5vw, 3.6rem); line-height: .98; margin: 0 0 14px; }
  .mv-t { color: var(--terracotta); }
  .mv-s { font-family: var(--serif); font-style: italic; font-size: 1.25rem; color: var(--muted); max-width: 62ch; margin: 0; }
  .mv hr { border: 0; border-top: 1.5px solid var(--gold); margin: 3rem 0 2.2rem; }
  .mv-ways { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 26px 40px; }
  .mv-ways li { display: flex; gap: 16px; }
  .mv-ways img { flex: none; margin-top: 2px; }
  .mv-n { color: var(--terracotta); margin-right: 6px; }
  .mv-ways b { font-family: var(--display); font-weight: 400; font-size: 2rem; color: var(--terracotta); line-height: 1; }
  .mv-ways h3 { font-family: var(--display); text-transform: uppercase; font-weight: 400; font-size: 1.35rem; margin: 0 0 4px; }
  .mv-ways p { margin: 0; color: var(--muted); }
  .mv-cta { margin-top: 3rem; font-family: var(--serif); font-size: 1.6rem; }
  .mv-cta a { color: var(--terracotta); border-bottom: 1px solid var(--gold); text-decoration: none; }
  .mv-beliefs { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 22px 40px; }
  .mv-beliefs li { border-left: 2px solid var(--gold); padding-left: 14px; }
  .mv-beliefs h3 { font-family: var(--display); text-transform: uppercase; font-weight: 400; font-size: 1.2rem; margin: 0 0 4px; }
  .mv-beliefs p { margin: 0; color: var(--muted); }
  @media (max-width: 700px) { .mv-beliefs { grid-template-columns: 1fr; } }
  @media (max-width: 700px) { .mv-ways { grid-template-columns: 1fr; } }
</style>
