  .build-right { flex: 1; min-width: 0; max-height: 62vh; overflow-y: auto; padding-right: 8px; }
  .build-log-line {
    font-size: 15px; color: var(--dev-muted1); line-height: 1.6; margin: 0 0 18px;
    padding-left: 16px; border-left: 2px solid var(--dev-hair);
