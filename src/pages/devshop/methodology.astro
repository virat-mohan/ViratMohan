---
// /devshop/methodology — a plain-language explainer of the actual
// diagnosis-to-build pipeline in src/lib/llm.ts's classifyAndBuild(), for a
// prospective client deciding whether to trust the process behind the demo
// they were just shown. Static content page, same dark design system as
// devshop.astro but without the wizard/SPA machinery — just a scroll.

const title = 'Our methodology — Fast Tech Dev Shop';
const description = 'How every demo gets built: diagnosis, a proven framework scored against alternatives, a P&L-mapped mechanism, and two rounds of validation before you ever see it.';

const steps = [
  {
    n: '01',
    title: 'Diagnose the real problem',
    body: "We start by naming which part of the business actually owns the problem, then dig past the symptom to the root cause. Every diagnosis is tagged with how confident we actually are — strongly supported, a reasonable inference, or a preliminary hypothesis — so you can see exactly which parts are grounded in what you told us and which are our best working assumption.",
  },
  {
    n: '02',
    title: 'Apply a proven framework, not a guess',
    body: "Every recommendation is grounded in an established methodology with a real track record — Six Sigma, Lean, Theory of Constraints, and others — never an invented framework. We score every framework we seriously considered across 9 dimensions (problem fit, evidence strength, industry track record, and more) and show you the comparison table, not just the winner.",
  },
  {
    n: '03',
    title: 'Map it to your P&L, in numbers',
    body: "We name the specific revenue or cost line the fix moves — not “improves efficiency,” but which line, from what baseline, to what target. The arithmetic behind that number is shown as a simple table you can check yourself, and every figure is tagged as something you told us or an industry-grounded assumption — never presented as fact when it isn't.",
  },
  {
    n: '04',
    title: 'Design the actual mechanism',
    body: "We design the specific workflow that fixes the root cause — what triggers it, what data it acts on, what happens at each step — built from a fixed, curated library of AI agent roles (data extraction, classification, decision-making, action-taking, and more). That consistency means what we propose is something we've actually built the pattern for before, not a one-off idea invented for your pitch.",
  },
  {
    n: '05',
    title: 'Validate it before you ever see it',
    body: "Before a demo reaches you, it goes through two rounds of self-audit: one checking the reasoning itself (does the evidence really support this confidence level, does the framework genuinely fit, is the economics plausible), and a second checking the actual working demo (does it use real tools, do the before/after numbers actually change, is there a control you can press). A flagged issue holds the demo back for our review instead of shipping automatically.",
  },
  {
    n: '06',
    title: 'See it work, not a slide deck',
    body: "You get a working, interactive walkthrough of the mechanism — press Run and watch it move through the same steps it would in production, using your own tools and your own numbers. No mockups standing in for a real product.",
  },
  {
    n: '07',
    title: 'One round of feedback, then we build',
    body: "Answer the clarifying questions, add anything else that needs to change, and we revise once — directly incorporating every point, not a cosmetic pass. From there, the build runs on a fixed 30-day timeline from deposit.",
  },
  {
    n: '08',
    title: 'Priced like a team, not a project',
    body: "The one-time build is estimated role by role — solution architect, engineer, AI/automation engineer, and others — using the same mechanism spec the demo was built from. Ongoing support after launch is priced the same way: a transparent resource estimate, not a black-box retainer.",
  },
];
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <header>
    <div class="header-inner">
      <a class="logo" href="/devshop">DevShop<span class="logo-sub">Effective Fast Tech using Ai</span></a>
      <a class="back-link" href="/devshop">&larr; Back to start</a>
    </div>
    <div class="header-hair"></div>
  </header>

  <main class="wrap">
    <div class="eyebrow">METHODOLOGY</div>
    <h1 class="hero serif">How every demo <span class="tint-blue">actually</span> gets built.</h1>
    <p class="sub">Not a chatbot bolted onto your business. The same eight-stage process, every time — which is exactly what makes the output something you can trust and we can stand behind.</p>

    <div class="steps-list">
      {steps.map((s) => (
        <div class="step-row">
          <div class="step-num mono">{s.n}</div>
          <div class="step-body">
            <h2 class="serif">{s.title}</h2>
            <p>{s.body}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="cta-block">
      <h2 class="serif">Ready to see it applied to your problem?</h2>
      <a class="btn" href="/devshop">Start &rarr;</a>
    </div>

    <div class="footer-bar"><span>Built fast, for real businesses</span></div>
  </main>
</body>
</html>

<style>
  :root {
    --dev-bg: #15130f;
    --dev-text: #f5f5f0;
    --dev-muted1: #b7b5af;
    --dev-muted2: #85837e;
    --dev-muted3: #625f59;
    --dev-gold: #d4af37;
    --dev-blue: #91afc0;
    --dev-hair: rgba(245, 245, 240, 0.18);
  }
  *, *::before, *::after { box-sizing: border-box; }
  html, body { width: 100%; margin: 0; }
  body {
    background: var(--dev-bg);
    color: var(--dev-text);
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    overflow-x: hidden;
  }
  a { color: inherit; text-decoration: none; }
  .serif { font-family: 'Instrument Serif', Georgia, serif; font-weight: 400; }
  .mono { font-family: 'JetBrains Mono', SFMono-Regular, Consolas, monospace; }
  .tint-blue { color: var(--dev-blue); }

  header { position: sticky; top: 0; z-index: 50; background: var(--dev-bg); }
  .header-inner { display: flex; align-items: center; justify-content: space-between; padding: 22px 64px; gap: 20px; }
  .logo {
    font-family: 'Instrument Serif', Georgia, serif; font-style: italic;
    font-size: 32px; letter-spacing: 0.01em; color: var(--dev-gold); font-weight: 400; line-height: 1;
  }
  .logo-sub {
    display: block; font-family: 'Inter', sans-serif; font-style: italic;
    font-size: 10px; letter-spacing: 0.03em; color: var(--dev-muted2); margin-top: 4px;
  }
  .back-link { font-size: 13px; letter-spacing: 0.06em; color: var(--dev-muted1); white-space: nowrap; }
  .back-link:hover { color: var(--dev-text); }
  .header-hair {
    height: 1px;
    background: linear-gradient(90deg, var(--dev-blue), var(--dev-muted1), var(--dev-gold));
    opacity: 0.55;
  }

  .wrap { max-width: 820px; margin: 0 auto; padding: 64px 64px 40px; }
  .eyebrow { font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--dev-muted2); margin-bottom: 24px; }
  h1.hero { font-size: clamp(34px, 5.2vw, 56px); line-height: 1.05; letter-spacing: -0.01em; margin: 0 0 20px; }
  p.sub { font-size: 17px; color: var(--dev-muted1); max-width: 560px; line-height: 1.6; margin: 0 0 56px; }

  .steps-list { display: flex; flex-direction: column; }
  .step-row { display: flex; gap: 28px; padding: 32px 0; border-top: 1px solid var(--dev-hair); }
  .step-row:last-child { border-bottom: 1px solid var(--dev-hair); }
  .step-num { flex: none; font-size: 13px; color: var(--dev-gold); padding-top: 6px; width: 32px; }
  .step-body h2 { font-size: 24px; margin: 0 0 10px; }
  .step-body p { font-size: 15px; line-height: 1.7; color: var(--dev-muted1); margin: 0; max-width: 60ch; }

  .cta-block { text-align: center; padding: 72px 0 56px; }
  .cta-block h2 { font-size: 28px; margin: 0 0 24px; }
  .btn {
    display: inline-block; font-size: 14px; letter-spacing: 0.03em; padding: 16px 28px;
    border: 1px solid var(--dev-gold); color: var(--dev-gold); border-radius: 2px;
    transition: background 0.2s;
  }
  .btn:hover { background: rgba(212, 175, 55, 0.08); }

  .footer-bar {
    padding: 28px 0; border-top: 1px solid var(--dev-hair);
    font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--dev-muted3);
  }

  @media (max-width: 560px) {
    .header-inner { padding: 16px 20px; }
    .logo { font-size: 24px; }
    .logo-sub { font-size: 9px; }
    .back-link { font-size: 12px; }
    .wrap { padding: 40px 20px 24px; }
    h1.hero { font-size: clamp(28px, 9vw, 40px); }
    .step-row { gap: 16px; padding: 24px 0; }
    .step-body h2 { font-size: 20px; }
    .cta-block { padding: 48px 0 40px; }
  }
</style>
