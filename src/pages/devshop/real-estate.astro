---
// /devshop/real-estate — Real Estate & Property Management industry vertical
// of the same DevShop product.
//
// ARCHITECTURE: this file is a direct copy of /devshop/restaurants.astro. Per
// instruction, the whole product architecture (screens, wizard, build/
// orchestrator simulation, intake pipeline) is reused unchanged across
// industry verticals — only two things change per vertical: (1) the --dev-*
// colour tokens (cosmetic — this vertical uses a light blue-grey/cool stone
// ground, same gold/blue/green/rose hue family) and (2) the content that's
// specific to the industry (hero copy, the "Common use cases" section, the
// industry/tools chip sets in the intake wizard). Everything else —
// how-it-works, pricing structure, the wizard mechanics, the build/orchestrator
// screens, login/dashboard/integrations/activity/billing — is untouched.
//
// This page intentionally does NOT use Base.astro / Nav.astro / Footer.astro,
// matching /devshop.astro. Not linked from the main site nav — reachable only
// by direct URL, per instruction.
//
// SCOPE NOTE: everything from "Login" onward (Dashboard, Orchestrator,
// Integrations, Activity, Billing) is a UI-only front-end simulation,
// identical to /devshop.astro — see inline comments in the <script> below.
// The intake wizard is real: it posts to the same /devshop/api/intake
// endpoint that runs the actual classify+build pipeline.

import { site } from '../../data/site';
import PortalHeader from '../../components/devshop/PortalHeader.astro';

// ---- Easily-editable config, per prompt instructions ----
const CURRENCY = '₹'; // INR is the standard currency for this product.
const PRICING = {
  buildLow: '1,00,000',
  buildHigh: '10,00,000',
  retainerMin: '50,000',
};
// Real-estate-specific pricing bands are not decided yet — reusing the
// generic DevShop numbers above as a placeholder until that's scoped.

// ---- Common use cases, mapped to the business function that owns each one.
// Replaces the generic Proof (client logos/screenshots) section for this
// vertical — there's no real-estate case study yet, and a browsable problem
// map is more useful here than borrowed proof. Each `problem` string is what
// gets dropped straight into the intake wizard's "What's the problem?" field
// when clicked — real enough to submit as-is, specific enough to point the
// classifier at the right framework immediately.
const VERTICAL = 'real-estate'; // matches this route, used as usecase_templates.vertical

// Business-type taxonomy within this industry (industry → business function →
// business type → use case). A use case with no `types` field applies broadly
// across portfolio segments; one with `types` is specific to those segments
// only — see the filter bar wired to this in the landing section below.
const TYPES = [
  { slug: 'all', label: 'All types' },
  { slug: 'residential', label: 'Residential leasing' },
  { slug: 'commercial', label: 'Commercial / office leasing' },
  { slug: 'retail-property', label: 'Retail property management' },
  { slug: 'coworking', label: 'Co-working / flex space' },
  { slug: 'brokerage', label: 'Real estate brokerage' },
  { slug: 'short-let', label: 'Vacation rentals / short-let' },
  { slug: 'mixed-use', label: 'Mixed-use / multi-property' },
] as const;

const useCases = [
  {
    fn: 'Rent & Financial Reconciliation',
    items: [
      { id: 'rent-collection-delays', label: 'Rent collection delays & arrears tracking', problem: 'Our rent collection has no consistent tracking — we find out a tenant is in arrears whenever someone happens to check the bank statement, not when it first goes overdue.' },
      { id: 'security-deposit-recon', label: 'Security deposit reconciliation', types: ['residential', 'short-let'], problem: 'Security deposits sit in a spreadsheet nobody updates in real time, so at move-out we’re often arguing over deductions with numbers neither side fully trusts.' },
      { id: 'cam-charge-recon', label: 'CAM charge reconciliation', types: ['commercial', 'retail-property', 'mixed-use'], problem: 'Our common-area-maintenance charges are estimated once a year and reconciled against actual spend so late that tenants dispute the true-up by the time we send it.' },
      { id: 'multi-property-pnl', label: 'Multi-property consolidated P&L', types: ['mixed-use'], problem: 'Every property in our portfolio tracks income and expenses in its own format, so we can never get one clean consolidated P&L without someone manually rebuilding it each month.' },
      { id: 'late-fee-inconsistency', label: 'Late-fee enforcement inconsistency', types: ['residential'], problem: 'Late fees on overdue rent get waived or enforced depending on which property manager is handling the tenant, with no consistent policy anyone can point to.' },
      { id: 'rent-escalation-tracking', label: 'Rent escalation clause tracking', types: ['commercial'], problem: 'We have annual rent escalation clauses baked into our commercial leases but nobody’s systematically tracking when each one kicks in, so we routinely under-bill for months before catching it.' },
    ],
  },
  {
    fn: 'Maintenance & Facilities',
    items: [
      { id: 'maintenance-sla', label: 'Maintenance ticket response SLA', problem: 'Maintenance requests come in over calls, WhatsApp, and email with no shared queue, so we have no real idea how long a ticket actually sits before someone acts on it.' },
      { id: 'vendor-scheduling-conflicts', label: 'Vendor & contractor scheduling conflicts', problem: 'We book plumbers, electricians, and cleaning crews on an ad hoc basis and regularly double-book a unit or miss a scheduled visit entirely.' },
      { id: 'preventive-vs-reactive', label: 'Preventive maintenance vs. reactive breakdowns', problem: 'Almost all our maintenance spend goes to fixing things after they break instead of a preventive schedule, and we’ve never actually modeled what that reactive pattern is costing us.' },
      { id: 'recurring-issue-units', label: 'Recurring-issue units with no root-cause tracking', problem: 'The same handful of units generate repeat maintenance tickets every few months and nobody’s ever traced whether it’s a structural issue, a tenant behavior pattern, or a vendor doing a poor repair job.' },
    ],
  },
  {
    fn: 'Leasing & Occupancy',
    items: [
      { id: 'vacancy-duration', label: 'Vacancy duration / time-to-lease', problem: 'Units sit empty for weeks longer than they should and we don’t have a clear read on whether it’s pricing, marketing, or the leasing process itself that’s slow.' },
      { id: 'lead-to-signed-conversion', label: 'Lead-to-tour-to-signed-lease conversion tracking', problem: 'We get plenty of inbound leads on our listings but have no idea what percentage actually convert to a tour, and what percentage of tours convert to a signed lease.' },
      { id: 'renewal-rate-decline', label: 'Renewal rate decline', problem: 'Our lease renewal rate has been sliding and we don’t have a system that flags at-risk tenants early enough to actually do something about it.' },
      { id: 'rent-roll-accuracy', label: 'Rent-roll accuracy', problem: 'Our rent roll doesn’t always match what’s actually being collected — a lease amendment or a move-out updates one system but not the others, and discrepancies pile up.' },
      { id: 'occupancy-dynamic-pricing', label: 'Occupancy-based dynamic pricing', types: ['coworking', 'short-let'], problem: 'We charge the same rate regardless of how full the building is running, and have never tested occupancy-based dynamic pricing the way hotels or airlines do.' },
      { id: 'broker-commission-tracking', label: 'Broker commission & deal pipeline tracking', types: ['brokerage'], problem: 'We track our brokerage deal pipeline and commission splits across spreadsheets and memory, and deals regularly fall through the cracks between showing and closing.' },
    ],
  },
  {
    fn: 'Tenant Experience & Retention',
    items: [
      { id: 'complaint-resolution-sla', label: 'Tenant complaints have no resolution SLA', problem: 'A tenant complaint gets handled however the on-site manager feels like handling it that day, with no consistent process or time-to-resolution target.' },
      { id: 'move-in-out-disputes', label: 'Move-in / move-out inspection disputes', types: ['residential'], problem: 'Our move-in and move-out condition reports are inconsistent paper checklists, so almost every deposit deduction turns into a dispute over what was already damaged versus what happened during the tenancy.' },
      { id: 'communication-scattered', label: 'Tenant communication scattered across channels', problem: 'Tenant conversations happen across email, WhatsApp, and phone calls with no single record, so a new property manager has to reconstruct history from scratch every time someone leaves.' },
      { id: 'tenant-turnover-deposit-disputes', label: 'Tenant turnover & security deposit disputes', types: ['residential'], problem: 'Every time a tenant moves out we end up in some form of dispute over the security deposit, and it’s becoming a real driver of bad reviews and repeat vacancy.' },
      { id: 'guest-experience-short-let', label: 'Guest experience & review management', types: ['short-let'], problem: 'Our short-let reviews are slipping and nobody’s systematically tracking which complaints — cleanliness, check-in, noise — are actually recurring across listings.' },
    ],
  },
  {
    fn: 'Compliance & Risk',
    items: [
      { id: 'lease-clause-tracking', label: 'Lease clause & renewal-date tracking', problem: 'Our lease terms, break clauses, and renewal dates live across individual PDF contracts, so we routinely find out a lease is about to auto-renew or expire only when it’s almost too late to act.' },
      { id: 'fire-safety-cert-renewals', label: 'Fire-safety & building-code certification renewals', problem: 'Fire safety and building-code certifications across our properties get renewed reactively, usually right after someone notices one has already lapsed.' },
      { id: 'insurance-cert-expiry', label: 'Insurance certificate expiry tracking', problem: 'We rely on tenants and vendors to keep their liability insurance current, but nobody’s actually tracking expiry dates, so we find out a certificate lapsed only after something goes wrong.' },
      { id: 'legal-notice-tracking', label: 'Eviction & legal notice process tracking', types: ['residential'], problem: 'When we do need to issue a legal notice on a tenant, the process and required documentation depend on whoever’s handling it that week, and we’ve had notices thrown out on a technicality before.' },
      { id: 'zoning-permit-compliance', label: 'Zoning & permit compliance for mixed-use conversions', types: ['mixed-use'], problem: 'As we convert or repurpose space across our mixed-use properties, zoning and permit compliance gets checked inconsistently, and we’ve been caught out by a requirement we missed.' },
    ],
  },
  {
    fn: 'Marketing & Lead Generation',
    items: [
      { id: 'listing-syndication', label: 'Listing syndication inconsistency across portals', problem: 'The same unit shows different photos, prices, or availability across our listing portals because nobody’s syndicating updates consistently, and it costs us credibility with prospects.' },
      { id: 'lead-response-time', label: 'Lead response time', problem: 'Inbound leads from our listings sit unanswered for hours because there’s no consistent owner for first response, and we suspect we’re losing serious prospects to whoever answers first.' },
      { id: 'empty-unit-marketing', label: 'Empty-unit marketing has no consistent playbook', problem: 'When a unit goes vacant, marketing it is whatever the property manager remembers to do that week — there’s no repeatable playbook for photos, pricing, and where it gets posted.' },
      { id: 'short-let-channel-management', label: 'Short-let channel manager & OTA pricing parity', types: ['short-let'], problem: 'We list our short-let units across multiple OTAs and our pricing and availability regularly go out of sync between them, which has caused real double-bookings.' },
    ],
  },
  {
    fn: 'Vendor & Procurement',
    items: [
      { id: 'vendor-price-comparison', label: 'No multi-vendor price comparison for repeat services', problem: 'We reorder cleaning, security, and landscaping services from the same vendors out of habit and have never systematically compared prices across the market for our recurring spend.' },
      { id: 'vendor-invoice-mismatch', label: 'Vendor invoice-vs-work-order mismatches', problem: 'Vendor invoices regularly don’t match the actual work order or the quote we approved, and right now someone just eyeballs them against a paper trail.' },
      { id: 'contractor-vetting', label: 'Contractor vetting & compliance documentation gaps', problem: 'We don’t have a consistent process for vetting a new contractor’s licenses, insurance, and past work before putting them on a property, and it’s bitten us at least once.' },
    ],
  },
  {
    fn: 'People & Operations',
    items: [
      { id: 'staff-turnover', label: 'Property manager & on-site staff turnover', problem: 'We’re constantly rehiring and retraining on-site property managers and have never actually costed what that churn is doing to tenant retention and maintenance response times.' },
      { id: 'workload-imbalance', label: 'Workload imbalance across a growing portfolio', problem: 'As we’ve added properties, workload across our property managers has gotten badly uneven, and we’re still assigning new units by habit instead of any real capacity model.' },
      { id: 'onsite-staff-scheduling', label: 'On-site staff & security scheduling gaps', types: ['commercial', 'retail-property'], problem: 'On-site staff and security coverage across our commercial and retail properties gets scheduled manually and we’ve had gaps where a shift simply wasn’t covered.' },
    ],
  },
  {
    fn: 'Portfolio & Investment Reporting',
    items: [
      { id: 'owner-reporting-delays', label: 'Owner / investor reporting delays', problem: 'Our owners and investors expect a monthly performance report and we’re consistently late putting it together because the underlying numbers live across too many disconnected sources.' },
      { id: 'noi-visibility-lag', label: 'NOI visibility lag', problem: 'We don’t have real-time visibility into net operating income across our properties — it’s a number we reconstruct after the fact each month, not one we can check any given week.' },
      { id: 'capex-opex-tracking', label: 'Capex vs. opex tracking', problem: 'We don’t cleanly separate capital expenditure from operating expenditure across properties, which makes it hard to tell owners what’s actually driving a cost increase.' },
      { id: 'portfolio-benchmarking', label: 'Cross-property performance benchmarking', types: ['mixed-use'], problem: 'We have no consistent way to benchmark one property against another in our portfolio, so underperformance often goes unnoticed until it’s a much bigger problem.' },
    ],
  },
];

// Full-colour icon marks for the Integrations screen only, unchanged from
// /devshop.astro — same simulation, not real-estate-specific.
const CRM_LOGO = `<svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"><rect width="40" height="40" rx="6" fill="#91AFC0"/><circle cx="20" cy="15" r="6" fill="#15130F"/><path d="M8 32c0-6.6 5.4-12 12-12s12 5.4 12 12" fill="#15130F"/></svg>`;

const SHEETS_LOGO = `<svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"><rect width="40" height="40" rx="6" fill="#0F9D58"/><rect x="10" y="7" width="20" height="26" rx="2" fill="#F5F5F0"/><rect x="13" y="11" width="14" height="2.2" fill="#0F9D58"/><rect x="13" y="16" width="14" height="2.2" fill="#0F9D58"/><rect x="13" y="21" width="14" height="2.2" fill="#0F9D58"/><rect x="13" y="26" width="14" height="2.2" fill="#0F9D58"/><rect x="18.9" y="11" width="2.2" height="17.2" fill="#0F9D58"/></svg>`;

const SLACK_LOGO = `<svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"><rect width="40" height="40" rx="6" fill="#15130F"/><path d="M15.5 24.5a2.5 2.5 0 1 1-2.5-2.5h2.5v2.5z" fill="#E01E5A"/><path d="M16.75 24.5a2.5 2.5 0 1 1 5 0v6.25a2.5 2.5 0 1 1-5 0V24.5z" fill="#E01E5A"/><path d="M17 15.5a2.5 2.5 0 1 1 2.5-2.5v2.5H17z" fill="#36C5F0"/><path d="M17 16.75a2.5 2.5 0 1 1 0 5h-6.25a2.5 2.5 0 1 1 0-5H17z" fill="#36C5F0"/><path d="M25.5 17a2.5 2.5 0 1 1 2.5 2.5H25.5V17z" fill="#2EB67D"/><path d="M24.25 17a2.5 2.5 0 1 1-5 0v-6.25a2.5 2.5 0 1 1 5 0V17z" fill="#2EB67D"/><path d="M24 25.5a2.5 2.5 0 1 1-2.5 2.5V25.5H24z" fill="#ECB22E"/><path d="M24 24.25a2.5 2.5 0 1 1 0-5h6.25a2.5 2.5 0 1 1 0 5H24z" fill="#ECB22E"/></svg>`;

const EMAIL_LOGO = `<svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"><rect width="40" height="40" rx="6" fill="#F5F5F0"/><path d="M7 12h26v18a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V12z" fill="#EA4335"/><path d="M7 12l13 10 13-10" fill="none" stroke="#F5F5F0" stroke-width="2"/><path d="M7 12l13 10 13-10" fill="#FBBC05"/><path d="M7 12a2 2 0 0 1 2-2h22a2 2 0 0 1 2 2l-13 10L7 12z" fill="#EA4335"/></svg>`;

const title = 'Real Estate DevShop — problem in, working demo on the spot';
const description =
  'Real Estate DevShop: tell us what’s bleeding NOI — rent recon, maintenance SLAs, vacancy, tenant turnover. Get a working demo right there. Build delivered in 30 days from deposit.';
const canonical = new URL('/devshop/real-estate', site.domain).href;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="noindex, follow" />
  <link rel="icon" href="/devshop-favicon.svg" type="image/svg+xml" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Real Estate DevShop" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL('/devshop-og.png', site.domain).href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL('/devshop-og.png', site.domain).href} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
</head>
<body>

<PortalHeader homeHref="/devshop/real-estate" spa={true} currentSlug="real-estate" industryLabel="Real Estate & Property Management" verticalTag="RE">
  <a href="#" data-go="landing" slot="extra-nav">Common use cases</a>
</PortalHeader>

<main class="wrap">

  <!-- 01 LANDING — leads with the common-use-case picker (per instruction:
       "should start with the common use cases that can be selected or a
       custom one can be put in"). The old separate "Common use cases" screen
       (id="proof") is merged in here; a custom free-text problem is still
       available below the grid for anything not on the list. -->
  <section class="screen active" id="landing" data-marketing-index="1">
    <div class="eyebrow">AI ORCHESTRATION FOR REAL ESTATE &amp; PROPERTY MANAGEMENT</div>
    <h1 class="hero serif" style="font-size:clamp(32px,4.6vw,64px);">Every property problem has an <span class="tint-blue">owner.</span><br />Pick yours, get a <span class="tint-gold">demo on the spot.</span></h1>
    <p class="sub" style="max-width:640px;">Nine business functions, mapped to the failure modes that actually show up on a rent roll. Filter by what you manage, then tap as many as apply — we'll solve for all of them together.</p>
    <div class="segment-row" id="typeFilterRow">
      {TYPES.map((t, i) => (
        <button type="button" class={`segment-chip${i === 0 ? ' active' : ''}`} data-type-filter={t.slug}>{t.label}</button>
      ))}
    </div>
    <div class="usecase-grid" id="usecaseGrid">
      {useCases.map((fn) => (
        <div class="usecase-card">
          <div class="usecase-fn">{fn.fn}</div>
          <div class="usecase-list">
            {fn.items.map((item) => (
              <button type="button" class="usecase-btn" aria-pressed="false" data-usecase-id={`${VERTICAL}:${item.id}`} data-fn={fn.fn} data-label={item.label} data-problem={item.problem} data-types={(item.types ?? ['all']).join(' ')}>{item.label}</button>
            ))}
          </div>
        </div>
      ))}
    </div>
    <div class="custom-problem">
      <div class="custom-problem-label">Don't see yours?</div>
      <form class="input-row" id="landingForm">
        <input type="text" id="landingProblem" placeholder="Describe what's actually broken, in your own words" />
        <button class="btn" type="submit">Submit</button>
      </form>
    </div>
    <p class="sub">No proposal. No scoping call. Just show us what's broken in your leasing, maintenance, or reporting ops.</p>
    <div class="footer-bar"><span class="footer-bar-text">Built fast, for landlords, property managers &amp; brokerages<sup>TM</sup></span></div>
  </section>

  <!-- floating bar shown once >=1 use case is selected via checkbox-style toggle -->
  <div class="usecase-selection-bar" id="usecaseSelectionBar" hidden>
    <span><strong id="usecaseSelectionCount">0</strong> selected</span>
    <button type="button" class="btn-plain" id="usecaseClearBtn">Clear</button>
    <button type="button" class="btn" id="usecaseContinueBtn">Continue →</button>
  </div>

  <!-- 02 HOW IT WORKS -->
  <section class="screen" id="how-it-works" data-marketing-index="2">
    <div class="eyebrow">HOW IT WORKS</div>
    <h1 class="hero serif">From <span class="tint-blue">problem</span><br />to production. <span class="tint-gold">Fast.</span></h1>
    <div class="steps">
      <div class="step"><div class="num">01</div><div class="rule"></div><h3>Problem in</h3><p>Tell us what's broken.<br />No specs. No decks.</p></div>
      <div class="step"><div class="num">02</div><div class="rule"></div><h3><span class="tint-gold">Instant</span> demo</h3><p>We diagnose and show you<br />a working demo right there.</p></div>
      <div class="step"><div class="num">03</div><div class="rule"></div><h3>30-day build</h3><p>You give feedback, then pay the deposit.<br />We ship within 30 days of that.</p></div>
    </div>
    <div class="footer-bar"><span class="footer-bar-text">Built fast, for landlords, property managers &amp; brokerages<sup>TM</sup></span></div>
  </section>

  <!-- 03 PRICING -->
  <section class="screen" id="pricing" data-marketing-index="3">
    <div class="eyebrow">PRICING</div>
    <div class="pricing-block">
      <h1 class="hero serif" style="font-size:clamp(36px,5vw,72px);">Build once.<br />Run on a <span class="tint-gold">retainer.</span></h1>
      <div style="display:flex; gap:64px; margin-top:48px; flex-wrap:wrap;">
        <div>
          <div class="eyebrow" style="margin-bottom:14px;">ONE-TIME BUILD</div>
          <div class="serif" style="font-size:clamp(28px,3.2vw,44px);">{CURRENCY}{PRICING.buildLow} – {CURRENCY}{PRICING.buildHigh}</div>
          <p class="sub" style="max-width:340px;">Depending on complexity.</p>
        </div>
        <div>
          <div class="eyebrow" style="margin-bottom:14px;">MONTHLY RETAINER</div>
          <div class="serif" style="font-size:clamp(28px,3.2vw,44px);"><span class="tint-gold">{CURRENCY}{PRICING.retainerMin}</span> minimum</div>
          <p class="sub" style="max-width:340px;">Scales with project spec and requirements.</p>
        </div>
      </div>
      <p class="sub" style="margin-top:36px;">Variable / custom pricing available outside this range. No proposals. No scoping calls.</p>
      <div style="margin-top:40px;"><button class="btn" data-go="intake">Start →</button></div>
    </div>
    <div class="footer-bar"><span class="footer-bar-text">Built fast, for landlords, property managers &amp; brokerages<sup>TM</sup></span></div>
  </section>

  <!-- 05 INTAKE — one question at a time, centered, keyboard-driven -->
  <section class="screen wizard-screen" id="intake" data-marketing-index="4">
    <div class="wizard" id="intakeWizard">
      <a href="#" class="wizard-back-link" data-go="landing">← Back to use cases</a>
      <div class="wizard-progress" id="wizardProgress" aria-hidden="true"></div>
      <form id="intakeForm" novalidate>
        <input type="hidden" name="usecaseId" value="" />
        <input type="hidden" name="usecaseVertical" value={VERTICAL} />
        <input type="hidden" name="usecaseLabel" value="" />
        <input type="hidden" name="usecaseBusinessFunction" value="" />
        <div class="wizard-step" data-field="problem" data-required="true" data-minlength="30">
          <p class="eyebrow">START</p>
          <h1 class="serif wizard-q">What's the problem?</h1>
          <p class="wizard-sub">More than one? List them all — we'll solve for each.</p>
          <textarea
            name="problem"
            class="wizard-input"
            rows="3"
            placeholder="Tell us what isn't working, what takes too long, or what you wish existed…"
          ></textarea>
          <div class="wizard-actions">
            <button type="button" class="btn wizard-next">Next →</button>
            <span class="wizard-hint">shift + enter for a new line, enter to continue</span>
          </div>
        </div>

        <div class="wizard-step" data-field="company" hidden>
          <h1 class="serif wizard-q">Who's asking?</h1>
          <input type="text" name="company" class="wizard-input" placeholder="Company name" />
          <div class="wizard-actions">
            <button type="button" class="btn wizard-next">Next →</button>
            <button type="button" class="btn-plain wizard-skip">Skip</button>
          </div>
        </div>

        <div class="wizard-step" data-field="industry" hidden>
          <h1 class="serif wizard-q">What kind of portfolio are you managing?</h1>
          <p class="wizard-sub">Helps us pick a framework with a real track record for portfolios like yours.</p>
          <div class="chip-row" id="industryChips">
            <button type="button" class="chip" data-value="Real Estate — Residential leasing">Residential leasing</button>
            <button type="button" class="chip" data-value="Real Estate — Commercial / office leasing">Commercial / office leasing</button>
            <button type="button" class="chip" data-value="Real Estate — Retail property management">Retail property management</button>
            <button type="button" class="chip" data-value="Real Estate — Co-working / flex space">Co-working / flex space</button>
            <button type="button" class="chip" data-value="Real Estate — Brokerage">Real estate brokerage</button>
            <button type="button" class="chip" data-value="Real Estate — Vacation rentals / short-let">Vacation rentals / short-let</button>
            <button type="button" class="chip" data-value="Real Estate — Mixed-use / multi-property">Mixed-use / multi-property</button>
          </div>
          <input type="text" name="industry" class="wizard-input wizard-input--secondary" placeholder="Other — name your segment" />
          <div class="wizard-actions">
            <button type="button" class="btn wizard-next">Next →</button>
            <button type="button" class="btn-plain wizard-skip">Skip</button>
          </div>
        </div>

        <div class="wizard-step" data-field="website" hidden>
          <h1 class="serif wizard-q">Got a website?</h1>
          <p class="wizard-sub">Helps the demo match your brand instead of ours.</p>
          <input type="text" name="website" class="wizard-input" placeholder="company.com" />
          <div class="wizard-actions">
            <button type="button" class="btn wizard-next">Next →</button>
            <button type="button" class="btn-plain wizard-skip">Skip</button>
          </div>
        </div>

        <div class="wizard-step" data-field="tools" hidden>
          <h1 class="serif wizard-q">What do you run on today?</h1>
          <p class="wizard-sub">Pick what applies — whatever the eventual build needs to connect to.</p>
          <div class="chip-row" id="toolsChips">
            <button type="button" class="chip" data-value="Property management software (Yardi/Buildium)">Property management software</button>
            <button type="button" class="chip" data-value="Accounting / ERP (Tally/QuickBooks)">Accounting / ERP</button>
            <button type="button" class="chip" data-value="Listing portals (99acres/MagicBricks/Zillow)">Listing portals</button>
            <button type="button" class="chip" data-value="CRM">CRM</button>
            <button type="button" class="chip" data-value="WhatsApp">WhatsApp</button>
            <button type="button" class="chip" data-value="Maintenance ticketing system">Maintenance ticketing system</button>
            <button type="button" class="chip" data-value="E-signature / lease platform">E-signature / lease platform</button>
            <button type="button" class="chip" data-value="Spreadsheets">Spreadsheets</button>
          </div>
          <input type="text" name="tools" class="wizard-input wizard-input--secondary" placeholder="Other — name the specific tool(s)" />
          <div class="wizard-actions">
            <button type="button" class="btn wizard-next">Next →</button>
            <button type="button" class="btn-plain wizard-skip">Skip</button>
          </div>
        </div>

        <div class="wizard-step" data-field="preferredFramework" hidden>
          <h1 class="serif wizard-q">Want a specific framework applied?</h1>
          <p class="wizard-sub">Optional — name it and we'll use it. Otherwise we'll pick the best fit for your problem.</p>
          <input type="text" name="preferredFramework" class="wizard-input" placeholder="e.g. Lean Six Sigma, OKRs, Jobs to Be Done…" />
          <div class="wizard-actions">
            <button type="button" class="btn wizard-next">Next →</button>
            <button type="button" class="btn-plain wizard-skip">Skip</button>
          </div>
        </div>

        <div class="wizard-step" data-field="email" data-required="true" hidden>
          <h1 class="serif wizard-q">Where should the demo go?</h1>
          <input type="email" name="email" class="wizard-input" placeholder="you@company.com" />
          <div class="wizard-actions">
            <button type="submit" class="btn" id="intakeSubmitBtn">Submit →</button>
          </div>
        </div>
      </form>
      <p class="wizard-error" id="intakeError" hidden></p>
    </div>
  </section>

  <!-- 05a BUILDING — shown while the synchronous Claude classify+build call runs (~60-90s) -->
  <section class="screen wizard-screen build-screen" id="building">
    <div class="build-layout">
      <div class="build-left">
        <div class="eyebrow">BUILDING</div>
        <h1 class="serif wizard-q" style="margin-bottom:8px;">Working the problem through the orchestrator.</h1>
        <p class="wizard-sub" id="buildCountdown">Usually takes about a minute.</p>
        <div class="build-progress"><div class="build-progress-fill" id="buildProgressFill"></div></div>
      </div>
      <div class="build-right">
        <div class="build-log" id="buildLog"></div>
      </div>
    </div>
  </section>

  <!-- 05b CONFIRMATION — real intake landed, no fake login/dashboard after this -->
  <section class="screen" id="confirmation">
    <div class="eyebrow">RECEIVED</div>
    <h1 class="hero serif" style="max-width:760px;">Got it. <span class="tint-gold">Check your email.</span></h1>
    <p class="sub" style="max-width:560px;">We've emailed you the link to your demo — one round of feedback, then a 30-day build once the deposit's in.</p>
    <div style="margin-top:40px;"><a href="#" data-go="landing" class="btn-plain">← Back to start</a></div>
    <div class="footer-bar"><span class="footer-bar-text">Built fast, for landlords, property managers &amp; brokerages<sup>TM</sup></span></div>
  </section>

  <!-- 06 LOGIN (UI-only — no real auth, see script comments) -->
  <section class="screen" id="login" style="justify-content:center;">
    <div class="login-box">
      <h2 class="serif">Welcome back.</h2>
      <form id="loginForm">
        <div class="field"><label>Email</label><input type="email" placeholder="you@company.com" required /></div>
        <button type="submit" class="btn" style="width:100%;">Send magic link →</button>
      </form>
    </div>
  </section>

  <!-- 07 DASHBOARD (UI-only — static demo data, no backend) -->
  <section class="screen" id="dashboard">
    <div class="eyebrow">PROJECT</div>
    <h1 class="hero serif" style="font-size:clamp(32px,4.4vw,52px);">Lead Intelligence Orchestrator</h1>
    <div class="tracker">
      <div class="node"><div class="dot-row"><div class="dot done"></div><div class="line done"></div></div><div class="label done">01 Problem received</div></div>
      <div class="node"><div class="dot-row"><div class="dot now"></div><div class="line"></div></div><div class="label now">02 Demo ready</div></div>
      <div class="node"><div class="dot-row"><div class="dot"></div><div class="line"></div></div><div class="label">03 Building</div></div>
      <div class="node"><div class="dot-row"><div class="dot"></div></div><div class="label">04 Live</div></div>
    </div>
    <div><button class="btn" data-go="orchestrator">View demo →</button></div>
    <p class="sub" style="margin-top:24px; max-width:620px;">One round of feedback before we build. Approving the demo is the scope document — there's no separate proposal.</p>
    <div class="activity-box">
      <div class="h">LAST ACTIVITY</div>
      <div class="line">Connected to CRM</div>
      <div class="line">Demo generated</div>
      <div class="line">Awaiting your feedback</div>
    </div>
  </section>

  <!-- 08 ORCHESTRATOR (UI-only — scripted log, no real Claude API call) -->
  <section class="screen" id="orchestrator">
    <div style="display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:12px;">
      <div class="eyebrow" style="margin-bottom:0;">LEAD INTELLIGENCE ORCHESTRATOR</div>
      <div class="app-status" id="orchStatus">BUILDING</div>
    </div>
    <div class="orch-problem">
      <div class="eyebrow" style="margin-bottom:10px;">ORIGINAL PROBLEM</div>
      <div class="q serif">"We have 90 days of CRM data but our sales team has no clear view of which leads need attention."</div>
    </div>
    <div class="orch-log">
      <div class="h">ORCHESTRATOR ACTIVITY <span class="sim-tag">(simulated)</span></div>
      <div id="logContainer"></div>
    </div>
    <div class="orch-input-row">
      <input type="text" id="orchInput" placeholder="Ask the orchestrator anything…" />
      <button class="btn" id="orchRunBtn">Run →</button>
    </div>
    <p class="sub" style="margin-top:20px; max-width:620px;">One round of feedback before we build — approve this demo and the 30-day build starts against it.</p>
  </section>

  <!-- 09 INTEGRATIONS (UI-only — no real OAuth, connect state is client-side only) -->
  <section class="screen" id="integrations">
    <div class="eyebrow">CONNECT THE TOOLS</div>
    <h1 class="hero serif" style="font-size:clamp(32px,4.4vw,52px);">Connect the tools.</h1>
    <div class="int-list">
      <div class="int-row">
        <div class="int-left">
          <span class="int-logo" aria-hidden="true" set:html={CRM_LOGO} />
          <div><div class="name">CRM</div><div class="desc">Your customer and pipeline data.</div></div>
        </div>
        <button class="btn connect-btn">Connect</button>
      </div>
      <div class="int-row">
        <div class="int-left">
          <span class="int-logo" aria-hidden="true" set:html={SHEETS_LOGO} />
          <div><div class="name">Google Sheets</div><div class="desc">Read and write operational data.</div></div>
        </div>
        <button class="btn connect-btn">Connect</button>
      </div>
      <div class="int-row">
        <div class="int-left">
          <span class="int-logo" aria-hidden="true" set:html={SLACK_LOGO} />
          <div><div class="name">Slack</div><div class="desc">Bring workflows into the team's workspace.</div></div>
        </div>
        <button class="btn connect-btn">Connect</button>
      </div>
      <div class="int-row">
        <div class="int-left">
          <span class="int-logo" aria-hidden="true" set:html={EMAIL_LOGO} />
          <div><div class="name">Email</div><div class="desc">Send updates and trigger workflows.</div></div>
        </div>
        <button class="btn connect-btn">Connect</button>
      </div>
    </div>
  </section>

  <!-- 10 ACTIVITY (UI-only — static log lines, no real job execution layer) -->
  <section class="screen" id="activity">
    <div class="eyebrow">AGENT ACTIVITY <span class="sim-tag">(simulated)</span></div>
    <div class="activity-box" style="max-width:760px;">
      <div class="line" style="color:var(--gold);"><span class="mono">09:42:16&nbsp;&nbsp;RUNNING&nbsp;&nbsp;&nbsp;&nbsp;Opportunity scoring</span></div>
      <div class="line mono">09:42:14&nbsp;&nbsp;COMPLETE&nbsp;&nbsp;&nbsp;Priority summary drafted</div>
      <div class="line mono">09:42:11&nbsp;&nbsp;COMPLETE&nbsp;&nbsp;&nbsp;Inactive opportunities identified</div>
      <div class="line mono">09:42:07&nbsp;&nbsp;COMPLETE&nbsp;&nbsp;&nbsp;Lead records normalized</div>
      <div class="line mono">09:42:04&nbsp;&nbsp;COMPLETE&nbsp;&nbsp;&nbsp;90 days of CRM data pulled</div>
      <div class="line mono">09:42:01&nbsp;&nbsp;COMPLETE&nbsp;&nbsp;&nbsp;CRM connection established</div>
    </div>
  </section>

  <!-- 11 BILLING (UI-only — static rows, no real billing system) -->
  <section class="screen" id="billing">
    <div class="eyebrow">BILLING</div>
    <h1 class="hero serif" style="font-size:clamp(32px,4.4vw,52px);">Real Estate DevShop</h1>
    <div class="billing-summary">
      <div class="item"><div class="l">MONTHLY</div><div class="v">{CURRENCY}{PRICING.retainerMin}</div></div>
      <div class="item"><div class="l">NEXT BILLING</div><div class="v">04 Oct 2026</div></div>
