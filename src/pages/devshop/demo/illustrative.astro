<script is:inline>
  // Tab switcher — same click-to-toggle pattern used across the site's
  // other artefact tab bars.
  document.getElementById('ktTabs').addEventListener('click', function (e) {
    var btn = e.target.closest('.kt-tab');
    if (!btn) return;
    document.querySelectorAll('.kt-tab').forEach(function (t) { t.classList.toggle('active', t === btn); });
    document.querySelectorAll('.kt-panel').forEach(function (p) { p.classList.toggle('active', p.dataset.ktpanel === btn.dataset.kttab); });
  });

  // Scenario run — one named payment, moving through data-in ->
  // processing -> outcome, with a separate agent-activity pane logging
  // which agent fires at each step. Same pacing (~1.1-1.6s/step) used
  // across the site's other run demos.
  (function () {
    var runBtn = document.getElementById('ktRun');
    if (!runBtn) return;
    var runStatus = document.getElementById('ktRunStatus');
    var steps = Array.prototype.slice.call(document.querySelectorAll('.kt-sc-step'));
    var logEl = document.getElementById('ktAgentLog');
    var wait = function (ms) { return new Promise(function (r) { setTimeout(r, ms); }); };

    function logLine(who, text, term) {
      return wait(30).then(function () {
        var line = document.createElement('div');
        line.className = 'kt-agent-line';
        line.innerHTML = (term ? '' : '<span class="kt-pulse"></span>') + '<span class="kt-who">' + who + '</span> — ' + text;
        if (term) line.classList.add('term');
        logEl.appendChild(line);
        return wait(20).then(function () { line.classList.add('show'); });
      });
    }

    runBtn.addEventListener('click', function () {
      runBtn.disabled = true;
      runBtn.textContent = '● Running…';
      runStatus.textContent = 'Payment #PMT-88213 · ₹1,84,500 · Orbis Retail';
      steps.forEach(function (s) { s.classList.remove('live', 'done'); });
      document.querySelectorAll('.kt-record').forEach(function (r) { r.classList.remove('show'); });
      document.getElementById('ktEsc').classList.remove('show');
      logEl.innerHTML = '';

      (async function () {
        steps[0].classList.add('live');
        await logLine('Data Extraction Agent', 'reading payment record PMT-88213…');
        await wait(1300);
        document.getElementById('ktRec1').classList.add('show');
        await wait(700);
        steps[0].classList.remove('live'); steps[0].classList.add('done');

        steps[1].classList.add('live');
        await logLine('Reconciliation/Matching Agent', 'checking against 14 open invoices…');
        await wait(1500);
        await logLine('Reconciliation/Matching Agent', 'matched INV-4471 + INV-4483, ₹120 short');
        await wait(700);
        document.getElementById('ktRec2').classList.add('show');
        await wait(800);
        steps[1].classList.remove('live'); steps[1].classList.add('done');

        steps[2].classList.add('live');
        await logLine('Exception/Diagnosis Agent', 'variance outside auto-approve tolerance — flagging');
        await wait(1300);
        await logLine('Notification Agent', 'sending escalation to AR Lead', true);
        await wait(700);
        document.getElementById('ktEsc').classList.add('show');
        await wait(400);
        steps[2].classList.remove('live'); steps[2].classList.add('done');

        runStatus.textContent = 'Escalated to AR Lead — one payment, real agents, real outcome';
        runBtn.disabled = false;
        runBtn.textContent = '↻ Run again';
        document.getElementById('ktResult').hidden = false;
      })();
    });
  })();
</script>
