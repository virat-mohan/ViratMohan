---
export const prerender = false;

import { getDb } from '../../../lib/db';
import { getEnv } from '../../../lib/env';

const env = getEnv();
const { id } = Astro.params;

const row = id ? await getDb(env).getById(id) : null;

if (!row || !row.artefact_html || (row.status !== 'sent' && row.status !== 'demo_ready')) {
  return new Response('Not found', { status: 404 });
}

const notes = row.solution_notes;
const levers = row.pnl_levers ?? [];
const title = row.company ? `Your demo — ${row.company}` : 'Your demo';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=Inter:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
</head>
<body>

  <main class="brief">
    <div class="eyebrow">SOLUTION BRIEF{row.company ? ` — ${row.company}` : ''}</div>
    <blockquote class="submitted-problem">
      <span class="submitted-label">What you told us</span>
      {row.problem}
    </blockquote>
    <h1>What we heard, and what we're proposing.</h1>

    {notes && notes.problemBreakdown.length > 0 && (
      <section class="block">
        <h2>The problem{notes.problemBreakdown.length > 1 ? 's' : ''}</h2>
        {notes.problemBreakdown.map((p) => (
          <div class="card">
            <p class="card-title">{p.problem_statement}</p>
            <p class="card-function">{p.business_function}</p>
            <ul class="bullets">
              <li><span class="bullet-label">Root cause</span>{p.root_cause}</li>
              <li><span class="bullet-label">Cost of inaction</span>{p.current_cost_of_inaction}</li>
            </ul>
          </div>
        ))}
      </section>
    )}

    {notes && notes.frameworkSelections.length > 0 && (
      <section class="block framework-block">
        <h2>Grounded in a proven approach</h2>
        {notes.frameworkSelections.map((f) => (
          <div class="card">
            <p class="card-title">{f.framework_name}</p>
            <p class="card-function">{f.framework_source}</p>
            <ul class="bullets">
              <li><span class="bullet-label">Why this fits</span>{f.why_selected}</li>
              <li><span class="bullet-label">Also considered</span>{f.alternatives_considered}</li>
            </ul>
          </div>
        ))}
      </section>
    )}

    {notes && notes.solutionMechanisms.length > 0 && (
      <section class="block">
        <h2>What we'd build</h2>
        {notes.solutionMechanisms.map((m) => (
          <div class="card">
            <p class="card-title">{m.mechanism_name}</p>
            <ol class="bullets numbered">
              {m.how_it_works_steps.map((step) => <li>{step}</li>)}
            </ol>
          </div>
        ))}
      </section>
    )}

    {levers.length > 0 && (
      <section class="block">
        <h2>Expected impact</h2>
        <ul class="bullets flat">
          {levers.map((l) => (
            <li><span class="bullet-label">{l.lever}</span>{l.reasoning}</li>
          ))}
        </ul>
      </section>
    )}

    {notes && notes.clarifyingQuestions.length > 0 && (
      <section class="block questions">
        <h2>To sharpen these numbers, we'd ask</h2>
        <p class="questions-intro">Assumptions used industry benchmarks where we didn't have your real figures — answer any of these in your reply for the exact number:</p>
        <ul class="bullets">
          {notes.clarifyingQuestions.map((q) => <li>{q}</li>)}
        </ul>
      </section>
    )}

    <p class="feedback-note">
      Reply to the email this came from with one round of feedback — that's the scope for the 7-day build. No proposal, no scoping call.
    </p>
  </main>

  <div class="divider"><span>Try it yourself</span></div>

  <div class="artefact-embed" set:html={row.artefact_html}></div>

</body>
</html>

<style>
  :root { color-scheme: light; }
  html, body { margin: 0; background: #fafaf8; }
  body { font-family: 'Inter', system-ui, sans-serif; color: #24211d; }

  .brief { max-width: 720px; margin: 0 auto; padding: 56px 32px 32px; }
  .eyebrow { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: #8a8378; margin-bottom: 14px; }
  h1 { font-family: 'Source Serif 4', Georgia, serif; font-weight: 600; font-size: clamp(26px, 4vw, 36px); line-height: 1.15; margin: 0 0 32px; max-width: 20ch; }

  .submitted-problem {
    margin: 0 0 28px; padding: 14px 18px; border-left: 3px solid #c48d2e;
    background: #fff6ea; font-style: italic; font-size: 15px; line-height: 1.6; color: #4a453e;
  }
  .submitted-label {
    display: block; font-style: normal; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;
    color: #a67c2e; margin-bottom: 4px;
  }
  h2 { font-family: 'Source Serif 4', Georgia, serif; font-weight: 600; font-size: 17px; margin: 0 0 12px; }
  .block { margin-bottom: 28px; }
  .card { padding: 14px 0; border-top: 1px solid rgba(36,33,29,0.1); }
  .card:first-of-type { border-top: none; }
  .card-title { font-weight: 600; font-size: 15px; margin: 0 0 4px; }
  .card-function { font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: #a67c2e; margin: 0 0 10px; }

  .bullets { margin: 0; padding-left: 18px; font-size: 14px; line-height: 1.55; color: #3a3630; }
  .bullets li { margin-bottom: 4px; }
  .bullets.flat > li { padding: 10px 0; border-top: 1px solid rgba(36,33,29,0.08); list-style: none; padding-left: 0; margin-left: -18px; }
  .bullets.flat > li:first-child { border-top: none; }
  .bullets.numbered { padding-left: 20px; }
  .bullet-label { display: block; font-weight: 600; color: #24211d; font-size: 12px; text-transform: uppercase; letter-spacing: 0.03em; margin-bottom: 2px; }

  .questions { background: #fff6ea; border: 1px solid rgba(196,141,46,0.3); border-radius: 8px; padding: 20px 24px; }
  .framework-block { background: #f5f8f6; border: 1px solid rgba(31,122,92,0.2); border-radius: 8px; padding: 20px 24px; }
  .framework-block .card { border-top-color: rgba(31,122,92,0.15); }
  .framework-block .card:first-of-type { border-top: none; }
  .questions-intro { font-size: 13px; color: #6b5f4a; margin: 0 0 10px; }
  .feedback-note { font-size: 13px; color: #6b6459; border-top: 1px solid rgba(36,33,29,0.1); padding-top: 20px; }

  .divider { display: flex; align-items: center; gap: 16px; max-width: 720px; margin: 8px auto 28px; padding: 0 32px; }
  .divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: rgba(36,33,29,0.15); }
  .divider span { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: #8a8378; white-space: nowrap; }

  .artefact-embed { max-width: 960px; margin: 0 auto 64px; padding: 0 32px; }

  @media (max-width: 640px) {
    .brief { padding: 36px 20px 24px; }
    .artefact-embed { padding: 0 20px; }
  }
</style>
