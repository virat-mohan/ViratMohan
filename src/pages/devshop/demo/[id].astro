---
export const prerender = false;

import { getDb } from '../../../lib/db';

const env = Astro.locals.runtime.env;
const { id } = Astro.params;

const row = id ? await getDb(env).getById(id) : null;

if (!row || !row.artefact_html || (row.status !== 'sent' && row.status !== 'demo_ready')) {
  return new Response('Not found', { status: 404 });
}
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Your demo — Fast Tech Dev Shop</title>
  <meta name="robots" content="noindex, nofollow" />
</head>
<body set:html={row.artefact_html}></body>
</html>

<style>
  html, body { margin: 0; background: #15130f; }
</style>
