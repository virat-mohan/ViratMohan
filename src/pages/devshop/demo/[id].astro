---
export const prerender = false;

import { getDb, type PipelineStage } from '../../../lib/db';
import { getEnv } from '../../../lib/env';
import { FIT_DIMENSIONS } from '../../../lib/llm';
import { shouldProcessFeedback } from '../../../lib/feedback-parsing';
import { RESOURCE_CATEGORY_LABELS } from '../../../lib/amc';
import { IMPLEMENTATION_ROLE_LABELS } from '../../../lib/implementation';

const env = getEnv();
const { id } = Astro.params;

const row = id ? await getDb(env).getById(id) : null;

// Visible for the whole post-send lifecycle, not just the instant it's
// sent — the page keeps working (timeline, pricing, artefact) as the
// client progresses through the pipeline. Not shown before a demo has
// actually been generated and sent (received/revising/failed) or once
// refunded.
const HIDDEN_STATUSES: PipelineStage[] = ['received', 'revising', 'failed', 'refunded'];
if (!row || !row.artefact_html || HIDDEN_STATUSES.includes(row.status)) {
  return new Response('Not found', { status: 404 });
}

const notes = row.solution_notes;
const levers = row.pnl_levers ?? [];
const title = row.company ? `Your demo — ${row.company}` : 'Your demo';
const canGiveFeedback = shouldProcessFeedback(row);

// Plain-language column labels for the framework evaluation table — same
// fixed dimensions the admin scoring uses (src/lib/llm.ts FIT_DIMENSIONS),
// worded for a reader who's never seen the internal taxonomy.
const DIMENSION_LABELS: Record<string, string> = {
  problem_pattern_fit: 'Matches this problem',
  root_cause_fit: 'Addresses the root cause',
  business_function_fit: 'Fits the right team',
  evidence_sufficiency: 'Enough evidence to apply',
  intervention_compatibility: 'Fits the planned fix',
  pnl_relevance: 'Likely to move the numbers',
  framework_specificity: 'Specific, not generic',
  contraindication_risk: 'No red flags here',
  industry_relevance: 'Track record in your industry',
};
// One-line plain descriptor per column, so "why does this score exist" is
// answered without needing to already know the internal taxonomy.
const DIMENSION_DESCRIPTIONS: Record<string, string> = {
  problem_pattern_fit: 'Does this approach generally fit the kind of problem you described?',
  root_cause_fit: 'Does it address the specific root cause we found, not just the general topic?',
  business_function_fit: 'Is it built for the part of the business actually feeling this pain?',
  evidence_sufficiency: 'Do we know enough yet to apply it with real confidence?',
  intervention_compatibility: 'Does it match the actual fix we\'re planning to build?',
  pnl_relevance: 'Would using it plausibly move the number we\'re targeting?',
  framework_specificity: 'Does it give concrete steps, or is it vague enough to fit anything?',
  contraindication_risk: 'Any known reason this approach could mislead or misfire here?',
  industry_relevance: 'Does it have a real track record in businesses like yours?',
};
const FIT_TABLE_MAX = FIT_DIMENSIONS.length * 5;

const frameworkEvaluations = (notes?.frameworkSelections ?? []).map((f) => ({
  problem_index: f.problem_index,
  candidates: [...(f.fitCandidates ?? [])].sort((a, b) => b.total_score - a.total_score),
}));

// A fake-but-plausible address-bar label so the artefact reads as "your
// actual product running in a browser" rather than a bare embedded box.
const companySlug = (row.company || 'yourcompany').toLowerCase().replace(/[^a-z0-9]+/g, '');
const browserUrlLabel = row.website
  ? row.website.replace(/^https?:\/\//i, '').replace(/\/$/, '')
  : `app.${companySlug || 'yourcompany'}.com`;

const preparedDate = new Date(row.created_at).toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' });

// Item 4 — timeline shown on-site, mapped from the same pipeline stages
// the admin panel drives. Grouped into fewer visitor-facing milestones
// than the raw PIPELINE_STAGES list.
const TIMELINE_STAGES: { statuses: PipelineStage[]; label: string }[] = [
  { statuses: ['demo_ready', 'sent'], label: 'Demo delivered' },
  { statuses: ['interested'], label: 'You confirmed' },
  { statuses: ['scoping_scheduled', 'scoping_complete'], label: 'Scoping call' },
  { statuses: ['proposal_sent'], label: 'Proposal' },
  { statuses: ['deposit_paid', 'build_scheduled'], label: 'Deposit & kickoff' },
  { statuses: ['in_build', 'uat'], label: '30-day build' },
  { statuses: ['delivered', 'feedback_requested'], label: 'Delivered' },
  { statuses: ['amc_active'], label: 'Live on AMC' },
];
const currentTimelineIndex = Math.max(0, TIMELINE_STAGES.findIndex((s) => s.statuses.includes(row.status)));
const canMoveForward = row.status === 'sent';
const alreadyMovedForward = currentTimelineIndex > 0;

// Numbered section eyebrows (01, 02, 03…), consulting-report style —
// incremented in document order as each section actually renders, so a
// skipped section (e.g. no clarifying questions) just isn't counted rather
// than leaving a visible gap.
let sectionCounter = 0;
function nextSectionNum() {
  sectionCounter += 1;
  return String(sectionCounter).padStart(2, '0');
}
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,500;0,6..72,600;1,6..72,500&family=Archivo:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
</head>
<body>

  <main class="brief">
    <div class="doc-header">
      <div class="eyebrow">SOLUTION BRIEF</div>
      <h1>What we heard, and what we're proposing.</h1>
      <div class="doc-meta">
        <div class="doc-meta-row"><span class="doc-meta-label">Prepared for</span>{row.company || row.email}</div>
        <div class="doc-meta-row"><span class="doc-meta-label">Date</span>{preparedDate}</div>
        <div class="doc-meta-row"><span class="doc-meta-label">Status</span>Confidential — one revision round, then a 30-day build from deposit</div>
      </div>
    </div>

    <blockquote class="submitted-problem">
      <span class="submitted-label">What you told us</span>
      {row.problem}
    </blockquote>

    {notes && notes.problemBreakdown.length > 0 && (
      <section class="block">
        <div class="section-head"><span class="section-num">{nextSectionNum()}</span><h2>The problem{notes.problemBreakdown.length > 1 ? 's' : ''}</h2></div>
        {notes.problemBreakdown.map((p) => (
          <div class="card">
            <p class="card-title">{p.plain_summary || p.problem_statement}</p>
            <p class="card-function"><span class="card-tag">Business function</span>{p.business_function}</p>
          </div>
        ))}
      </section>
    )}

    {notes && notes.frameworkSelections.length > 0 && (
      <section class="block framework-block">
        <div class="section-head"><span class="section-num">{nextSectionNum()}</span><h2>Grounded in a proven approach</h2></div>
        {notes.frameworkSelections.map((f) => (
          <div class="card">
            <p class="card-title">{f.framework_link ? <a href={f.framework_link} target="_blank" style="color:inherit; text-decoration:underline;">{f.framework_name}</a> : f.framework_name}</p>
            <p class="card-function">{f.framework_source}</p>
            <p class="plain-copy">{f.plain_explanation || f.why_selected}</p>
          </div>
        ))}
      </section>
    )}

    {frameworkEvaluations.some((e) => e.candidates.length > 1) && (
      <section class="block eval-block">
        <div class="section-head"><span class="section-num">{nextSectionNum()}</span><h2>How we compared approaches</h2></div>
        <p class="eval-intro">We don't just pick the first framework that sounds relevant — every candidate below was scored on the same 9 points before we chose. Higher is better on every column; the approach we went with isn't always the highest scorer on every single point, but it's the best overall fit.</p>
        {frameworkEvaluations.map((evaln) => evaln.candidates.length > 1 && (
          <div class="eval-table-wrap">
            <table class="eval-table">
              <thead>
                <tr>
                  <th>Approach</th>
                  {FIT_DIMENSIONS.map((d) => <th title={DIMENSION_DESCRIPTIONS[d]}>{DIMENSION_LABELS[d]}</th>)}
                  <th>Total</th>
                </tr>
              </thead>
              <tbody>
                {evaln.candidates.map((c) => (
                  <tr class={c.is_selected ? 'eval-row-selected' : ''}>
                    <td>
                      {c.is_selected && <span class="eval-arrow" aria-hidden="true">→</span>}
                      {c.framework_name}
                    </td>
                    {FIT_DIMENSIONS.map((d) => {
                      const entry = c.dimension_scores.find((s) => s.dimension === d);
                      return <td class="eval-score-cell">{entry ? entry.score : '—'}</td>;
                    })}
                    <td class="eval-total-cell">{c.total_score}/{FIT_TABLE_MAX}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            {evaln.candidates.find((c) => c.is_selected) && (
              <p class="eval-recommendation">Our recommendation: <strong>{evaln.candidates.find((c) => c.is_selected)!.framework_name}</strong></p>
            )}
          </div>
        ))}
        <h3 class="eval-legend-title">Understanding the scoring metrics</h3>
        <ul class="eval-legend">
          {FIT_DIMENSIONS.map((d) => (
            <li><strong>{DIMENSION_LABELS[d]}</strong> — {DIMENSION_DESCRIPTIONS[d]}</li>
          ))}
        </ul>
      </section>
    )}

    {notes && notes.solutionMechanisms.length > 0 && (
      <section class="block">
        <div class="section-head"><span class="section-num">{nextSectionNum()}</span><h2>What we'd build</h2></div>
        {notes.solutionMechanisms.map((m) => (
          <div class="card">
            <p class="card-title">{m.mechanism_name}</p>
            <p class="plain-copy">{m.plain_explanation}</p>
            {m.agentSequence && m.agentSequence.length > 0 && (
              <p class="agent-list">
                Powered by: {[...new Map(m.agentSequence.map((a) => [a.agent_name, a])).values()].map((a, i, arr) => (
                  <>{i > 0 ? ', ' : ''}{a.agent_name}</>
                ))}
              </p>
            )}
          </div>
        ))}
      </section>
    )}

    {levers.length > 0 && (
      <section class="block">
        <div class="section-head"><span class="section-num">{nextSectionNum()}</span><h2>Expected impact</h2></div>
        {levers.map((l) => (
          <div class="impact-card">
            <p class="plain-copy">{l.plain_explanation || l.reasoning}</p>
            {l.calculation && l.calculation.length > 0 && (
              <table class="calc-table">
                <tbody>
                  {l.calculation.map((row, i) => (
                    <tr class={i === l.calculation.length - 1 ? 'calc-result-row' : ''}>
                      <td class="calc-label">{row.label}</td>
                      <td class="calc-value">{row.value}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
            {l.value_status !== 'known' && (
              <p class="calc-note">Based on typical industry figures, not numbers you've given us yet — see the questions below to make this exact.</p>
            )}
          </div>
        ))}
      </section>
    )}

    {notes && notes.clarifyingQuestions.length > 0 && (
      <section class="block questions">
        <div class="section-head"><span class="section-num">{nextSectionNum()}</span><h2>To sharpen these numbers, we'd ask</h2></div>
        <p class="questions-intro">(<em>Assumptions used industry benchmarks where we didn't have your real figures — answer any of these in your reply for the exact number.</em>)</p>
        <ul class="bullets">
          {notes.clarifyingQuestions.map((q) => (
            <li>{q.blocking && <span class="q-blocking">Please confirm</span>}{q.question}</li>
          ))}
        </ul>
      </section>
    )}

    <p class="feedback-note">
      Have a change or a correction? Use the feedback form below — we'll fold it into one revised version, and that's the scope we build to. The 30-day clock starts once your deposit is in, not before.
    </p>

    {notes && (
      <details class="appendix">
        <summary>Appendix — the detailed reasoning behind this</summary>

        {notes.problemBreakdown.length > 0 && (
          <div class="appendix-section">
            <h3>Diagnosis, in full</h3>
            {notes.problemBreakdown.map((p) => (
              <div class="appendix-card">
                <p class="appendix-title">{p.problem_statement}</p>
                <ul class="bullets">
                  <li><span class="bullet-label">Root cause</span>{p.root_cause}</li>
                  <li><span class="bullet-label">Who's affected</span>{p.who_is_affected}</li>
                  <li><span class="bullet-label">Cost of inaction</span>{p.current_cost_of_inaction}</li>
                </ul>
              </div>
            ))}
          </div>
        )}

        {notes.frameworkSelections.length > 0 && (
          <div class="appendix-section">
            <h3>Why this framework, specifically</h3>
            {notes.frameworkSelections.map((f) => (
              <div class="appendix-card">
                <p class="appendix-title">{f.framework_name}</p>
                <ul class="bullets">
                  <li><span class="bullet-label">Why this fits</span>{f.why_selected}</li>
                </ul>
                {f.runner_ups.length > 0 && (
                  <p class="also-considered">
                    Also weighed: {f.runner_ups.map((r, i) => (
                      <>{i > 0 ? ', ' : ''}{r.link ? <a href={r.link} target="_blank" style="color:inherit;">{r.name}</a> : r.name}</>
                    ))}
                  </p>
                )}
              </div>
            ))}
          </div>
        )}

        {notes.solutionMechanisms.length > 0 && (
          <div class="appendix-section">
            <h3>How the mechanism actually works</h3>
            {notes.solutionMechanisms.map((m) => (
              <div class="appendix-card">
                <p class="appendix-title">{m.mechanism_name}</p>
                <ol class="bullets numbered">
                  {m.how_it_works_steps.map((step) => <li>{step}</li>)}
                </ol>
              </div>
            ))}
          </div>
        )}

        {levers.length > 0 && (
          <div class="appendix-section">
            <h3>The P&amp;L reasoning</h3>
            <ul class="bullets flat">
              {levers.map((l) => (
                <li><span class="bullet-label">{l.lever}</span>{l.reasoning}</li>
              ))}
            </ul>
          </div>
        )}
      </details>
    )}
  </main>

  <div class="walkthrough-intro">
    <p class="walkthrough-eyebrow">See it work</p>
    <h2 class="walkthrough-heading">The interactive walkthrough</h2>
    <p class="artefact-caption">Press <strong>Run</strong> below to watch the mechanism work end to end, using your own tools.</p>
  </div>

  <div class="browser-chrome">
    <div class="browser-chrome-bar">
      <span class="chrome-dot chrome-dot--red"></span>
      <span class="chrome-dot chrome-dot--yellow"></span>
      <span class="chrome-dot chrome-dot--green"></span>
      <div class="chrome-address">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M6 10V8a6 6 0 1112 0v2M5 10h14a1 1 0 011 1v9a1 1 0 01-1 1H5a1 1 0 01-1-1v-9a1 1 0 011-1z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="chrome-address-text">{browserUrlLabel}</span>
      </div>
    </div>
    <div class="artefact-embed">
      <iframe id="artefactFrame" title="Interactive demo" srcdoc={row.artefact_html}></iframe>
    </div>
  </div>

  <main class="brief next-steps">
    {canGiveFeedback && (
      <section class="block feedback-block" id="feedbackSection">
        <div class="section-head"><span class="section-num">{nextSectionNum()}</span><h2>Your feedback</h2></div>
        <p class="eval-intro">One round, and we build from it — answer what you can below, add anything else that needs to change, then submit. No email needed.</p>

        {notes && notes.clarifyingQuestions.length > 0 && (
          <div class="qa-list">
            {notes.clarifyingQuestions.map((q, i) => (
              <div class="qa-row">
                <label class="qa-question" for={`qa-answer-${i}`}>{q.blocking && <span class="q-blocking">Please confirm</span>}{q.question}</label>
                {q.expected_answer_type === 'yes_no' ? (
                  <select id={`qa-answer-${i}`} class="qa-answer" data-question={q.question}>
                    <option value="">Your answer (optional)</option>
                    <option value="Yes">Yes</option>
                    <option value="No">No</option>
                  </select>
                ) : (
                  <input
                    type={q.expected_answer_type === 'number' ? 'number' : 'text'}
                    id={`qa-answer-${i}`}
                    class="qa-answer"
                    data-question={q.question}
                    placeholder="Your answer (optional)"
                  />
                )}
              </div>
            ))}
          </div>
        )}

        <label class="qa-question" for="additionalFeedback">Anything else to change?</label>
        <textarea id="additionalFeedback" rows="3" placeholder="Optional — describe any other changes"></textarea>

        <button id="feedbackSubmitBtn" class="cta-btn">Submit feedback &amp; revise</button>
        <p class="hint-text" id="feedbackHint" hidden></p>

        <div class="feedback-revising" id="feedbackRevising" hidden>
          <div class="mini-spinner" aria-hidden="true"></div>
          <span>Revising your demo — this takes about a minute…</span>
        </div>
      </section>
    )}

    {!canGiveFeedback && row.feedback_round >= 1 && (
      <section class="block">
        <p class="revised-note">✓ Your feedback has been incorporated — this is the final version this build proceeds from.</p>
      </section>
    )}

    <section class="block timeline-block">
      <div class="section-head"><span class="section-num">{nextSectionNum()}</span><h2>Where this stands</h2></div>
      <div class="timeline">
        {TIMELINE_STAGES.map((stage, i) => (
          <div class={`timeline-step ${i < currentTimelineIndex ? 'done' : i === currentTimelineIndex ? 'current' : ''}`}>
            <span class="timeline-dot"></span>
            <span class="timeline-label">{stage.label}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="block pricing-block">
      <div class="section-head"><span class="section-num">{nextSectionNum()}</span><h2>Investment</h2></div>
      <div class="pricing-grid">
        <div class="pricing-card">
          <p class="pricing-amount">₹1,50,000</p>
          <p class="pricing-label">First module — standard build</p>
        </div>
        <div class="pricing-card">
          <p class="pricing-amount">₹75,000</p>
          <p class="pricing-label">Each additional module, within 30 days of the first</p>
        </div>
        <div class="pricing-card">
          <p class="pricing-amount">From ₹50,000<span class="pricing-per">/mo</span></p>
          <p class="pricing-label">AMC per live module — ongoing updates, monitoring, and support</p>
        </div>
      </div>
      <p class="pricing-note">A genuinely complex build is custom-quoted after a short scoping call, not fit into the standard price. The 30-day delivery guarantee applies to standard builds, and the clock starts the moment your deposit clears — not at the demo, not at scoping.</p>

      {row.implementation_estimate && (
        <div class="team-block">
          <h3 class="team-title">Who works on your build</h3>
          <p class="team-intro">Transparently — the actual team and hours behind the price, not a black box.</p>
          <div class="team-rows">
            {row.implementation_estimate.estimates.filter((e) => e.hours > 0).map((e) => (
              <div class="team-row">
                <span class="team-role">{IMPLEMENTATION_ROLE_LABELS[e.role]}</span>
                <span class="team-hours">{e.people} {e.people === 1 ? 'person' : 'people'} · {e.hours} hrs</span>
              </div>
            ))}
          </div>
        </div>
      )}

      {row.amc_resource_estimate && row.amc_pricing_decision && (
        <div class="team-block">
          <h3 class="team-title">Who supports you afterward</h3>
          <p class="team-intro">Ongoing FTDS team included in your AMC, ₹{row.amc_pricing_decision.monthly_amount_inr.toLocaleString('en-IN')}/month.</p>
          <div class="team-rows">
            {row.amc_resource_estimate.estimates.map((e) => (
              <div class="team-row">
                <span class="team-role">{RESOURCE_CATEGORY_LABELS[e.category]}</span>
                <span class="team-hours">{e.monthly_hours} hrs/mo</span>
              </div>
            ))}
          </div>
        </div>
      )}
    </section>

    <section class="block move-forward-block">
      {canMoveForward && (
        <>
          <button id="moveForwardBtn" class="cta-btn cta-btn--primary">This solves it — let's move forward</button>
          <p class="hint-text" id="moveForwardHint" hidden></p>
        </>
      )}
      {alreadyMovedForward && (
        <p class="revised-note">✓ You've confirmed you want to move forward — we'll reach out to schedule scoping and kickoff.</p>
      )}
    </section>
  </main>

  <script define:vars={{ id: row.id }}>
    const feedbackBtn = document.getElementById('feedbackSubmitBtn');
    if (feedbackBtn) {
      feedbackBtn.addEventListener('click', async () => {
        const hint = document.getElementById('feedbackHint');
        const answers = Array.from(document.querySelectorAll('.qa-answer'))
          .map((el) => ({ question: el.dataset.question, answer: el.value.trim() }))
          .filter((a) => a.answer);
        const additionalFeedback = document.getElementById('additionalFeedback').value.trim();
        if (answers.length === 0 && !additionalFeedback) {
          hint.textContent = 'Answer at least one question or add feedback first.';
          hint.hidden = false;
          return;
        }
        hint.hidden = true;
        feedbackBtn.disabled = true;
        feedbackBtn.hidden = true;
        document.getElementById('feedbackRevising').hidden = false;
        try {
          const res = await fetch('/devshop/api/demo-feedback', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ id, answers, additionalFeedback }),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || 'Something went wrong.');
          location.reload();
        } catch (err) {
          document.getElementById('feedbackRevising').hidden = true;
          feedbackBtn.hidden = false;
          feedbackBtn.disabled = false;
          hint.textContent = 'Failed: ' + err.message;
          hint.hidden = false;
        }
      });
    }

    const moveForwardBtn = document.getElementById('moveForwardBtn');
    if (moveForwardBtn) {
      moveForwardBtn.addEventListener('click', async () => {
        moveForwardBtn.disabled = true;
        moveForwardBtn.textContent = 'Confirming…';
        try {
          const res = await fetch('/devshop/api/demo-interest', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ id }),
          });
          if (!res.ok) throw new Error('Something went wrong.');
          location.reload();
        } catch (err) {
          moveForwardBtn.disabled = false;
          moveForwardBtn.textContent = "This solves it — let's move forward";
          const hint = document.getElementById('moveForwardHint');
          hint.textContent = 'Failed: ' + err.message;
          hint.hidden = false;
        }
      });
    }
  </script>

  <script>
    // The artefact is a full interactive mini-app with its own <script>
    // tags — those never execute if injected via innerHTML, which silently
    // breaks every button/toggle in it. An iframe with srcdoc runs them
    // properly (same-origin by default, so we can still read its height to
    // auto-size it rather than showing an internal scrollbar).
    const frame = document.getElementById('artefactFrame');
    if (frame) {
      let observed = false;
      const resize = () => {
        try {
          const doc = frame.contentDocument;
          if (doc && doc.documentElement) frame.style.height = doc.documentElement.scrollHeight + 'px';
          if (!observed && doc && doc.body && 'ResizeObserver' in window) {
            observed = true;
            new ResizeObserver(resize).observe(doc.body);
          }
        } catch (e) {
          // Cross-origin or not yet ready — leave the current height alone.
        }
      };
      // This script tag runs as a deferred module, and a srcdoc iframe's
      // content can finish loading before that — so the 'load' event may
      // already have fired by the time we attach a listener for it. Call
      // resize immediately (covers that case) AND listen for 'load' (covers
      // the case where it hasn't fired yet), then keep polling regardless —
      // covers any content change a ResizeObserver might miss.
