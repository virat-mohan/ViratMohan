---
export const prerender = false;

import { getDb } from '../../../lib/db';
import { getEnv } from '../../../lib/env';
import { FIT_DIMENSIONS } from '../../../lib/llm';

const env = getEnv();
const { id } = Astro.params;

const row = id ? await getDb(env).getById(id) : null;

if (!row || !row.artefact_html || (row.status !== 'sent' && row.status !== 'demo_ready')) {
  return new Response('Not found', { status: 404 });
}

const notes = row.solution_notes;
const levers = row.pnl_levers ?? [];
const title = row.company ? `Your demo — ${row.company}` : 'Your demo';

// Plain-language column labels for the framework evaluation table — same
// fixed dimensions the admin scoring uses (src/lib/llm.ts FIT_DIMENSIONS),
// worded for a reader who's never seen the internal taxonomy.
const DIMENSION_LABELS: Record<string, string> = {
  problem_pattern_fit: 'Matches this problem',
  root_cause_fit: 'Addresses the root cause',
  business_function_fit: 'Fits the right team',
  evidence_sufficiency: 'Enough evidence to apply',
  intervention_compatibility: 'Fits the planned fix',
  pnl_relevance: 'Likely to move the numbers',
  framework_specificity: 'Specific, not generic',
  contraindication_risk: 'No red flags here',
  industry_relevance: 'Track record in your industry',
};
// One-line plain descriptor per column, so "why does this score exist" is
// answered without needing to already know the internal taxonomy.
const DIMENSION_DESCRIPTIONS: Record<string, string> = {
  problem_pattern_fit: 'Does this approach generally fit the kind of problem you described?',
  root_cause_fit: 'Does it address the specific root cause we found, not just the general topic?',
  business_function_fit: 'Is it built for the part of the business actually feeling this pain?',
  evidence_sufficiency: 'Do we know enough yet to apply it with real confidence?',
  intervention_compatibility: 'Does it match the actual fix we\'re planning to build?',
  pnl_relevance: 'Would using it plausibly move the number we\'re targeting?',
  framework_specificity: 'Does it give concrete steps, or is it vague enough to fit anything?',
  contraindication_risk: 'Any known reason this approach could mislead or misfire here?',
  industry_relevance: 'Does it have a real track record in businesses like yours?',
};
const FIT_TABLE_MAX = FIT_DIMENSIONS.length * 5;

const frameworkEvaluations = (notes?.frameworkSelections ?? []).map((f) => ({
  problem_index: f.problem_index,
  candidates: [...(f.fitCandidates ?? [])].sort((a, b) => b.total_score - a.total_score),
}));
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=Inter:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
</head>
<body>

  <main class="brief">
    <div class="eyebrow">SOLUTION BRIEF{row.company ? ` — ${row.company}` : ''}</div>
    <blockquote class="submitted-problem">
      <span class="submitted-label">What you told us</span>
      {row.problem}
    </blockquote>
    <h1>What we heard, and what we're proposing.</h1>

    {notes && notes.problemBreakdown.length > 0 && (
      <section class="block">
        <h2>The problem{notes.problemBreakdown.length > 1 ? 's' : ''}</h2>
        {notes.problemBreakdown.map((p) => (
          <div class="card">
            <p class="card-title">{p.plain_summary || p.problem_statement}</p>
            <p class="card-function"><span class="card-tag">Business function</span>{p.business_function}</p>
          </div>
        ))}
      </section>
    )}

    {notes && notes.frameworkSelections.length > 0 && (
      <section class="block framework-block">
        <h2>Grounded in a proven approach</h2>
        {notes.frameworkSelections.map((f) => (
          <div class="card">
            <p class="card-title">{f.framework_link ? <a href={f.framework_link} target="_blank" style="color:inherit; text-decoration:underline;">{f.framework_name}</a> : f.framework_name}</p>
            <p class="card-function">{f.framework_source}</p>
            <p class="plain-copy">{f.plain_explanation || f.why_selected}</p>
          </div>
        ))}
      </section>
    )}

    {frameworkEvaluations.some((e) => e.candidates.length > 1) && (
      <section class="block eval-block">
        <h2>How we compared approaches</h2>
        <p class="eval-intro">We don't just pick the first framework that sounds relevant — every candidate below was scored on the same 9 points before we chose. Higher is better on every column; the approach we went with isn't always the highest scorer on every single point, but it's the best overall fit.</p>
        {frameworkEvaluations.map((evaln) => evaln.candidates.length > 1 && (
          <div class="eval-table-wrap">
            <table class="eval-table">
              <thead>
                <tr>
                  <th>Approach</th>
                  {FIT_DIMENSIONS.map((d) => <th title={DIMENSION_DESCRIPTIONS[d]}>{DIMENSION_LABELS[d]}</th>)}
                  <th>Total</th>
                </tr>
              </thead>
              <tbody>
                {evaln.candidates.map((c) => (
                  <tr class={c.is_selected ? 'eval-row-selected' : ''}>
                    <td>
                      {c.is_selected && <span class="eval-arrow" aria-hidden="true">→</span>}
                      {c.framework_name}
                    </td>
                    {FIT_DIMENSIONS.map((d) => {
                      const entry = c.dimension_scores.find((s) => s.dimension === d);
                      return <td class="eval-score-cell">{entry ? entry.score : '—'}</td>;
                    })}
                    <td class="eval-total-cell">{c.total_score}/{FIT_TABLE_MAX}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            {evaln.candidates.find((c) => c.is_selected) && (
              <p class="eval-recommendation">Our recommendation: <strong>{evaln.candidates.find((c) => c.is_selected)!.framework_name}</strong></p>
            )}
          </div>
        ))}
        <h3 class="eval-legend-title">Understanding the scoring metrics</h3>
        <ul class="eval-legend">
          {FIT_DIMENSIONS.map((d) => (
            <li><strong>{DIMENSION_LABELS[d]}</strong> — {DIMENSION_DESCRIPTIONS[d]}</li>
          ))}
        </ul>
      </section>
    )}

    {notes && notes.solutionMechanisms.length > 0 && (
      <section class="block">
        <h2>What we'd build</h2>
        {notes.solutionMechanisms.map((m) => (
          <div class="card">
            <p class="card-title">{m.mechanism_name}</p>
            <p class="plain-copy">{m.plain_explanation}</p>
          </div>
        ))}
      </section>
    )}

    {levers.length > 0 && (
      <section class="block">
        <h2>Expected impact</h2>
        {levers.map((l) => (
          <div class="impact-card">
            <p class="plain-copy">{l.plain_explanation || l.reasoning}</p>
            {l.calculation && l.calculation.length > 0 && (
              <table class="calc-table">
                <tbody>
                  {l.calculation.map((row, i) => (
                    <tr class={i === l.calculation.length - 1 ? 'calc-result-row' : ''}>
                      <td class="calc-label">{row.label}</td>
                      <td class="calc-value">{row.value}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
            {l.value_status !== 'known' && (
              <p class="calc-note">Based on typical industry figures, not numbers you've given us yet — see the questions below to make this exact.</p>
            )}
          </div>
        ))}
      </section>
    )}

    {notes && notes.clarifyingQuestions.length > 0 && (
      <section class="block questions">
        <h2>To sharpen these numbers, we'd ask</h2>
        <p class="questions-intro">(<em>Assumptions used industry benchmarks where we didn't have your real figures — answer any of these in your reply for the exact number.</em>)</p>
        <ul class="bullets">
          {notes.clarifyingQuestions.map((q) => <li>{q}</li>)}
        </ul>
      </section>
    )}

    <p class="feedback-note">
      Have a change or a correction? Just reply to this email — we'll fold your feedback into one revised version, and that's what we build over the next 30 days.
    </p>

    {notes && (
      <details class="appendix">
        <summary>Appendix — the detailed reasoning behind this</summary>

        {notes.problemBreakdown.length > 0 && (
          <div class="appendix-section">
            <h3>Diagnosis, in full</h3>
            {notes.problemBreakdown.map((p) => (
              <div class="appendix-card">
                <p class="appendix-title">{p.problem_statement}</p>
                <ul class="bullets">
                  <li><span class="bullet-label">Root cause</span>{p.root_cause}</li>
                  <li><span class="bullet-label">Who's affected</span>{p.who_is_affected}</li>
                  <li><span class="bullet-label">Cost of inaction</span>{p.current_cost_of_inaction}</li>
                </ul>
              </div>
            ))}
          </div>
        )}

        {notes.frameworkSelections.length > 0 && (
          <div class="appendix-section">
            <h3>Why this framework, specifically</h3>
            {notes.frameworkSelections.map((f) => (
              <div class="appendix-card">
                <p class="appendix-title">{f.framework_name}</p>
                <ul class="bullets">
                  <li><span class="bullet-label">Why this fits</span>{f.why_selected}</li>
                </ul>
                {f.runner_ups.length > 0 && (
                  <p class="also-considered">
                    Also weighed: {f.runner_ups.map((r, i) => (
                      <>{i > 0 ? ', ' : ''}{r.link ? <a href={r.link} target="_blank" style="color:inherit;">{r.name}</a> : r.name}</>
                    ))}
                  </p>
                )}
              </div>
            ))}
          </div>
        )}

        {notes.solutionMechanisms.length > 0 && (
          <div class="appendix-section">
            <h3>How the mechanism actually works</h3>
            {notes.solutionMechanisms.map((m) => (
              <div class="appendix-card">
                <p class="appendix-title">{m.mechanism_name}</p>
                <ol class="bullets numbered">
                  {m.how_it_works_steps.map((step) => <li>{step}</li>)}
                </ol>
              </div>
            ))}
          </div>
        )}

        {levers.length > 0 && (
          <div class="appendix-section">
            <h3>The P&amp;L reasoning</h3>
            <ul class="bullets flat">
              {levers.map((l) => (
                <li><span class="bullet-label">{l.lever}</span>{l.reasoning}</li>
              ))}
            </ul>
          </div>
        )}
      </details>
    )}
  </main>

  <div class="divider"><span>Try it yourself</span></div>

  <div class="artefact-embed">
    <iframe id="artefactFrame" title="Interactive demo" srcdoc={row.artefact_html}></iframe>
  </div>

  <script>
    // The artefact is a full interactive mini-app with its own <script>
    // tags — those never execute if injected via innerHTML, which silently
    // breaks every button/toggle in it. An iframe with srcdoc runs them
    // properly (same-origin by default, so we can still read its height to
    // auto-size it rather than showing an internal scrollbar).
    const frame = document.getElementById('artefactFrame');
    if (frame) {
      const resize = () => {
        try {
          const doc = frame.contentDocument;
          if (doc && doc.documentElement) frame.style.height = doc.documentElement.scrollHeight + 'px';
        } catch (e) {
          // Cross-origin or not yet ready — leave the current height alone.
        }
      };
      frame.addEventListener('load', () => {
        resize();
        const interval = setInterval(resize, 400);
        setTimeout(() => clearInterval(interval), 10000);
      });
    }
  </script>

</body>
</html>

<style>
  :root { color-scheme: light; }
  html, body { margin: 0; background: #fafaf8; }
  body { font-family: 'Inter', system-ui, sans-serif; color: #24211d; }

  .brief { max-width: 720px; margin: 0 auto; padding: 56px 32px 32px; }
  .eyebrow { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: #8a8378; margin-bottom: 14px; }
  h1 { font-family: 'Source Serif 4', Georgia, serif; font-weight: 600; font-size: clamp(26px, 4vw, 36px); line-height: 1.15; margin: 0 0 32px; max-width: 20ch; }

  .submitted-problem {
    margin: 0 0 28px; padding: 14px 18px; border-left: 3px solid #c48d2e;
    background: #fff6ea; font-style: italic; font-size: 15px; line-height: 1.6; color: #4a453e;
  }
  .submitted-label {
    display: block; font-style: normal; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;
    color: #a67c2e; margin-bottom: 4px;
  }
  h2 { font-family: 'Source Serif 4', Georgia, serif; font-weight: 600; font-size: 17px; margin: 0 0 12px; }
  .block { margin-bottom: 28px; }
  .card { padding: 14px 0; border-top: 1px solid rgba(36,33,29,0.1); }
  .card:first-of-type { border-top: none; }
  .card-title { font-weight: 600; font-size: 15px; margin: 0 0 4px; }
  .card-function { font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: #a67c2e; margin: 0 0 10px; }
  .card-tag { display: inline-block; color: #8a8378; margin-right: 8px; padding-right: 8px; border-right: 1px solid rgba(36,33,29,0.15); }

  .bullets { margin: 0; padding-left: 18px; font-size: 14px; line-height: 1.55; color: #3a3630; }
  .bullets li { margin-bottom: 4px; }
  .bullets.flat > li { padding: 10px 0; border-top: 1px solid rgba(36,33,29,0.08); list-style: none; padding-left: 0; margin-left: -18px; }
  .bullets.flat > li:first-child { border-top: none; }
  .bullets.numbered { padding-left: 20px; }
  .bullet-label { display: block; font-weight: 600; color: #24211d; font-size: 12px; text-transform: uppercase; letter-spacing: 0.03em; margin-bottom: 2px; }

  .questions { background: #fff6ea; border: 1px solid rgba(196,141,46,0.3); border-radius: 8px; padding: 20px 24px; }
  .framework-block { background: #f5f8f6; border: 1px solid rgba(31,122,92,0.2); border-radius: 8px; padding: 20px 24px; }
  .framework-block .card { border-top-color: rgba(31,122,92,0.15); }
  .framework-block .card:first-of-type { border-top: none; }
  .also-considered { font-size: 12.5px; color: #6b6459; margin: 10px 0 0; }

  .eval-block { background: #f5f8f6; border: 1px solid rgba(31,122,92,0.2); border-radius: 8px; padding: 20px 24px; }
  .eval-intro { font-size: 13.5px; color: #4a453e; line-height: 1.55; margin: 0 0 16px; }
  .eval-table-wrap { overflow-x: auto; margin-bottom: 18px; -webkit-overflow-scrolling: touch; }
  .eval-table { border-collapse: collapse; font-size: 12px; width: 100%; min-width: 640px; }
  .eval-table th, .eval-table td { padding: 8px 10px; border: 1px solid rgba(31,122,92,0.15); text-align: center; }
  .eval-table th { font-weight: 600; color: #2c5a44; font-size: 11px; cursor: help; background: #f5f8f6; }
  .eval-table th:first-child, .eval-table td:first-child { text-align: left; font-weight: 500; }
  .eval-row-selected { background: rgba(31,122,92,0.08); }
  .eval-arrow { color: #1f7a5c; font-weight: 700; margin-right: 4px; }
  .eval-score-cell { color: #4a453e; }
  .eval-total-cell { font-weight: 600; color: #24211d; }
  .eval-table th:last-child, .eval-table td:last-child { position: sticky; right: 0; background: #f5f8f6; box-shadow: -6px 0 6px -6px rgba(36,33,29,0.15); }
  .eval-row-selected td:last-child { background: #eef5f0; }
  .eval-recommendation { font-size: 13px; color: #1f7a5c; margin: 10px 0 0; padding-left: 2px; }
  .eval-recommendation strong { font-weight: 600; }
  .eval-legend-title { font-family: 'Source Serif 4', Georgia, serif; font-weight: 600; font-size: 14px; color: #2c5a44; margin: 4px 0 8px; }
  .eval-legend { margin: 0; padding: 0; list-style: none; font-size: 12px; color: #6b6459; line-height: 1.7; }
  .eval-legend strong { color: #4a453e; }
  .questions-intro { font-size: 13px; color: #6b5f4a; margin: 0 0 10px; font-style: italic; }
  .impact-card { padding: 14px 0; border-top: 1px solid rgba(36,33,29,0.1); }
  .impact-card:first-of-type { border-top: none; }
  .calc-table { border-collapse: collapse; font-size: 13px; margin: 10px 0 0; }
  .calc-table td { padding: 5px 12px 5px 0; }
  .calc-label { color: #6b6459; }
  .calc-value { color: #24211d; font-weight: 500; font-family: 'JetBrains Mono', 'SF Mono', monospace; }
  .calc-result-row td { border-top: 1px solid rgba(36,33,29,0.15); padding-top: 8px; font-weight: 600; }
  .calc-note { font-size: 12px; color: #8a8378; margin: 8px 0 0; font-style: italic; }
  .feedback-note { font-size: 13px; color: #6b6459; border-top: 1px solid rgba(36,33,29,0.1); padding-top: 20px; }
  .plain-copy { font-size: 15px; line-height: 1.6; color: #3a3630; margin: 0; }

  .appendix { margin-top: 12px; }
  .appendix summary { cursor: pointer; font-size: 12.5px; color: #8a8378; text-transform: uppercase; letter-spacing: 0.08em; padding: 16px 0; border-top: 1px solid rgba(36,33,29,0.1); }
  .appendix-section { margin: 20px 0; }
  .appendix h3 { font-family: 'Source Serif 4', Georgia, serif; font-weight: 600; font-size: 14.5px; margin: 0 0 10px; color: #4a453e; }
  .appendix-card { padding: 10px 0; border-top: 1px solid rgba(36,33,29,0.08); }
  .appendix-card:first-of-type { border-top: none; }
  .appendix-title { font-weight: 600; font-size: 13.5px; margin: 0 0 6px; color: #4a453e; }

  .divider { display: flex; align-items: center; gap: 16px; max-width: 720px; margin: 8px auto 28px; padding: 0 32px; }
  .divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: rgba(36,33,29,0.15); }
  .divider span { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: #8a8378; white-space: nowrap; }

  .artefact-embed { max-width: 960px; margin: 0 auto 64px; padding: 0 32px; }
  .artefact-embed iframe { width: 100%; border: 0; display: block; min-height: 400px; }

  @media (max-width: 640px) {
    .brief { padding: 36px 20px 24px; }
    .artefact-embed { padding: 0 20px; }
  }
</style>
