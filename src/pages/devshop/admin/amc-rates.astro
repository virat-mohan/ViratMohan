---
export const prerender = false;
// Same access protection as /devshop/admin — see index.astro.

import { getDb } from '../../../lib/db';
import { getEnv } from '../../../lib/env';
import { RESOURCE_CATEGORIES, RESOURCE_CATEGORY_LABELS } from '../../../lib/amc';

const env = getEnv();
const rates = await getDb(env).listAllAmcRates();
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AMC rate benchmarks — Fast Tech Dev Shop admin</title>
  <meta name="robots" content="noindex, nofollow" />
</head>
<body>
  <main class="wrap">
    <a class="back" href="/devshop/admin">← All queries</a>
    <h1>AMC rate benchmarks</h1>
    <p class="sub">The AMC pricing calculation only ever uses a rate from this list — never a number the model invents. A rate marked "unverified" is still usable but flagged for human review in every pricing recommendation it touches. Curate real, source-cited rates here as they're gathered.</p>

    <div class="add-card">
      <h2>Add a rate benchmark</h2>
      <div class="form-row">
        <select id="rateCategory">
          {RESOURCE_CATEGORIES.map((c) => <option value={c}>{RESOURCE_CATEGORY_LABELS[c]}</option>)}
        </select>
        <input id="rateDomain" type="text" placeholder='Domain (e.g. "e-commerce", or "general" as fallback)' />
      </div>
      <div class="form-row">
        <input id="rateRole" type="text" placeholder="Role label (e.g. Senior growth marketer)" />
        <input id="rateAmount" type="number" placeholder="Rate per hour (INR)" />
      </div>
      <div class="form-row">
        <input id="rateSource" type="text" placeholder="Source — where this benchmark comes from" />
      </div>
      <label class="checkbox-row"><input id="rateVerified" type="checkbox" /> Verified — cross-checked against the cited source</label>
      <textarea id="rateNote" rows="2" placeholder="Note (optional)"></textarea>
      <button id="addBtn" class="btn-small">Add benchmark</button>
      <p class="hint" id="addHint" hidden></p>
    </div>

    <table>
      <thead>
        <tr><th>Category</th><th>Domain</th><th>Role</th><th>Rate / hr (INR)</th><th>Source</th><th>Verified</th><th>Active</th><th></th></tr>
      </thead>
      <tbody>
        {rates.map((r) => (
          <tr class={r.active ? '' : 'inactive'}>
            <td>{RESOURCE_CATEGORY_LABELS[r.resource_category]}</td>
            <td>{r.domain}</td>
            <td>{r.role_label}</td>
            <td>₹{r.rate_per_hour_inr.toLocaleString('en-IN')}</td>
            <td class="when">{r.source}{r.note ? <span class="note"> — {r.note}</span> : null}</td>
            <td>{r.verified ? <span class="verified-yes">Yes</span> : <span class="verified-no">No</span>}</td>
            <td>{r.active ? 'Yes' : 'No'}</td>
            <td>
              <button class="toggle-btn" data-id={r.id} data-active={String(!r.active)}>
                {r.active ? 'Deactivate' : 'Reactivate'}
              </button>
            </td>
          </tr>
        ))}
        {rates.length === 0 && <tr><td colspan="8">No rate benchmarks yet — run migrations/0009_amc.sql for the seed set.</td></tr>}
      </tbody>
    </table>
  </main>

  <script type="module">
    const addBtn = document.getElementById('addBtn');
    const addHint = document.getElementById('addHint');
    addBtn.addEventListener('click', async () => {
      const resource_category = document.getElementById('rateCategory').value;
      const domain = document.getElementById('rateDomain').value.trim();
      const role_label = document.getElementById('rateRole').value.trim();
      const rate_per_hour_inr = parseFloat(document.getElementById('rateAmount').value);
      const source = document.getElementById('rateSource').value.trim();
      const verified = document.getElementById('rateVerified').checked;
      const note = document.getElementById('rateNote').value.trim();
      if (!domain || !role_label || !source || !rate_per_hour_inr) {
        addHint.textContent = 'Fill in domain, role, source, and a rate.';
        addHint.hidden = false;
        return;
      }
      addBtn.disabled = true;
      try {
        const res = await fetch('/devshop/api/amc-rates', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ action: 'add', resource_category, domain, role_label, rate_per_hour_inr, source, verified, note }),
        });
        if (!res.ok) throw new Error(await res.text());
        location.reload();
      } catch (err) {
        addBtn.disabled = false;
        addHint.textContent = 'Failed: ' + err.message;
        addHint.hidden = false;
      }
    });

    document.querySelectorAll('.toggle-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        try {
          const res = await fetch('/devshop/api/amc-rates', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ action: 'setActive', id: btn.dataset.id, active: btn.dataset.active === 'true' }),
          });
          if (!res.ok) throw new Error(await res.text());
          location.reload();
        } catch (err) {
          btn.disabled = false;
          alert('Failed: ' + err.message);
        }
      });
    });
  </script>
</body>
</html>

<style>
  :root { color-scheme: dark; }
  body { background: #15130f; color: #f5f5f0; font-family: system-ui, sans-serif; margin: 0; }
  .wrap { max-width: 1100px; margin: 0 auto; padding: 48px 32px; }
  .back { color: #85837e; font-size: 13px; text-decoration: none; }
  h1 { font-size: 22px; font-weight: 500; margin: 24px 0 8px; }
  h2 { font-size: 14px; font-weight: 500; color: #85837e; text-transform: uppercase; letter-spacing: 0.06em; margin: 0 0 14px; }
  .sub { font-size: 14px; color: #b7b5af; max-width: 70ch; margin-bottom: 32px; }
  .add-card { border: 1px solid rgba(245,245,240,0.15); border-radius: 6px; padding: 20px; margin-bottom: 32px; }
  .form-row { display: flex; gap: 10px; margin-bottom: 10px; }
  input, select, textarea {
    background: #1c1a15; border: 1px solid rgba(245,245,240,0.18); color: #f5f5f0;
    font-size: 13px; padding: 9px 11px; border-radius: 3px; font-family: inherit; flex: 1;
  }
  textarea { width: 100%; margin-bottom: 12px; resize: vertical; }
  .checkbox-row { display: flex; align-items: center; gap: 8px; font-size: 13px; color: #b7b5af; margin-bottom: 12px; }
  .checkbox-row input { flex: none; width: auto; }
  .btn-small { font-size: 12px; padding: 9px 16px; border: 1px solid #d4af37; color: #d4af37; background: none; cursor: pointer; border-radius: 3px; }
  .hint { font-size: 12.5px; color: #a66a62; margin-top: 8px; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th { text-align: left; color: #85837e; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; padding: 0 10px 10px; border-bottom: 1px solid rgba(245,245,240,0.18); }
  td { padding: 12px 10px; border-bottom: 1px solid rgba(245,245,240,0.08); vertical-align: top; }
  td.when { color: #b7b5af; max-width: 320px; }
  td .note { color: #85837e; }
  tr.inactive { opacity: 0.45; }
  .verified-yes { color: #8fae95; }
  .verified-no { color: #d4af37; }
  .toggle-btn { font-size: 11.5px; padding: 6px 10px; border: 1px solid rgba(245,245,240,0.25); color: #b7b5af; background: none; cursor: pointer; border-radius: 3px; }
</style>
