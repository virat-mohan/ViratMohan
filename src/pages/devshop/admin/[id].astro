---
export const prerender = false;
// Same access protection as /devshop/admin — see index.astro.

import { getDb } from '../../../lib/db';
import { getEnv } from '../../../lib/env';

const env = getEnv();
const { id } = Astro.params;

const row = id ? await getDb(env).getById(id) : null;

if (!row) {
  return new Response('Not found', { status: 404 });
}

const levers = row.pnl_levers ?? [];
const notes = row.solution_notes;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Query — Fast Tech Dev Shop admin</title>
  <meta name="robots" content="noindex, nofollow" />
</head>
<body>
  <main class="wrap">
    <a class="back" href="/devshop/admin">← All queries</a>
    <p class="status">Status: <strong>{row.status}</strong></p>

    <h1>Problem</h1>
    <p class="problem">{row.problem}</p>

    <div class="meta">
      <div><span>Company</span>{row.company || '—'}</div>
      <div><span>Website</span>{row.website || '—'}</div>
      <div><span>Tools in use</span>{row.tools || '—'}</div>
      <div><span>Reply-to</span>{row.email}</div>
      <div><span>Received</span>{row.created_at}</div>
    </div>

    {row.status === 'received' && <p class="hint">Still classifying and generating the demo artefact — refresh in a moment.</p>}
    {row.status === 'revising' && <p class="hint">Incorporating client feedback into a revised demo — refresh in a moment.</p>}
    {row.status === 'failed' && <p class="hint error">Generation failed: {row.error}</p>}

    {row.feedback_text && (
      <div class="reasoning-block">
        <h2>Client feedback (round {row.feedback_round || 1})</h2>
        <div class="note-card"><p>{row.feedback_text}</p></div>
      </div>
    )}

    {notes && notes.problemBreakdown.length > 0 && (
      <div class="reasoning-block">
        <h2>Diagnosis ({notes.problemBreakdown.length} problem{notes.problemBreakdown.length > 1 ? 's' : ''} identified)</h2>
        {notes.problemBreakdown.map((p, i) => (
          <div class="note-card">
            <p class="note-title">{i + 1}. {p.problem_statement}</p>
            <ul class="bullets">
              <li><span class="note-label">Root cause</span>{p.root_cause}</li>
              <li><span class="note-label">Who's affected</span>{p.who_is_affected}</li>
              <li><span class="note-label">Cost of inaction</span>{p.current_cost_of_inaction}</li>
            </ul>
          </div>
        ))}
      </div>
    )}

    {levers.length > 0 && (
      <div class="reasoning-block">
        <h2>P&amp;L lever{levers.length > 1 ? 's' : ''}</h2>
        {levers.map((l) => (
          <div class="note-card">
            <p class="note-title"><strong>{l.category}</strong> — {l.lever}</p>
            <p class="reasoning">{l.reasoning}</p>
          </div>
        ))}
      </div>
    )}

    {notes && notes.solutionMechanisms.length > 0 && (
      <div class="reasoning-block">
        <h2>Mechanism</h2>
        {notes.solutionMechanisms.map((m) => (
          <div class="note-card">
            <p class="note-title">{m.mechanism_name}</p>
            <ol class="bullets numbered">
              {m.how_it_works_steps.map((step) => <li>{step}</li>)}
            </ol>
            <p><span class="note-label">Trigger / data source</span>{m.trigger_or_data_source}</p>
            <p><span class="note-label">Why not generic</span>{m.why_not_generic}</p>
          </div>
        ))}
      </div>
    )}

    {notes && notes.artefactPlan && (
      <div class="reasoning-block">
        <h2>Demo plan</h2>
        <div class="note-card">
          <p>{notes.artefactPlan.narrative_arc}</p>
          <ul class="sections-list">
            {notes.artefactPlan.sections.map((s) => <li><strong>{s.name}</strong> — {s.purpose}</li>)}
          </ul>
        </div>
      </div>
    )}

    {notes && notes.clarifyingQuestions.length > 0 && (
      <div class="reasoning-block">
        <h2>Clarifying questions (sent to client)</h2>
        <div class="note-card">
          <ul class="sections-list">
            {notes.clarifyingQuestions.map((q) => <li>{q}</li>)}
          </ul>
        </div>
      </div>
    )}

    {row.artefact_html && (
      <div class="artefact">
        <h2>Generated demo artefact</h2>
        <iframe title="Demo artefact preview" srcdoc={row.artefact_html}></iframe>
      </div>
    )}

    {row.status === 'demo_ready' && (
      <button id="approveBtn" data-id={row.id}>{row.feedback_round >= 1 ? 'Approve & send revised demo →' : 'Approve & send to client →'}</button>
    )}
    {row.status === 'sent' && <p class="hint sent">Sent to {row.email}{row.feedback_round >= 1 ? ' (final, revised version)' : ''}.</p>}
  </main>

  <script type="module" define:vars={{ id: row.id }}>
    const btn = document.getElementById('approveBtn');
    if (btn) {
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        btn.textContent = 'Sending…';
        try {
          const res = await fetch('/devshop/api/approve', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ id }),
          });
          if (!res.ok) throw new Error(await res.text());
          location.reload();
        } catch (err) {
          btn.disabled = false;
          btn.textContent = 'Approve & send to client →';
          alert('Failed to send: ' + err.message);
        }
      });
    }
  </script>
</body>
</html>

<style>
  :root { color-scheme: dark; }
  body { background: #15130f; color: #f5f5f0; font-family: system-ui, sans-serif; margin: 0; }
  .wrap { max-width: 900px; margin: 0 auto; padding: 48px 32px; }
  .back { color: #85837e; font-size: 13px; text-decoration: none; }
  h1 { font-size: 15px; font-weight: 500; color: #85837e; text-transform: uppercase; letter-spacing: 0.08em; margin: 28px 0 8px; }
  h2 { font-size: 15px; font-weight: 500; color: #85837e; text-transform: uppercase; letter-spacing: 0.08em; margin: 32px 0 8px; }
  .problem { font-size: 20px; line-height: 1.5; }
  .status { color: #b7b5af; font-size: 13px; margin-top: 16px; }
  .meta { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 24px 0; font-size: 14px; }
  .meta span { display: block; color: #625f59; font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 4px; }
  .hint { color: #d4af37; font-size: 14px; }
  .hint.error { color: #a66a62; }
  .hint.sent { color: #718a78; }
  .reasoning-block { border-top: 1px solid rgba(245,245,240,0.18); padding-top: 8px; }
  .note-card { margin-bottom: 16px; font-size: 14px; line-height: 1.6; }
  .note-card p { margin: 2px 0; }
  .note-title { font-size: 15px; margin-bottom: 6px !important; }
  .note-label { display: inline-block; min-width: 160px; color: #625f59; font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; vertical-align: top; }
  .sections-list { margin: 8px 0 0; padding-left: 18px; color: #b7b5af; }
  .bullets { margin: 0; padding-left: 18px; color: #b7b5af; }
  .bullets li { margin-bottom: 4px; }
  .bullets.numbered { margin-bottom: 8px; }
  .reasoning { color: #b7b5af; font-size: 14px; }
  .artefact iframe { width: 100%; height: 560px; border: 1px solid rgba(245,245,240,0.18); margin-top: 8px; background: #15130f; }
  button { margin-top: 32px; font-size: 14px; padding: 14px 24px; border: 1px solid #d4af37; color: #d4af37; background: none; cursor: pointer; border-radius: 2px; }
  button:disabled { opacity: 0.5; cursor: default; }
</style>
