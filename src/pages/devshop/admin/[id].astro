---
export const prerender = false;
// Same access protection as /devshop/admin — see index.astro.

import { getDb, PIPELINE_STAGES } from '../../../lib/db';
import { getEnv } from '../../../lib/env';
import { FIT_DIMENSIONS } from '../../../lib/llm';
import { MECHANISM_TYPES, AUTOMATION_LEVELS, DECISION_CRITICALITY, RESOURCE_CATEGORY_LABELS } from '../../../lib/amc';

const env = getEnv();
const { id } = Astro.params;

const row = id ? await getDb(env).getById(id) : null;

if (!row) {
  return new Response('Not found', { status: 404 });
}

const levers = row.pnl_levers ?? [];
const notes = row.solution_notes;
const validations = notes?.validations ?? [];
const blockCount = validations.filter((v) => v.status === 'block').length;
const warningCount = validations.filter((v) => v.status === 'warning').length;

// Pipeline management only makes sense once a demo has actually gone out —
// received/demo_ready/revising/failed are all system-managed states.
const inPipeline = ['sent', 'interested', 'scoping_scheduled', 'scoping_complete', 'proposal_sent', 'deposit_paid', 'build_scheduled', 'in_build', 'delivered', 'feedback_requested', 'amc_active', 'refunded'].includes(row.status);
const stageOptions = PIPELINE_STAGES.filter((s) => !['received', 'demo_ready', 'revising'].includes(s)).concat(['refunded'] as any);
const trackerVisible = ['interested', 'scoping_scheduled', 'scoping_complete', 'proposal_sent', 'deposit_paid', 'build_scheduled', 'in_build', 'delivered', 'feedback_requested', 'amc_active', 'refunded'].includes(row.status);
const amcRelevant = ['build_scheduled', 'in_build', 'delivered', 'feedback_requested', 'amc_active'].includes(row.status);
const amcProfile = row.amc_solution_profile;
const amcEstimate = row.amc_resource_estimate;
const amcRecommendation = row.amc_pricing_recommendation;
const amcDecision = row.amc_pricing_decision;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Query — Fast Tech Dev Shop admin</title>
  <meta name="robots" content="noindex, nofollow" />
</head>
<body>
  <main class="wrap">
    <a class="back" href="/devshop/admin">← All queries</a>
    <p class="status">Status: <strong>{row.status}</strong></p>

    {validations.length > 0 && (
      <div class={`validation-banner ${blockCount > 0 ? 'banner-block' : warningCount > 0 ? 'banner-warning' : 'banner-pass'}`}>
        {blockCount > 0 && <strong>{blockCount} blocking issue{blockCount > 1 ? 's' : ''}</strong>}
        {blockCount > 0 && warningCount > 0 && ' · '}
        {warningCount > 0 && <strong>{warningCount} warning{warningCount > 1 ? 's' : ''}</strong>}
        {blockCount === 0 && warningCount === 0 && <strong>All validation checks passed</strong>}
        {' '}— see Validation section below before approving.
      </div>
    )}

    <h1>Problem</h1>
    <p class="problem">{row.problem}</p>

    <div class="meta">
      <div><span>Company</span>{row.company || '—'}</div>
      <div><span>Industry</span>{row.industry || '—'}</div>
      <div><span>Website</span>{row.website || '—'}</div>
      <div><span>Tools in use</span>{row.tools || '—'}</div>
      <div><span>Reply-to</span>{row.email}</div>
      <div><span>Received</span>{row.created_at}</div>
    </div>

    {row.status === 'received' && <p class="hint">Still classifying and generating the demo artefact — refresh in a moment.</p>}
    {row.status === 'revising' && <p class="hint">Incorporating client feedback into a revised demo — refresh in a moment.</p>}
    {row.status === 'failed' && <p class="hint error">Generation failed: {row.error}</p>}

    {row.feedback_text && (
      <div class="reasoning-block">
        <h2>Client feedback (round {row.feedback_round || 1})</h2>
        <div class="note-card"><p>{row.feedback_text}</p></div>
      </div>
    )}

    {notes && notes.problemBreakdown.length > 0 && (
      <div class="reasoning-block">
        <h2>Diagnosis ({notes.problemBreakdown.length} problem{notes.problemBreakdown.length > 1 ? 's' : ''} identified)</h2>
        {notes.problemBreakdown.map((p, i) => (
          <div class="note-card">
            <p class="note-title">{i + 1}. {p.problem_statement} <span class={`confidence-badge confidence-${p.confidence_level}`}>{p.confidence_level?.replace(/_/g, ' ')}</span></p>
            <ul class="bullets">
              <li><span class="note-label">Function</span>{p.business_function}</li>
              <li><span class="note-label">Root cause</span>{p.root_cause}</li>
              <li><span class="note-label">Who's affected</span>{p.who_is_affected}</li>
              <li><span class="note-label">Cost of inaction</span>{p.current_cost_of_inaction}</li>
              {p.supporting_evidence && <li><span class="note-label">Supporting evidence</span>{p.supporting_evidence}</li>}
              {p.evidence_gaps && <li><span class="note-label">Evidence gaps</span>{p.evidence_gaps}</li>}
            </ul>
          </div>
        ))}
      </div>
    )}

    {notes && notes.frameworkSelections.length > 0 && (
      <div class="reasoning-block">
        <h2>Framework applied</h2>
        {notes.frameworkSelections.map((f) => (
          <div class="note-card">
            <p class="note-title">
              {f.framework_link ? <a href={f.framework_link} target="_blank" style="color:inherit;">{f.framework_name}</a> : f.framework_name}
              <span class="fw-source">— {f.framework_source}</span>
              {!f.in_library && <span class="fw-flag">suggested — review for library</span>}
            </p>
            <ul class="bullets">
              <li><span class="note-label">Why this one</span>{f.why_selected}</li>
            </ul>
            {f.runner_ups.length > 0 && (
              <div class="runner-ups">
                <span class="note-label">Also considered</span>
                <ul class="bullets runner-up-list">
                  {f.runner_ups.map((r) => (
                    <li>{r.link ? <a href={r.link} target="_blank" style="color:#b7b5af;">{r.name}</a> : r.name} <span class="fw-source">({r.source})</span></li>
                  ))}
                </ul>
              </div>
            )}
            {f.fitCandidates && f.fitCandidates.length > 0 && (
              <details class="fit-scores">
                <summary>Fit scoring ({f.fitCandidates.length} candidate{f.fitCandidates.length > 1 ? 's' : ''} — also shown to the client)</summary>
                <table class="fit-table">
                  <thead>
                    <tr>
                      <th>Candidate</th>
                      {FIT_DIMENSIONS.map((d) => <th class="fit-dim-head">{d.replace(/_/g, ' ')}</th>)}
                      <th>Total</th>
                    </tr>
                  </thead>
                  <tbody>
                    {f.fitCandidates.map((c) => (
                      <tr class={c.is_selected ? 'fit-row-selected' : ''}>
                        <td>{c.framework_name}{c.is_selected && <span class="fw-flag" style="margin-left:6px;">selected</span>}</td>
                        {FIT_DIMENSIONS.map((d) => {
                          const entry = c.dimension_scores.find((s) => s.dimension === d);
                          return <td class="fit-score-cell">{entry ? entry.score : '—'}</td>;
                        })}
                        <td><strong>{c.total_score}</strong></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                {f.fitCandidates.map((c) => (
                  <p class="fit-evidence">
                    <strong>{c.framework_name}</strong> —
                    <span class="note-label">For</span>{c.positive_evidence}
                    <span class="note-label">Against</span>{c.negative_evidence}
                  </p>
                ))}
              </details>
            )}
          </div>
        ))}
      </div>
    )}

    {levers.length > 0 && (
      <div class="reasoning-block">
        <h2>P&amp;L lever{levers.length > 1 ? 's' : ''}</h2>
        {levers.map((l) => (
          <div class="note-card">
            <p class="note-title"><strong>{l.category}</strong> — {l.lever} <span class={`value-status value-status-${l.value_status}`}>{l.value_status?.replace(/_/g, ' ')}</span></p>
            <p class="reasoning">{l.reasoning}</p>
          </div>
        ))}
      </div>
    )}

    {notes && notes.solutionMechanisms.length > 0 && (
      <div class="reasoning-block">
        <h2>Mechanism</h2>
        {notes.solutionMechanisms.map((m) => (
          <div class="note-card">
            <p class="note-title">{m.mechanism_name}</p>
            <ol class="bullets numbered">
              {m.how_it_works_steps.map((step) => <li>{step}</li>)}
            </ol>
            <p><span class="note-label">Trigger / data source</span>{m.trigger_or_data_source}</p>
            <p><span class="note-label">Why not generic</span>{m.why_not_generic}</p>
          </div>
        ))}
      </div>
    )}

    {validations.length > 0 && (
      <div class="reasoning-block">
        <h2>Validation ({blockCount} block, {warningCount} warning, {validations.length - blockCount - warningCount} pass)</h2>
        {validations.map((v) => (
          <div class="note-card">
            <p class="note-title">
              <span class={`validation-status validation-${v.status}`}>{v.status}</span>
              {' '}{v.validation_type.replace(/_/g, ' ')}
              <span class="fw-source">— severity: {v.severity}</span>
            </p>
            <p class="reasoning">{v.explanation}</p>
            {v.status !== 'pass' && <p class="reasoning"><span class="note-label">Recommended action</span>{v.recommended_action}</p>}
          </div>
        ))}
      </div>
    )}

    {notes && notes.artefactPlan && (
      <div class="reasoning-block">
        <h2>Demo plan</h2>
        <div class="note-card">
          <p>{notes.artefactPlan.narrative_arc}</p>
          <ul class="sections-list">
            {notes.artefactPlan.sections.map((s) => <li><strong>{s.name}</strong> — {s.purpose}</li>)}
          </ul>
        </div>
      </div>
    )}

    {notes && notes.clarifyingQuestions.length > 0 && (
      <div class="reasoning-block">
        <h2>Clarifying questions (sent to client)</h2>
        <div class="note-card">
          <ul class="sections-list">
            {notes.clarifyingQuestions.map((q) => <li>{q}</li>)}
          </ul>
        </div>
      </div>
    )}

    {row.artefact_html && (
      <div class="artefact">
        <h2>Generated demo artefact</h2>
        <iframe title="Demo artefact preview" srcdoc={row.artefact_html}></iframe>
      </div>
    )}

    {row.status === 'demo_ready' && (
      <button id="approveBtn" data-id={row.id} data-block-count={blockCount}>{row.feedback_round >= 1 ? 'Approve & send revised demo →' : 'Approve & send to client →'}</button>
    )}
    {row.status === 'sent' && <p class="hint sent">Sent to {row.email}{row.feedback_round >= 1 ? ' (final, revised version)' : ''}.</p>}

    {inPipeline && (
      <div class="reasoning-block pipeline-panel">
        <h2>Pipeline</h2>

        {trackerVisible && (
          <p class="tracker-link"><a href={`/devshop/track/${row.id}`} target="_blank">Client tracker page →</a></p>
        )}

        <div class="panel-row">
          <label>Stage</label>
          <select id="stageSelect">
            {stageOptions.map((s) => <option value={s} selected={s === row.status}>{s}</option>)}
          </select>
          <button id="stageBtn" class="btn-small">Update stage</button>
        </div>

        <div class="panel-row">
          <label>Complexity</label>
          <select id="complexitySelect">
            <option value="standard" selected={row.complexity_tier === 'standard'}>Standard — fixed pricing</option>
            <option value="complex" selected={row.complexity_tier === 'complex'}>Complex — custom quote</option>
          </select>
          <input id="complexityNote" type="text" placeholder="Recommendation note (optional)" value={row.price_recommendation || ''} />
          <button id="complexityBtn" class="btn-small">Save</button>
        </div>
        {row.price_recommendation && <p class="panel-note">Current: {row.complexity_tier} — {row.price_recommendation}</p>}

        {row.status === 'proposal_sent' && (
          <div class="panel-row">
            <button id="depositBtn" class="btn-small">Mark deposit paid (₹19,999) — starts 30-day clock</button>
          </div>
        )}
        {row.deposit_paid_at && (
          <p class="panel-note">Deposit paid {new Date(row.deposit_paid_at).toLocaleDateString()} — deadline {row.delivery_deadline ? new Date(row.delivery_deadline).toLocaleDateString() : '—'}</p>
        )}

        {(row.status === 'build_scheduled' || row.status === 'in_build') && (
          <div class="weekly-form">
            <label>Add weekly update</label>
            <textarea id="weeklySummary" rows="2" placeholder="What shipped this week, what's next"></textarea>
            <div class="panel-row">
              <select id="weeklyBlocker">
                <option value="none">No blocker</option>
                <option value="client">Waiting on client</option>
                <option value="internal">Blocked internally</option>
              </select>
              <input id="weeklyBlockerDetail" type="text" placeholder="Blocker detail (if any)" />
              <button id="weeklyBtn" class="btn-small">Post update</button>
            </div>
          </div>
        )}

        {(row.weekly_updates ?? []).length > 0 && (
          <div class="weekly-log">
            {[...(row.weekly_updates ?? [])].reverse().map((u) => (
              <div class="weekly-entry">
                <span class="weekly-date">{new Date(u.date).toLocaleDateString()}</span>
                <span>{u.summary}</span>
                {u.blocker !== 'none' && <span class="weekly-blocker">{u.blocker}: {u.blocker_detail}</span>}
              </div>
            ))}
          </div>
        )}

        {amcRelevant && (
          <div class="amc-panel">
            <h2>AMC pricing</h2>
            <p class="panel-note">Calculated from estimated monthly service hours × <a href="/devshop/admin/amc-rates" style="color:#d4af37;">curated rate benchmarks</a> — never a model-invented number. Always a range + rationale, floored at ₹50,000/month.</p>

            <div class="amc-form">
              <div class="panel-row">
                <input id="amcDomain" type="text" placeholder='Domain (e.g. "e-commerce")' value={amcProfile?.domain || row.industry || ''} />
                <select id="amcMechanism">
                  {MECHANISM_TYPES.map((m) => <option value={m} selected={amcProfile?.mechanism_type === m}>{m.replace(/_/g, ' ')}</option>)}
                </select>
              </div>
              <div class="panel-row">
                <input id="amcWorkflows" type="number" min="1" placeholder="Distinct workflows" value={amcProfile?.workflow_count ?? 1} />
                <input id="amcIntegrations" type="number" min="0" placeholder="Distinct integrations" value={amcProfile?.integration_count ?? 0} />
              </div>
              <div class="panel-row">
                <select id="amcAutomation">
                  {AUTOMATION_LEVELS.map((a) => <option value={a} selected={amcProfile?.automation_level === a}>{a.replace(/_/g, ' ')}</option>)}
                </select>
                <select id="amcCriticality">
                  {DECISION_CRITICALITY.map((c) => <option value={c} selected={amcProfile?.decision_criticality === c}>{c}</option>)}
                </select>
                <button id="amcGenerateBtn" class="btn-small">{amcRecommendation ? 'Re-generate estimate' : 'Generate estimate'}</button>
              </div>
              <p class="hint" id="amcGenerateHint" hidden></p>
            </div>

            {amcEstimate && (
              <table class="amc-table">
                <thead><tr><th>Resource category</th><th>Monthly hours</th><th>Status</th><th>Rationale</th></tr></thead>
                <tbody>
                  {amcEstimate.estimates.map((e) => (
                    <tr>
                      <td>{RESOURCE_CATEGORY_LABELS[e.category]}</td>
                      <td>{e.monthly_hours}</td>
                      <td><span class={`value-status value-status-${e.status}`}>{e.status.replace(/_/g, ' ')}</span></td>
                      <td class="when">{e.rationale}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
            {amcEstimate && <p class="panel-note">{amcEstimate.overall_confidence_note}</p>}

            {amcRecommendation && (
              <div class="amc-recommendation">
                <p><span class="note-label">Market-equivalent value</span>₹{amcRecommendation.market_equivalent_value_low_inr.toLocaleString('en-IN')}–₹{amcRecommendation.market_equivalent_value_high_inr.toLocaleString('en-IN')}/month</p>
                <p><span class="note-label">FTDS cost to serve</span>₹{amcRecommendation.cost_to_serve_inr.toLocaleString('en-IN')}/month</p>
                <p><span class="note-label">Recommended range</span><strong>₹{amcRecommendation.recommended_range_low_inr.toLocaleString('en-IN')}–₹{amcRecommendation.recommended_range_high_inr.toLocaleString('en-IN')}/month</strong>{amcRecommendation.used_minimum_floor && <span class="fw-flag">minimum floor applied</span>}</p>
                <p class="panel-note">{amcRecommendation.rationale}</p>
                {amcRecommendation.unverified_rate_categories.length > 0 && (
                  <p class="hint">Unverified rate for: {amcRecommendation.unverified_rate_categories.map((c) => RESOURCE_CATEGORY_LABELS[c]).join(', ')} — review before quoting.</p>
                )}
              </div>
            )}

            {amcRecommendation && (
              <div class="amc-decision-form">
                <h2>Pricing decision</h2>
                <div class="panel-row">
                  <select id="amcMode">
                    <option value="approved" selected={amcDecision?.mode === 'approved'}>Approve as calculated</option>
                    <option value="adjusted" selected={amcDecision?.mode === 'adjusted'}>Adjust</option>
                    <option value="custom" selected={amcDecision?.mode === 'custom'}>Custom (complex build)</option>
                  </select>
                  <input id="amcAmount" type="number" placeholder="Monthly amount (INR)" value={amcDecision?.monthly_amount_inr ?? amcRecommendation.recommended_range_low_inr} />
                </div>
                <textarea id="amcRationale" rows="2" placeholder="Rationale (required unless approving as-is)">{amcDecision?.rationale || ''}</textarea>
                <button id="amcDecisionBtn" class="btn-small">Save decision</button>
                <p class="hint" id="amcDecisionHint" hidden></p>
                {amcDecision && <p class="panel-note">Current: ₹{amcDecision.monthly_amount_inr.toLocaleString('en-IN')}/month ({amcDecision.mode}) — decided {new Date(amcDecision.decided_at).toLocaleDateString()}</p>}
              </div>
            )}
          </div>
        )}
      </div>
    )}
  </main>

  <script type="module" define:vars={{ id: row.id }}>
    const btn = document.getElementById('approveBtn');
    if (btn) {
      btn.addEventListener('click', async () => {
        const blockCount = parseInt(btn.dataset.blockCount || '0', 10);
        if (blockCount > 0) {
          const proceed = confirm(`${blockCount} blocking validation issue${blockCount > 1 ? 's are' : ' is'} still unresolved. Send anyway?`);
          if (!proceed) return;
        }
        btn.disabled = true;
        btn.textContent = 'Sending…';
        try {
          const res = await fetch('/devshop/api/approve', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ id }),
          });
          if (!res.ok) throw new Error(await res.text());
          location.reload();
        } catch (err) {
          btn.disabled = false;
          btn.textContent = 'Approve & send to client →';
          alert('Failed to send: ' + err.message);
        }
      });
    }

    async function trackUpdate(payload) {
      const res = await fetch('/devshop/api/track-update', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ id, ...payload }),
      });
      if (!res.ok) throw new Error(await res.text());
    }

    const stageBtn = document.getElementById('stageBtn');
    if (stageBtn) {
      stageBtn.addEventListener('click', async () => {
        const status = document.getElementById('stageSelect').value;
        stageBtn.disabled = true;
        try {
          await trackUpdate({ action: 'setStage', status });
          location.reload();
        } catch (err) {
          stageBtn.disabled = false;
          alert('Failed: ' + err.message);
        }
      });
    }

    const complexityBtn = document.getElementById('complexityBtn');
    if (complexityBtn) {
      complexityBtn.addEventListener('click', async () => {
        const tier = document.getElementById('complexitySelect').value;
        const recommendation = document.getElementById('complexityNote').value;
        complexityBtn.disabled = true;
        try {
          await trackUpdate({ action: 'setComplexity', tier, recommendation });
          location.reload();
        } catch (err) {
          complexityBtn.disabled = false;
          alert('Failed: ' + err.message);
        }
      });
    }

    const depositBtn = document.getElementById('depositBtn');
    if (depositBtn) {
      depositBtn.addEventListener('click', async () => {
        if (!confirm('Confirm the ₹19,999 deposit has actually cleared? This starts the 30-day guarantee clock.')) return;
        depositBtn.disabled = true;
        try {
          await trackUpdate({ action: 'markDepositPaid' });
          location.reload();
        } catch (err) {
          depositBtn.disabled = false;
          alert('Failed: ' + err.message);
        }
      });
    }

    const amcGenerateBtn = document.getElementById('amcGenerateBtn');
    if (amcGenerateBtn) {
      amcGenerateBtn.addEventListener('click', async () => {
        const domain = document.getElementById('amcDomain').value.trim();
        if (!domain) {
          const hint = document.getElementById('amcGenerateHint');
          hint.textContent = 'Enter a domain first.';
          hint.hidden = false;
          return;
        }
        amcGenerateBtn.disabled = true;
        amcGenerateBtn.textContent = 'Estimating…';
        try {
          const res = await fetch('/devshop/api/amc-proposal', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              id,
              domain,
              mechanism_type: document.getElementById('amcMechanism').value,
              workflow_count: parseInt(document.getElementById('amcWorkflows').value || '1', 10),
              integration_count: parseInt(document.getElementById('amcIntegrations').value || '0', 10),
              automation_level: document.getElementById('amcAutomation').value,
              decision_criticality: document.getElementById('amcCriticality').value,
            }),
          });
          if (!res.ok) throw new Error(await res.text());
          location.reload();
        } catch (err) {
          amcGenerateBtn.disabled = false;
          amcGenerateBtn.textContent = 'Generate estimate';
          const hint = document.getElementById('amcGenerateHint');
          hint.textContent = 'Failed: ' + err.message;
          hint.hidden = false;
        }
      });
    }

    const amcDecisionBtn = document.getElementById('amcDecisionBtn');
    if (amcDecisionBtn) {
      amcDecisionBtn.addEventListener('click', async () => {
        const mode = document.getElementById('amcMode').value;
        const monthly_amount_inr = parseFloat(document.getElementById('amcAmount').value);
        const rationale = document.getElementById('amcRationale').value.trim();
        const hint = document.getElementById('amcDecisionHint');
        if (!monthly_amount_inr) {
          hint.textContent = 'Enter a monthly amount.';
          hint.hidden = false;
          return;
        }
        if (mode !== 'approved' && !rationale) {
          hint.textContent = 'A rationale is required when adjusting or setting a custom price.';
          hint.hidden = false;
          return;
        }
        amcDecisionBtn.disabled = true;
        try {
          const res = await fetch('/devshop/api/amc-decision', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ id, mode, monthly_amount_inr, rationale }),
          });
          if (!res.ok) throw new Error(await res.text());
          location.reload();
        } catch (err) {
          amcDecisionBtn.disabled = false;
          hint.textContent = 'Failed: ' + err.message;
          hint.hidden = false;
        }
      });
    }

    const weeklyBtn = document.getElementById('weeklyBtn');
    if (weeklyBtn) {
      weeklyBtn.addEventListener('click', async () => {
        const summary = document.getElementById('weeklySummary').value.trim();
        if (!summary) return alert('Add a summary first.');
        const blocker = document.getElementById('weeklyBlocker').value;
        const blockerDetail = document.getElementById('weeklyBlockerDetail').value.trim() || null;
        weeklyBtn.disabled = true;
        try {
          await trackUpdate({ action: 'addWeeklyUpdate', summary, blocker, blockerDetail });
          location.reload();
        } catch (err) {
