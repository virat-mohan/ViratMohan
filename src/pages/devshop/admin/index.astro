---
export const prerender = false;
// Protect this route (and /devshop/admin/*) — e.g. Vercel Deployment
// Protection scoped to this path, or an equivalent gate. No app-level auth
// is implemented here.

import { getDb } from '../../../lib/db';
import { getEnv } from '../../../lib/env';
import { formatTimestamp } from '../../../lib/format';

const env = getEnv();
const results = await getDb(env).listRecent(100);

function leverSummary(levers: { lever: string }[] | null): string {
  if (!levers || levers.length === 0) return '—';
  return levers.length === 1 ? levers[0].lever : `${levers.length} levers`;
}
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin — Fast Tech Dev Shop</title>
  <meta name="robots" content="noindex, nofollow" />
</head>
<body>
  <main class="wrap">
    <div style="display:flex; justify-content:space-between; align-items:baseline;">
      <h1>Queries</h1>
      <div style="display:flex; gap:18px;">
        <a href="/devshop/admin/frameworks" style="font-size:13px; color:#d4af37;">Framework library →</a>
        <a href="/devshop/admin/amc-rates" style="font-size:13px; color:#d4af37;">AMC rate benchmarks →</a>
      </div>
    </div>
    <table id="queriesTable" class="sortable">
      <thead>
        <tr>
          <th data-sort-type="date">Received</th>
          <th data-sort-type="text">Company</th>
          <th data-sort-type="text" data-no-sort="true">Problem</th>
          <th data-sort-type="text">Lever</th>
          <th data-sort-type="text">Status</th>
          <th data-no-sort="true"></th>
        </tr>
      </thead>
      <tbody>
        {results.map((r) => (
          <tr>
            <td data-sort-value={r.created_at}>{formatTimestamp(r.created_at)}</td>
            <td>{r.company || '—'}</td>
            <td class="problem">{r.problem}</td>
            <td>{leverSummary(r.pnl_levers)}</td>
            <td><span class={`status status--${r.status}`}>{r.status}</span></td>
            <td><a href={`/devshop/admin/${r.id}`}>Open →</a></td>
          </tr>
        ))}
        {results.length === 0 && (
          <tr><td colspan="6">No queries yet.</td></tr>
        )}
      </tbody>
    </table>
  </main>

  <script>
    // Generic click-to-sort: reads data-sort-value if present, else the
    // cell's own text; data-sort-type="date" compares as timestamps.
    // Columns marked data-no-sort are left alone (free text / actions).
    document.querySelectorAll('table.sortable').forEach((table) => {
      const headers = Array.from(table.querySelectorAll('thead th'));
      headers.forEach((th, colIndex) => {
        if (th.dataset.noSort === 'true') return;
        th.style.cursor = 'pointer';
        let ascending = true;
        th.addEventListener('click', () => {
          const tbody = table.querySelector('tbody');
          const rows = Array.from(tbody.querySelectorAll('tr')).filter((r) => !r.querySelector('td[colspan]'));
          const type = th.dataset.sortType || 'text';
          rows.sort((a, b) => {
            const cellA = a.children[colIndex];
            const cellB = b.children[colIndex];
            const rawA = cellA.dataset.sortValue ?? cellA.textContent.trim();
            const rawB = cellB.dataset.sortValue ?? cellB.textContent.trim();
            let cmp;
            if (type === 'date') {
              cmp = new Date(rawA).getTime() - new Date(rawB).getTime();
            } else {
              cmp = rawA.localeCompare(rawB, undefined, { numeric: true, sensitivity: 'base' });
            }
            return ascending ? cmp : -cmp;
          });
          rows.forEach((r) => tbody.appendChild(r));
          headers.forEach((h) => h.classList.remove('sort-asc', 'sort-desc'));
          th.classList.add(ascending ? 'sort-asc' : 'sort-desc');
          ascending = !ascending;
        });
      });
    });
  </script>
</body>
</html>

<style>
  :root { color-scheme: dark; }
  body { background: #15130f; color: #f5f5f0; font-family: system-ui, sans-serif; margin: 0; }
  .wrap { max-width: 1100px; margin: 0 auto; padding: 48px 32px; }
  h1 { font-weight: 500; font-size: 22px; margin-bottom: 24px; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th { text-align: left; color: #85837e; font-weight: 500; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; padding: 0 12px 10px; border-bottom: 1px solid rgba(245,245,240,0.18); user-select: none; }
  th.sort-asc::after { content: ' \25B2'; }
  th.sort-desc::after { content: ' \25BC'; }
  td { padding: 12px; border-bottom: 1px solid rgba(245,245,240,0.1); vertical-align: top; }
  .problem { max-width: 360px; color: #b7b5af; }
  a { color: #d4af37; }
  .status { padding: 2px 8px; border-radius: 2px; border: 1px solid #625f59; color: #b7b5af; font-size: 12px; }
  .status--demo_ready { border-color: #d4af37; color: #d4af37; }
  .status--sent { border-color: #718a78; color: #718a78; }
  .status--failed { border-color: #a66a62; color: #a66a62; }
</style>
