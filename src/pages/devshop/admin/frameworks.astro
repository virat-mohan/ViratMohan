---
export const prerender = false;
// Same access protection as /devshop/admin — see index.astro.

import { getDb } from '../../../lib/db';
import { getEnv } from '../../../lib/env';
import { BUSINESS_FUNCTIONS } from '../../../lib/pnl-levers';

const env = getEnv();
const rawFrameworks = await getDb(env).listAllFrameworks();
// Defensive: if migrations 0011/0014 (framework metadata columns) haven't
// landed in this environment yet, Supabase returns rows without those
// fields rather than erroring — normalize here so a missing column can
// never crash this whole page over metadata that's still optional.
const frameworks = rawFrameworks.map((f) => ({
  ...f,
  problem_archetypes: f.problem_archetypes ?? [],
  ideal_use_cases: f.ideal_use_cases ?? [],
  required_conditions: f.required_conditions ?? [],
  required_evidence: f.required_evidence ?? [],
  contraindications: f.contraindications ?? [],
  expected_intervention_types: f.expected_intervention_types ?? [],
  applicable_business_functions: f.applicable_business_functions ?? [],
  applicable_pnl_levers: f.applicable_pnl_levers ?? [],
  framework_version: f.framework_version ?? 1,
}));
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Framework library — Fast Tech Dev Shop admin</title>
  <meta name="robots" content="noindex, nofollow" />
</head>
<body>
  <main class="wrap">
    <a class="back" href="/devshop/admin">← All queries</a>
    <h1>Framework library</h1>
    <p class="sub">The solutioning engine draws from this list first, and only suggests beyond it when nothing here fits — those suggestions show up flagged in each submission's diagnosis for you to review and add here.</p>

    <div class="add-card">
      <h2>Add a framework</h2>
      <div class="form-row">
        <input id="fwName" type="text" placeholder="Framework name" />
        <button id="suggestBtn" class="btn-small" type="button">Suggest via Claude</button>
      </div>
      <p class="hint" id="suggestNote" hidden></p>
      <div class="form-row">
        <input id="fwSource" type="text" placeholder="Source / originator (e.g. Korn Ferry)" />
      </div>
      <div class="form-row">
        <select id="fwFunction">
          {BUSINESS_FUNCTIONS.map((f) => <option value={f}>{f}</option>)}
        </select>
        <input id="fwLink" type="text" placeholder="Study link (optional, e.g. Wikipedia or a primary source)" />
      </div>
      <textarea id="fwWhen" rows="2" placeholder="When to use it — what kind of root cause this fits"></textarea>
      <div class="form-row">
        <input id="fwArchetypes" type="text" placeholder="Problem archetypes, comma-separated (e.g. funnel-drop-off, repeat-cost-leakage)" />
      </div>
      <details class="advanced-metadata">
        <summary>Advanced metadata (optional)</summary>
        <div class="form-row">
          <input id="fwIdealUseCases" type="text" placeholder="Ideal use cases, comma-separated" />
        </div>
        <div class="form-row">
          <input id="fwRequiredConditions" type="text" placeholder="Required conditions, comma-separated" />
        </div>
        <div class="form-row">
          <input id="fwRequiredEvidence" type="text" placeholder="Required evidence, comma-separated" />
        </div>
        <div class="form-row">
          <input id="fwContraindications" type="text" placeholder="Contraindications, comma-separated" />
        </div>
        <div class="form-row">
          <input id="fwInterventionTypes" type="text" placeholder="Expected intervention types, comma-separated" />
        </div>
        <div class="form-row">
          <input id="fwApplicableFunctions" type="text" placeholder="Applicable business functions, comma-separated" />
        </div>
        <div class="form-row">
          <input id="fwApplicableLevers" type="text" placeholder="Applicable P&L levers, comma-separated" />
        </div>
        <textarea id="fwExpertNotes" rows="2" placeholder="Expert notes (free text)"></textarea>
      </details>
      <button id="addBtn" class="btn-small">Add to library</button>
      <p class="hint" id="addHint" hidden></p>
    </div>

    <table class="sortable">
      <thead>
        <tr>
          <th data-sort-type="text">Name</th>
          <th data-sort-type="text">Source</th>
          <th data-sort-type="text">Function</th>
          <th data-sort-type="text" data-no-sort="true">Archetypes</th>
          <th data-sort-type="text" data-no-sort="true">When to use</th>
          <th data-no-sort="true">Link</th>
          <th data-sort-type="text">Version</th>
          <th data-sort-type="text">Reviewed</th>
          <th data-sort-type="text">Active</th>
          <th data-no-sort="true">Metadata</th>
          <th data-no-sort="true"></th>
        </tr>
      </thead>
      <tbody>
        {frameworks.map((f) => (
          <tr class={f.active ? '' : 'inactive'}>
            <td>{f.name}</td>
            <td>{f.source}</td>
            <td>{f.business_function}</td>
            <td class="archetypes">
              {f.problem_archetypes.length > 0
                ? f.problem_archetypes.map((a) => <span class="archetype-pill">{a}</span>)
                : '—'}
            </td>
            <td class="when">{f.when_to_use}</td>
            <td>{f.link ? <a href={f.link} target="_blank" style="color:#d4af37;">study →</a> : '—'}</td>
            <td>v{f.framework_version}</td>
            <td>
              {f.reviewed_by
                ? <span title={f.source_verified_at ? new Date(f.source_verified_at).toLocaleDateString() : ''}>✓ {f.reviewed_by}</span>
                : <span class="unreviewed">Not yet</span>}
            </td>
            <td>{f.active ? 'Yes' : 'No'}</td>
            <td>
              {(f.ideal_use_cases.length + f.required_conditions.length + f.required_evidence.length + f.contraindications.length + f.expected_intervention_types.length + f.applicable_business_functions.length + f.applicable_pnl_levers.length > 0 || f.expert_notes) ? (
                <details class="metadata-details">
                  <summary>View</summary>
                  {f.ideal_use_cases.length > 0 && <p><strong>Ideal use cases:</strong> {f.ideal_use_cases.join(', ')}</p>}
                  {f.required_conditions.length > 0 && <p><strong>Required conditions:</strong> {f.required_conditions.join(', ')}</p>}
                  {f.required_evidence.length > 0 && <p><strong>Required evidence:</strong> {f.required_evidence.join(', ')}</p>}
                  {f.contraindications.length > 0 && <p><strong>Contraindications:</strong> {f.contraindications.join(', ')}</p>}
                  {f.expected_intervention_types.length > 0 && <p><strong>Intervention types:</strong> {f.expected_intervention_types.join(', ')}</p>}
                  {f.applicable_business_functions.length > 0 && <p><strong>Applicable functions:</strong> {f.applicable_business_functions.join(', ')}</p>}
                  {f.applicable_pnl_levers.length > 0 && <p><strong>Applicable P&amp;L levers:</strong> {f.applicable_pnl_levers.join(', ')}</p>}
                  {f.expert_notes && <p><strong>Expert notes:</strong> {f.expert_notes}</p>}
                </details>
              ) : '—'}
            </td>
            <td class="actions-cell">
              <button class="toggle-btn" data-id={f.id} data-active={String(!f.active)}>
                {f.active ? 'Deactivate' : 'Reactivate'}
              </button>
              <button class="review-btn" data-id={f.id}>Mark reviewed</button>
            </td>
          </tr>
        ))}
        {frameworks.length === 0 && <tr><td colspan="11">No frameworks yet — add one above, or run migrations/0005_frameworks.sql for the starter set.</td></tr>}
      </tbody>
    </table>
  </main>

  <script type="module">
    const suggestBtn = document.getElementById('suggestBtn');
    const suggestNote = document.getElementById('suggestNote');
    suggestBtn.addEventListener('click', async () => {
      const name = document.getElementById('fwName').value.trim();
      if (!name) {
        suggestNote.textContent = 'Type a framework name first.';
        suggestNote.hidden = false;
        return;
      }
      suggestBtn.disabled = true;
      suggestBtn.textContent = 'Asking Claude…';
      suggestNote.hidden = true;
      try {
        const res = await fetch('/devshop/api/frameworks', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ action: 'suggest', name }),
        });
        if (!res.ok) throw new Error(await res.text());
        const { suggestion } = await res.json();
        document.getElementById('fwSource').value = suggestion.source;
        document.getElementById('fwFunction').value = suggestion.business_function;
        document.getElementById('fwWhen').value = suggestion.when_to_use;
        document.getElementById('fwLink').value = suggestion.link || '';
        const parts = [`Confidence: ${suggestion.confidence}`];
        if (suggestion.note) parts.push(suggestion.note);
        if (suggestion.confidence !== 'high') parts.push('Review every field before saving.');
        suggestNote.textContent = parts.join(' — ');
        suggestNote.hidden = false;
      } catch (err) {
        suggestNote.textContent = 'Failed: ' + err.message;
        suggestNote.hidden = false;
      } finally {
        suggestBtn.disabled = false;
        suggestBtn.textContent = 'Suggest via Claude';
      }
    });

    const addBtn = document.getElementById('addBtn');
    const addHint = document.getElementById('addHint');
    addBtn.addEventListener('click', async () => {
      const name = document.getElementById('fwName').value.trim();
      const source = document.getElementById('fwSource').value.trim();
      const business_function = document.getElementById('fwFunction').value;
      const when_to_use = document.getElementById('fwWhen').value.trim();
      const link = document.getElementById('fwLink').value.trim();
      const problem_archetypes = document.getElementById('fwArchetypes').value.trim();
      const ideal_use_cases = document.getElementById('fwIdealUseCases').value.trim();
      const required_conditions = document.getElementById('fwRequiredConditions').value.trim();
      const required_evidence = document.getElementById('fwRequiredEvidence').value.trim();
      const contraindications = document.getElementById('fwContraindications').value.trim();
      const expected_intervention_types = document.getElementById('fwInterventionTypes').value.trim();
      const applicable_business_functions = document.getElementById('fwApplicableFunctions').value.trim();
      const applicable_pnl_levers = document.getElementById('fwApplicableLevers').value.trim();
      const expert_notes = document.getElementById('fwExpertNotes').value.trim();
      if (!name || !source || !when_to_use) {
        addHint.textContent = 'Fill in name, source, and when-to-use.';
        addHint.hidden = false;
        return;
      }
      addBtn.disabled = true;
      try {
        const res = await fetch('/devshop/api/frameworks', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            action: 'add', name, source, business_function, when_to_use, link, problem_archetypes,
            ideal_use_cases, required_conditions, required_evidence, contraindications,
            expected_intervention_types, applicable_business_functions, applicable_pnl_levers, expert_notes,
          }),
        });
        if (!res.ok) throw new Error(await res.text());
        location.reload();
      } catch (err) {
        addBtn.disabled = false;
        addHint.textContent = 'Failed: ' + err.message;
        addHint.hidden = false;
      }
    });

    document.querySelectorAll('.toggle-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        try {
          const res = await fetch('/devshop/api/frameworks', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ action: 'setActive', id: btn.dataset.id, active: btn.dataset.active === 'true' }),
          });
          if (!res.ok) throw new Error(await res.text());
          location.reload();
        } catch (err) {
          btn.disabled = false;
          alert('Failed: ' + err.message);
        }
      });
    });

    document.querySelectorAll('.review-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const reviewedBy = prompt('Your name, for the review record:');
        if (!reviewedBy?.trim()) return;
        btn.disabled = true;
        try {
          const res = await fetch('/devshop/api/frameworks', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ action: 'markReviewed', id: btn.dataset.id, reviewedBy: reviewedBy.trim() }),
          });
          if (!res.ok) throw new Error(await res.text());
          location.reload();
        } catch (err) {
          btn.disabled = false;
          alert('Failed: ' + err.message);
        }
      });
    });

    document.querySelectorAll('table.sortable').forEach((table) => {
      const headers = Array.from(table.querySelectorAll('thead th'));
      headers.forEach((th, colIndex) => {
        if (th.dataset.noSort === 'true') return;
        th.style.cursor = 'pointer';
        let ascending = true;
        th.addEventListener('click', () => {
          const tbody = table.querySelector('tbody');
          const rows = Array.from(tbody.querySelectorAll('tr')).filter((r) => !r.querySelector('td[colspan]'));
          rows.sort((a, b) => {
            const rawA = a.children[colIndex].textContent.trim();
            const rawB = b.children[colIndex].textContent.trim();
            const cmp = rawA.localeCompare(rawB, undefined, { numeric: true, sensitivity: 'base' });
            return ascending ? cmp : -cmp;
          });
          rows.forEach((r) => tbody.appendChild(r));
          headers.forEach((h) => h.classList.remove('sort-asc', 'sort-desc'));
          th.classList.add(ascending ? 'sort-asc' : 'sort-desc');
          ascending = !ascending;
        });
      });
    });
  </script>
</body>
</html>

<style>
  :root { color-scheme: dark; }
  body { background: #15130f; color: #f5f5f0; font-family: system-ui, sans-serif; margin: 0; }
  .wrap { max-width: 1000px; margin: 0 auto; padding: 48px 32px; }
  .back { color: #85837e; font-size: 13px; text-decoration: none; }
  h1 { font-size: 22px; font-weight: 500; margin: 24px 0 8px; }
  h2 { font-size: 14px; font-weight: 500; color: #85837e; text-transform: uppercase; letter-spacing: 0.06em; margin: 0 0 14px; }
  .sub { font-size: 14px; color: #b7b5af; max-width: 70ch; margin-bottom: 32px; }
  .add-card { border: 1px solid rgba(245,245,240,0.15); border-radius: 6px; padding: 20px; margin-bottom: 32px; }
  .form-row { display: flex; gap: 10px; margin-bottom: 10px; }
  input, select, textarea {
    background: #1c1a15; border: 1px solid rgba(245,245,240,0.18); color: #f5f5f0;
    font-size: 13px; padding: 9px 11px; border-radius: 3px; font-family: inherit; flex: 1;
  }
  textarea { width: 100%; margin-bottom: 12px; resize: vertical; }
  .btn-small { font-size: 12px; padding: 9px 16px; border: 1px solid #d4af37; color: #d4af37; background: none; cursor: pointer; border-radius: 3px; }
  .hint { font-size: 12.5px; color: #a66a62; margin-top: 8px; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th { text-align: left; color: #85837e; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; padding: 0 10px 10px; border-bottom: 1px solid rgba(245,245,240,0.18); }
  td { padding: 12px 10px; border-bottom: 1px solid rgba(245,245,240,0.08); vertical-align: top; }
  td.when { color: #b7b5af; max-width: 320px; }
  tr.inactive { opacity: 0.45; }
  .toggle-btn, .review-btn { font-size: 11.5px; padding: 6px 10px; border: 1px solid rgba(245,245,240,0.25); color: #b7b5af; background: none; cursor: pointer; border-radius: 3px; }
  .actions-cell { display: flex; gap: 6px; flex-wrap: wrap; }
  th.sort-asc::after { content: ' \25B2'; }
  th.sort-desc::after { content: ' \25BC'; }
  .archetypes { max-width: 200px; }
  .archetype-pill { display: inline-block; font-size: 10.5px; color: #d4af37; border: 1px solid rgba(212,175,55,0.35); padding: 1px 6px; border-radius: 10px; margin: 2px 4px 2px 0; }
  .unreviewed { color: #a66a62; font-size: 12.5px; }
  .advanced-metadata { margin: 6px 0 12px; border: 1px solid rgba(245,245,240,0.1); border-radius: 4px; padding: 4px 12px; }
  .advanced-metadata summary { cursor: pointer; font-size: 12px; color: #85837e; padding: 8px 0; }
  .metadata-details { max-width: 220px; }
  .metadata-details summary { cursor: pointer; color: #d4af37; font-size: 12px; }
  .metadata-details p { font-size: 11.5px; color: #b7b5af; margin: 6px 0; }
  .metadata-details strong { color: #85837e; font-weight: 500; }
</style>
