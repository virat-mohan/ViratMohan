---
export const prerender = false;
// Same access protection as /devshop/admin — see index.astro.

import { getDb } from '../../../lib/db';
import { getEnv } from '../../../lib/env';
import { BUSINESS_FUNCTIONS } from '../../../lib/pnl-levers';

const env = getEnv();
const frameworks = await getDb(env).listAllFrameworks();
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Framework library — Fast Tech Dev Shop admin</title>
  <meta name="robots" content="noindex, nofollow" />
</head>
<body>
  <main class="wrap">
    <a class="back" href="/devshop/admin">← All queries</a>
    <h1>Framework library</h1>
    <p class="sub">The solutioning engine draws from this list first, and only suggests beyond it when nothing here fits — those suggestions show up flagged in each submission's diagnosis for you to review and add here.</p>

    <div class="add-card">
      <h2>Add a framework</h2>
      <div class="form-row">
        <input id="fwName" type="text" placeholder="Framework name" />
        <button id="suggestBtn" class="btn-small" type="button">Suggest via Claude</button>
      </div>
      <p class="hint" id="suggestNote" hidden></p>
      <div class="form-row">
        <input id="fwSource" type="text" placeholder="Source / originator (e.g. Korn Ferry)" />
      </div>
      <div class="form-row">
        <select id="fwFunction">
          {BUSINESS_FUNCTIONS.map((f) => <option value={f}>{f}</option>)}
        </select>
        <input id="fwLink" type="text" placeholder="Study link (optional, e.g. Wikipedia or a primary source)" />
      </div>
      <textarea id="fwWhen" rows="2" placeholder="When to use it — what kind of root cause this fits"></textarea>
      <button id="addBtn" class="btn-small">Add to library</button>
      <p class="hint" id="addHint" hidden></p>
    </div>

    <table>
      <thead>
        <tr><th>Name</th><th>Source</th><th>Function</th><th>When to use</th><th>Link</th><th>Active</th><th></th></tr>
      </thead>
      <tbody>
        {frameworks.map((f) => (
          <tr class={f.active ? '' : 'inactive'}>
            <td>{f.name}</td>
            <td>{f.source}</td>
            <td>{f.business_function}</td>
            <td class="when">{f.when_to_use}</td>
            <td>{f.link ? <a href={f.link} target="_blank" style="color:#d4af37;">study →</a> : '—'}</td>
            <td>{f.active ? 'Yes' : 'No'}</td>
            <td>
              <button class="toggle-btn" data-id={f.id} data-active={String(!f.active)}>
                {f.active ? 'Deactivate' : 'Reactivate'}
              </button>
            </td>
          </tr>
        ))}
        {frameworks.length === 0 && <tr><td colspan="7">No frameworks yet — add one above, or run migrations/0005_frameworks.sql for the starter set.</td></tr>}
      </tbody>
    </table>
  </main>

  <script type="module">
    const suggestBtn = document.getElementById('suggestBtn');
    const suggestNote = document.getElementById('suggestNote');
    suggestBtn.addEventListener('click', async () => {
      const name = document.getElementById('fwName').value.trim();
      if (!name) {
        suggestNote.textContent = 'Type a framework name first.';
        suggestNote.hidden = false;
        return;
      }
      suggestBtn.disabled = true;
      suggestBtn.textContent = 'Asking Claude…';
      suggestNote.hidden = true;
      try {
        const res = await fetch('/devshop/api/frameworks', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ action: 'suggest', name }),
        });
        if (!res.ok) throw new Error(await res.text());
        const { suggestion } = await res.json();
        document.getElementById('fwSource').value = suggestion.source;
        document.getElementById('fwFunction').value = suggestion.business_function;
        document.getElementById('fwWhen').value = suggestion.when_to_use;
        document.getElementById('fwLink').value = suggestion.link || '';
        const parts = [`Confidence: ${suggestion.confidence}`];
        if (suggestion.note) parts.push(suggestion.note);
        if (suggestion.confidence !== 'high') parts.push('Review every field before saving.');
        suggestNote.textContent = parts.join(' — ');
        suggestNote.hidden = false;
      } catch (err) {
        suggestNote.textContent = 'Failed: ' + err.message;
        suggestNote.hidden = false;
      } finally {
        suggestBtn.disabled = false;
        suggestBtn.textContent = 'Suggest via Claude';
      }
    });

    const addBtn = document.getElementById('addBtn');
    const addHint = document.getElementById('addHint');
    addBtn.addEventListener('click', async () => {
      const name = document.getElementById('fwName').value.trim();
      const source = document.getElementById('fwSource').value.trim();
      const business_function = document.getElementById('fwFunction').value;
      const when_to_use = document.getElementById('fwWhen').value.trim();
      const link = document.getElementById('fwLink').value.trim();
      if (!name || !source || !when_to_use) {
        addHint.textContent = 'Fill in name, source, and when-to-use.';
        addHint.hidden = false;
        return;
      }
      addBtn.disabled = true;
      try {
        const res = await fetch('/devshop/api/frameworks', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ action: 'add', name, source, business_function, when_to_use, link }),
        });
        if (!res.ok) throw new Error(await res.text());
        location.reload();
      } catch (err) {
        addBtn.disabled = false;
        addHint.textContent = 'Failed: ' + err.message;
        addHint.hidden = false;
      }
    });

    document.querySelectorAll('.toggle-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        try {
          const res = await fetch('/devshop/api/frameworks', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ action: 'setActive', id: btn.dataset.id, active: btn.dataset.active === 'true' }),
          });
          if (!res.ok) throw new Error(await res.text());
          location.reload();
        } catch (err) {
          btn.disabled = false;
          alert('Failed: ' + err.message);
        }
      });
    });
  </script>
</body>
</html>

<style>
  :root { color-scheme: dark; }
  body { background: #15130f; color: #f5f5f0; font-family: system-ui, sans-serif; margin: 0; }
  .wrap { max-width: 1000px; margin: 0 auto; padding: 48px 32px; }
  .back { color: #85837e; font-size: 13px; text-decoration: none; }
  h1 { font-size: 22px; font-weight: 500; margin: 24px 0 8px; }
  h2 { font-size: 14px; font-weight: 500; color: #85837e; text-transform: uppercase; letter-spacing: 0.06em; margin: 0 0 14px; }
  .sub { font-size: 14px; color: #b7b5af; max-width: 70ch; margin-bottom: 32px; }
  .add-card { border: 1px solid rgba(245,245,240,0.15); border-radius: 6px; padding: 20px; margin-bottom: 32px; }
  .form-row { display: flex; gap: 10px; margin-bottom: 10px; }
  input, select, textarea {
    background: #1c1a15; border: 1px solid rgba(245,245,240,0.18); color: #f5f5f0;
    font-size: 13px; padding: 9px 11px; border-radius: 3px; font-family: inherit; flex: 1;
  }
  textarea { width: 100%; margin-bottom: 12px; resize: vertical; }
  .btn-small { font-size: 12px; padding: 9px 16px; border: 1px solid #d4af37; color: #d4af37; background: none; cursor: pointer; border-radius: 3px; }
  .hint { font-size: 12.5px; color: #a66a62; margin-top: 8px; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th { text-align: left; color: #85837e; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; padding: 0 10px 10px; border-bottom: 1px solid rgba(245,245,240,0.18); }
  td { padding: 12px 10px; border-bottom: 1px solid rgba(245,245,240,0.08); vertical-align: top; }
  td.when { color: #b7b5af; max-width: 320px; }
  tr.inactive { opacity: 0.45; }
  .toggle-btn { font-size: 11.5px; padding: 6px 10px; border: 1px solid rgba(245,245,240,0.25); color: #b7b5af; background: none; cursor: pointer; border-radius: 3px; }
</style>
