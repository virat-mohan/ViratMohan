---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const swatches = ['terracotta', 'cobalt', 'magenta', 'bronze'];

const areas = [
  {
    title: 'Commercial & operational due diligence',
    body: 'Reading a target the way an auditor and an operator would at once — where value is real, where it is fragile, and what breaks under growth.',
  },
  {
    title: 'Financial modelling & unit economics',
    body: 'Site-by-site and cohort-level economics for food, retail and services businesses, built to survive scrutiny rather than flatter a deck.',
  },
  {
    title: 'Capital allocation',
    body: 'Where the next rupee or dollar earns its highest return, across equity, debt and internal reinvestment.',
  },
  {
    title: 'GCC & India market entry',
    body: 'Structuring and sequencing entry across India, the UAE, KSA and the wider Gulf — regulatory, operational and commercial.',
  },
  {
    title: 'Operational turnarounds',
    body: 'Stabilising unit economics and operating cadence in businesses that have outgrown their systems.',
  },
  {
    title: 'DRHP & IPO readiness',
    body: 'Preparing the numbers, the operations and the narrative to withstand regulators and institutional investors.',
  },
];
---

<Base
  title="Advisory — Virat Mohan"
  description="Virat Mohan advises on commercial and operational due diligence, financial modelling, unit economics, capital allocation, GCC and India market entry, operational turnarounds, and DRHP/IPO readiness across India, the UAE and the UK."
  path="/advisory"
>
  <section class="section">
    <div class="container">
      <p class="eyebrow" data-reveal style="color: var(--cobalt)">Advisory</p>
      <h1 class="advisory__h" data-reveal style="--reveal-delay: 60ms">
        Where capital meets execution.
      </h1>
      <hr class="advisory__rule" />
      <p class="advisory__intro dim measure" data-reveal style="--reveal-delay: 120ms">
        Selective advisory for founders, investors and operating teams. The
        work concentrates on the seam between financing and operations — the
        place a career spent on both sides of the term sheet is most useful.
        Geographic focus: India, the UAE and the UK.
      </p>
      <p class="advisory__relation dim measure" data-reveal style="--reveal-delay: 140ms">
        This sits apart from <a class="link-underline" href="/devshop">Dev Shop</a> on
        purpose. Dev Shop is fast and technical — a working system in days.
        Advisory is the opposite kind of engagement: longer-term, not
        code-driven, and built entirely on judgment accumulated across two
        decades of audit, operating and capital work. Dev Shop answers
        "can this be built." Advisory answers the questions no machine
        can — where a plan quietly breaks, which number actually decides
        the outcome, what a term sheet is really pricing in.
      </p>

      <ul class="advisory__list">
        {
          areas.map((a, i) => (
            <li
              class="advisory__item"
              data-reveal
              style={`--c: var(--${swatches[i % swatches.length]}); --rot: ${
                i % 2 === 0 ? '-1deg' : '0.8deg'
              }`}
            >
              <h2 class="advisory__title">{a.title}</h2>
              <p class="advisory__body">{a.body}</p>
            </li>
          ))
        }
      </ul>

      <p class="advisory__cta" data-reveal>
        <a class="link-underline advisory__mail" href={`mailto:${site.email}`}>
          {site.email}
        </a>
      </p>
    </div>
  </section>
</Base>

<style>
  .advisory__h {
    margin: 0.75rem 0 1.75rem;
    max-width: 14ch;
  }
  .advisory__rule {
    border: 0;
    height: 4px;
    width: 4rem;
    background: var(--cobalt);
    margin: 0 0 1.5rem;
  }
  .advisory__intro {
    margin: 0 0 1.75rem;
    font-size: 1.125rem;
  }
  .advisory__relation {
    margin: 0 0 4rem;
    font-size: 0.9375rem;
    padding: 1.5rem;
    background: color-mix(in srgb, var(--cobalt) 8%, var(--bg));
    border-left: 3px solid var(--cobalt);
  }
  .advisory__relation a {
    color: var(--fg);
  }
  .advisory__list {
    list-style: none;
    margin: 0 0 3rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 2rem 1.75rem;
  }
  .advisory__item {
    background: var(--c);
    padding: 2.25rem 1.75rem 2.5rem;
    transform: rotate(var(--rot));
    transition: transform 0.3s ease;
    min-height: 13rem;
  }
  .advisory__item:hover {
    transform: rotate(0deg) scale(1.02);
  }
  .advisory__title {
    font-size: clamp(1.4rem, 2.2vw, 1.75rem);
    margin: 0 0 0.9rem;
    color: var(--poster-cream);
  }
  .advisory__body {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--poster-cream);
    opacity: 0.92;
  }
  .advisory__cta {
    margin-top: 3rem;
    font-family: var(--serif);
    font-size: clamp(1.75rem, 4vw, 3rem);
  }
  @media (max-width: 720px) {
    .advisory__list {
      grid-template-columns: 1fr;
    }
    .advisory__item {
      transform: none;
    }
  }
</style>
