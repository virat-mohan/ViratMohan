---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { site, personId } from '../../data/site';
import LogoMark from '../../components/work/LogoMark.astro';

export async function getStaticPaths() {
  const projects = await getCollection('work');
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const displayDomain = entry.data.domain.replace(/^https?:\/\//, '').replace(/\/$/, '');

const workSchema = {
  '@type': 'CreativeWork',
  '@id': `${site.domain}/work/${entry.id}#work`,
  name: `${entry.data.category} — ${entry.data.brand}`,
  description: entry.data.tagline,
  url: entry.data.domain,
  creator: { '@id': personId },
};
---

<Base
  title={`${entry.data.category} — Virat Mohan`}
  description={entry.data.tagline}
  path={`/work/${entry.id}`}
  schema={[workSchema]}
>
  <article class="project section">
    <div class="container">
      <header class="project__head" data-reveal>
        <LogoMark
          logo={entry.data.logo}
          brand={entry.data.brand}
          accent={entry.data.accent}
          founder={entry.data.founder}
          size="lg"
        />
        <p class="eyebrow project__eyebrow">
          <a class="link-underline" href="/work">Work</a>
        </p>
        <h1 class="project__title">{entry.data.category}</h1>
        <p class="project__proof">
          Built and running for <strong>{entry.data.brand}</strong> —
          <a
            class="link-underline"
            href={entry.data.domain}
            target="_blank"
            rel="noopener noreferrer"
          >
            {displayDomain} ↗
          </a>
        </p>
        <p class="project__tagline">{entry.data.tagline}</p>
        <hr
          class="project__rule"
          style={`background: ${entry.data.accent};`}
        />
      </header>

      <div class="prose tnum" data-reveal style="--reveal-delay: 80ms">
        <Content />
      </div>

      <div class="project__cta" data-reveal>
        <hr class="rule-hair" />
        <p class="project__cta-line">
          Want {entry.data.category.toLowerCase()} built for your business?
        </p>
        <div class="project__cta-links">
          <a
            class="link-underline"
            href={site.bookingUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Schedule a call
          </a>
          <span class="dim" aria-hidden="true">·</span>
          <a class="link-underline" href={`mailto:${site.email}`}>
            {site.email}
          </a>
        </div>
      </div>
    </div>
  </article>
</Base>

<style>
  .project__head {
    max-width: 68ch;
    margin-bottom: 3.5rem;
  }
  .project__eyebrow {
    margin-top: 1.5rem;
  }
  .project__title {
    margin: 1rem 0 1.25rem;
    font-size: clamp(2.25rem, 5.5vw, 4rem);
    line-height: 1.02;
  }
  .project__proof {
    font-size: 0.9375rem;
    color: var(--muted);
    margin: 0 0 1.25rem;
  }
  .project__proof strong {
    color: var(--fg);
    font-weight: 500;
  }
  .project__tagline {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    line-height: 1.4;
    max-width: 46ch;
    color: var(--fg);
    margin: 0 0 2rem;
  }
  .project__rule {
    margin: 0;
    border: 0;
    height: 2px;
    opacity: 0.7;
  }

  .prose {
    max-width: 66ch;
    line-height: 1.75;
  }
  .prose :global(p) {
    margin: 0 0 1.5rem;
  }
  .prose :global(> p:first-of-type) {
    font-size: 1.1875rem;
  }
  .prose :global(h3) {
    margin: 4rem 0 1.5rem;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.4rem, 2.6vw, 1.85rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--fg);
  }
  .prose :global(strong) {
    color: var(--fg);
    font-weight: 500;
  }
  .prose :global(em) {
    font-style: italic;
  }
  .prose :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-underline-offset: 3px;
  }
  .prose :global(ul) {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .prose :global(li) {
    position: relative;
    padding-left: 1.3rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--muted);
    max-width: 58ch;
  }
  .prose :global(li)::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.7em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--muted);
  }

  .project__cta {
    max-width: 66ch;
    margin-top: 4rem;
  }
  .project__cta-line {
    font-family: var(--serif);
    font-size: clamp(1.35rem, 2.6vw, 1.9rem);
    line-height: 1.25;
    margin: 2rem 0 1.25rem;
    max-width: 22ch;
  }
  .project__cta-links {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1rem;
  }
</style>
