---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const essays = (await getCollection('writing')).sort(
  (a, b) => a.data.order - b.data.order
);

function readingTime(body: string | undefined): number {
  const words = (body ?? '')
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/[#*_>\-`]/g, ' ')
    .trim()
    .split(/\s+/).length;
  return Math.max(1, Math.round(words / 200));
}
---

<Base
  title="Writing — Virat Mohan"
  description="Essays by Virat Mohan on operating businesses, unit economics, capital and the place of judgment in an AI-native firm."
  path="/writing"
>
  <section class="section">
    <div class="container">
      <p class="eyebrow" data-reveal>Writing</p>
      <h1 class="writing__h" data-reveal style="--reveal-delay: 60ms">
        Notes on capital, execution and judgment.
      </h1>

      <ul class="writing__list">
        {
          essays.map((e, i) => (
            <li class="writing__item" data-reveal>
              {i > 0 && <hr class="rule-gold" />}
              <a class="writing__link" href={`/writing/${e.id}`}>
                <span class="eyebrow writing__time">
                  {readingTime(e.body)} min read
                </span>
                <span class="writing__title">{e.data.title}</span>
                <span class="writing__standfirst dim">
                  {e.data.standfirst}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .writing__h {
    margin: 0.75rem 0 3.5rem;
    max-width: 16ch;
  }
  .writing__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .writing__item + .writing__item {
    margin-top: 0;
  }
  .writing__link {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-decoration: none;
    padding-block: 2rem;
  }
  .writing__item:first-child .writing__link {
    padding-top: 0;
  }
  .writing__time {
    margin: 0;
  }
  .writing__title {
    font-family: var(--serif);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    transition: color 0.3s ease;
  }
  .writing__standfirst {
    max-width: 56ch;
    font-size: 1.0625rem;
    line-height: 1.5;
  }
  .writing__link:hover .writing__title,
  .writing__link:focus-visible .writing__title {
    color: var(--gold);
  }
</style>
