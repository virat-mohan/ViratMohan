---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { site, personId } from '../../data/site';

export async function getStaticPaths() {
  const essays = await getCollection('writing');
  return essays.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const articleSchema = {
  '@type': 'Article',
  '@id': `${site.domain}/writing/${entry.id}#article`,
  headline: entry.data.title,
  description: entry.data.standfirst,
  datePublished: entry.data.pubDate.toISOString(),
  author: { '@id': personId },
  publisher: { '@id': personId },
  mainEntityOfPage: `${site.domain}/writing/${entry.id}`,
};
---

<Base
  title={`${entry.data.title} — Virat Mohan`}
  description={entry.data.standfirst}
  path={`/writing/${entry.id}`}
  schema={[articleSchema]}
>
  <article class="essay section">
    <div class="container">
      <header class="essay__head" data-reveal>
        <p class="eyebrow">
          <a class="link-underline" href="/writing">Writing</a>
        </p>
        <h1 class="essay__title">{entry.data.title}</h1>
        <p class="essay__standfirst dim">{entry.data.standfirst}</p>
        <hr class="rule-gold essay__rule" />
      </header>

      <div class="prose tnum" data-reveal style="--reveal-delay: 80ms">
        <Content />
      </div>
    </div>
  </article>
</Base>

<style>
  .essay__head {
    max-width: 68ch;
    margin-bottom: 3.5rem;
  }
  .essay__title {
    margin: 1rem 0 1.25rem;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1;
  }
  .essay__standfirst {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    line-height: 1.4;
    max-width: 44ch;
    margin: 0 0 2rem;
  }
  .essay__rule {
    margin: 0;
  }

  .prose {
    max-width: 66ch;
    line-height: 1.75;
  }
  .prose :global(p) {
    margin: 0 0 1.5rem;
  }
  .prose :global(> p:first-of-type) {
    font-size: 1.1875rem;
  }
  .prose :global(h2) {
    margin: 3rem 0 1rem;
  }
  .prose :global(h3) {
    margin: 3rem 0 0.75rem;
    font-family: var(--sans);
    font-size: 0.875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
  }
  .prose :global(strong) {
    color: var(--fg);
    font-weight: 500;
  }
  .prose :global(em) {
    font-style: italic;
  }
  .prose :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-underline-offset: 3px;
  }
  .prose :global(blockquote) {
    margin: 2rem 0;
    padding-left: 1.5rem;
    border-left: 1px solid var(--gold);
    font-family: var(--serif);
    font-size: 1.35rem;
    line-height: 1.35;
  }
</style>
