---
export const prerender = false;
import { getRetailOsDb } from '../../../lib/retail-os-db';
import { getEnv } from '../../../lib/env';

const { id } = Astro.params;
const env = getEnv();
let app = null;
let plan = null;
let design = null;
let loadError = false;
if (id && env.SUPABASE_URL && env.SUPABASE_SERVICE_ROLE_KEY) {
  const db = getRetailOsDb(env);
  try {
    app = await db.getById(id);
    if (app) plan = await db.getLatestBusinessPlan(id);
  } catch (err) {
    console.error('track page lookup failed', err);
    loadError = true;
  }
  // Separate so a design-direction failure (e.g. its table not migrated yet)
  // never takes down the partner's whole tracker.
  if (app) {
    try {
      design = await db.getLatestDesignDirection(id);
    } catch (err) {
      console.error('track page design lookup failed', err);
    }
  }
}
function inr(n: number) {
  return '₹' + Math.round(n).toLocaleString('en-IN');
}
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Onboarding status — DevShop Retail OS</title>
<meta name="robots" content="noindex" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
<style>
  :root{ --cream:#F4EAD4; --ink:#1A1410; --ink-soft:#4A4038; --gold:#D4AF37; --gold-deep:#C99A3D;
    --terracotta:#D9714B; --line: rgba(26,20,16,0.14); }
  *{box-sizing:border-box;}
  body{ margin:0; background:var(--cream); color:var(--ink); font-family:'Inter',system-ui,sans-serif;
    font-size:15px; line-height:1.55; }
  h1,h2,h3{font-family:'Anton','Arial Narrow',sans-serif; font-weight:400; text-transform:uppercase; margin:0;}
  a{color:inherit;}
  .wrap{max-width:720px; margin-inline:auto; padding-inline:24px; padding-block:32px 60px;}
  .stripe{display:flex; height:6px;} .stripe span{flex:1;}
  .stripe span:nth-child(1){background:var(--gold);} .stripe span:nth-child(2){background:#3E6FA6;}
  .stripe span:nth-child(3){background:#E91E8C;} .stripe span:nth-child(4){background:#9C7A4A;}
  nav{display:flex; justify-content:space-between; align-items:center; padding-block:16px 28px;}
  .wordmark{display:flex; align-items:baseline; gap:2px; font-family:'Anton'; font-size:20px; text-transform:uppercase;}
  .wordmark .w1{color:var(--gold-deep);} .wordmark .w2{color:var(--ink);}
  .wordmark small{font-family:'Inter'; font-style:italic; font-weight:500; font-size:10.5px; color:var(--ink-soft); text-transform:none; margin-left:8px;}
  nav a.back{font-size:13px; font-weight:600; text-decoration:none; color:var(--ink-soft);}
  .appid{font-family:'IBM Plex Mono'; font-size:11px; color:var(--ink-soft);}
  .pipeline-head{display:flex; justify-content:space-between; align-items:flex-end; gap:14px; margin-bottom:16px; flex-wrap:wrap;}
  .pipeline{display:flex; flex-direction:column; border:2px solid var(--ink);}
  .pipeline-row{display:flex; align-items:center; gap:14px; padding:14px 18px; border-bottom:1.5px solid var(--ink);}
  .pipeline-row:last-child{border-bottom:none;}
  .pipeline-badge{font-family:'IBM Plex Mono'; font-size:10px; font-weight:700; letter-spacing:0.04em; text-transform:uppercase;
    padding:4px 10px; border:1.5px solid currentColor; flex:none; min-width:84px; text-align:center;}
  .pipeline-badge.done{background:var(--ink); color:var(--cream); border-color:var(--ink);}
  .pipeline-badge.pending{color:var(--ink-soft); border-color:var(--line);}
  .pipeline-badge.skipped{color:var(--line); border-color:var(--line);}
  .pipeline-label{font-weight:700; font-size:13.5px;}
  .pipeline-note{font-size:11.5px; color:var(--ink-soft); font-weight:500; margin-top:2px;}
  .notfound{padding-block:60px; text-align:center;}
  .notfound p{color:var(--ink-soft); font-weight:500; max-width:44ch; margin:14px auto 0;}
  .lookup{margin-top:32px; padding-top:28px; border-top:1.5px solid var(--line);}
  .lookup-label{font-size:12.5px; font-weight:600; color:var(--ink-soft); margin-bottom:10px;}
  .lookup form{display:flex; gap:8px; justify-content:center; flex-wrap:wrap;}
  .lookup input{border:1.5px solid var(--ink); padding:10px 12px; font-family:'Inter'; font-size:13.5px; min-width:220px;}
  .lookup button{border:2px solid var(--ink); background:var(--ink); color:var(--cream); padding:10px 16px; font-family:'Inter'; font-weight:700; font-size:13.5px; cursor:pointer;}
  .lookup-msg{font-size:12px; color:var(--terracotta); font-weight:600; margin-top:10px; min-height:16px;}
  .panel{border:2px solid var(--ink); padding:20px; margin-top:24px;}
  .panel h2{font-size:1.25rem; margin-bottom:12px;}
  .split-grid{display:grid; grid-template-columns:1fr 1fr 1fr; gap:20px;}
  @media (max-width:640px){ .split-grid{grid-template-columns:1fr;} }
  .split-col h3{font-family:'Inter'; font-size:11.5px; font-weight:700; text-transform:uppercase; letter-spacing:0.03em; color:var(--ink-soft); margin-bottom:8px;}
  .split-col ul{margin:0; padding-left:18px; font-size:13px;}
  .split-col li{margin-bottom:5px;}
  .split-note{font-size:11px; color:var(--ink-soft); margin-top:14px; font-style:italic;}
  .provisional-tag{font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.04em; color:var(--terracotta); border:1.5px solid var(--terracotta); padding:3px 8px; margin-left:10px; vertical-align:middle;}
  .forecast-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-top:14px;}
  .forecast-cell{border:1.5px solid var(--line); padding:12px;}
  .forecast-cell .fc-label{font-size:10.5px; font-weight:700; text-transform:uppercase; color:var(--ink-soft);}
  .forecast-cell .fc-value{font-family:'IBM Plex Mono'; font-size:1.15rem; font-weight:700; margin-top:4px;}
  .forecast-note{font-size:12px; color:var(--ink-soft); margin-top:14px; line-height:1.5;}
  .ref-card{border:1.5px solid var(--line); padding:12px 14px; margin-bottom:10px;}
  .ref-card .ref-name{font-weight:700; font-size:13.5px;}
  .ref-card .ref-url{font-family:'IBM Plex Mono'; font-size:10.5px; color:var(--ink-soft); margin:2px 0 6px; word-break:break-all;}
  .ref-card .ref-note{font-size:12.5px; color:var(--ink-soft);}
  .swatches{display:flex; gap:10px; flex-wrap:wrap; margin:6px 0 10px;}
  .swatch{width:76px;}
  .swatch .chip{height:44px; border:1.5px solid var(--ink);}
  .swatch .hex{font-family:'IBM Plex Mono'; font-size:10px; margin-top:4px; text-align:center;}
  .swatch .name{font-size:9px; color:var(--ink-soft); text-align:center; text-transform:uppercase; font-weight:700;}
  .sub-h{font-family:'Inter'; font-size:11.5px; font-weight:700; text-transform:uppercase; letter-spacing:0.03em; color:var(--ink-soft); margin:18px 0 8px;}
  ul.ux{margin:0; padding-left:18px; font-size:13px;} ul.ux li{margin-bottom:6px;}
  footer{padding-block:24px; text-align:center;}
  footer p{margin:0; font-size:10.5px; font-weight:700; letter-spacing:0.03em; color:var(--ink-soft);}
</style>
</head>
<body>
<div class="stripe"><span></span><span></span><span></span><span></span></div>
<div class="wrap">
  <nav>
    <div class="wordmark"><span class="w1">Dev</span><span class="w2">Shop</span><small>Retail OS™</small></div>
    <a class="back" href="/retail-os">← Back to Retail OS</a>
  </nav>

  {app ? (
    <>
      <div class="pipeline-head">
        <h1 style="font-size:1.8rem;">Onboarding status</h1>
        <span class="appid">{app.id.slice(0,8).toUpperCase()} · {app.brand_name}</span>
      </div>
      <div class="pipeline">
        {app.stages.map((s) => (
          <div class="pipeline-row">
            <span class={`pipeline-badge ${s.status}`}>{s.status === 'done' ? 'Done' : s.status === 'skipped' ? 'Skipped' : 'Pending'}</span>
            <div>
              <div class="pipeline-label">{s.label}</div>
              {s.note && <div class="pipeline-note">{s.note}</div>}
            </div>
          </div>
        ))}
      </div>

      {plan && (
        <div class="panel">
          <h2>Quarterly forecast <span class="provisional-tag">Provisional</span></h2>
          <div class="forecast-grid">
            <div class="forecast-cell"><div class="fc-label">3-month revenue</div><div class="fc-value">{inr(plan.quarter_totals.revenueInr)}</div></div>
            <div class="forecast-cell"><div class="fc-label">3-month profit pool</div><div class="fc-value">{inr(plan.quarter_totals.profitPoolInr)}</div></div>
            <div class="forecast-cell"><div class="fc-label">Your share (3 months)</div><div class="fc-value">{inr(plan.quarter_totals.founderShareInr)}</div></div>
          </div>
          <p class="forecast-note">
            Built from your catalog and researched category/city benchmarks — this is a starting estimate, not a
            guarantee. It gets sharper as we lock in your actual payment gateway, shipping, and Meta ad numbers
            through onboarding, and becomes your official benchmark once you're live.
          </p>
        </div>
      )}

      {design && (
        <div class="panel">
          <h2>Design direction <span class="provisional-tag">Proposed — for your review</span></h2>
          <p class="forecast-note" style="margin-top:0;">
            {design.has_existing_site
              ? "Built from your existing look, pushed toward how the best sites in your category execute."
              : "You don't have a live site yet, so we've started from a proven, successful brand in your category as the template."}
          </p>

          <div class="sub-h">{design.has_existing_site ? 'Primary reference' : 'Template we\'ll start from'}</div>
          <div class="ref-card">
            <div class="ref-name">{design.primary_reference.name}</div>
            {design.primary_reference.url && <div class="ref-url"><a href={design.primary_reference.url} target="_blank" rel="noopener noreferrer">{design.primary_reference.url}</a></div>}
            <div class="ref-note">{design.primary_reference.note}</div>
          </div>
          {design.additional_references.length > 0 && (
            <>
              <div class="sub-h">Also drawing from</div>
              {design.additional_references.map((r) => (
                <div class="ref-card">
                  <div class="ref-name">{r.name}</div>
                  {r.url && <div class="ref-url"><a href={r.url} target="_blank" rel="noopener noreferrer">{r.url}</a></div>}
                  <div class="ref-note">{r.note}</div>
                </div>
              ))}
            </>
          )}

          <div class="sub-h">Palette</div>
          <div class="swatches">
            {([
              ['Primary', design.color_palette.primaryHex],
              ['Secondary', design.color_palette.secondaryHex],
              ['Accent', design.color_palette.accentHex],
              ['Background', design.color_palette.backgroundHex],
              ['Text', design.color_palette.textHex],
            ] as [string, string][]).map(([name, hex]) => (
              <div class="swatch">
                <div class="chip" style={`background:${hex}`}></div>
                <div class="hex">{hex}</div>
                <div class="name">{name}</div>
              </div>
            ))}
          </div>
          <p class="forecast-note" style="margin-top:0;">{design.color_palette.rationale}</p>

          <div class="sub-h">Typography</div>
          <p style="margin:0; font-size:13.5px;"><b>Headings:</b> {design.typography.headingFont} · <b>Body:</b> {design.typography.bodyFont}</p>

          <div class="sub-h">How the site will work</div>
          <ul class="ux">{design.ux_principles.map((p) => <li>{p}</li>)}</ul>

          <div class="sub-h">Tone of voice</div>
          <p style="margin:0; font-size:13px; line-height:1.6;">{design.tone_of_voice}</p>
        </div>
      )}

      <div class="panel">
        <h2>Who handles what</h2>
        <div class="split-grid">
          <div class="split-col">
            <h3>DevShop</h3>
            <ul>
              <li>Storefront build, hosting &amp; maintenance</li>
              <li>Payment gateway integration</li>
              <li>Meta Business Manager, catalog &amp; pixel setup</li>
              <li>WhatsApp Business API provisioning</li>
              <li>Day-to-day site operations &amp; catalog management</li>
              <li>Performance marketing execution</li>
              <li>Pricing — we fix the price of each product with you</li>
              <li>Your benchmark P&amp;L and monthly reporting</li>
            </ul>
          </div>
          <div class="split-col">
            <h3>You</h3>
            <ul>
              <li>Product sourcing, manufacturing &amp; inventory</li>
              <li>Fulfillment — packing &amp; handoff to courier</li>
              <li>Brand creative &amp; product photography</li>
              <li>Customer relationships beyond order status</li>
              <li>Answering the setup questions we'll ask at each stage below</li>
            </ul>
          </div>
          <div class="split-col">
            <h3>Decided together</h3>
            <ul>
              <li>Discounting &amp; promo rules — these move gross profit directly, so we agree them jointly</li>
              <li>Any freelancers we bring in (performance marketing, content/production, etc.) and their cost — also comes out of gross profit, so agreed before we hire</li>
            </ul>
          </div>
        </div>
        <p class="split-note">Full detail is in your signed Partnership Agreement — this is the plain-English summary.</p>
      </div>
    </>
  ) : (
    <div class="notfound">
      <h2>{loadError ? 'Status temporarily unavailable' : "Can't find that application"}</h2>
      <p>{loadError
        ? "There's a hiccup reaching the backend right now — try again shortly, or email viratmohan@gmail.com."
        : "This link doesn't match an application on file."}</p>
      {!loadError && (
        <div class="lookup">
          <p class="lookup-label">Lost your link? Enter the email you applied with:</p>
          <form id="lookupForm">
            <input type="email" id="lookupEmail" placeholder="you@brand.com" required />
            <button type="submit">Resend link →</button>
          </form>
          <p class="lookup-msg" id="lookupMsg"></p>
        </div>
      )}
    </div>
  )}
</div>
<footer><p>DEVSHOP RETAIL OS™ — REAL-TIME ONBOARDING STATUS</p></footer>
<script>
  var form = document.getElementById('lookupForm');
  if (form) {
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      var email = document.getElementById('lookupEmail').value;
      var msg = document.getElementById('lookupMsg');
      msg.textContent = 'Sending…';
      try {
        await fetch('/retail-os/api/resend-link', {
          method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ email: email })
        });
      } catch (e) {}
      msg.textContent = "If that email has an application, we've sent the link.";
    });
  }
</script>
</body>
</html>
