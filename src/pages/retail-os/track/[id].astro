---
export const prerender = false;
import { getRetailOsDb, journeyStep, BUILD_WINDOW_DAYS, DEPOSIT_INR } from '../../../lib/retail-os-db';
import type { RetailOsApplication, RetailOsBusinessPlan, RetailOsDesignDirection, JourneyStep } from '../../../lib/retail-os-db';
import { getEnv } from '../../../lib/env';
import { sectionsFor } from '../../../lib/retail-os-setup';
import { buildTermLines } from '../../../lib/retail-os-terms';

const { id } = Astro.params;
const env = getEnv();
let app: RetailOsApplication | null = null;
let plan: RetailOsBusinessPlan | null = null;
let designs: RetailOsDesignDirection[] = [];
let loadError = false;
if (id && env.SUPABASE_URL && env.SUPABASE_SERVICE_ROLE_KEY) {
  const db = getRetailOsDb(env);
  try {
    app = await db.getById(id);
  } catch (err) {
    console.error('track page lookup failed', err);
    loadError = true;
  }
  // Loaded separately so a failure (e.g. a table not migrated yet) never takes
  // down the partner's whole page.
  if (app) {
    [plan, designs] = await Promise.all([
      db.getLatestBusinessPlan(app.id).catch((err) => { console.error('track plan lookup failed', err); return null; }),
      db.getLatestDesignOptions(app.id).catch((err) => { console.error('track design lookup failed', err); return [] as RetailOsDesignDirection[]; }),
    ]);
  }
}

function inr(n: number) {
  return '₹' + Math.round(n).toLocaleString('en-IN');
}
const fmtDate = (d: Date) => d.toLocaleDateString('en-IN', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'Asia/Kolkata' });

const design = designs[0] ?? null;
const chosenDesign = designs.find((x) => x.chosen) ?? null;
const step: JourneyStep | null = app ? journeyStep(app, !!plan, !!design) : null;
const prepFailed = !!app?.prep_error && (!plan || !design);
const termLines = app?.terms ? (app.agreement?.terms?.lines as { label: string; value: string }[] | undefined) ?? buildTermLines(app, app.terms) : [];
const sections = app ? sectionsFor(app) : [];
const answered = app?.setup_answers ?? {};
const firstOpen = sections.find((s) => !answered[s.key])?.key ?? null;
const answeredCount = sections.filter((s) => answered[s.key]).length;

let buildDay = 0;
let targetDate: Date | null = null;
if (app?.build_started_at) {
  const start = new Date(app.build_started_at);
  targetDate = new Date(start.getTime() + BUILD_WINDOW_DAYS * 86400000);
  buildDay = Math.min(BUILD_WINDOW_DAYS, Math.max(1, Math.floor((Date.now() - start.getTime()) / 86400000) + 1));
}

const upiLink = env.RETAIL_OS_UPI_ID
  ? `upi://pay?pa=${encodeURIComponent(env.RETAIL_OS_UPI_ID)}&pn=${encodeURIComponent(env.RETAIL_OS_UPI_PAYEE || 'DevShop')}&am=${DEPOSIT_INR}&cu=INR&tn=${encodeURIComponent(`Retail OS deposit ${app?.id.slice(0, 8).toUpperCase() ?? ''}`)}`
  : null;

const qrUrl = /^https:\/\//i.test(env.RETAIL_OS_UPI_QR_URL) ? env.RETAIL_OS_UPI_QR_URL : null;
const waDigits = env.RETAIL_OS_WHATSAPP_NUMBER.replace(/\D/g, '');
const waLink = waDigits && app
  ? `https://wa.me/${waDigits}?text=${encodeURIComponent(`Retail OS deposit for ${app.brand_name} (${app.id.slice(0, 8).toUpperCase()}): ₹${DEPOSIT_INR} paid. Payment screenshot attached.`)}`
  : null;

const JOURNEY: { key: string; label: string }[] = [
  { key: 'applied', label: 'Applied' },
  { key: 'plan', label: 'Forecast & design' },
  { key: 'terms', label: 'Sign terms' },
  { key: 'deposit', label: 'Deposit' },
  { key: 'build', label: `${BUILD_WINDOW_DAYS}-day build` },
  { key: 'live', label: 'Live' },
];
const STEP_INDEX: Record<JourneyStep, number> = { preparing: 1, review: 2, sign: 2, deposit: 3, confirming: 3, building: 4, live: 5 };
const currentIndex = step ? STEP_INDEX[step] : 0;

// ── Checklist: every step of the journey on a 7-day clock from application ──
const clockStart = app ? new Date(app.created_at) : new Date();
const goLiveTarget = new Date(clockStart.getTime() + BUILD_WINDOW_DAYS * 86400000);
const today = Math.max(0, Math.floor((Date.now() - clockStart.getTime()) / 86400000));
const stageStatus = (k: string) => app?.stages.find((s) => s.key === k)?.status ?? 'pending';
const dayDate = (n: number) => new Date(clockStart.getTime() + n * 86400000).toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'Asia/Kolkata' });
type CkItem = { key: string; label: string; day: [number, number]; owner: 'DevShop' | 'You' | 'Together'; status: 'done' | 'pending' | 'skipped'; we: string; you: string; detail?: 'application' | 'plan' | 'design' | 'terms' | 'deposit' | 'setup' };
const checklist: CkItem[] = app ? [
  { key: 'submitted', label: 'Application', day: [0, 0], owner: 'You', status: 'done', we: 'Read your answers and research your category and cities.', you: 'Tell us about the brand, catalog, payments and shipping.', detail: 'application' },
  { key: 'plan', label: 'Business plan & forecast', day: [0, 0], owner: 'Together', status: plan ? 'done' : 'pending', we: `Build a 3-month P&L on DevShop's strategy: product ≤25%, marketing ≤25%, admin and all other costs ≤10% of revenue.`, you: 'Go through the assumptions with Virat and agree the numbers.', detail: 'plan' },
  { key: 'design', label: 'Design direction', day: [0, 0], owner: 'You', status: chosenDesign || stageStatus('design') === 'done' ? 'done' : 'pending', we: 'Propose three directions, each based on a real brand that works.', you: 'Pick the one that feels most like your brand.', detail: 'design' },
  { key: 'agreement', label: 'Terms signed', day: [0, 0], owner: 'Together', status: app.agreement ? 'done' : 'pending', we: 'Send your terms with the agreed lane and split.', you: 'Read, type your name, tick both boxes and sign.', detail: 'terms' },
  { key: 'deposit', label: 'Deposit ₹5,000', day: [0, 0], owner: 'You', status: app.deposit?.confirmedAt ? 'done' : 'pending', we: 'Confirm it; the build starts the same moment.', you: 'Pay by UPI.', detail: 'deposit' },
  { key: 'setup', label: 'Setup questions', day: [1, 1], owner: 'You', status: sections.length > 0 && answeredCount === sections.length ? 'done' : 'pending', we: 'Use the answers to configure everything below.', you: 'Answer each section on this page.', detail: 'setup' },
  { key: 'identity', label: 'Brand identity', day: [1, 2], owner: 'DevShop', status: stageStatus('identity'), we: 'Domain, brand email, Instagram and Meta Business Manager where needed.', you: 'Approve names and handles.' },
  { key: 'catalog', label: 'Catalog', day: [1, 2], owner: 'DevShop', status: stageStatus('catalog'), we: 'Import from Shopify or build the catalog; prices fixed with you.', you: 'Confirm products, prices and stock.' },
  { key: 'payments', label: 'Payments', day: [2, 4], owner: 'Together', status: stageStatus('payments'), we: 'Set up the gateway and settlement into DevShop, then weekly to you.', you: 'Share KYC documents when the gateway asks.' },
  { key: 'shipping', label: 'Shipping', day: [2, 3], owner: 'DevShop', status: stageStatus('shipping'), we: 'Wire in the courier, pickup address and rates.', you: 'Confirm the pickup address and packing process.' },
  { key: 'meta', label: 'Meta (Instagram & Facebook)', day: [3, 4], owner: 'DevShop', status: stageStatus('meta'), we: 'Connect Business Manager, catalog and pixel; draft launch ads.', you: 'Accept the access request.' },
  { key: 'whatsapp', label: 'WhatsApp', day: [3, 5], owner: 'DevShop', status: stageStatus('whatsapp'), we: 'Provision the WhatsApp Business number for orders and catalog.', you: 'Approve the display name.' },
  { key: 'postbarter', label: 'Pay with a Post', day: [5, 5], owner: 'DevShop', status: stageStatus('postbarter'), we: 'Switch on post-to-unlock at checkout, if opted in.', you: 'Nothing.' },
  { key: 'golive', label: 'Go-live review', day: [6, 6], owner: 'Together', status: stageStatus('golive'), we: 'Test orders, payments, shipping and messages end to end.', you: 'Place a test order and sign off.' },
  { key: 'live', label: 'Live & selling', day: [BUILD_WINDOW_DAYS, BUILD_WINDOW_DAYS], owner: 'DevShop', status: stageStatus('live'), we: 'Open the store and start ads; weekly settlement every Monday.', you: 'Pack and ship orders.' },
] : [];
const doneCount = checklist.filter((c) => c.status !== 'pending').length;
const editMode = Astro.url.searchParams.get('edit') === '1';
type Field = { key: string; label: string; raw: string; shown: string | null | undefined; explain: string; options?: [string, string][] };
const pick = (opts: [string, string][], v: string | null | undefined) => opts.find(([k]) => k === v)?.[1] ?? v;
const O = {
  brand_status: [['existing', 'Existing brand'], ['new_sub_brand', 'New sub-brand'], ['from_zero', 'Starting from zero']] as [string, string][],
  yesno: [['yes', 'Yes'], ['no', 'No']] as [string, string][],
  catalog_mode: [['shopify', 'Shopify import'], ['manual', 'Built manually']] as [string, string][],
  payment_mode: [['managed', 'DevShop-managed'], ['own', 'Own gateway account']] as [string, string][],
  payment_methods: [['both', 'Prepaid + cash on delivery'], ['prepaid', 'Prepaid only'], ['cod', 'Cash on delivery only']] as [string, string][],
  shipping: [['free', 'Free, always'], ['threshold', 'Free above a minimum order'], ['flat', 'Flat fee'], ['calculated', 'Calculated at checkout']] as [string, string][],
  returns: [['7', '7 days'], ['14', '14 days'], ['30', '30 days'], ['none', 'No returns']] as [string, string][],
  carrier: [['aggregator', 'DevShop aggregator'], ['own', 'Own courier account']] as [string, string][],
  meta_bm: [['yes', 'Have one'], ['no', 'Needs setup']] as [string, string][],
};
const thr = app?.free_shipping_threshold ? `₹${Number(app.free_shipping_threshold).toLocaleString('en-IN')}` : 'the minimum';
const shipExplain: Record<string, string> = {
  free: 'Customers never pay for shipping; the cost comes out of the profit pool.',
  threshold: `Customers pay a shipping fee on orders under ${thr}; orders of ${thr} or more ship free.`,
  flat: 'Every order carries the same shipping fee, whatever its size.',
  calculated: 'Shipping is priced at checkout by weight and pincode.',
};
const payExplain: Record<string, string> = {
  both: 'Customers can pay online (UPI, card, netbanking) or in cash when the order arrives. COD widens reach but has more returns.',
  prepaid: 'Customers pay online before the order ships. No cash-on-delivery returns.',
  cod: 'Customers pay in cash at delivery only.',
};
const fields: Field[] = app ? [
  { key: 'brand_name', label: 'Brand', raw: app.brand_name, shown: app.brand_name, explain: 'The name on the store, emails and terms.' },
  { key: 'founder_name', label: 'Founder', raw: app.founder_name, shown: app.founder_name, explain: 'Main contact and signatory.' },
  { key: 'founder_email', label: 'Email', raw: app.founder_email, shown: app.founder_email, explain: 'Where this page link, terms and weekly statements go.' },
  { key: 'founder_phone', label: 'Phone', raw: app.founder_phone ?? '', shown: app.founder_phone, explain: 'For quick questions during the build.' },
  { key: 'brand_status', label: 'Where the brand is', raw: app.brand_status ?? '', shown: pick(O.brand_status, app.brand_status), explain: 'An existing brand keeps its name, domain and accounts; new brands get these set up by DevShop.', options: O.brand_status },
  { key: 'category', label: 'Category', raw: app.category ?? '', shown: app.category, explain: 'Sets the benchmarks used for the forecast and design.' },
  { key: 'format', label: 'Format', raw: app.format ?? '', shown: app.format, explain: 'D2C direct: you sell your own products on your own store.' },
  { key: 'handle', label: 'Instagram', raw: app.handle ?? '', shown: app.handle, explain: 'Linked to the store for catalog and ads.' },
  { key: 'has_revenue', label: 'Selling today', raw: app.has_revenue ?? '', shown: pick(O.yesno, app.has_revenue), explain: 'Brands already selling go on Full Operate; brands from zero can take the AI-Enabler route.', options: O.yesno },
  { key: 'revenue_range', label: 'Monthly revenue', raw: app.revenue_range ?? '', shown: app.revenue_range, explain: 'Current online sales, used as the starting point.' },
  { key: 'following', label: 'Following', raw: app.following ?? '', shown: app.following, explain: 'Instagram audience size; affects how fast orders ramp.' },
  { key: 'catalog_mode', label: 'Catalog', raw: app.catalog_mode ?? '', shown: pick(O.catalog_mode, app.catalog_mode), explain: 'Shopify import: we copy products, photos and prices from the current store.', options: O.catalog_mode },
  { key: 'shopify_url', label: 'Store URL', raw: app.shopify_url ?? '', shown: app.shopify_url, explain: 'The current store we import from.' },
  { key: 'product_count', label: 'Products', raw: app.product_count ?? '', shown: app.product_count, explain: 'Number of products (SKUs) at launch.' },
  { key: 'store_categories', label: 'Store categories', raw: app.store_categories?.join(', ') ?? '', shown: app.store_categories?.join(', '), explain: 'How the store menu is organised. Separate with commas.' },
  { key: 'product_noun_singular', label: 'One product is called', raw: app.product_noun_singular ?? '', shown: app.product_noun_singular, explain: 'Used in store copy, e.g. "Add 2 packs".' },
  { key: 'product_noun_plural', label: 'Many are called', raw: app.product_noun_plural ?? '', shown: app.product_noun_plural, explain: 'Plural of the above.' },
  { key: 'payment_mode', label: 'Payment setup', raw: app.payment_mode ?? '', shown: pick(O.payment_mode, app.payment_mode), explain: "DevShop-managed: payments land in DevShop's account and are settled to you every Monday by 1 PM.", options: O.payment_mode },
  { key: 'payment_methods', label: 'Payment methods', raw: app.payment_methods ?? '', shown: pick(O.payment_methods, app.payment_methods), explain: payExplain[app.payment_methods ?? ''] ?? '', options: O.payment_methods },
  { key: 'shipping_charge_model', label: 'Shipping charge', raw: app.shipping_charge_model ?? '', shown: pick(O.shipping, app.shipping_charge_model), explain: shipExplain[app.shipping_charge_model ?? ''] ?? '', options: O.shipping },
  { key: 'free_shipping_threshold', label: 'Free shipping from (₹)', raw: app.free_shipping_threshold ?? '', shown: app.free_shipping_threshold ? `₹${app.free_shipping_threshold}` : null, explain: 'Order value at which shipping becomes free.' },
  { key: 'return_window', label: 'Returns window', raw: app.return_window ?? '', shown: pick(O.returns, app.return_window), explain: 'How long after delivery a customer can ask for a return.', options: O.returns },
  { key: 'same_day_delivery', label: 'Same-day delivery', raw: app.same_day_delivery ?? '', shown: pick(O.yesno, app.same_day_delivery), explain: 'Same-day delivery in selected cities, if offered.', options: O.yesno },
  { key: 'carrier', label: 'Courier', raw: app.carrier ?? '', shown: pick(O.carrier, app.carrier), explain: "DevShop aggregator: we book couriers on DevShop's rates; you just pack and hand over.", options: O.carrier },
  { key: 'pincode', label: 'Pickup pincode', raw: app.pincode ?? '', shown: app.pincode, explain: 'Where couriers collect orders.' },
  { key: 'meta_bm', label: 'Meta Business Manager', raw: app.meta_bm ?? '', shown: pick(O.meta_bm, app.meta_bm), explain: 'Needed for Instagram/Facebook ads and catalog. DevShop sets it up if missing.', options: O.meta_bm },
  { key: 'ad_budget', label: 'Ad budget', raw: app.ad_budget ?? '', shown: app.ad_budget, explain: 'Monthly ad spend comes from the 25% marketing budget in the forecast.' },
  { key: 'wa_number', label: 'WhatsApp number', raw: app.wa_number ?? '', shown: app.wa_number, explain: 'Number customers message for orders and support.' },
  { key: 'target_cities', label: 'Target cities', raw: app.target_cities ?? '', shown: app.target_cities, explain: 'Where ads are focused first.' },
  { key: 'post_ack', label: 'Pay with a Post', raw: app.post_ack ? 'Yes' : 'No', shown: app.post_ack ? 'Yes' : 'No', explain: 'Customers unlock a perk by posting about the product; DevShop takes 1% of sales it drives.', options: [['Yes', 'Yes'], ['No', 'No']] },
  { key: 'split_range_lo', label: 'Split range: low (%)', raw: String(app.split_range_lo ?? ''), shown: app.split_range_lo != null ? `${app.split_range_lo}%` : null, explain: "Lowest DevShop share of the profit pool discussed." },
  { key: 'split_range_hi', label: 'Split range: high (%)', raw: String(app.split_range_hi ?? ''), shown: app.split_range_hi != null ? `${app.split_range_hi}%` : null, explain: 'Highest DevShop share discussed. The final % is set in the terms.' },
] : [];
const splitNow = app && plan ? (app.ai_enabler_track ? 0 : app.terms?.splitPct ?? plan.drivers.splitPct ?? (plan.quarter_totals.profitPoolInr ? Math.round((plan.quarter_totals.devshopShareInr / plan.quarter_totals.profitPoolInr) * 1000) / 10 : null)) : null;
const perDay = (n: number) => Math.round((n / 30) * 10) / 10;

const d = plan?.drivers?.rationale;
const planWhy = d ? ([
  ['Orders', d.orders], ['Average order value', d.aov], ['Product cost', d.cogsPct], ['Marketing', d.cacPct],
  ['Payments', d.payments], ['Shipping and returns', d.logistics],
] as [string, string | undefined][]).filter(([, v]) => !!v) : [];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{app ? `${app.brand_name} — DevShop Retail OS` : 'Onboarding — DevShop Retail OS'}</title>
<meta name="robots" content="noindex" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
<style>
  :root{ --cream:#F4EAD4; --ink:#1A1410; --ink-soft:#4A4038; --gold:#D4AF37; --gold-deep:#C99A3D;
    --terracotta:#D9714B; --teal:#2B8C86; --line: rgba(26,20,16,0.14); }
  *{box-sizing:border-box;}
  body{ margin:0; background:var(--cream); color:var(--ink); font-family:'Inter',system-ui,sans-serif; font-size:15px; line-height:1.55; }
  h1,h2,h3{font-family:'Anton','Arial Narrow',sans-serif; font-weight:400; text-transform:uppercase; margin:0;}
  a{color:inherit;}
  [hidden]{display:none!important;}
  .wrap{max-width:760px; margin-inline:auto; padding-inline:16px; padding-block:24px 60px;}
  .mono{font-family:'IBM Plex Mono';}
  .stripe{display:flex; height:6px;} .stripe span{flex:1;}
  .stripe span:nth-child(1){background:var(--gold);} .stripe span:nth-child(2){background:#3E6FA6;}
  .stripe span:nth-child(3){background:#E91E8C;} .stripe span:nth-child(4){background:#9C7A4A;}
  nav{display:flex; justify-content:space-between; align-items:center; padding-block:12px 24px; gap:12px; flex-wrap:wrap;}
  .wordmark{display:flex; align-items:baseline; gap:2px; font-family:'Anton'; font-size:20px; text-transform:uppercase;}
  .wordmark .w1{color:var(--gold-deep);} .wordmark .w2{color:var(--ink);}
  .wordmark small{font-family:'Inter'; font-style:italic; font-weight:500; font-size:10.5px; color:var(--ink-soft); text-transform:none; margin-left:8px;}
  nav a.back{font-size:13px; font-weight:600; text-decoration:none; color:var(--ink-soft);}
  .head{display:flex; justify-content:space-between; align-items:flex-end; gap:12px; flex-wrap:wrap; margin-bottom:18px;}
  .head h1{font-size:1.9rem; line-height:1;}
  .appid{font-family:'IBM Plex Mono'; font-size:11px; color:var(--ink-soft);}

  .journey{display:grid; grid-template-columns:repeat(6,1fr); gap:4px; margin-bottom:22px;}
  .jstep{font-size:10.5px; font-weight:700; text-transform:uppercase; letter-spacing:0.03em; color:var(--ink-soft);}
  .jstep i{display:block; height:5px; background:var(--line); margin-bottom:6px;}
  .jstep.done i{background:var(--ink);} .jstep.current i{background:var(--terracotta);}
  .jstep.current{color:var(--ink);}
  @media (max-width:560px){ .jstep span{display:none;} .jstep.current span{display:block;} }

  .next{border:2px solid var(--ink); background:var(--ink); color:var(--cream); padding:22px; margin-bottom:24px;}
  .next h2{font-size:1.35rem; margin-bottom:8px; color:var(--cream);}
  .next p{margin:0 0 10px; font-size:14px; color:rgba(244,234,212,0.9);}
  .next p:last-child{margin-bottom:0;}
  .next .big{font-family:'Anton'; font-size:2.2rem; line-height:1; color:var(--gold);}
  .next .bar{height:6px; background:rgba(244,234,212,0.2); margin:12px 0;}
  .next .bar i{display:block; height:100%; background:var(--gold);}
  .pulse{display:inline-block; width:9px; height:9px; border-radius:50%; background:var(--gold); margin-right:8px; animation:pulse 1.2s ease-in-out infinite;}
  @keyframes pulse{0%,100%{opacity:.25}50%{opacity:1}}

  .panel{border:2px solid var(--ink); padding:20px; margin-top:20px; background:var(--cream);}
  .panel h2{font-size:1.25rem; margin-bottom:12px;}
  .tag{font-family:'Inter'; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.04em; color:var(--terracotta); border:1.5px solid var(--terracotta); padding:3px 8px; margin-left:8px; vertical-align:middle;}
  .tag.ok{color:var(--teal); border-color:var(--teal);}
  .note{font-size:12.5px; color:var(--ink-soft); line-height:1.5;}
  .sub-h{font-size:11.5px; font-weight:700; text-transform:uppercase; letter-spacing:0.03em; color:var(--ink-soft); margin:18px 0 8px;}

  .forecast-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin:6px 0 14px;}
  @media (max-width:560px){ .forecast-grid{grid-template-columns:1fr;} }
  .fcell{border:1.5px solid var(--line); padding:12px;}
  .fcell .l{font-size:10.5px; font-weight:700; text-transform:uppercase; color:var(--ink-soft);}
  .fcell .v{font-family:'IBM Plex Mono'; font-size:1.15rem; font-weight:700; margin-top:4px;}
  table.months{width:100%; border-collapse:collapse; font-size:12.5px;}
  table.months th, table.months td{border-bottom:1px solid var(--line); padding:7px 6px; text-align:right;}
  table.months th:first-child, table.months td:first-child{text-align:left;}
  table.months th{font-size:10.5px; text-transform:uppercase; color:var(--ink-soft);}
  .scroll{overflow-x:auto;}
  dl.why{margin:0; font-size:13px;}
  dl.why dt{font-weight:700; margin-top:10px;} dl.why dd{margin:2px 0 0; color:var(--ink-soft);}

  .ref-card{border:1.5px solid var(--line); padding:12px 14px; margin-bottom:10px;}
  .ref-name{font-weight:700; font-size:13.5px;}
  .ref-url{font-family:'IBM Plex Mono'; font-size:10.5px; color:var(--ink-soft); margin:2px 0 6px; word-break:break-all;}
  .ref-note{font-size:12.5px; color:var(--ink-soft);}
  .swatches{display:flex; gap:10px; flex-wrap:wrap; margin:6px 0 10px;}
  .swatch{width:76px;} .swatch .chip{height:44px; border:1.5px solid var(--ink);}
  .swatch .hex{font-family:'IBM Plex Mono'; font-size:10px; margin-top:4px; text-align:center;}
  .swatch .name{font-size:9px; color:var(--ink-soft); text-align:center; text-transform:uppercase; font-weight:700;}
  ul.plain{margin:0; padding-left:18px; font-size:13px;} ul.plain li{margin-bottom:6px;}
  .option{border:2px solid var(--ink); background:#fff; padding:16px; margin-top:12px;}
  .opt-head{display:flex; justify-content:space-between; align-items:flex-start; gap:12px;}
  .opt-name{font-family:'Anton'; font-size:1.3rem; text-transform:uppercase; line-height:1.05;}
  .mini-swatches{display:flex; flex:none;} .mini-swatches span{width:22px; height:22px; border:1.5px solid var(--ink); margin-left:-1.5px;}

  .terms{border-collapse:collapse; width:100%; font-size:13px;}
  .terms td{border-bottom:1px solid var(--line); padding:9px 6px; vertical-align:top;}
  .terms td:first-child{font-weight:700; width:32%;}
  form.stack label{display:block; font-size:11.5px; font-weight:700; text-transform:uppercase; letter-spacing:0.04em; color:var(--ink-soft); margin:14px 0 6px;}
  form.stack input[type=text], form.stack select, form.stack textarea{width:100%; border:1.5px solid var(--ink); background:#fff; padding:10px 12px; font-family:'Inter'; font-size:14px; color:var(--ink); border-radius:0;}
  form.stack textarea{min-height:76px; resize:vertical;}
  .hint{font-size:11.5px; color:var(--ink-soft); margin-top:4px;}
  .check{display:flex; gap:10px; align-items:flex-start; font-size:13.5px; font-weight:600; margin-top:14px;}
  .check input{margin-top:4px;}
  .btn{display:inline-block; border:2px solid var(--ink); background:var(--ink); color:var(--cream); padding:11px 18px; font-family:'Inter'; font-weight:700; font-size:14px; cursor:pointer; text-decoration:none; margin-top:14px;}
  .btn.light{background:var(--cream); color:var(--ink);}
  .btn:disabled{opacity:.5; cursor:wait;}
  .msg{font-size:12.5px; color:var(--terracotta); font-weight:600; margin-top:8px; min-height:1em;}
  .upi{border:1.5px dashed var(--ink); padding:14px; margin-top:10px; font-size:13.5px;}
  .upi b{font-family:'IBM Plex Mono';}

  details.sec{border:1.5px solid var(--ink); margin-top:10px; background:#fff;}
  details.sec summary{cursor:pointer; padding:12px 14px; font-weight:700; font-size:14px; list-style:none; display:flex; justify-content:space-between; gap:10px;}
  details.sec summary::-webkit-details-marker{display:none;}
  details.sec .body{padding:0 14px 14px;}
  details.sec .state{font-family:'IBM Plex Mono'; font-size:10.5px; font-weight:700; text-transform:uppercase; color:var(--ink-soft);}
  details.sec.done .state{color:var(--teal);}
  details.sec.next-up{border-color:var(--terracotta); border-width:2px;}
  .answers{font-size:12.5px; color:var(--ink-soft); margin:0 0 6px;} .answers b{color:var(--ink);}

  .split-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:18px;}
  @media (max-width:640px){ .split-grid{grid-template-columns:1fr;} }
  .split-col h3{font-family:'Inter'; font-size:11.5px; font-weight:700; letter-spacing:0.03em; color:var(--ink-soft); margin-bottom:8px;}

  .pipeline{display:flex; flex-direction:column; border:1.5px solid var(--line); margin-top:8px;}
  .prow{display:flex; align-items:center; gap:12px; padding:10px 12px; border-bottom:1px solid var(--line); font-size:13px;}
  .prow:last-child{border-bottom:none;}
  .badge{font-family:'IBM Plex Mono'; font-size:9.5px; font-weight:700; text-transform:uppercase; padding:3px 8px; border:1.5px solid var(--line); min-width:74px; text-align:center; flex:none;}
  .badge.done{background:var(--ink); color:var(--cream); border-color:var(--ink);} .badge.skipped{color:var(--line);}
  .daybar{display:grid; grid-template-columns:repeat(8,1fr); gap:4px; margin:10px 0 14px;}
  .dcell{border:1.5px solid var(--line); padding:6px 4px; text-align:center; font-size:10.5px; line-height:1.3;}
  .dcell b{display:block; font-family:'IBM Plex Mono'; font-size:12px;} .dcell span{color:var(--ink-soft);}
  .dcell.past{background:rgba(26,20,16,0.06);} .dcell.now{background:var(--gold); border-color:var(--ink);}
  details.ck{border:1.5px solid var(--line); border-bottom:none;} details.ck:last-of-type{border-bottom:1.5px solid var(--line);}
  details.ck summary{display:flex; align-items:center; gap:12px; padding:11px 12px; cursor:pointer; list-style:none; font-size:13.5px;}
  details.ck summary::-webkit-details-marker{display:none;}
  details.ck[open] summary{background:rgba(212,175,55,0.18);}
  .ck-label{font-weight:700; flex:1;} .ck-day{font-family:'IBM Plex Mono'; font-size:11px; color:var(--ink-soft); white-space:nowrap;}
  .ck-body{padding:4px 14px 14px; font-size:13.5px;}
  .ck-split{display:grid; grid-template-columns:1fr 1fr; gap:16px;} .ck-split p{margin:0;} .ck-split .sub-h{margin-top:10px;}
  .qlist{padding-left:18px; margin:8px 0 0;} .qlist > li{margin-bottom:8px;} .qlist ul{margin:4px 0 0; padding-left:16px; color:var(--ink-soft); font-size:12.5px;}
  .edit-form{margin-top:14px; border-top:2px solid var(--ink); padding-top:6px;}
  .edit-grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:10px;}
  .edit-grid label{display:flex; flex-direction:column; gap:4px; font-size:11px; font-weight:700; text-transform:uppercase; color:var(--ink-soft);}
  .edit-grid input, .edit-grid select{border:1.5px solid var(--ink); padding:7px; font-size:13px; font-family:'Inter'; text-transform:none; color:var(--ink); background:#fff;}
  @media (max-width:560px){ .ck-split{grid-template-columns:1fr;} .ck-day{display:none;} .daybar span{display:none;} }
  .pnote{font-size:11.5px; color:var(--ink-soft);}

  .notfound{padding-block:60px; text-align:center;}
  .notfound p{color:var(--ink-soft); max-width:44ch; margin:14px auto 0;}
  .lookup{margin-top:32px; padding-top:28px; border-top:1.5px solid var(--line);}
  .lookup form{display:flex; gap:8px; justify-content:center; flex-wrap:wrap;}
  .lookup input{border:1.5px solid var(--ink); padding:10px 12px; font-size:13.5px; min-width:220px;}
  .lookup button{border:2px solid var(--ink); background:var(--ink); color:var(--cream); padding:10px 16px; font-weight:700; cursor:pointer;}
  footer{padding-block:24px; text-align:center;}
  footer p{margin:0; font-size:10.5px; font-weight:700; letter-spacing:0.03em; color:var(--ink-soft);}
</style>
</head>
<body>
<div class="stripe"><span></span><span></span><span></span><span></span></div>
<div class="wrap">
  <nav>
    <div class="wordmark"><span class="w1">Dev</span><span class="w2">Shop</span><small>Retail OS™</small></div>
    <a class="back" href="/retail-os">← About Retail OS</a>
  </nav>

  {app && step ? (
    <>
      <div class="head">
        <h1>{app.brand_name}</h1>
        <span class="appid">{app.id.slice(0, 8).toUpperCase()} · applied {new Date(app.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
      </div>

      <div class="journey">
        {JOURNEY.map((j, i) => (
          <div class={`jstep ${i < currentIndex ? 'done' : i === currentIndex ? 'current' : ''}`}><i></i><span>{j.label}</span></div>
        ))}
      </div>

      {/* ── The one thing to do now ── */}
      {step === 'preparing' && (
        <div class="next" id="prepCard">
          <h2>{prepFailed ? 'Your forecast is being finished by hand' : 'Preparing your forecast and design direction'}</h2>
          {prepFailed ? (
            <p>Part of the research needs a closer look, so Virat is completing it himself. You'll get an email when it's on this page.</p>
          ) : (
            <>
              <p><span class="pulse"></span><span id="prepMsg">Researching your category, competitors and target cities. This takes about 2–3 minutes; keep this page open.</span></p>
              <p>You'll see a provisional quarterly P&amp;L for your brand and a proposed look for your store, before anything is signed.</p>
            </>
          )}
        </div>
      )}
      {step === 'review' && (
        <div class="next">
          <h2>Your forecast and design direction are ready</h2>
          <p>Have a look below. Next, Virat walks you through the plan and sends your terms to this page for signature, usually within the week.</p>
          <a class="btn light" href={`mailto:viratmohan@gmail.com?subject=${encodeURIComponent(`Retail OS: ${app.brand_name}`)}`}>Talk it through with Virat →</a>
        </div>
      )}
      {step === 'sign' && (
        <div class="next">
          <h2>Your terms are ready to sign</h2>
          <p>Read them below, then sign by typing your full name. Next comes the ₹{DEPOSIT_INR.toLocaleString('en-IN')} deposit, and your {BUILD_WINDOW_DAYS}-day build starts once it's confirmed.</p>
          <a class="btn light" href="#terms">Review and sign →</a>
        </div>
      )}
      {step === 'deposit' && (
        <div class="next">
          <h2>Pay the ₹{DEPOSIT_INR.toLocaleString('en-IN')} deposit</h2>
          <p>It's fully adjusted against your actual onboarding tech costs; DevShop keeps none of it. Your {BUILD_WINDOW_DAYS}-day build starts the moment it's confirmed.</p>
          <a class="btn light" href="#deposit">Pay the deposit →</a>
        </div>
      )}
      {step === 'confirming' && (
        <div class="next">
          <h2>Confirming your deposit</h2>
          <p>We're matching reference <span class="mono">{app.deposit?.utr}</span> against our bank statement, usually within one working day. Start the setup questions below meanwhile: the more you answer now, the faster the build.</p>
        </div>
      )}
      {step === 'building' && targetDate && (
        <div class="next">
          <h2>Your store is being built</h2>
          <div class="big">Day {buildDay} of {BUILD_WINDOW_DAYS}</div>
          <div class="bar"><i style={`width:${Math.round((buildDay / BUILD_WINDOW_DAYS) * 100)}%`}></i></div>
          <p>Target go-live: <b>{fmtDate(targetDate)}</b>. {answeredCount < sections.length ? `${sections.length - answeredCount} setup ${sections.length - answeredCount === 1 ? 'section is' : 'sections are'} still waiting on you below.` : 'All setup questions answered, thank you.'}</p>
        </div>
      )}
      {step === 'live' && (
        <div class="next">
          <h2>You're live</h2>
          <p>Your store is public and selling. Settlement statements arrive every Monday.</p>
        </div>
      )}

      {editMode && (
        <div class="panel" id="controls" style="border-color:var(--terracotta);">
          <h2>Virat's controls <span class="tag">Admin only</span></h2>
          <p class="note" style="margin-top:0;">Emails go to <b>{app.founder_email}</b>. To use their official email, change it under Checklist → Application → Edit answers.</p>

          <div class="sub-h">1. Send terms</div>
          {app.agreement ? <p class="note">Signed by {app.agreement.signedName}.</p> : (
            <form class="stack" id="sendTermsForm">
              <div class="edit-grid">
                {!app.ai_enabler_track && <label>DevShop share of profit pool (%)<input type="number" step="0.5" name="splitPct" value={app.terms?.splitPct ?? splitNow ?? ''} /></label>}
                <label style="grid-column:1/-1;">Anything else agreed (optional)<input type="text" name="notes" value={app.terms?.notes ?? ''} /></label>
              </div>
              <button type="submit" class="btn">{app.terms ? 'Update terms' : 'Send terms to this page'}</button>
              <div class="msg" id="sendTermsMsg"></div>
            </form>
          )}

          <div class="sub-h">2. Deposit</div>
          {app.deposit?.confirmedAt ? <p class="note">Confirmed. Build started.</p> : !app.agreement ? <p class="note">Available once the terms are signed.</p> : (
            <form class="stack" id="markPaidForm">
              <div class="edit-grid"><label>Payment reference (UTR, or "cash")<input type="text" name="reference" placeholder="Collected in the meeting" /></label></div>
              <button type="submit" class="btn">Mark ₹{DEPOSIT_INR.toLocaleString('en-IN')} paid and email {app.founder_email}</button>
              <div class="msg" id="markPaidMsg"></div>
            </form>
          )}

          <div class="sub-h">3. Terms document</div>
          <p class="note"><a href={`/retail-os/terms/${app.id}`} target="_blank">Open {app.brand_name}'s terms as PDF →</a></p>
        </div>
      )}

      {/* ── Setup questions, one section at a time ── */}
      {app.agreement && sections.length > 0 && (
        <div class="panel" id="setup">
          <h2>Setup questions <span class={`tag ${answeredCount === sections.length ? 'ok' : ''}`}>{answeredCount} of {sections.length} done</span></h2>
          <p class="note">One section at a time. Never enter passwords, API keys or card details here: where we need access to an account, we request it through the provider.</p>
          {sections.map((s) => {
            const saved = answered[s.key];
            return (
              <details class={`sec ${saved ? 'done' : ''} ${s.key === firstOpen ? 'next-up' : ''}`} open={s.key === firstOpen}>
                <summary><span>{s.title}</span><span class="state">{saved ? 'Done ✓' : s.key === firstOpen ? 'Next' : 'To do'}</span></summary>
                <div class="body">
                  <p class="note" style="margin-top:0;">{s.why}</p>
                  <form class="stack setup-form" data-section={s.key}>
                    {s.fields.map((f) => (
                      <>
                        <label for={`${s.key}-${f.key}`}>{f.label}</label>
                        {f.type === 'select' ? (
                          <select id={`${s.key}-${f.key}`} name={f.key}>
                            <option value="">Select…</option>
                            {f.options!.map((o) => <option value={o} selected={saved?.answers[f.key] === o}>{o}</option>)}
                          </select>
                        ) : f.type === 'textarea' ? (
                          <textarea id={`${s.key}-${f.key}`} name={f.key} placeholder={f.placeholder}>{saved?.answers[f.key] ?? ''}</textarea>
                        ) : (
                          <input type="text" id={`${s.key}-${f.key}`} name={f.key} placeholder={f.placeholder} value={saved?.answers[f.key] ?? ''} />
                        )}
                        {f.hint && <div class="hint">{f.hint}</div>}
                      </>
                    ))}
                    <button type="submit" class="btn">{saved ? 'Update' : 'Save and continue'}</button>
                    <div class="msg"></div>
                  </form>
                </div>
              </details>
            );
          })}
        </div>
      )}

      {/* ── Terms and signature ── */}
      {app.terms && (
        <div class="panel" id="terms">
          <h2>Your commercial terms {app.agreement ? <span class="tag ok">Signed</span> : <span class="tag">Awaiting your signature</span>}</h2>
          <table class="terms">
            {termLines.map((l) => <tr><td>{l.label}</td><td>{l.value}</td></tr>)}
          </table>
          <p class="note" style="margin-top:8px;"><a href={`/retail-os/terms/${app.id}`} target="_blank">View or save these terms as a PDF →</a></p>
          {app.agreement ? (
            <p class="note" style="margin-top:12px;">Signed by <b>{app.agreement.signedName}</b> on {new Date(app.agreement.signedAt).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' })} IST. A copy was emailed to you.</p>
          ) : (
            <form class="stack" id="signForm">
              <p class="note" style="margin-top:14px;">These terms form part of the DevShop Retail OS partnership agreement between you and DevShop. Your typed name, the time, and your device and IP address are recorded as your signature.</p>
              <label for="signedName">Your full legal name</label>
              <input type="text" id="signedName" autocomplete="name" required />
              <label class="check" style="text-transform:none; letter-spacing:0; font-size:13.5px; color:var(--ink);"><input type="checkbox" id="accept" /> <span>I have read and accept these terms on behalf of {app.brand_name}.</span></label>
              <label class="check" style="text-transform:none; letter-spacing:0; font-size:13.5px; color:var(--ink);"><input type="checkbox" id="portfolioConsent" /> <span>I agree DevShop may reference {app.brand_name}'s name, logo and results as part of its own portfolio and marketing communications.</span></label>
              <button type="submit" class="btn">Sign terms</button>
              <div class="msg" id="signMsg"></div>
            </form>
          )}
        </div>
      )}

      {/* ── Deposit ── */}
      {app.agreement && (
        <div class="panel" id="deposit">
          <h2>Deposit {app.deposit?.confirmedAt ? <span class="tag ok">Confirmed</span> : app.deposit ? <span class="tag">Being confirmed</span> : <span class="tag">Due</span>}</h2>
          <p class="note" style="margin-top:0;">₹{DEPOSIT_INR.toLocaleString('en-IN')}, fully adjusted against your actual onboarding tech costs (hosting, database, WhatsApp number, email, domain and AI). DevShop keeps none of it; every charge against it will be listed here.</p>
          {app.deposit ? (
            <p class="note">Reported {new Date(app.deposit.submittedAt).toLocaleDateString('en-IN')} with reference <span class="mono">{app.deposit.utr}</span>{app.deposit.confirmedAt ? `, confirmed ${new Date(app.deposit.confirmedAt).toLocaleDateString('en-IN')}.` : '.'}</p>
          ) : (
            <>
              {env.RETAIL_OS_UPI_ID || qrUrl ? (
                <div class="upi">
                  <div><b>1.</b> Pay <b>₹{DEPOSIT_INR.toLocaleString('en-IN')}</b> by UPI{env.RETAIL_OS_UPI_ID && <> to <b>{env.RETAIL_OS_UPI_ID}</b></>}{env.RETAIL_OS_UPI_PAYEE && <> ({env.RETAIL_OS_UPI_PAYEE})</>}: scan the code, or tap the button on your phone.</div>
                  {qrUrl && <img src={qrUrl} alt="DevShop UPI QR code" width="200" height="200" style="display:block; margin:12px 0; border:1.5px solid var(--ink); background:#fff;" />}
                  {upiLink && <a class="btn light" href={upiLink}>Open my UPI app →</a>}
                  {waLink && (
                    <div style="margin-top:14px;"><b>2.</b> Send the payment screenshot on WhatsApp so we can confirm it quickly.<br /><a class="btn light" href={waLink} target="_blank" rel="noopener noreferrer">Send screenshot on WhatsApp →</a></div>
                  )}
                  <div style="margin-top:14px;"><b>{waLink ? '3.' : '2.'}</b> Enter the reference number below.</div>
                </div>
              ) : (
                <div class="upi">Payment details for the deposit are sent to you by email once your terms are signed.</div>
              )}
              <form class="stack" id="depositForm">
                <label for="utr">UPI reference number (UTR) after paying</label>
                <input type="text" id="utr" placeholder="12-digit number from your UPI app" inputmode="numeric" />
                <button type="submit" class="btn">I've paid</button>
                <div class="msg" id="depositMsg"></div>
              </form>
            </>
          )}
        </div>
      )}

      {/* ── Forecast ── */}
      {plan && (
        <div class="panel" id="forecast">
          <h2>Quarterly forecast <span class="tag">Provisional</span></h2>
          <div class="forecast-grid">
            <div class="fcell"><div class="l">3-month revenue</div><div class="v">{inr(plan.quarter_totals.revenueInr)}</div></div>
            <div class="fcell"><div class="l">3-month profit pool</div><div class="v">{inr(plan.quarter_totals.profitPoolInr)}</div></div>
            <div class="fcell"><div class="l">Your share</div><div class="v">{inr(plan.quarter_totals.founderShareInr)}</div></div>
          </div>
          <p class="note" style="margin-top:8px;">{perDay(plan.drivers.ordersM1)} → {perDay(plan.drivers.ordersM3)} orders a day over the quarter. {splitNow != null && !app.ai_enabler_track && <>Profit pool split: <b>DevShop {splitNow}% · {app.brand_name} {Math.round((100 - splitNow) * 10) / 10}%</b>.</>} <a href="#checklist">See the full plan ↓</a></p>
          {app.agreement ? (<>
          <div class="scroll">
            <table class="months">
              <tr><th>Month</th><th>Orders/day</th><th>Orders</th><th>Revenue</th><th>Profit pool</th><th>Your share</th></tr>
              {plan.months.map((m) => <tr><td>{m.label}</td><td>{perDay(m.orders)}</td><td>{m.orders.toLocaleString('en-IN')}</td><td>{inr(m.revenueInr)}</td><td>{inr(m.profitPoolInr)}</td><td>{inr(m.founderShareInr)}</td></tr>)}
            </table>
          </div>
          {planWhy.length > 0 && (
            <>
              <div class="sub-h">How we got these numbers</div>
              <dl class="why">{planWhy.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
            </>
          )}
          <p class="note" style="margin-top:14px;">Built from your answers and researched category and city benchmarks. It gets sharper as your real payment, shipping and ad numbers come in, and once you're live it becomes the benchmark your monthly results are compared with.</p>
          </>) : (
            <p class="note" style="margin-top:4px;">A first estimate from your answers and category research. Virat walks you through the full plan before you sign.</p>
          )}
        </div>
      )}

      {/* ── Design directions: the brand chooses one ── */}
      {design && (
        <div class="panel" id="design">
          <h2>{designs.length > 1 ? 'Design directions' : 'Design direction'} {chosenDesign ? <span class="tag ok">Chosen</span> : designs.length > 1 ? <span class="tag">Choose one</span> : <span class="tag">Proposed</span>}</h2>
          <p class="note" style="margin-top:0;">
            {design.has_existing_site
              ? 'Built from your existing look, and two bolder alternatives. Each is based on a real, successful brand in or near your category.'
              : 'Each starts from a real, successful brand in or near your category that is worth building on.'}
            {designs.length > 1 && !chosenDesign && ' Pick the one that feels most like your brand; we refine it with you during the build.'}
          </p>
          {designs.map((o, i) => {
            const isChosen = o.chosen;
            const full = !!app.agreement && (isChosen || designs.length === 1);
            return (
              <div class="option" style={isChosen ? 'border-color:var(--teal); border-width:3px;' : ''}>
                <div class="opt-head">
                  <div>
                    <div class="sub-h" style="margin:0 0 4px;">Option {i + 1}{isChosen ? ' · your choice' : ''}</div>
                    <div class="opt-name">{o.option_name ?? 'Your design direction'}</div>
                  </div>
                  <div class="mini-swatches">
                    {[o.color_palette.primaryHex, o.color_palette.secondaryHex, o.color_palette.accentHex, o.color_palette.backgroundHex, o.color_palette.textHex].map((hex) => <span style={`background:${hex}`}></span>)}
                  </div>
                </div>
                {o.option_summary && <p style="margin:8px 0 0; font-size:14px;">{o.option_summary}</p>}
                <p class="note" style="margin:10px 0 0;"><b>Based on:</b> {o.primary_reference.url ? <a href={o.primary_reference.url} target="_blank" rel="noopener noreferrer">{o.primary_reference.name}</a> : o.primary_reference.name} · <b>Fonts:</b> {o.typography.headingFont} / {o.typography.bodyFont}</p>
                <ul class="plain" style="margin-top:10px;">{(full ? o.ux_principles : o.ux_principles.slice(0, 3)).map((p) => <li>{p}</li>)}</ul>
                {full && (
                  <>
                    <p class="note" style="margin-top:6px;">{o.primary_reference.note}</p>
                    {o.additional_references.length > 0 && <p class="note"><b>Also drawing from:</b> {o.additional_references.map((r) => r.name).join(', ')}</p>}
                    <p class="note"><b>Tone of voice:</b> {o.tone_of_voice}</p>
                  </>
                )}
                {designs.length > 1 && !app.build_started_at && (
                  isChosen
                    ? <p class="note" style="margin-top:10px; color:var(--teal); font-weight:700;">Chosen ✓</p>
                    : <button type="button" class="btn light choose-design" data-design={o.id}>Choose this direction</button>
                )}
              </div>
            );
          })}
          <div class="msg" id="designMsg"></div>
          {chosenDesign && !app.agreement && (
            <p class="note" style="margin-top:14px;"><b>Next:</b> review and sign the commercial terms below to start the 7-day build.</p>
          )}
        </div>
      )}

      {/* ── Who handles what ── */}
      <div class="panel">
        <h2>Who handles what</h2>
        <div class="split-grid">
          <div class="split-col">
            <h3>DevShop</h3>
            <ul class="plain">
              <li>Storefront build, hosting and maintenance</li>
              <li>Payments, shipping, Meta, WhatsApp and Google set up and run</li>
              <li>Pricing, fixed with you per product</li>
              <li>Performance marketing and content</li>
              <li>Weekly settlement and your P&amp;L against the plan</li>
            </ul>
          </div>
          <div class="split-col">
            <h3>You</h3>
            <ul class="plain">
              <li>Product sourcing, manufacturing and inventory</li>
              <li>Packing orders and handing them to the courier</li>
              <li>Product photos, unless we agree otherwise</li>
              <li>Answering the setup questions on this page</li>
            </ul>
          </div>
          <div class="split-col">
            <h3>Decided together</h3>
            <ul class="plain">
              <li>Discount and promotion rules</li>
              <li>Any freelancers we hire, and what they cost</li>
            </ul>
          </div>
        </div>
      </div>

      {/* ── Detailed checklist ── */}
      <div class="panel" id="checklist">
        <h2>Checklist <span class="tag">{doneCount} of {checklist.length} done</span></h2>
        <p class="note" style="margin-top:0;">Day 0 is {dayDate(0)}, the day you applied. Target go-live: <b>{fmtDate(goLiveTarget)}</b> (day {BUILD_WINDOW_DAYS}). Today is day {Math.min(today, 99)}. Tap any step to see the detail.</p>
        <div class="daybar">
          {Array.from({ length: BUILD_WINDOW_DAYS + 1 }, (_, n) => (
            <div class={`dcell ${n < today ? 'past' : n === today ? 'now' : ''}`}><b>D{n}</b><span>{dayDate(n).split(' ').slice(1).join(' ')}</span></div>
          ))}
        </div>
        {checklist.map((c) => {
          const late = c.status === 'pending' && today > c.day[1];
          return (
            <details class={`ck ${c.status}`}>
              <summary>
                <span class={`badge ${c.status}`}>{c.status === 'done' ? 'Done' : c.status === 'skipped' ? 'Not needed' : late ? 'Due' : 'Pending'}</span>
                <span class="ck-label">{c.label}</span>
                <span class="ck-day">{c.day[0] === c.day[1] ? `Day ${c.day[0]}` : `Days ${c.day[0]}–${c.day[1]}`} · {c.owner}</span>
              </summary>
              <div class="ck-body">
                <div class="ck-split">
                  <div><div class="sub-h">DevShop does</div><p>{c.we}</p></div>
                  <div><div class="sub-h">You do</div><p>{c.you}</p></div>
                </div>

                {c.detail === 'application' && (
                  <table class="terms">{fields.filter((f) => f.shown).map((f) => <tr><td>{f.label}</td><td>{f.shown}{f.explain && <div class="pnote">{f.explain}</div>}</td></tr>)}</table>
                )}
                {c.detail === 'application' && editMode && (
                  <form class="stack edit-form" id="appEditForm">
                    <div class="sub-h">Edit answers</div>
                    <div class="edit-grid">
                      {fields.map((f) => (
                        <label>{f.label}
                          {f.options
                            ? <select name={f.key}><option value="">—</option>{f.options.map(([v, l]) => <option value={v} selected={f.raw === v}>{l}</option>)}</select>
                            : <input type="text" name={f.key} value={f.raw} />}
                        </label>
                      ))}
                    </div>
                    <button type="submit" class="btn">Save answers</button>
                    <div class="msg" id="appEditMsg"></div>
                  </form>
                )}

                {c.detail === 'plan' && plan && (
                  <>
                    <table class="terms">
                      <tr><td>Orders per day</td><td>{perDay(plan.drivers.ordersM1)} · {perDay(plan.drivers.ordersM2)} · {perDay(plan.drivers.ordersM3)}<div class="pnote">Months 1–3; that's {plan.drivers.ordersM1.toLocaleString('en-IN')} · {plan.drivers.ordersM2.toLocaleString('en-IN')} · {plan.drivers.ordersM3.toLocaleString('en-IN')} orders a month (30-day months).</div></td></tr>
                      <tr><td>Average order value</td><td>{inr(plan.drivers.aovInr)}</td></tr>
                      <tr><td>Product cost</td><td>{plan.drivers.cogsPct}% of revenue</td></tr>
                      <tr><td>Marketing (online + offline)</td><td>{plan.drivers.cacPct}% of revenue</td></tr>
                      <tr><td>Admin and other costs</td><td>{plan.quarter_totals.revenueInr ? Math.round(((plan.quarter_totals.adminTechInr + plan.quarter_totals.operatingExpensesInr) / plan.quarter_totals.revenueInr) * 1000) / 10 : 0}% of revenue (fees, shipping, packing, returns, platform)</td></tr>
                      <tr><td>3-month revenue</td><td>{inr(plan.quarter_totals.revenueInr)}</td></tr>
                      <tr><td>3-month profit pool</td><td>{inr(plan.quarter_totals.profitPoolInr)}</td></tr>
                      {splitNow != null && !app.ai_enabler_track && <tr><td>Profit pool split</td><td>DevShop {splitNow}% ({inr(plan.quarter_totals.devshopShareInr)}) · {app.brand_name} {Math.round((100 - splitNow) * 10) / 10}% ({inr(plan.quarter_totals.founderShareInr)})</td></tr>}
                    </table>
                    {editMode && (
                      <form class="stack edit-form" id="planEditForm" data-plan={plan.id}>
                        <div class="sub-h">Edit forecast</div>
                        <div class="edit-grid">
                          <label>Orders/day, month 1<input type="number" step="0.1" name="perDay1" value={perDay(plan.drivers.ordersM1)} /></label>
                          <label>Orders/day, month 2<input type="number" step="0.1" name="perDay2" value={perDay(plan.drivers.ordersM2)} /></label>
                          <label>Orders/day, month 3<input type="number" step="0.1" name="perDay3" value={perDay(plan.drivers.ordersM3)} /></label>
                          <label>Average order value (₹)<input type="number" name="aovInr" value={plan.drivers.aovInr} /></label>
                          <label>Product cost (% of revenue)<input type="number" step="0.1" name="cogsPct" value={plan.drivers.cogsPct} /></label>
                          <label>Marketing (% of revenue)<input type="number" step="0.1" name="cacPct" value={plan.drivers.cacPct} /></label>
                          <label>Admin & tech (% of revenue)<input type="number" step="0.1" name="adminTechPct" value={plan.drivers.adminTechPct} /></label>
                          {!app.ai_enabler_track && <label>DevShop share of profit pool (%)<input type="number" step="0.5" name="splitPct" value={splitNow ?? ''} /></label>}
                          <label>COD share of orders (%)<input type="number" step="0.1" name="codOrderSharePct" value={plan.drivers.codOrderSharePct} /></label>
                          <label>Gateway fee (% of prepaid)<input type="number" step="0.01" name="paymentGatewayFeePct" value={plan.drivers.paymentGatewayFeePct} /></label>
                          <label>COD fee (% of COD)<input type="number" step="0.01" name="codHandlingFeePct" value={plan.drivers.codHandlingFeePct} /></label>
                          <label>RTO rate (% of COD)<input type="number" step="0.1" name="rtoRatePct" value={plan.drivers.rtoRatePct} /></label>
                          <label>RTO cost per order (₹)<input type="number" name="rtoCostPerOrderInr" value={plan.drivers.rtoCostPerOrderInr} /></label>
                          <label>Shipping per order (₹)<input type="number" name="shippingCostPerOrderInr" value={plan.drivers.shippingCostPerOrderInr} /></label>
                          <label>Packaging per order (₹)<input type="number" name="packagingCostPerOrderInr" value={plan.drivers.packagingCostPerOrderInr} /></label>
                          <label>Platform & tools (₹/month)<input type="number" name="platformToolsFixedInrPerMonth" value={plan.drivers.platformToolsFixedInrPerMonth} /></label>
                          <input type="hidden" name="postBarterFeePct" value={plan.drivers.postBarterFeePct} />
                        </div>
                        <p class="note">Saving locks these numbers in: the automatic 25/25/10 strategy won't change them again.</p>
                        <button type="submit" class="btn">Save forecast</button>
                        <div class="msg" id="planEditMsg"></div>
                      </form>
                    )}
                    {plan.assumptions.length > 0 && (
                      <>
                        <div class="sub-h" style="margin-top:12px;">Assumptions</div>
                        <ul class="plain">{plan.assumptions.map((a) => <li><b>{a.label}:</b> {a.value}{a.rationale && <span class="pnote"> — {a.rationale}</span>}</li>)}</ul>
                      </>
                    )}
                    <p class="note">Any number can be changed with Virat and locked in before signing.</p>
                  </>
                )}
                {c.detail === 'plan' && !plan && <p class="note">Being prepared.</p>}

                {c.detail === 'design' && (
                  <p class="note">{chosenDesign ? <>Chosen: <b>{chosenDesign.option_name}</b>, based on {chosenDesign.primary_reference.name}.</> : designs.length ? <>{designs.length} directions proposed: {designs.map((o) => o.option_name).join(', ')}. <a href="#design">Choose one ↑</a></> : 'Being prepared.'}</p>
                )}

                {c.detail === 'terms' && (
                  <>
                    {termLines.length > 0
                      ? <table class="terms">{termLines.map((l) => <tr><td>{l.label}</td><td>{l.value}</td></tr>)}</table>
                      : <p class="note">Sent to this page once the commercial lane and split are agreed with Virat.</p>}
                    <p class="note">Documents: <a href={`/retail-os/terms/${app.id}`} target="_blank"><b>{app.brand_name}'s terms (PDF)</b></a> · <a href="/retail-os/docs/DevShop-Retail-OS-NCNDA.docx" download>NCNDA</a> · <a href="/retail-os/docs/DevShop-Retail-OS-Partnership-Terms.docx" download>Partnership terms (summary)</a></p>
                  </>
                )}

                {c.detail === 'deposit' && (
                  <p class="note">{app.deposit?.confirmedAt ? `Confirmed ${new Date(app.deposit.confirmedAt).toLocaleDateString('en-IN')} (ref ${app.deposit.utr}).` : app.deposit ? 'Reported, being confirmed.' : `₹${DEPOSIT_INR.toLocaleString('en-IN')}, fully adjusted against onboarding tech costs. Due once terms are signed.`}</p>
                )}

                {c.detail === 'setup' && (
                  <ol class="qlist">
                    {sections.map((s) => (
                      <li>
                        <b>{s.title}</b>{answered[s.key] && <span class="tag ok" style="margin-left:6px;">Answered</span>}
                        <ul>{s.fields.map((f) => <li>{f.label}{answered[s.key]?.answers[f.key] && <> — <span class="mono">{answered[s.key]!.answers[f.key]}</span></>}</li>)}</ul>
                      </li>
                    ))}
                  </ol>
                )}
              </div>
            </details>
          );
        })}
      </div>
    </>
  ) : (
    <div class="notfound">
      <h2>{loadError ? 'Status temporarily unavailable' : "Can't find that application"}</h2>
      <p>{loadError
        ? "There's a hiccup reaching the backend right now. Try again shortly, or email viratmohan@gmail.com."
        : "This link doesn't match an application on file."}</p>
      {!loadError && (
        <div class="lookup">
          <p class="note">Lost your link? Enter the email you applied with:</p>
          <form id="lookupForm">
            <input type="email" id="lookupEmail" placeholder="you@brand.com" required />
            <button type="submit">Resend link →</button>
          </form>
          <p class="msg" id="lookupMsg"></p>
        </div>
      )}
    </div>
  )}
</div>
<footer><p>DEVSHOP RETAIL OS™ — YOUR ONBOARDING, LIVE</p></footer>

<script define:vars={{ appId: app?.id ?? null, autoPrepare: step === 'preparing' && !prepFailed }}>
  function post(url, body) {
    return fetch(url, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body || {}) })
      .then(function (r) { return r.json().catch(function () { return {}; }).then(function (d) { return { ok: r.ok, data: d }; }); });
  }

  // Automatic forecast + design preparation, then poll until both exist.
  if (appId && autoPrepare) {
    var prepMsg = document.getElementById('prepMsg');
    var started = Date.now();
    var poll = function () {
      fetch('/retail-os/api/status/' + appId).then(function (r) { return r.json(); }).then(function (s) {
        if (s.hasPlan && s.hasDesign) return location.reload();
        if (s.prepFailed) return location.reload();
        if (Date.now() - started > 8 * 60 * 1000) {
          if (prepMsg) prepMsg.textContent = 'This is taking longer than usual. Refresh in a few minutes; nothing is lost.';
          return;
        }
        setTimeout(poll, 15000);
      }).catch(function () { setTimeout(poll, 20000); });
    };
    post('/retail-os/api/prepare/' + appId).then(function (res) {
      var st = res.data && res.data.status;
      if (st === 'ready' || st === 'partial' || st === 'failed') return location.reload();
      if (st === 'queued' && prepMsg) prepMsg.textContent = "We're preparing several brands right now. Yours starts shortly; keep this page open or come back in a few minutes.";
      if (st === 'unavailable' && prepMsg) prepMsg.textContent = 'Your forecast is being prepared by hand and will appear here soon.';
      setTimeout(poll, st === 'queued' ? 60000 : 15000);
    }).catch(function () { setTimeout(poll, 20000); });
  }

  var signForm = document.getElementById('signForm');
  if (signForm) {
    signForm.addEventListener('submit', function (e) {
      e.preventDefault();
      var msg = document.getElementById('signMsg');
      var btn = signForm.querySelector('button');
      btn.disabled = true; msg.textContent = 'Signing…';
      post('/retail-os/api/sign/' + appId, {
        signedName: document.getElementById('signedName').value,
        accept: document.getElementById('accept').checked,
        portfolioConsent: document.getElementById('portfolioConsent').checked,
      }).then(function (res) {
        if (res.ok) return location.reload();
        msg.textContent = (res.data && res.data.error) || 'Could not sign. Try again.';
        btn.disabled = false;
      });
    });
  }

  var depositForm = document.getElementById('depositForm');
  if (depositForm) {
    depositForm.addEventListener('submit', function (e) {
      e.preventDefault();
      var msg = document.getElementById('depositMsg');
      var btn = depositForm.querySelector('button');
      btn.disabled = true; msg.textContent = 'Saving…';
      post('/retail-os/api/deposit/' + appId, { utr: document.getElementById('utr').value }).then(function (res) {
        if (res.ok) return location.reload();
        msg.textContent = (res.data && res.data.error) || 'Could not save. Try again.';
        btn.disabled = false;
      });
    });
  }

  document.querySelectorAll('form.setup-form').forEach(function (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var msg = form.querySelector('.msg');
      var btn = form.querySelector('button');
      var answers = {};
      form.querySelectorAll('input, select, textarea').forEach(function (el) { if (el.name) answers[el.name] = el.value; });
      btn.disabled = true; msg.textContent = 'Saving…';
      post('/retail-os/api/setup/' + appId, { section: form.getAttribute('data-section'), answers: answers }).then(function (res) {
        if (res.ok) return location.reload();
        msg.textContent = (res.data && res.data.error) || 'Could not save. Try again.';
        btn.disabled = false;
      });
    });
  });

  var sendTerms = document.getElementById('sendTermsForm');
  if (sendTerms) sendTerms.addEventListener('submit', function (e) {
    e.preventDefault();
    var msg = document.getElementById('sendTermsMsg'); msg.textContent = 'Sending…';
    var split = sendTerms.querySelector('[name="splitPct"]');
    post('/retail-os/api/admin/send-terms', { id: appId, splitPct: split ? split.value : null, notes: sendTerms.querySelector('[name="notes"]').value }).then(function (res) {
      if (res.ok) return location.reload();
      msg.textContent = (res.data && res.data.error) || 'Could not send. Are you logged in to admin?';
    });
  });

  var markPaid = document.getElementById('markPaidForm');
  if (markPaid) markPaid.addEventListener('submit', function (e) {
    e.preventDefault();
    var msg = document.getElementById('markPaidMsg'); msg.textContent = 'Confirming…';
    post('/retail-os/api/admin/mark-deposit-paid', { id: appId, reference: markPaid.querySelector('[name="reference"]').value }).then(function (res) {
      if (res.ok) { msg.textContent = 'Confirmed. Email sent to ' + (res.data.emailedTo || 'the founder') + '.'; return setTimeout(function () { location.reload(); }, 1200); }
      msg.textContent = (res.data && res.data.error) || 'Could not confirm. Are you logged in to admin?';
    });
  });

  var appEdit = document.getElementById('appEditForm');
  if (appEdit) appEdit.addEventListener('submit', function (e) {
    e.preventDefault();
    var msg = document.getElementById('appEditMsg'); msg.textContent = 'Saving…';
    var fields = {};
    appEdit.querySelectorAll('input, select').forEach(function (el) { if (el.name) fields[el.name] = el.value; });
    post('/retail-os/api/admin/update-application', { id: appId, fields: fields }).then(function (res) {
      if (res.ok) return location.reload();
      msg.textContent = (res.data && res.data.error) || 'Could not save. Are you logged in to admin?';
    });
  });

  var planEdit = document.getElementById('planEditForm');
  if (planEdit) planEdit.addEventListener('submit', function (e) {
    e.preventDefault();
    var msg = document.getElementById('planEditMsg'); msg.textContent = 'Saving…';
    var v = {};
    planEdit.querySelectorAll('input').forEach(function (el) { if (el.name) v[el.name] = Number(el.value); });
    v.ordersM1 = Math.round(v.perDay1 * 30); v.ordersM2 = Math.round(v.perDay2 * 30); v.ordersM3 = Math.round(v.perDay3 * 30);
    delete v.perDay1; delete v.perDay2; delete v.perDay3;
    v.planId = planEdit.getAttribute('data-plan'); v.applicationId = appId;
    post('/retail-os/api/admin/update-plan-drivers', v).then(function (res) {
      if (res.ok) return location.reload();
      msg.textContent = (res.data && res.data.error) || 'Could not save. Are you logged in to admin?';
    });
  });

  document.querySelectorAll('button.choose-design').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var msg = document.getElementById('designMsg');
      btn.disabled = true; msg.textContent = 'Saving your choice…';
      post('/retail-os/api/design-choice/' + appId, { designId: btn.getAttribute('data-design') }).then(function (res) {
        if (res.ok) return location.reload();
        msg.textContent = (res.data && res.data.error) || 'Could not save. Try again.';
        btn.disabled = false;
      });
    });
  });

  var lookup = document.getElementById('lookupForm');
  if (lookup) {
    lookup.addEventListener('submit', function (e) {
      e.preventDefault();
      var msg = document.getElementById('lookupMsg');
      msg.textContent = 'Sending…';
      post('/retail-os/api/resend-link', { email: document.getElementById('lookupEmail').value }).finally(function () {
        msg.textContent = "If that email has an application, we've sent the link.";
      });
    });
  }
</script>
</body>
</html>
