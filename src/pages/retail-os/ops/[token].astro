---
export const prerender = false;
import { getEnv } from '../../../lib/env';
import { getOpsDb, planByObjective, doNow, OPS_STATUSES, STATUS_LABEL, PRIORITY_LABEL } from '../../../lib/retail-os-ops';
import type { TeamMember, OpsTask, Objective } from '../../../lib/retail-os-ops';

// A team member's private workbench. One idea per screen: what to do now,
// then the rest grouped by the DevShop objective it serves, in priority
// order. The token is the bearer; there is no login.
const { token } = Astro.params;
const env = getEnv();
let member: TeamMember | null = null;
let tasks: OpsTask[] = [];
let objectives: Objective[] = [];
if (token && env.SUPABASE_URL && env.SUPABASE_SERVICE_ROLE_KEY) {
  const db = getOpsDb(env);
  member = await db.memberByToken(token).catch((err) => { console.error('ops member lookup failed', err); return null; });
  if (member) [tasks, objectives] = await Promise.all([db.listTasks(member.id), db.listObjectives()]);
}
const today = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Kolkata' });
const plan = planByObjective(objectives, tasks);
const now = doNow(tasks);
const open = (t: OpsTask) => t.status !== 'done' && t.status !== 'na';
const waiting = tasks.filter((t) => open(t) && t.owner !== 'team');
const done = tasks.filter((t) => t.status === 'done').length;
const counted = tasks.filter((t) => t.status !== 'na').length;
const day = (d: string) => new Date(`${d}T00:00:00+05:30`).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', timeZone: 'Asia/Kolkata' });
const first = member?.name.split(' ')[0] ?? '';
const WHO: Record<string, string> = { founder: 'Virat', brand: 'Brand' };
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{member ? `${first}'s work` : 'Retail OS'}</title>
<meta name="robots" content="noindex" />
<link rel="stylesheet" href="/brand/tokens.css" />
<style>
  *{box-sizing:border-box;}
  body{font-size:15px; line-height:1.55;}
  .wrap{max-width:720px; margin-inline:auto; padding:28px 16px 120px;}
  h1{font-family:var(--serif); font-weight:400; font-size:2.1rem; line-height:1.15; margin:18px 0 6px;}
  h2{font-family:var(--display); font-weight:400; text-transform:uppercase; letter-spacing:.02em; font-size:1.05rem; margin:0;}
  .lede{color:var(--dim); margin:0 0 28px;}
  .eyebrow{font-size:11px; font-weight:700; letter-spacing:.14em; text-transform:uppercase; color:var(--terracotta); margin:0 0 10px;}
  .card{background:rgba(255,255,255,.55); border:1px solid var(--line); border-radius:14px; padding:18px 18px 8px; margin-bottom:18px;}
  .task{padding:12px 0; border-top:1px solid var(--line);} .task:first-of-type{border-top:0;}
  .row{display:flex; gap:12px; align-items:flex-start;}
  .row .t{flex:1; min-width:0;}
  .t b{font-weight:600;}
  .meta{font-size:12.5px; color:var(--dim); margin-top:2px;}
  .meta .late{color:var(--terracotta); font-weight:600;}
  select.status{appearance:none; border:1px solid var(--line); border-radius:999px; background:#fff; padding:5px 12px; font:600 12px var(--sans); color:var(--ink); cursor:pointer; flex:none;}
  select.status.doing{background:#f6ecc8; border-color:var(--gold);}
  select.status.done{background:var(--sage); border-color:var(--sage);}
  select.status.blocked{background:#f5d8cb; border-color:var(--terracotta);}
  details.how{margin-top:6px;} details.how summary{font-size:12.5px; color:var(--dim); cursor:pointer; list-style:none;} details.how summary::-webkit-details-marker{display:none;}
  details.how summary::before{content:'+ '; } details.how[open] summary::before{content:'– ';}
  .why{font-size:13px; color:var(--dim); margin:6px 0;}
  textarea{width:100%; border:1px solid var(--line); border-radius:10px; padding:8px 10px; font:13.5px var(--sans); background:#fff; resize:vertical; min-height:40px;}
  .saved{font-size:11.5px; color:#5d7a52; height:14px;}
  details.obj{border-top:1px solid var(--line); padding:14px 0;} details.obj:first-of-type{border-top:0;}
  details.obj > summary{cursor:pointer; list-style:none; display:flex; justify-content:space-between; gap:10px; align-items:baseline;}
  details.obj > summary::-webkit-details-marker{display:none;}
  .count{font-size:12.5px; color:var(--dim); white-space:nowrap;}
  .bar{height:4px; background:var(--line); border-radius:4px; margin:8px 0 4px; overflow:hidden;} .bar i{display:block; height:4px; background:var(--gold); transition:width .6s ease;}
  .band{font-size:11px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:var(--dim); margin:14px 0 2px;}
  .brand{font-size:11.5px; color:var(--bronze); font-weight:600;}
  .btn{border:0; border-radius:999px; background:var(--ink); color:var(--paper); padding:10px 18px; font:600 13.5px var(--sans); cursor:pointer; margin-top:8px;}
  .msg{font-size:12.5px; min-height:16px; margin-top:6px; color:var(--dim);}
  .empty{color:var(--dim); padding:6px 0 12px;}
  /* Assistant */
  .ask-open{position:fixed; right:16px; bottom:16px; border:0; border-radius:999px; background:var(--ink); color:var(--paper); padding:12px 18px; font:600 14px var(--sans); box-shadow:0 6px 24px rgba(23,19,15,.18); cursor:pointer; z-index:5;}
  .ask{position:fixed; right:16px; bottom:16px; width:min(380px, calc(100vw - 32px)); max-height:min(560px, calc(100vh - 32px)); display:flex; flex-direction:column; background:var(--paper); border:1px solid var(--line); border-radius:16px; box-shadow:0 10px 40px rgba(23,19,15,.2); z-index:6; opacity:0; transform:translateY(8px); pointer-events:none; transition:opacity .25s ease, transform .25s ease;}
  .ask.on{opacity:1; transform:none; pointer-events:auto;}
  .ask header{display:flex; justify-content:space-between; align-items:center; padding:14px 16px; border-bottom:1px solid var(--line);}
  .ask header button{border:0; background:none; font-size:20px; cursor:pointer; color:var(--dim);}
  .thread{flex:1; overflow-y:auto; padding:14px 16px; display:flex; flex-direction:column; gap:10px;}
  .bubble{max-width:88%; padding:9px 12px; border-radius:12px; font-size:14px; white-space:pre-wrap;}
  .bubble.me{align-self:flex-end; background:var(--ink); color:var(--paper);}
  .bubble.bot{align-self:flex-start; background:#fff; border:1px solid var(--line);}
  .ask form{display:flex; gap:8px; padding:12px; border-top:1px solid var(--line);}
  .ask input{flex:1; border:1px solid var(--line); border-radius:999px; padding:10px 14px; font:14px var(--sans); background:#fff; min-width:0;}
  .ask form button{border:0; border-radius:999px; background:var(--ink); color:var(--paper); padding:0 16px; font:600 13px var(--sans); cursor:pointer;}
</style>
</head>
<body class="vm-page">
<div class="vm-band"></div>
<div class="wrap">
  {member ? (
    <>
      <p class="eyebrow">DevShop · Retail OS operations</p>
      <h1>Hi {first}. {now.length ? `${now.length} thing${now.length > 1 ? 's' : ''} to do now.` : 'Nothing urgent today.'}</h1>
      <p class="lede">{done} of {counted} done overall. Update the status as you go; the morning report reads it.</p>

      <section class="card">
        <p class="eyebrow">Do now</p>
        {now.length ? now.map((t) => (
          <div class="task" data-task={t.id}>
            <div class="row">
              <div class="t">
                <div class="brand">{t.brand_name}</div>
                <b>{t.task}</b>
                <div class="meta">{t.due_on && <span class={t.due_on < today ? 'late' : ''}>{t.due_on < today ? 'Overdue · ' : 'Due '}{day(t.due_on)}</span>}</div>
              </div>
              <select class={`status ${t.status}`} aria-label="Status">{OPS_STATUSES.map((s) => <option value={s} selected={t.status === s}>{STATUS_LABEL[s]}</option>)}</select>
            </div>
            <details class="how"><summary>How and why</summary><textarea class="note-in" placeholder="Steps, notes, or what you need">{t.note ?? ''}</textarea><div class="saved"></div></details>
          </div>
        )) : <p class="empty">All caught up. Pick the next item below.</p>}
      </section>

      <section class="card">
        <p class="eyebrow">All work, by objective</p>
        {plan.filter((p) => p.tasks.length).map((p, i) => (
          <details class="obj" open={i === 0 && p.done < p.total}>
            <summary><h2>{p.objective.title}</h2><span class="count">{p.done} of {p.total}</span></summary>
            <div class="bar"><i style={`width:${p.total ? Math.round((p.done / p.total) * 100) : 0}%`}></i></div>
            <p class="why">{p.objective.why}</p>
            {[1, 2, 3].map((pr) => {
              const list = p.tasks.filter((t) => t.priority === pr && t.status !== 'na');
              return list.length ? (
                <>
                  <div class="band">{PRIORITY_LABEL[pr]}</div>
                  {list.map((t) => (
                    <div class="task" data-task={t.id}>
                      <div class="row">
                        <div class="t">
                          <div class="brand">{t.brand_name}{t.owner !== 'team' ? ` · with ${WHO[t.owner]}` : ''}</div>
                          <b>{t.task}</b>
                          {t.due_on && open(t) && <div class="meta"><span class={t.due_on < today ? 'late' : ''}>{t.due_on < today ? 'Overdue · ' : 'Due '}{day(t.due_on)}</span></div>}
                        </div>
                        <select class={`status ${t.status}`} aria-label="Status">{OPS_STATUSES.map((s) => <option value={s} selected={t.status === s}>{STATUS_LABEL[s]}</option>)}</select>
                      </div>
                      <details class="how"><summary>How and why</summary><textarea class="note-in" placeholder="Steps, notes, or what you need">{t.note ?? ''}</textarea><div class="saved"></div></details>
                    </div>
                  ))}
                </>
              ) : null;
            })}
          </details>
        ))}
      </section>

      {waiting.length > 0 && (
        <section class="card">
          <details class="obj">
            <summary><h2>Waiting on others</h2><span class="count">{waiting.length}</span></summary>
            <p class="why">Book 15 minutes with Virat for his items. Chase brands the same day. Mark done once you have what you need.</p>
            {waiting.map((t) => <div class="task"><div class="brand">{t.brand_name} · {WHO[t.owner]}</div>{t.task}</div>)}
          </details>
        </section>
      )}

      <section class="card">
        <p class="eyebrow">End of day</p>
        <textarea id="daily" placeholder="Done today… Blocked on… Tomorrow…"></textarea>
        <button type="button" class="btn" id="dailyBtn">Post update</button>
        <div class="msg" id="dailyMsg"></div>
      </section>

      <button type="button" class="ask-open" id="askOpen">Ask a question</button>
      <div class="ask" id="ask" role="dialog" aria-label="Ask a question">
        <header><h2>Ask</h2><button type="button" id="askClose" aria-label="Close">×</button></header>
        <div class="thread" id="thread"><div class="bubble bot">Ask me anything about a task, a brand or how something works. If I don't know, I'll send it to Virat and you'll get his answer by email.</div></div>
        <form id="askForm"><input id="askIn" placeholder="Your question" autocomplete="off" /><button type="submit">Send</button></form>
      </div>
    </>
  ) : (
    <div class="card"><h2>Not found</h2><p class="why">This link isn't active. Email founder@viratmohan.com.</p></div>
  )}
</div>
<script>
  var token = location.pathname.split('/').pop();
  function post(url, body) {
    return fetch(url, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body || {}) })
      .then(function (r) { return r.json().catch(function () { return {}; }).then(function (d) { return { ok: r.ok, data: d }; }); });
  }
  document.querySelectorAll('.task[data-task]').forEach(function (row) {
    var id = row.getAttribute('data-task'), sel = row.querySelector('select.status'), note = row.querySelector('textarea.note-in'), saved = row.querySelector('.saved');
    function flash(t) { if (!saved) return; saved.textContent = t; setTimeout(function () { saved.textContent = ''; }, 2500); }
    sel.addEventListener('change', function () {
      // The same task can appear in "Do now" and in its objective; keep both in step.
      document.querySelectorAll('.task[data-task="' + id + '"] select.status').forEach(function (s) { s.value = sel.value; s.className = 'status ' + sel.value; });
      post('/retail-os/api/ops/' + token + '/task', { taskId: id, status: sel.value }).then(function (r) { if (!r.ok) alert('Not saved. Try again.'); });
    });
    var timer;
    note.addEventListener('input', function () {
      clearTimeout(timer);
      timer = setTimeout(function () {
        post('/retail-os/api/ops/' + token + '/task', { taskId: id, note: note.value }).then(function (r) { flash(r.ok ? 'Saved' : 'Not saved'); });
      }, 900);
    });
  });
  var dBtn = document.getElementById('dailyBtn');
  if (dBtn) dBtn.addEventListener('click', function () {
    var ta = document.getElementById('daily'), msg = document.getElementById('dailyMsg');
    dBtn.disabled = true; msg.textContent = 'Posting…';
    post('/retail-os/api/ops/' + token + '/log', { kind: 'daily', body: ta.value }).then(function (r) {
      dBtn.disabled = false; msg.textContent = r.ok ? 'Posted. Thank you.' : ((r.data && r.data.error) || 'Could not post.');
      if (r.ok) ta.value = '';
    });
  });
  var ask = document.getElementById('ask'), opener = document.getElementById('askOpen');
  if (ask) {
    var thread = document.getElementById('thread'), input = document.getElementById('askIn');
    function bubble(text, who) { var b = document.createElement('div'); b.className = 'bubble ' + who; b.textContent = text; thread.appendChild(b); thread.scrollTop = thread.scrollHeight; return b; }
    opener.addEventListener('click', function () { ask.classList.add('on'); opener.hidden = true; input.focus(); });
    document.getElementById('askClose').addEventListener('click', function () { ask.classList.remove('on'); opener.hidden = false; });
    document.getElementById('askForm').addEventListener('submit', function (e) {
      e.preventDefault();
      var q = input.value.trim(); if (!q) return;
      input.value = ''; bubble(q, 'me'); var wait = bubble('Thinking…', 'bot');
      post('/retail-os/api/ops/' + token + '/log', { kind: 'query', body: q }).then(function (r) {
        if (!r.ok) { wait.textContent = (r.data && r.data.error) || 'That did not send. Try again.'; return; }
        wait.textContent = r.data && r.data.answered ? r.data.answer.replace(/\s*\[[^\]]+\]/g, '') + '\n\n(Also in your email.)' : "I don't have a sourced answer for that yet, so I've sent it to Virat. His reply will come to your email.";
      });
    });
  }
</script>
</body>
</html>
