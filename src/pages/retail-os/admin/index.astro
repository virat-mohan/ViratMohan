---
export const prerender = false;
import { getRetailOsDb, journeyStep, BUILD_WINDOW_DAYS } from '../../../lib/retail-os-db';
import { getEnv } from '../../../lib/env';
import { sectionsFor } from '../../../lib/retail-os-setup';

const env = getEnv();
let apps: Awaited<ReturnType<ReturnType<typeof getRetailOsDb>['listRecent']>> = [];
let loadError = false;
const prepState: Record<string, { plan: boolean; design: boolean }> = {};
const STEP_LABEL: Record<string, string> = {
  preparing: 'Preparing forecast', review: 'Needs your review → send terms', sign: 'Terms sent, awaiting signature',
  deposit: 'Signed, awaiting deposit', confirming: 'Deposit reported → confirm', building: 'Building', live: 'Live',
};
const BRAND_STATUS: Record<string, string> = { existing: 'Existing brand', new_sub_brand: 'New sub-brand', from_zero: 'Starting from zero' };
const MODEL_LABELS: Record<string, string> = {
  mpListingType: 'Listed', mpSellerCount: 'Sellers at launch', mpCommission: 'Commission %', mpWhoShips: 'Who ships', mpSellerJoin: 'Sellers join',
  subWhat: 'Delivered', subFrequencies: 'How often', subDurations: 'Plan lengths', subArea: 'Area', subDelivery: 'Who delivers',
};
function daysLeft(startIso: string | null) {
  if (!startIso) return null;
  const end = new Date(startIso).getTime() + BUILD_WINDOW_DAYS * 86400000;
  return Math.ceil((end - Date.now()) / 86400000);
}
if (env.SUPABASE_URL && env.SUPABASE_SERVICE_ROLE_KEY) {
  try {
    const db = getRetailOsDb(env);
    apps = await db.listRecent();
    const withPlan = await Promise.all(apps.map(async (a) => [
      a.id,
      !!(await db.getLatestBusinessPlan(a.id).catch(() => null)),
      !!(await db.getLatestDesignDirection(a.id).catch(() => null)),
    ] as const));
    for (const [appId, p, d] of withPlan) prepState[appId] = { plan: p, design: d };
  } catch (err) {
    console.error('retail-os admin list failed', err);
    loadError = true;
  }
}
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Applications — DevShop Retail OS Admin</title>
<meta name="robots" content="noindex" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
<style>
  :root{ --cream:#F4EAD4; --ink:#1A1410; --ink-soft:#4A4038; --gold:#D4AF37; --terracotta:#D9714B; --line: rgba(26,20,16,0.14); }
  *{box-sizing:border-box;}
  body{ margin:0; background:var(--cream); color:var(--ink); font-family:'Inter',system-ui,sans-serif; font-size:14px; }
  h1,h2{font-family:'Anton','Arial Narrow',sans-serif; font-weight:400; text-transform:uppercase; margin:0;}
  a{color:inherit;}
  .wrap{max-width:1040px; margin-inline:auto; padding:28px 24px 60px;}
  .mono{font-family:'IBM Plex Mono';}
  .app-card{border:2px solid var(--ink); margin-bottom:20px;}
  .app-head{display:flex; justify-content:space-between; align-items:center; padding:14px 18px; background:var(--ink); color:var(--cream); flex-wrap:wrap; gap:8px;}
  .app-head h2{font-size:1.1rem; color:var(--cream);}
  .app-head .meta{font-size:11px; color:rgba(244,234,212,0.75);}
  .app-body{padding:16px 18px; display:grid; grid-template-columns:1fr 1fr; gap:8px 24px; font-size:12.5px;}
  .app-body div span:first-child{color:var(--ink-soft); font-weight:600; margin-right:4px;}
  .stages{border-top:1.5px solid var(--line); margin-top:12px; padding-top:12px;}
  .stage-row{display:flex; align-items:center; justify-content:space-between; gap:10px; padding-block:6px; font-size:12.5px;}
  .stage-row label{font-weight:600;}
  select.stage-status{font-family:'IBM Plex Mono'; font-size:11px; border:1.5px solid var(--ink); padding:4px 6px; background:#fff;}
  .track-link{font-size:11px; color:var(--terracotta); text-decoration:none; font-weight:600;}
  .delete-link{color:#a33;}
  .empty{padding-block:60px; text-align:center; color:var(--ink-soft);}
  .save-msg{font-size:11px; color:var(--terracotta); margin-left:8px;}
  .journey-chip{font-family:'IBM Plex Mono'; font-size:10.5px; font-weight:700; text-transform:uppercase; background:var(--gold); color:var(--ink); padding:3px 8px;}
  .journey-chip.act{background:var(--terracotta); color:#fff;}
  .actions{grid-column:1 / -1; border-top:1.5px solid var(--line); padding-top:12px; margin-top:6px; display:grid; gap:12px;}
  .actions h3{font-family:'Inter'; font-size:11px; text-transform:uppercase; letter-spacing:0.04em; color:var(--ink-soft); margin:0 0 6px;}
  .actions input[type=text], .actions textarea{border:1.5px solid var(--ink); padding:7px 9px; font-family:'Inter'; font-size:12.5px; background:#fff;}
  .actions textarea{width:100%; min-height:54px;}
  .abtn{border:2px solid var(--ink); background:var(--ink); color:var(--cream); padding:6px 12px; font-weight:700; font-size:12px; cursor:pointer;}
  details.answers summary{cursor:pointer; font-weight:700; font-size:12.5px;}
  details.answers dl{margin:6px 0 0; font-size:12px;} details.answers dt{font-weight:700; margin-top:6px;} details.answers dd{margin:0; color:var(--ink-soft); white-space:pre-wrap;}
</style>
</head>
<body>
<div class="wrap">
  <p style="margin:0 0 10px; font-size:12.5px; font-weight:700;"><a href="/retail-os/admin/console" style="color:var(--terracotta);">Founder console →</a> &nbsp; <a href="/retail-os/admin/reports" style="color:var(--terracotta);">Brand reports →</a></p>
  <h1 style="margin-bottom:4px;">Retail OS — Applications</h1>
  <p class="mono" style="color:var(--ink-soft); font-size:12px; margin-bottom:28px;">{apps.length} on file</p>

  {loadError && <p style="color:var(--terracotta);">Couldn't load applications — check SUPABASE env vars.</p>}
  {!loadError && apps.length === 0 && <div class="empty">No applications yet.</div>}

  {apps.map((app) => (
    <div class="app-card" data-app-id={app.id}>
      <div class="app-head">
        <h2>{app.brand_name}</h2>
        <span class="meta mono">{(() => {
          const st = journeyStep(app, prepState[app.id]?.plan ?? false, prepState[app.id]?.design ?? false);
          const dl = st === 'building' ? daysLeft(app.build_started_at) : null;
          return <span class={`journey-chip ${st === 'review' || st === 'confirming' ? 'act' : ''}`}>{STEP_LABEL[st]}{dl != null ? ` · ${dl > 0 ? `${dl} days left` : `${-dl} days over`}` : ''}</span>;
        })()} {app.id.slice(0,8).toUpperCase()} · {new Date(app.created_at).toLocaleDateString()}</span>
      </div>
      <div class="app-body">
        <div><span>Founder</span>{app.founder_name} ({app.founder_email}{app.founder_phone ? `, ${app.founder_phone}` : ''})</div>
        <div><span>Category / Format</span>{app.category || '—'} / {app.format || '—'}</div>
        <div><span>Brand</span>{app.brand_status ? BRAND_STATUS[app.brand_status] : '—'}</div>
        <div><span>Model details</span>{app.model_details ? Object.entries(app.model_details).map(([k, v]) => `${MODEL_LABELS[k] ?? k}: ${v}`).join(' · ') : '—'}</div>
        <div><span>Auto-prep</span>{prepState[app.id]?.plan && prepState[app.id]?.design ? 'Forecast + design ready' : app.prep_error ? `Failed — generate manually (${app.prep_error.slice(0, 120)})` : app.prep_started_at ? 'Running or waiting' : 'Not started (starts when founder opens their page)'}</div>
        <div><span>Existing revenue</span>{app.has_revenue === 'yes' ? (app.revenue_range || 'Yes') : 'No — AI-Enabler track'}</div>
        <div><span>Following</span>{app.following || '—'}</div>
        <div><span>Catalog</span>{app.catalog_mode === 'shopify' ? `Shopify — ${app.shopify_url || ''}` : 'Manual'}</div>
        <div><span>Store categories</span>{app.store_categories?.length ? app.store_categories.join(', ') : '—'}</div>
        <div><span>Product called</span>{app.product_noun_singular ? `${app.product_noun_singular}${app.product_noun_plural ? ` / ${app.product_noun_plural}` : ''}` : '—'}</div>
        <div><span>Product options</span>{app.sku_attributes?.length ? app.sku_attributes.map((a) => a.options.length ? `${a.name}: ${a.options.join(', ')}` : a.name).join(' · ') : '—'}</div>
        <div><span>Loyalty</span>{app.programmes?.loyalty ? `${app.programmes.loyalty.name ?? 'Unnamed'} — ${app.programmes.loyalty.pointsPerUnit ?? '?'}/product; ${app.programmes.loyalty.redeemEveryPoints ?? '?'} = ₹${app.programmes.loyalty.redeemValueInr ?? '?'} off` : '—'}</div>
        <div><span>Referrals</span>{app.programmes?.referral ? `Friend ₹${app.programmes.referral.friendDiscountInr ?? '?'} off · referrer ${app.programmes.referral.referrerRewardPoints ?? '?'} pts` : '—'}</div>
        <div><span>Drops / stories</span>{app.programmes?.dropsName || '—'} / {app.programmes?.storiesName || '—'}</div>
        <div><span>Payments</span>{app.payment_mode === 'own' ? 'Own gateway' : 'DevShop-managed'}</div>
        <div><span>Shipping</span>Pincode {app.pincode || '—'} · {app.carrier === 'own' ? 'Own carrier' : 'DevShop aggregator'}</div>
        <div><span>Meta / WhatsApp</span>{app.meta_bm === 'yes' ? 'Has BM' : 'Needs BM'} · {app.wa_number || '—'}</div>
        <div><span>Pay with a Post</span>{app.post_ack ? 'Requested' : 'Not requested'}</div>
        <div><a class="track-link" href={`/retail-os/track/${app.id}`} target="_blank">View founder status page →</a></div>
        <div><a class="track-link" href={`/retail-os/admin/plan/${app.id}`}>Business plan →</a></div>
        <div><a class="track-link" href={`/retail-os/admin/design/${app.id}`}>Design direction →</a></div>
        <div>
          <a class="track-link resend-link" href="#" data-resend={app.id} data-email={app.founder_email}>Resend link to founder</a>
          {' · '}
          <a class="track-link delete-link" href="#" data-delete={app.id} data-brand={app.brand_name}>Delete</a>
        </div>
        <div class="actions">
          {!app.agreement && (
            <form class="terms-form" data-app={app.id}>
              <h3>{app.terms ? `Terms sent ${new Date(app.terms.sentAt).toLocaleDateString('en-IN')} — resend with changes` : 'Send terms'}</h3>
              {app.ai_enabler_track ? (
                <p style="margin:0 0 6px; font-size:12px;">AI-Enabler track: 50% of brand IP, no profit-pool split.</p>
              ) : (
                <label style="font-size:12px;">DevShop share of profit pool (%) <input type="text" name="splitPct" size="5" value={String(app.terms?.splitPct ?? 40)} /> <span style="color:var(--ink-soft);">standard 40%; lower only if negotiated</span></label>
              )}
              <textarea name="notes" placeholder="Anything else agreed (optional) — shown to the founder as part of the terms">{app.terms?.notes ?? ''}</textarea>
              <button class="abtn" type="submit">{app.terms ? 'Resend terms' : 'Send terms to founder'}</button> <span class="save-msg"></span>
            </form>
          )}
          {app.agreement && (
            <div><h3>Signed</h3><p style="margin:0; font-size:12px;">{app.agreement.signedName} · {new Date(app.agreement.signedAt).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' })} IST · IP {app.agreement.ip ?? '—'}</p></div>
          )}
          {app.agreement && app.deposit && (
            <div>
              <h3>Deposit</h3>
              <p style="margin:0 0 6px; font-size:12px;">UTR <b class="mono">{app.deposit.utr}</b> reported {new Date(app.deposit.submittedAt).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' })}{app.deposit.confirmedAt ? ` · confirmed ${new Date(app.deposit.confirmedAt).toLocaleDateString('en-IN')}` : ''}</p>
              {!app.deposit.confirmedAt && <button class="abtn confirm-deposit" data-app={app.id}>Confirm deposit and start the 7-day build</button>}<span class="save-msg"></span>
            </div>
          )}
          {app.agreement && !app.deposit && (
            <div>
              <h3>Deposit</h3>
              <p style="margin:0 0 6px; font-size:12px; color:var(--ink-soft);">Not reported by the founder yet. Collected it in person (cash, UPI shown on your phone, etc.)? Mark it paid directly — this starts the 7-day build immediately.</p>
              <input type="text" class="mark-paid-ref" data-app={app.id} placeholder="Reference (optional) — e.g. UPI ref, cash" style="border:1.5px solid var(--ink); padding:6px 8px; font-family:'IBM Plex Mono'; font-size:11px; margin-right:6px;" />
              <button class="abtn mark-deposit-paid" data-app={app.id}>Mark deposit paid &amp; start build</button><span class="save-msg"></span>
            </div>
          )}
          {app.agreement && (
            <details class="answers">
              <summary>Setup answers ({sectionsFor(app).filter((s) => app.setup_answers?.[s.key]).length} of {sectionsFor(app).length} sections)</summary>
              {sectionsFor(app).map((s) => {
                const saved = app.setup_answers?.[s.key];
                return (
                  <dl>
                    <dt>{s.title} {saved ? `· ${new Date(saved.savedAt).toLocaleDateString('en-IN')}` : '· not answered'}</dt>
                    {saved && s.fields.filter((f) => saved.answers[f.key]).map((f) => <dd><b>{f.label}:</b> {saved.answers[f.key]}</dd>)}
                  </dl>
                );
              })}
            </details>
          )}
        </div>
      </div>
      <div class="stages" style="padding:0 18px 16px;">
        {app.stages.map((s) => (
          <div class="stage-row">
            <label>{s.label}</label>
            <span>
              <select class="stage-status" data-app={app.id} data-stage={s.key}>
                <option value="pending" selected={s.status === 'pending'}>Pending</option>
                <option value="done" selected={s.status === 'done'}>Done</option>
                <option value="skipped" selected={s.status === 'skipped'}>Skipped</option>
              </select>
              <span class="save-msg" data-msg-for={`${app.id}:${s.key}`}></span>
            </span>
          </div>
        ))}
      </div>
    </div>
  ))}
</div>
<script>
  document.querySelectorAll('select.stage-status').forEach(function (el) {
    el.addEventListener('change', async function () {
      var appId = el.getAttribute('data-app');
      var stageKey = el.getAttribute('data-stage');
      var status = el.value;
      var msg = document.querySelector('[data-msg-for="' + appId + ':' + stageKey + '"]');
      if (msg) msg.textContent = 'Saving…';
      try {
        var res = await fetch('/retail-os/api/admin/update-stage', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ id: appId, stageKey: stageKey, status: status }),
        });
        if (!res.ok) throw new Error('failed');
        if (msg) { msg.textContent = 'Saved'; setTimeout(function(){ msg.textContent = ''; }, 1500); }
      } catch (e) {
        if (msg) msg.textContent = 'Failed to save';
      }
    });
  });

  document.querySelectorAll('a.resend-link').forEach(function (el) {
    el.addEventListener('click', async function (e) {
      e.preventDefault();
      var email = el.getAttribute('data-email');
      el.textContent = 'Sending…';
      try {
        await fetch('/retail-os/api/resend-link', {
          method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ email: email })
        });
        el.textContent = 'Sent';
        setTimeout(function () { el.textContent = 'Resend link to founder'; }, 2000);
      } catch (err) {
        el.textContent = 'Failed';
      }
    });
  });

  document.querySelectorAll('form.terms-form').forEach(function (form) {
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      var msg = form.querySelector('.save-msg');
      var split = form.querySelector('[name="splitPct"]');
      msg.textContent = 'Sending…';
      try {
        var res = await fetch('/retail-os/api/admin/send-terms', {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ id: form.getAttribute('data-app'), splitPct: split ? split.value : null, notes: form.querySelector('[name="notes"]').value })
        });
        var out = await res.json().catch(function () { return {}; });
        if (!res.ok) throw new Error(out.error || 'failed');
        msg.textContent = 'Sent — founder emailed';
      } catch (err) {
        msg.textContent = err.message || 'Failed';
      }
    });
  });

  document.querySelectorAll('button.confirm-deposit').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      if (!confirm('Confirm this UTR matches a ₹5,000 credit on the bank statement? This starts the 7-day build clock.')) return;
      var msg = btn.nextElementSibling;
      btn.disabled = true;
      try {
        var res = await fetch('/retail-os/api/admin/confirm-deposit', {
          method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id: btn.getAttribute('data-app') })
        });
        if (!res.ok) throw new Error('failed');
        location.reload();
      } catch (err) {
        if (msg) msg.textContent = 'Failed';
        btn.disabled = false;
      }
    });
  });

  document.querySelectorAll('button.mark-deposit-paid').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      var appId = btn.getAttribute('data-app');
      var refInput = document.querySelector('.mark-paid-ref[data-app="' + appId + '"]');
      if (!confirm('Mark the ₹5,000 deposit as paid and start the 7-day build now?')) return;
      var msg = btn.nextElementSibling;
      btn.disabled = true;
      try {
        var res = await fetch('/retail-os/api/admin/mark-deposit-paid', {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ id: appId, reference: refInput ? refInput.value : '' })
        });
        if (!res.ok) throw new Error('failed');
        location.reload();
      } catch (err) {
        if (msg) msg.textContent = 'Failed';
        btn.disabled = false;
      }
    });
  });

  document.querySelectorAll('a.delete-link').forEach(function (el) {
    el.addEventListener('click', async function (e) {
      e.preventDefault();
      var id = el.getAttribute('data-delete');
      var brand = el.getAttribute('data-brand');
      if (!confirm('Delete "' + brand + '" permanently? This cannot be undone.')) return;
      el.textContent = 'Deleting…';
      try {
        var res = await fetch('/retail-os/api/admin/delete', {
          method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id: id })
        });
        if (!res.ok) throw new Error('failed');
        var card = document.querySelector('[data-app-id="' + id + '"]');
        if (card) card.remove();
      } catch (err) {
        el.textContent = 'Failed to delete';
      }
    });
  });
</script>
</body>
</html>
