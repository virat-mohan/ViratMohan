---
export const prerender = false;
import { getRetailOsDb } from '../../../../lib/retail-os-db';
import { getEnv } from '../../../../lib/env';

const { id } = Astro.params;
const env = getEnv();
const db = getRetailOsDb(env);
const app = id ? await db.getById(id) : null;
const designs = id ? await db.getLatestDesignOptions(id) : [];
const design = designs[0] ?? null;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Design Direction — {app ? app.brand_name : 'Not found'}</title>
<meta name="robots" content="noindex" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
<style>
  :root{ --cream:#F4EAD4; --ink:#1A1410; --ink-soft:#4A4038; --gold:#D4AF37; --terracotta:#D9714B; --teal:#2B8C86; --line: rgba(26,20,16,0.14); }
  *{box-sizing:border-box;}
  body{ margin:0; background:var(--cream); color:var(--ink); font-family:'Inter',system-ui,sans-serif; font-size:14px; }
  h1,h2,h3{font-family:'Anton','Arial Narrow',sans-serif; font-weight:400; text-transform:uppercase; margin:0;}
  a{color:inherit;}
  .wrap{max-width:900px; margin-inline:auto; padding:28px 24px 60px;}
  .mono{font-family:'IBM Plex Mono';}
  .back{font-size:12px; color:var(--ink-soft); text-decoration:none; font-weight:600;}
  .panel{border:2px solid var(--ink); margin-bottom:24px; padding:20px;}
  .btn{border:2px solid var(--ink); background:var(--ink); color:var(--cream); padding:11px 18px; font-family:'Inter'; font-weight:700; font-size:13.5px; cursor:pointer;}
  .btn:disabled{opacity:0.5;}
  .empty{color:var(--ink-soft); font-size:13px;}
  .site-tag{font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.04em; padding:3px 8px; border:1.5px solid var(--ink); margin-left:10px; vertical-align:middle;}
  .site-tag.existing{background:var(--teal); color:var(--cream); border-color:var(--teal);}
  .site-tag.copy{background:var(--terracotta); color:var(--cream); border-color:var(--terracotta);}
  .ref-card{border:1.5px solid var(--line); padding:14px; margin-bottom:12px;}
  .ref-card .ref-name{font-weight:700; font-size:14px;}
  .ref-card .ref-url{font-family:'IBM Plex Mono'; font-size:11px; color:var(--ink-soft); margin:2px 0 6px;}
  .ref-card .ref-note{font-size:12.5px; color:var(--ink-soft);}
  .swatches{display:flex; gap:10px; flex-wrap:wrap; margin-bottom:12px;}
  .swatch{width:88px;}
  .swatch .chip{height:56px; border:1.5px solid var(--ink);}
  .swatch .hex{font-family:'IBM Plex Mono'; font-size:10.5px; margin-top:4px; text-align:center;}
  .swatch .name{font-size:9.5px; color:var(--ink-soft); text-align:center; text-transform:uppercase; font-weight:700;}
  .rationale{font-size:12.5px; color:var(--ink-soft); margin-top:8px;}
  ul.ux{margin:0; padding-left:20px; font-size:13px;}
  ul.ux li{margin-bottom:8px;}
</style>
</head>
<body>
<div class="wrap">
  <a class="back" href="/retail-os/admin">← All applications</a>

  {!app ? (
    <h1 style="margin-top:16px;">Application not found</h1>
  ) : (
    <>
      <h1 style="margin-top:12px; font-size:1.8rem;">{app.brand_name} — Design Direction</h1>
      <p class="mono" style="color:var(--ink-soft); font-size:12px; margin:4px 0 24px;">
        {app.category || '—'} · {app.format || '—'}
        {app.catalog_mode === 'shopify' && app.shopify_url ? ` · ${app.shopify_url}` : ' · no live site on file'}
      </p>

      <div class="panel">
        <h3 style="font-size:1.1rem; margin-bottom:10px;">{design ? 'Regenerate' : 'Generate'} design direction</h3>
        <p style="font-size:12.5px; color:var(--ink-soft); margin-bottom:12px;">
          Claude researches category-leading global brand websites via native web search. If this brand has a live
          site, it's fetched directly and used as the grounding for palette/tone. If not, the model names one
          proven, successful global brand in the category to use as the starting template.
        </p>
        <button class="btn" id="generateBtn">{design ? 'Regenerate →' : 'Generate →'}</button>
        <span class="mono" id="genMsg" style="font-size:12px; color:var(--terracotta); margin-left:12px;"></span>
      </div>

      {!design ? (
        <div class="panel"><p class="empty">No design direction generated yet.</p></div>
      ) : (
        <>
          <p class="mono" style="font-size:11px; color:var(--ink-soft); margin:0 0 6px;">
            {designs.length} option{designs.length === 1 ? '' : 's'} · {design.has_existing_site ? 'elevating an existing look' : 'no existing site: starting from category references'} · generated {new Date(design.created_at).toLocaleString('en-IN')} · prompt {design.prompt_version}
          </p>
          {designs.map((o, i) => (
            <div class="panel" style={o.chosen ? 'border-color:var(--teal); border-width:3px;' : ''}>
              <h3 style="font-size:1.1rem; margin-bottom:6px;">Option {i + 1}: {o.option_name ?? 'Design direction'} {o.chosen && <span class="site-tag existing">Chosen by brand</span>}</h3>
              {o.option_summary && <p style="margin:0 0 10px; font-size:13.5px;">{o.option_summary}</p>}
              <div class="ref-card">
                <div class="ref-name">{o.primary_reference.name}</div>
                <div class="ref-url">{o.primary_reference.url}</div>
                <div class="ref-note">{o.primary_reference.note}</div>
              </div>
              {o.additional_references.length > 0 && <p class="rationale"><b>Also:</b> {o.additional_references.map((r) => `${r.name} (${r.url})`).join(' · ')}</p>}
              <div class="swatches" style="margin-top:10px;">
                {([
                  ['Primary', o.color_palette.primaryHex], ['Secondary', o.color_palette.secondaryHex], ['Accent', o.color_palette.accentHex],
                  ['Background', o.color_palette.backgroundHex], ['Text', o.color_palette.textHex],
                ] as [string, string][]).map(([name, hex]) => (
                  <div class="swatch"><div class="chip" style={`background:${hex}`}></div><div class="hex">{hex}</div><div class="name">{name}</div></div>
                ))}
              </div>
              <div class="rationale">{o.color_palette.rationale}</div>
              <p style="font-size:13.5px; margin:10px 0 4px;"><b>Heading:</b> {o.typography.headingFont} &nbsp; <b>Body:</b> {o.typography.bodyFont}</p>
              <div class="rationale">{o.typography.rationale}</div>
              <ul class="ux" style="margin-top:10px;">{o.ux_principles.map((p) => <li>{p}</li>)}</ul>
              <p style="font-size:13px; line-height:1.6; margin-top:8px;"><b>Tone:</b> {o.tone_of_voice}</p>
            </div>
          ))}
        </>
      )}
    </>
  )}
</div>
<script define:vars={{ appId: app?.id }}>
  var genBtn = document.getElementById('generateBtn');
  if (genBtn) {
    genBtn.addEventListener('click', async function () {
      var msg = document.getElementById('genMsg');
      genBtn.disabled = true;
      msg.textContent = 'Researching references and drafting direction — this can take a minute or two…';
      try {
        var res = await fetch('/retail-os/api/admin/generate-design', {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ id: appId })
        });
        var out = await res.json();
        if (!res.ok) throw new Error(out.error || 'Failed');
        location.reload();
      } catch (err) {
        msg.textContent = err.message || 'Failed to generate';
        genBtn.disabled = false;
      }
    });
  }
</script>
</body>
</html>
