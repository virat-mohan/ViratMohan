---
export const prerender = false;
import { getRetailOsDb } from '../../../../lib/retail-os-db';
import { getEnv } from '../../../../lib/env';

const { id } = Astro.params;
const env = getEnv();
const db = getRetailOsDb(env);
const app = id ? await db.getById(id) : null;
const plan = id ? await db.getLatestBusinessPlan(id) : null;
const actuals = id ? await db.listActuals(id) : [];
const actualsByMonth: Record<string, typeof actuals[number]> = {};
actuals.forEach((a) => { actualsByMonth[a.month] = a; });

function inr(n: number) {
  return '₹' + Math.round(n).toLocaleString('en-IN');
}
const fmt = new Intl.DateTimeFormat('en-IN', { year: 'numeric', month: 'short' });
function monthLabel(offset: number) {
  const d = new Date();
  d.setMonth(d.getMonth() + offset);
  return { key: `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`, label: fmt.format(d) };
}
const nextThreeMonths = [monthLabel(1), monthLabel(2), monthLabel(3)];

// DevShop's split %, mirrored from the API routes — only used client-side
// to preview the effect of an edit before saving; the server recomputes
// authoritatively on save regardless.
const splitPct = app?.ai_enabler_track
  ? 0
  : app?.split_range_lo != null && app?.split_range_hi != null
    ? (app.split_range_lo + app.split_range_hi) / 2
    : 37.5;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Business Plan — {app ? app.brand_name : 'Not found'}</title>
<meta name="robots" content="noindex" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
<style>
  :root{ --cream:#F4EAD4; --ink:#1A1410; --ink-soft:#4A4038; --gold:#D4AF37; --terracotta:#D9714B; --teal:#2B8C86; --line: rgba(26,20,16,0.14); }
  *{box-sizing:border-box;}
  body{ margin:0; background:var(--cream); color:var(--ink); font-family:'Inter',system-ui,sans-serif; font-size:14px; }
  h1,h2,h3{font-family:'Anton','Arial Narrow',sans-serif; font-weight:400; text-transform:uppercase; margin:0;}
  a{color:inherit;}
  .wrap{max-width:1040px; margin-inline:auto; padding:28px 24px 60px;}
  .mono{font-family:'IBM Plex Mono';}
  .back{font-size:12px; color:var(--ink-soft); text-decoration:none; font-weight:600;}
  .panel{border:2px solid var(--ink); margin-bottom:24px; padding:20px;}
  textarea.notes{width:100%; min-height:70px; border:1.5px solid var(--ink); padding:10px; font-family:'Inter'; font-size:13px;}
  .btn{border:2px solid var(--ink); background:var(--ink); color:var(--cream); padding:11px 18px; font-family:'Inter'; font-weight:700; font-size:13.5px; cursor:pointer;}
  .btn:disabled{opacity:0.5;}
  .btn-outline{background:transparent; color:var(--ink);}
  table{width:100%; border-collapse:collapse; font-size:12.5px;}
  th, td{border:1px solid var(--line); padding:8px 10px; text-align:right;}
  th:first-child, td:first-child{text-align:left;}
  thead th{background:var(--ink); color:var(--cream); font-weight:700;}
  .assumption{border-bottom:1px solid var(--line); padding-block:10px;}
  .assumption:last-child{border-bottom:none;}
  .assumption .label{font-weight:700; font-size:13px;}
  .assumption .value{font-family:'IBM Plex Mono'; color:var(--terracotta); font-size:12.5px;}
  .assumption .rationale{color:var(--ink-soft); font-size:12px; margin-top:3px;}
  .basis-tag{font-size:9.5px; font-weight:700; text-transform:uppercase; padding:2px 6px; border:1px solid var(--line); margin-left:6px;}
  .driver-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:16px;}
  .driver-field label{display:block; font-size:10.5px; font-weight:700; text-transform:uppercase; color:var(--ink-soft); margin-bottom:5px;}
  .driver-field input{width:100%; border:1.5px solid var(--ink); padding:8px; font-family:'IBM Plex Mono'; font-size:13px;}
  .driver-field .driver-rationale{font-size:10.5px; color:var(--ink-soft); margin-top:4px;}
  .actual-row{display:flex; gap:8px; align-items:center; margin-bottom:8px; flex-wrap:wrap;}
  .actual-row input{border:1.5px solid var(--ink); padding:6px 8px; font-size:12px; width:110px;}
  .variance-pos{color:var(--teal); font-weight:700;}
  .variance-neg{color:var(--terracotta); font-weight:700;}
  .empty{color:var(--ink-soft); font-size:13px;}
  .live-tag{font-size:10px; font-weight:700; color:var(--teal); text-transform:uppercase; letter-spacing:0.04em;}
</style>
</head>
<body>
<div class="wrap">
  <a class="back" href="/retail-os/admin">← All applications</a>

  {!app ? (
    <h1 style="margin-top:16px;">Application not found</h1>
  ) : (
    <>
      <h1 style="margin-top:12px; font-size:1.8rem;">{app.brand_name} — Business Plan</h1>
      <p class="mono" style="color:var(--ink-soft); font-size:12px; margin:4px 0 24px;">
        {app.category || '—'} · {app.format || '—'} · Target cities: {app.target_cities || 'not specified'}
        {app.catalog_mode === 'shopify' && app.shopify_url ? ` · Catalog: ${app.shopify_url} (fetched directly)` : ''}
      </p>

      <div class="panel">
        <h3 style="font-size:1.1rem; margin-bottom:10px;">{plan ? 'Regenerate' : 'Generate'} plan</h3>
        <p style="font-size:12.5px; color:var(--ink-soft); margin-bottom:12px;">
          Claude does its own research (native web search) — category sizing, competitor pricing, city-level
          spend for the target cities above. If a Shopify catalog is linked, it's fetched directly first, as
          ground truth. Add anything you already know below that the model should treat as given, not optional.
        </p>
        <textarea class="notes" id="extraNotes" placeholder="Optional — anything you want treated as known fact, e.g. actual COGS, a competitor you want compared specifically">{plan ? plan.research_notes : ''}</textarea>
        <div style="margin-top:12px; display:flex; align-items:center; gap:12px;">
          <button class="btn" id="generateBtn">{plan ? 'Regenerate plan →' : 'Generate plan →'}</button>
          <span class="mono" id="genMsg" style="font-size:12px; color:var(--terracotta);"></span>
        </div>
      </div>

      {!plan ? (
        <div class="panel"><p class="empty">No plan generated yet.</p></div>
      ) : (
        <>
          <div class="panel">
            <h3 style="font-size:1.1rem; margin-bottom:4px;">Drivers <span class="live-tag">— edit any value, the P&amp;L updates live</span></h3>
            <p style="font-size:11.5px; color:var(--ink-soft); margin-bottom:14px;">Split: DevShop {splitPct}% of profit pool</p>
            <div class="driver-grid" id="driverGrid">
              <div class="driver-field"><label>Orders — Month 1</label><input type="number" id="d-ordersM1" value={plan.drivers.ordersM1} /></div>
              <div class="driver-field"><label>Orders — Month 2</label><input type="number" id="d-ordersM2" value={plan.drivers.ordersM2} /></div>
              <div class="driver-field"><label>Orders — Month 3</label><input type="number" id="d-ordersM3" value={plan.drivers.ordersM3} /></div>
              <div class="driver-field"><label>Avg order value (₹)</label><input type="number" id="d-aovInr" value={plan.drivers.aovInr} /></div>
              <div class="driver-field"><label>COGS %</label><input type="number" step="0.1" id="d-cogsPct" value={plan.drivers.cogsPct} /></div>
              <div class="driver-field"><label>CAC %</label><input type="number" step="0.1" id="d-cacPct" value={plan.drivers.cacPct} /></div>
              <div class="driver-field"><label>Admin/Tech %</label><input type="number" step="0.1" id="d-adminTechPct" value={plan.drivers.adminTechPct} /></div>
              <div class="driver-field" style="display:flex; align-items:flex-end;"><button class="btn" id="saveDriversBtn" style="width:100%;">Save →</button></div>
            </div>
            <div class="assumption"><div class="rationale"><b>Orders:</b> {plan.drivers.rationale.orders}</div></div>
            <div class="assumption"><div class="rationale"><b>AOV:</b> {plan.drivers.rationale.aov}</div></div>
            <div class="assumption"><div class="rationale"><b>COGS%:</b> {plan.drivers.rationale.cogsPct}</div></div>
            <div class="assumption"><div class="rationale"><b>CAC%:</b> {plan.drivers.rationale.cacPct}</div></div>
            <div class="assumption"><div class="rationale"><b>Admin/Tech%:</b> {plan.drivers.rationale.adminTechPct}</div></div>
            <span class="mono" id="saveMsg" style="font-size:11px; color:var(--terracotta);"></span>
          </div>

          <div class="panel">
            <h3 style="font-size:1.1rem; margin-bottom:10px;">Benchmark P&amp;L (next 3 months) vs actuals</h3>
            <table id="planTable">
              <thead>
                <tr><th>Month</th><th>Orders</th><th>Revenue</th><th>COGS</th><th>CAC</th><th>Admin/Tech</th><th>Profit Pool</th><th>DevShop</th><th>Founder</th></tr>
              </thead>
              <tbody id="planTbody">
                {plan.months.map((m, i) => {
                  const realMonth = nextThreeMonths[i];
                  const actual = realMonth ? actualsByMonth[realMonth.key] : undefined;
                  return (
                    <>
                      <tr>
                        <td>{m.label} <span class="mono" style="color:var(--ink-soft); font-size:10.5px;">({realMonth?.label})</span></td>
                        <td data-cell="orders">{m.orders}</td><td data-cell="revenueInr">{inr(m.revenueInr)}</td>
                        <td data-cell="cogsInr">{inr(m.cogsInr)}</td><td data-cell="cacInr">{inr(m.cacInr)}</td>
                        <td data-cell="adminTechInr">{inr(m.adminTechInr)}</td><td data-cell="profitPoolInr">{inr(m.profitPoolInr)}</td>
                        <td data-cell="devshopShareInr">{inr(m.devshopShareInr)}</td><td data-cell="founderShareInr">{inr(m.founderShareInr)}</td>
                      </tr>
                      <tr>
                        <td colspan="9" style="background:#fff;">
                          <form class="actual-row" data-month={realMonth?.key} data-app={app.id}>
                            <span class="mono" style="font-size:11px; color:var(--ink-soft); min-width:70px;">Actual:</span>
                            <input type="number" placeholder="Revenue" class="a-revenue" value={actual?.revenue_inr || ''} />
                            <input type="number" placeholder="COGS" class="a-cogs" value={actual?.cogs_inr || ''} />
                            <input type="number" placeholder="CAC" class="a-cac" value={actual?.cac_inr || ''} />
                            <input type="number" placeholder="Admin/Tech" class="a-admin" value={actual?.admin_tech_inr || ''} />
                            <button type="submit" class="btn" style="padding:6px 12px; font-size:11px;">Save</button>
                            {actual && (
                              <span class={actual.revenue_inr >= m.revenueInr ? 'variance-pos' : 'variance-neg'} style="font-size:11px;">
                                {actual.revenue_inr >= m.revenueInr ? '▲' : '▼'} {inr(Math.abs(actual.revenue_inr - m.revenueInr))} vs plan
                              </span>
                            )}
                          </form>
                        </td>
                      </tr>
                    </>
                  );
                })}
              </tbody>
              <tfoot>
                <tr id="quarterTotalRow" style="font-weight:700; background:var(--gold);">
                  <td>Quarter total</td><td data-total="ordersTotal">{plan.quarter_totals.ordersTotal}</td>
                  <td data-total="revenueInr">{inr(plan.quarter_totals.revenueInr)}</td>
                  <td data-total="cogsInr">{inr(plan.quarter_totals.cogsInr)}</td>
                  <td data-total="cacInr">{inr(plan.quarter_totals.cacInr)}</td>
                  <td data-total="adminTechInr">{inr(plan.quarter_totals.adminTechInr)}</td>
                  <td data-total="profitPoolInr">{inr(plan.quarter_totals.profitPoolInr)}</td>
                  <td data-total="devshopShareInr">{inr(plan.quarter_totals.devshopShareInr)}</td>
                  <td data-total="founderShareInr">{inr(plan.quarter_totals.founderShareInr)}</td>
                </tr>
              </tfoot>
            </table>
          </div>

          <div class="panel">
            <h3 style="font-size:1.1rem; margin-bottom:10px;">Other assumptions</h3>
            {plan.assumptions.length === 0 && <p class="empty">None.</p>}
            {plan.assumptions.map((a) => (
              <div class="assumption">
                <div class="label">{a.label} <span class="value">{a.value}</span> <span class="basis-tag">{a.basis.replace(/_/g,' ')}</span></div>
                <div class="rationale">{a.rationale}</div>
              </div>
            ))}
          </div>

          <div class="panel">
            <h3 style="font-size:1.1rem; margin-bottom:10px;">City breakdown</h3>
            {plan.city_breakdown.map((c) => (
              <div class="assumption">
                <div class="label">{c.city} <span class="value">{c.revenueSharePct}%</span></div>
                <div class="rationale">{c.rationale}</div>
              </div>
            ))}
          </div>

          <div class="panel">
            <h3 style="font-size:1.1rem; margin-bottom:10px;">Risks</h3>
            <ul style="margin:0; padding-left:20px; font-size:12.5px; color:var(--ink-soft);">
              {plan.risks.map((r) => <li style="margin-bottom:6px;">{r}</li>)}
            </ul>
          </div>

          <div class="panel">
            <h3 style="font-size:1.1rem; margin-bottom:10px;">Sources found</h3>
            <ul style="margin:0; padding-left:20px; font-size:12.5px; color:var(--ink-soft);">
              {plan.sources_cited.map((s) => <li style="margin-bottom:4px;">{s}</li>)}
            </ul>
            <p class="mono" style="font-size:10.5px; color:var(--ink-soft); margin-top:12px;">
              Generated {new Date(plan.created_at).toLocaleString('en-IN')} · {plan.model} · prompt {plan.prompt_version}
            </p>
          </div>
        </>
      )}
    </>
  )}
</div>
<script define:vars={{ appId: app?.id, planId: plan?.id, splitPct }}>
  var genBtn = document.getElementById('generateBtn');
  if (genBtn) {
    genBtn.addEventListener('click', async function () {
      var notes = document.getElementById('extraNotes').value;
      var msg = document.getElementById('genMsg');
      genBtn.disabled = true;
      msg.textContent = 'Researching and generating — this can take a minute or two…';
      try {
        var res = await fetch('/retail-os/api/admin/generate-plan', {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ id: appId, extraNotes: notes })
        });
        var out = await res.json();
        if (!res.ok) throw new Error(out.error || 'Failed');
        location.reload();
      } catch (err) {
        msg.textContent = err.message || 'Failed to generate';
        genBtn.disabled = false;
      }
    });
  }

  function inrFmt(n) { return '₹' + Math.round(n).toLocaleString('en-IN'); }

  function recomputeLive() {
    var orders = [
      Number(document.getElementById('d-ordersM1').value) || 0,
      Number(document.getElementById('d-ordersM2').value) || 0,
      Number(document.getElementById('d-ordersM3').value) || 0
    ];
    var aov = Number(document.getElementById('d-aovInr').value) || 0;
    var cogsPct = Number(document.getElementById('d-cogsPct').value) || 0;
    var cacPct = Number(document.getElementById('d-cacPct').value) || 0;
    var adminPct = Number(document.getElementById('d-adminTechPct').value) || 0;

    var rows = document.querySelectorAll('#planTbody tr:not(:has(form))');
    var totals = { ordersTotal:0, revenueInr:0, cogsInr:0, cacInr:0, adminTechInr:0, profitPoolInr:0, devshopShareInr:0, founderShareInr:0 };

    orders.forEach(function (o, i) {
      var revenue = Math.round(o * aov);
      var cogs = Math.round(revenue * (cogsPct/100));
      var cac = Math.round(revenue * (cacPct/100));
      var admin = Math.round(revenue * (adminPct/100));
      var profitPool = revenue - cogs - cac - admin;
      var devshopShare = Math.round(profitPool * (splitPct/100));
      var founderShare = profitPool - devshopShare;

      var row = rows[i];
      if (row) {
        row.querySelector('[data-cell="orders"]').textContent = o;
        row.querySelector('[data-cell="revenueInr"]').textContent = inrFmt(revenue);
        row.querySelector('[data-cell="cogsInr"]').textContent = inrFmt(cogs);
        row.querySelector('[data-cell="cacInr"]').textContent = inrFmt(cac);
        row.querySelector('[data-cell="adminTechInr"]').textContent = inrFmt(admin);
        row.querySelector('[data-cell="profitPoolInr"]').textContent = inrFmt(profitPool);
        row.querySelector('[data-cell="devshopShareInr"]').textContent = inrFmt(devshopShare);
        row.querySelector('[data-cell="founderShareInr"]').textContent = inrFmt(founderShare);
      }
      totals.ordersTotal += o; totals.revenueInr += revenue; totals.cogsInr += cogs; totals.cacInr += cac;
      totals.adminTechInr += admin; totals.profitPoolInr += profitPool; totals.devshopShareInr += devshopShare; totals.founderShareInr += founderShare;
    });

    Object.keys(totals).forEach(function (key) {
      var cell = document.querySelector('[data-total="' + key + '"]');
      if (cell) cell.textContent = key === 'ordersTotal' ? totals[key] : inrFmt(totals[key]);
    });
  }

  document.querySelectorAll('#driverGrid input').forEach(function (el) {
    el.addEventListener('input', recomputeLive);
  });

  var saveBtn = document.getElementById('saveDriversBtn');
  if (saveBtn) {
    saveBtn.addEventListener('click', async function () {
      var saveMsg = document.getElementById('saveMsg');
      saveBtn.disabled = true;
      saveMsg.textContent = 'Saving…';
      try {
        var res = await fetch('/retail-os/api/admin/update-plan-drivers', {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            planId: planId, applicationId: appId,
            ordersM1: document.getElementById('d-ordersM1').value, ordersM2: document.getElementById('d-ordersM2').value,
            ordersM3: document.getElementById('d-ordersM3').value, aovInr: document.getElementById('d-aovInr').value,
            cogsPct: document.getElementById('d-cogsPct').value, cacPct: document.getElementById('d-cacPct').value,
            adminTechPct: document.getElementById('d-adminTechPct').value
          })
        });
        if (!res.ok) throw new Error('failed');
        saveMsg.textContent = 'Saved — the plan now reflects these values.';
      } catch (err) {
        saveMsg.textContent = 'Failed to save';
      }
      saveBtn.disabled = false;
    });
  }

  document.querySelectorAll('form.actual-row').forEach(function (form) {
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      var btn = form.querySelector('button');
      btn.textContent = 'Saving…';
      try {
        await fetch('/retail-os/api/admin/save-actuals', {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            id: form.getAttribute('data-app'), month: form.getAttribute('data-month'),
            revenueInr: form.querySelector('.a-revenue').value, cogsInr: form.querySelector('.a-cogs').value,
            cacInr: form.querySelector('.a-cac').value, adminTechInr: form.querySelector('.a-admin').value
          })
        });
        location.reload();
      } catch (err) {
        btn.textContent = 'Failed';
      }
    });
  });
</script>
</body>
</html>
