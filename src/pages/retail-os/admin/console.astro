---
export const prerender = false;
import { getRetailOsDb, journeyStep, BUILD_WINDOW_DAYS } from '../../../lib/retail-os-db';
import type { RetailOsApplication, JourneyStep } from '../../../lib/retail-os-db';
import { getEnv } from '../../../lib/env';
import { getLiveBrands, clarityFriction, brandMetrics, brandBudget, leversFor, istToday, addDays, type FrictionPage, type Period, type Metrics, type Budget, type Lever } from '../../../lib/retail-os-portfolio';
import { getOpsDb, progressByBrand, planByObjective, OPS_STATUSES, STATUS_LABEL as OPS_STATUS_LABEL, PRIORITY_LABEL, OWNER_LABEL } from '../../../lib/retail-os-ops';
import type { TeamMember, OpsTask, OpsLog, Objective, ObjectivePlan } from '../../../lib/retail-os-ops';
import { serviceDb } from '../../../lib/ledger';
import { JOURNEY, EXITS, health, pipeline, stepFor, indexOf, daysToLive, goLiveTarget } from '../../../lib/lead-journey';
import { brandsDb, termsLine, STATUS_LABEL, type Brand } from '../../../lib/brands';

// The founder console (viratmohan.com/founder; gated by src/middleware.ts). Four tabs:
// CRM pipeline, Team, Live brands (sales and spend for a chosen period, high-level only,
// plus actions), and Brands & contacts. Brand owners never see this page.
const env = getEnv();
const db = getRetailOsDb(env);
const url = Astro.url;
const tab = ['crm', 'team', 'live', 'brands'].includes(url.searchParams.get('tab') ?? '') ? url.searchParams.get('tab')! : 'crm';

// ── Live brands: period filter ─────────────────────────────────────────────
type PKey = 'thisweek' | 'lastweek' | 'mtd' | 'lastmonth' | 'yesterday';
const PERIODS: { key: PKey; label: string }[] = [{ key: 'thisweek', label: 'This week' }, { key: 'lastweek', label: 'Last week' }, { key: 'mtd', label: 'Month to date' }, { key: 'lastmonth', label: 'Last month' }, { key: 'yesterday', label: 'Yesterday' }];
const pkey = (PERIODS.find((p) => p.key === url.searchParams.get('period'))?.key ?? 'thisweek') as PKey;
function periodsFor(k: PKey, today = istToday()): { current: Period; previous: Period } {
  const dow = new Date(`${today}T00:00:00Z`).getUTCDay();
  const thisMonday = addDays(today, -((dow + 6) % 7));
  const lastMonday = addDays(thisMonday, -7);
  const monthStart = `${today.slice(0, 7)}-01`;
  const prevMonthStart = `${addDays(monthStart, -1).slice(0, 7)}-01`;
  const elapsed = Math.round((Date.parse(today) - Date.parse(monthStart)) / 86400000);
  switch (k) {
    case 'thisweek': return { current: { key: 'weekly', label: 'This week so far', start: thisMonday, end: addDays(today, 1) }, previous: { key: 'weekly', label: 'Same days last week', start: lastMonday, end: addDays(lastMonday, Math.round((Date.parse(today) - Date.parse(thisMonday)) / 86400000) + 1) } };
    case 'lastweek': return { current: { key: 'weekly', label: `Week of ${lastMonday}`, start: lastMonday, end: thisMonday }, previous: { key: 'weekly', label: 'Week before', start: addDays(lastMonday, -7), end: lastMonday } };
    case 'mtd': return { current: { key: 'mtd', label: 'Month to date', start: monthStart, end: addDays(today, 1) }, previous: { key: 'mtd', label: 'Same days last month', start: prevMonthStart, end: addDays(prevMonthStart, elapsed + 1) } };
    case 'lastmonth': return { current: { key: 'monthly', label: `Month of ${prevMonthStart.slice(0, 7)}`, start: prevMonthStart, end: monthStart }, previous: { key: 'monthly', label: 'Month before', start: `${addDays(prevMonthStart, -1).slice(0, 7)}-01`, end: prevMonthStart } };
    default: { const y = addDays(today, -1); return { current: { key: 'daily', label: `Yesterday (${y})`, start: y, end: today }, previous: { key: 'daily', label: 'Day before', start: addDays(y, -1), end: y } }; }
  }
}
const { current, previous } = periodsFor(pkey);
const liveBrands = getLiveBrands();
type Card = { brand: { key: string; name: string }; ok: true; cur: Metrics; prev: Metrics; budget: Budget | null; levers: Lever[]; friction: { pages: FrictionPage[]; fetchedAt: string } | null } | { brand: { key: string; name: string }; ok: false; error: string };
const portfolio: Card[] = tab === 'live' ? await Promise.all(liveBrands.map(async (b): Promise<Card> => {
  try {
    const [cur, prev, budget, friction] = await Promise.all([brandMetrics(b, current), brandMetrics(b, previous), brandBudget(b, current).catch(() => null), clarityFriction(b).catch(() => null)]);
    return { brand: { key: b.key, name: b.name }, ok: true, cur, prev, budget, levers: leversFor(cur, budget), friction };
  } catch (err) { return { brand: { key: b.key, name: b.name }, ok: false, error: err instanceof Error ? err.message : String(err) }; }
})) : [];
const inr = (n: number) => '₹' + Math.round(n).toLocaleString('en-IN');
const pct = (a: number, b: number) => (b ? `${a >= b ? '+' : ''}${Math.round(((a - b) / Math.abs(b)) * 100)}%` : '—');
const totals = portfolio.reduce((t, p) => (p.ok ? { sales: t.sales + p.cur.netSales, prevSales: t.prevSales + p.prev.netSales, orders: t.orders + p.cur.orders, ad: t.ad + p.cur.adSpend, prevAd: t.prevAd + p.prev.adSpend, profit: t.profit + p.cur.netProfit } : t), { sales: 0, prevSales: 0, orders: 0, ad: 0, prevAd: 0, profit: 0 });

// ── Brands registry ────────────────────────────────────────────────────────
let brands: Brand[] = [];
try { brands = await brandsDb(env).list(); } catch (e) { console.error('console brands', e); }
const brandByKey = new Map(brands.map((b) => [b.key, b]));
const brandOrder: Record<string, number> = { live: 0, building: 1, lead: 2, paused: 3, ended: 4 };
brands.sort((a, b) => (brandOrder[a.status] ?? 9) - (brandOrder[b.status] ?? 9) || a.name.localeCompare(b.name));

// ── CRM: the lead journey + the application steps that need you ────────────
type Lead = { id: string; brand_name: string; contact_name: string | null; contact_email: string | null; stage: string; next_step: string | null; next_step_due: string | null; stage_changed_at: string | null; clock_started_at: string | null; application_id: string | null; updated_at: string };
let leads: Lead[] = [];
let waitingEmails = 0;
try {
  const sb = serviceDb(env);
  const l = await sb.from('leads').select('id, brand_name, contact_name, contact_email, stage, next_step, next_step_due, stage_changed_at, clock_started_at, application_id, updated_at').order('updated_at', { ascending: false }).limit(200);
  leads = (l.data ?? []) as Lead[];
  const w = await sb.from('lead_messages').select('id', { count: 'exact', head: true }).eq('status', 'awaiting_approval');
  waitingEmails = w.count ?? 0;
} catch (e) { console.error('console leads', e); }
const now = new Date();
const activeLeads = leads.filter((l) => !(EXITS as readonly string[]).includes(l.stage) && l.stage !== 'live' && l.stage !== 'won');
const counts = pipeline(leads.filter((l) => !(EXITS as readonly string[]).includes(l.stage)));
const withHealth = activeLeads.map((l) => ({ l, h: health(l, now), left: daysToLive(l, now), target: goLiveTarget(l) }));
const onVirat = withHealth.filter((x) => x.h.step?.owner === 'virat');
const slipping = withHealth.filter((x) => x.h.late);
const today = now.toISOString().slice(0, 10);
const day = (d: string | Date) => new Date(typeof d === 'string' && d.length === 10 ? d + 'T00:00:00+05:30' : d).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', timeZone: 'Asia/Kolkata' });

let apps: RetailOsApplication[] = [];
const prep: Record<string, { plan: boolean; design: boolean }> = {};
try {
  apps = await db.listRecent();
  await Promise.all(apps.map(async (a) => { const [p, d] = await Promise.all([db.getLatestBusinessPlan(a.id).catch(() => null), db.getLatestDesignDirection(a.id).catch(() => null)]); prep[a.id] = { plan: !!p, design: !!d }; }));
} catch (err) { console.error('console pipeline load failed', err); }
const DAY = 86400000;
const daysSince = (iso: string | null | undefined) => (iso ? Math.floor((Date.now() - Date.parse(iso)) / DAY) : 0);
const LABEL: Record<JourneyStep, string> = { preparing: 'Preparing forecast', review: 'Review → send terms', sign: 'Awaiting signature', deposit: 'Awaiting deposit', confirming: 'Confirm deposit', building: 'Building', live: 'Live' };
const appRows = apps.map((app) => { const step = journeyStep(app, prep[app.id]?.plan ?? false, prep[app.id]?.design ?? false); return { app, step }; });
const appsOnYou = appRows.filter((r) => r.step === 'review' || r.step === 'confirming' || r.app.prep_error);
const building = appRows.filter((r) => r.step === 'building').map((r) => ({ ...r, days: daysSince(r.app.build_started_at) }));

// ── Team ───────────────────────────────────────────────────────────────────
type TeamView = { member: TeamMember; tasks: OpsTask[]; log: OpsLog[]; progress: ReturnType<typeof progressByBrand>; blocked: OpsTask[]; onYou: OpsTask[]; dueSoon: OpsTask[] };
let team: TeamView[] = [];
let objectives: Objective[] = [];
let priorities: ObjectivePlan[] = [];
try {
  const ops = getOpsDb(env);
  const members = await ops.listMembers();
  objectives = await ops.listObjectives();
  const todayIst = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Kolkata' });
  team = await Promise.all(members.map(async (member) => {
    const [tasks, log] = await Promise.all([ops.listTasks(member.id), ops.listLog(member.id, 8)]);
    const open = tasks.filter((t) => t.status !== 'done' && t.status !== 'na');
    return { member, tasks, log, progress: progressByBrand(tasks, todayIst), blocked: tasks.filter((t) => t.status === 'blocked'), onYou: open.filter((t) => t.owner === 'founder'), dueSoon: open.filter((t) => t.due_on && t.due_on <= addDays(todayIst, 2)).sort((a, b) => (a.due_on! < b.due_on! ? -1 : 1)) };
  }));
  priorities = planByObjective(objectives, team.flatMap((tv) => tv.tasks));
} catch (err) { console.error('console team load failed', err); }
const fmtTs = (iso: string) => new Date(iso).toLocaleString('en-IN', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Kolkata' });
const teamOnYou = team.reduce((n, t) => n + t.onYou.length, 0);
const actionsCount = onVirat.length + appsOnYou.length + teamOnYou + waitingEmails;
const href = (t: string, extra = '') => `/retail-os/admin/console?tab=${t}${extra}`;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Founder console — DevShop Retail OS</title><meta name="robots" content="noindex" />
<link rel="stylesheet" href="/brand/tokens.css">
<style>
  body{margin:0;background:var(--paper);color:var(--ink);font:14px/1.55 var(--sans);-webkit-font-smoothing:antialiased;}
  a{color:inherit;}
  .wrap{max-width:1180px;margin-inline:auto;padding:28px 16px 72px;}
  .top{display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:10px;margin-bottom:18px;}
  h1{font-family:var(--serif);font-weight:400;font-size:clamp(2rem,5vw,2.6rem);line-height:1.05;margin:0;}
  .logo{display:flex;align-items:center;gap:8px;text-decoration:none;margin:0 0 10px;}.logo img{height:34px;width:auto;display:block;}.logo i{font-family:var(--serif);font-style:italic;font-size:14px;color:var(--dim);}
  .eyebrow{font:600 11px/1 var(--sans);letter-spacing:.16em;text-transform:uppercase;color:var(--terracotta);margin:0 0 10px;}
  .top nav a{font-size:13px;font-weight:600;margin-left:14px;text-decoration:none;color:var(--ink);text-underline-offset:3px;}
  .tabs{display:flex;gap:6px;flex-wrap:wrap;border-bottom:1px solid var(--line);margin:0 0 22px;}
  .tabs a{text-decoration:none;font:600 13px var(--sans);padding:10px 14px;border-radius:10px 10px 0 0;color:var(--dim);}
  .tabs a.on{color:var(--ink);background:rgba(255,255,255,.5);border:1px solid var(--line);border-bottom-color:var(--paper);margin-bottom:-1px;}
  .tabs a b{display:inline-block;min-width:18px;text-align:center;background:var(--terracotta);color:#fff;border-radius:999px;font-size:11px;padding:1px 6px;margin-left:6px;}
  .kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px;margin-bottom:22px;}
  .kpi{border:1px solid var(--line);border-radius:14px;padding:12px 14px;background:rgba(255,255,255,.5);}
  .kpi .l{font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--dim);}
  .kpi .v{font-family:var(--serif);font-size:1.6rem;line-height:1.1;margin-top:4px;} .kpi .s{font-size:12px;color:var(--dim);}
  h2{font-family:var(--serif);font-weight:400;font-size:1.35rem;margin:0 0 12px;}
  h3{font:600 11px/1 var(--sans);letter-spacing:.12em;text-transform:uppercase;color:var(--dim);margin:18px 0 8px;}
  section{border:1px solid var(--line);border-radius:16px;padding:18px;margin-bottom:18px;background:rgba(255,255,255,.35);}
  table{width:100%;border-collapse:collapse;font-size:13px;} th,td{padding:7px 8px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top;} th{font-size:10.5px;text-transform:uppercase;letter-spacing:.08em;color:var(--dim);} td.num,th.num{text-align:right;white-space:nowrap;}
  .bad{color:var(--terracotta);font-weight:700;} .good{color:var(--sage,#2B8C86);font-weight:700;}
  .note{font-size:12.5px;color:var(--dim);} .chip{display:inline-block;font-size:11px;font-weight:700;padding:3px 9px;border:1px solid var(--line);border-radius:999px;margin:0 4px 4px 0;background:#fff;} .chip.hot{background:var(--ink);color:var(--paper);border-color:var(--ink);}
  .pipe{display:flex;gap:6px;overflow-x:auto;padding-bottom:6px;margin-bottom:8px;} .pipe div{flex:0 0 auto;min-width:72px;border:1px solid var(--line);border-radius:12px;padding:8px 10px;background:#fff;} .pipe b{display:block;font-family:var(--serif);font-size:1.3rem;line-height:1;} .pipe span{font-size:10.5px;color:var(--dim);}
  .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:14px;}
  .card{border:1px solid var(--line);border-radius:14px;background:#fff;padding:14px;}
  .card h4{font-family:var(--serif);font-weight:400;font-size:1.2rem;margin:0 0 6px;}
  .lever{font-size:12.5px;margin:6px 0;} .lever b{display:block;}
  .filters{display:flex;gap:6px;flex-wrap:wrap;margin:0 0 14px;} .filters a{text-decoration:none;font:600 12px var(--sans);padding:6px 12px;border-radius:999px;border:1px solid var(--line);color:var(--dim);} .filters a.on{background:var(--ink);color:var(--paper);border-color:var(--ink);}
  .scroll{overflow-x:auto;} .btn{font:600 13px var(--sans);padding:8px 14px;border-radius:999px;border:1px solid var(--ink);background:transparent;color:var(--ink);text-decoration:none;display:inline-block;}
  .prio{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:10px;}
  .prio .o{border:1px solid var(--line);border-radius:14px;padding:14px;background:#fff;}
  .prio .n{font-size:11px;color:var(--dim);} .prio h4{font-family:var(--serif);font-weight:400;font-size:1.15rem;margin:4px 0 4px;}
  .track{height:4px;background:var(--line);border-radius:4px;margin:10px 0 8px;overflow:hidden;} .track i{display:block;height:4px;background:var(--gold);}
  table.ed td{padding:5px 4px;} table.ed input, table.ed select, .addrow input, .addrow select{font:12.5px var(--sans);border:1px solid var(--line);border-radius:8px;background:#fff;padding:5px 7px;width:100%;}
  table.ed .x{border:0;background:none;color:var(--terracotta);cursor:pointer;font-size:16px;}
  table.ed tr.saved td{background:#eef4ea;} table.ed tr.err td{background:#fbe4dc;}
  .addrow{display:grid;grid-template-columns:2fr 1fr 1fr 1.4fr 1fr 1fr auto;gap:6px;align-items:center;margin-top:10px;}
  @media (max-width:800px){ .addrow{grid-template-columns:1fr 1fr;} }
  .clock{font-size:12px;font-weight:700;color:var(--sage,#2B8C86);} .clock.over{color:var(--terracotta);}
</style>
</head>
<body>
<div class="wrap">
  <div class="top">
    <div><a class="logo" href="/founder" aria-label="DevShop Retail OS"><img src="/retail-os/email/devshop-logo.png" alt="DevShop" width="140" height="54" /><i>Retail OS™</i></a><h1>Founder console</h1></div>
    <nav><a href="/retail-os/admin/leads">Leads</a><a href="/retail-os/admin">Applications</a><a href="/retail-os/admin/brands">Brands</a><a href="/retail-os/admin/faq">FAQ inbox</a><a href="/retail-os/admin/reports">Reports</a></nav>
  </div>
  {priorities.length > 0 && (
    <section>
      <p class="eyebrow">DevShop priorities</p>
      <div class="prio">
        {priorities.map((p, i) => (
          <div class="o">
            <div class="n">{i + 1} · {p.done} of {p.total} done</div>
            <h4>{p.objective.title}</h4>
            <div class="note">{p.objective.why}</div>
            <div class="track"><i style={`width:${p.total ? Math.round((p.done / p.total) * 100) : 0}%`}></i></div>
            <div class="note">{p.now} to do now{p.onFounder ? <> · <span class="bad">{p.onFounder} on you</span></> : null}{p.blocked ? <> · <span class="bad">{p.blocked} blocked</span></> : null}</div>
          </div>
        ))}
      </div>
    </section>
  )}
  <div class="tabs">
    <a class={tab === 'crm' ? 'on' : ''} href={href('crm')}>CRM pipeline{(onVirat.length + appsOnYou.length + waitingEmails) ? <b>{onVirat.length + appsOnYou.length + waitingEmails}</b> : null}</a>
    <a class={tab === 'team' ? 'on' : ''} href={href('team')}>Team &amp; tasks{teamOnYou ? <b>{teamOnYou}</b> : null}</a>
    <a class={tab === 'live' ? 'on' : ''} href={href('live')}>Live brands</a>
    <a class={tab === 'brands' ? 'on' : ''} href={href('brands')}>Brands &amp; contacts</a>
  </div>

  {tab === 'crm' && (<>
    <div class="kpis">
      <div class="kpi"><div class="l">In the journey</div><div class="v">{activeLeads.length}</div><div class="s">{leads.filter((l) => l.stage === 'live' || l.stage === 'won').length} live</div></div>
      <div class="kpi"><div class="l">Waiting on you</div><div class={`v${actionsCount ? ' bad' : ''}`}>{onVirat.length + appsOnYou.length + waitingEmails}</div><div class="s">{waitingEmails} email{waitingEmails === 1 ? '' : 's'} to approve</div></div>
      <div class="kpi"><div class="l">Slipping</div><div class={`v${slipping.length ? ' bad' : ''}`}>{slipping.length}</div><div class="s">past their stage allowance</div></div>
      <div class="kpi"><div class="l">Clock running</div><div class="v">{withHealth.filter((x) => x.left !== null).length}</div><div class="s">7 days from NDA + data</div></div>
    </div>
    <section>
      <h2>Pipeline</h2>
      <div class="pipe">{counts.map((c) => <div><b>{c.count}</b><span>{c.label}</span></div>)}</div>
      <h3>Waiting on you ({onVirat.length + appsOnYou.length})</h3>
      {(onVirat.length + appsOnYou.length) === 0 ? <p class="note">Nothing. {waitingEmails ? `${waitingEmails} email(s) are waiting for your tap; check WhatsApp or your inbox.` : ''}</p> : (
        <div class="scroll"><table><tr><th>Brand</th><th>Where</th><th>What</th><th>Days</th><th></th></tr>
          {onVirat.map((x) => <tr><td>{x.l.brand_name}</td><td>{x.h.step?.label}</td><td>{x.l.next_step ?? x.h.does}</td><td class={x.h.late ? 'bad' : ''}>{x.h.daysIn}</td><td><a href="/retail-os/admin/leads">Open →</a></td></tr>)}
          {appsOnYou.map((r) => <tr><td>{r.app.brand_name}</td><td>{LABEL[r.step]}</td><td>{r.app.prep_error ? 'Auto-prep failed; generate manually' : r.step === 'review' ? 'Send terms' : 'Confirm deposit'}</td><td>{daysSince(r.app.created_at)}</td><td><a href="/retail-os/admin">Open →</a></td></tr>)}
        </table></div>
      )}
      <h3>Everyone in the journey</h3>
      <div class="scroll"><table><tr><th>Brand</th><th>Stage</th><th>With</th><th>Next</th><th>Due</th><th>Go-live</th></tr>
        {withHealth.sort((a, b) => indexOf(b.l.stage) - indexOf(a.l.stage)).map((x) => <tr><td><b>{x.l.brand_name}</b>{x.l.contact_name && <span class="note"> · {x.l.contact_name}</span>}</td><td class={x.h.late ? 'bad' : ''}>{x.h.step?.label ?? x.l.stage}{x.h.daysIn ? ` · ${x.h.daysIn}d` : ''}</td><td>{x.h.owner}</td><td>{x.l.next_step ?? x.h.does}</td><td class={x.l.next_step_due && x.l.next_step_due < today ? 'bad' : ''}>{x.l.next_step_due ? day(x.l.next_step_due) : '—'}</td><td>{x.left !== null ? <span class={`clock${x.left < 0 ? ' over' : ''}`}>{x.left < 0 ? `${-x.left}d over` : `${x.left}d left`} · {day(x.target!)}</span> : <span class="note">clock not started</span>}</td></tr>)}
      </table></div>
      {building.length > 0 && (<><h3>Building ({building.length})</h3><div class="scroll"><table><tr><th>Brand</th><th>Day</th><th>Note</th></tr>{building.map((r) => <tr><td>{r.app.brand_name}</td><td class={r.days > BUILD_WINDOW_DAYS ? 'bad' : ''}>{r.days} of {BUILD_WINDOW_DAYS}</td><td>{r.days < BUILD_WINDOW_DAYS ? `${BUILD_WINDOW_DAYS - r.days} days left` : `${r.days - BUILD_WINDOW_DAYS} days over`}</td></tr>)}</table></div></>)}
      <p class="note" style="margin-top:12px;">Add a lead, approve emails and move stages on the <a href="/retail-os/admin/leads">leads page</a>. Stages move by themselves when they sign the NDA, connect data, apply, sign terms and pay.</p>
    </section>
  </>)}

  {tab === 'team' && (<>
    {team.length === 0 ? <section><p class="note">No team members yet.</p></section> : team.map((tv) => (
      <section>
        <h2>{tv.member.name} <span class="note">· {tv.member.role} · since {new Date(tv.member.started_on).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' })}{tv.member.email ? ` · ${tv.member.email}` : ''} · <a href={`/retail-os/ops/${tv.member.token}`} target="_blank">their page →</a></span></h2>
        <div class="kpis">
          <div class="kpi"><div class="l">Open tasks</div><div class="v">{tv.tasks.filter((t) => t.status !== 'done' && t.status !== 'na').length}</div></div>
          <div class="kpi"><div class="l">Done</div><div class="v">{tv.tasks.filter((t) => t.status === 'done').length}</div></div>
          <div class="kpi"><div class="l">Blocked</div><div class={`v${tv.blocked.length ? ' bad' : ''}`}>{tv.blocked.length}</div></div>
          <div class="kpi"><div class="l">Waiting on you</div><div class={`v${tv.onYou.length ? ' bad' : ''}`}>{tv.onYou.length}</div></div>
        </div>
        <h3>Tasks by objective, in priority order</h3>
        <div class="scroll" data-member={tv.member.id}>
          {planByObjective(objectives, tv.tasks).filter((p) => p.tasks.length).map((p) => (
            <table class="ed">
              <tr><th colspan="7">{p.objective.title} · {p.done} of {p.total} done</th></tr>
              {p.tasks.map((t) => (
                <tr data-task={t.id}>
                  <td style="min-width:260px;"><input data-f="task" value={t.task} /><select data-f="objective" style="margin-top:4px;color:var(--dim);">{objectives.map((o) => <option value={o.key} selected={t.objective === o.key}>{o.title}</option>)}</select></td>
                  <td style="min-width:110px;"><input data-f="brand_name" value={t.brand_name} /></td>
                  <td><select data-f="priority">{[1, 2, 3].map((n) => <option value={n} selected={t.priority === n}>{PRIORITY_LABEL[n]}</option>)}</select></td>
                  <td><select data-f="status">{OPS_STATUSES.map((st) => <option value={st} selected={t.status === st}>{OPS_STATUS_LABEL[st]}</option>)}</select></td>
                  <td><select data-f="owner">{['team', 'founder', 'brand'].map((k) => <option value={k} selected={t.owner === k}>{k === 'team' ? tv.member.name : OWNER_LABEL[k]}</option>)}</select></td>
                  <td><input data-f="due_on" type="date" value={t.due_on ?? ''} /></td>
                  <td><button class="x" type="button" title="Remove">×</button></td>
                </tr>
              ))}
            </table>
          ))}
          <div class="addrow">
            <input data-f="task" placeholder="New task" />
            <input data-f="brand_name" placeholder="Brand" />
            <select data-f="priority">{[1, 2, 3].map((n) => <option value={n} selected={n === 2}>{PRIORITY_LABEL[n]}</option>)}</select>
            <select data-f="objective">{objectives.map((o) => <option value={o.key}>{o.title}</option>)}</select>
            <select data-f="owner">{['team', 'founder', 'brand'].map((k) => <option value={k}>{k === 'team' ? tv.member.name : OWNER_LABEL[k]}</option>)}</select>
            <input data-f="due_on" type="date" />
            <button class="btn addbtn" type="button">Add</button>
          </div>
        </div>
        <p class="note">Edits save as you make them. Removing a task also removes its notes.</p>
        {tv.onYou.length > 0 && (<><h3>Waiting on you ({tv.onYou.length})</h3>{tv.onYou.map((t) => <div class="lever"><b>{t.brand_name}: {t.task}</b>{t.note && <span class="note">{t.note}</span>}{t.due_on && <span class="note"> · due {day(t.due_on)}</span>}</div>)}</>)}
        {tv.blocked.length > 0 && (<><h3 class="bad">Blocked ({tv.blocked.length})</h3>{tv.blocked.map((t) => <div class="lever"><b>{t.brand_name}: {t.task}</b>{t.note && <span class="note">{t.note}</span>}</div>)}</>)}
        <h3>Latest from {tv.member.name}</h3>
        {tv.log.length ? tv.log.map((l) => <div class="lever"><span class="note">{fmtTs(l.created_at)} · {l.kind}</span><br />{l.body}</div>) : <p class="note">No updates yet.</p>}
      </section>
    ))}
  </>)}

  {tab === 'live' && (<>
    <div class="filters">{PERIODS.map((p) => <a class={p.key === pkey ? 'on' : ''} href={href('live', `&period=${p.key}`)}>{p.label}</a>)}</div>
    <div class="kpis">
      <div class="kpi"><div class="l">Net sales · {current.label}</div><div class="v">{inr(totals.sales)}</div><div class="s">{previous.label}: {inr(totals.prevSales)} ({pct(totals.sales, totals.prevSales)})</div></div>
      <div class="kpi"><div class="l">Orders</div><div class="v">{totals.orders.toLocaleString('en-IN')}</div></div>
      <div class="kpi"><div class="l">Ad spend · ROAS</div><div class="v">{inr(totals.ad)}</div><div class="s">{totals.ad ? `${(totals.sales / totals.ad).toFixed(1)}×` : 'no spend'} · before: {inr(totals.prevAd)}</div></div>
      <div class="kpi"><div class="l">Net profit</div><div class={`v${totals.profit < 0 ? ' bad' : ''}`}>{inr(totals.profit)}</div></div>
    </div>
    {liveBrands.length === 0 ? <section><p class="note">No live stores are connected for numbers yet. The Brands tab still lists every live brand and its terms; connecting a store's reporting key is on Prince's platform tasks.</p></section> : (
      <div class="grid">
        {portfolio.map((p) => { const meta = brandByKey.get(p.brand.key); return (
          <div class="card">
            <h4>{p.brand.name}</h4>
            {meta && <p class="note" style="margin:0 0 8px;">{termsLine(meta)}</p>}
            {!p.ok ? <p class="note bad">Couldn't read this store: {p.error}</p> : (<>
              <div class="scroll"><table>
                <tr><th></th><th class="num">{current.label}</th><th class="num">{previous.label}</th><th class="num">Change</th></tr>
                {([['Orders', p.cur.orders, p.prev.orders, false], ['Net sales', p.cur.netSales, p.prev.netSales, true], ['Ad spend', p.cur.adSpend, p.prev.adSpend, true], ['ROAS', p.cur.adSpend ? p.cur.netSales / p.cur.adSpend : 0, p.prev.adSpend ? p.prev.netSales / p.prev.adSpend : 0, 'x'], ['Net profit', p.cur.netProfit, p.prev.netProfit, true]] as [string, number, number, boolean | 'x'][]).map(([l, a, b, f]) => <tr><td>{l}</td><td class="num">{f === 'x' ? (a ? `${a.toFixed(1)}×` : '—') : f ? inr(a) : Math.round(a).toLocaleString('en-IN')}</td><td class="num">{f === 'x' ? (b ? `${b.toFixed(1)}×` : '—') : f ? inr(b) : Math.round(b).toLocaleString('en-IN')}</td><td class={`num ${a >= b ? 'good' : 'bad'}`}>{pct(a, b)}</td></tr>)}
              </table></div>
              {p.budget && <p class="note" style="margin-top:8px;">Plan for this period: {inr(p.budget.revenue)} sales · {p.budget.orders} orders · {inr(p.budget.adSpend)} ads.</p>}
              <h3>Actions</h3>
              {p.levers.length ? p.levers.map((l) => <div class="lever"><b>{l.title}</b>{l.detail}</div>) : <p class="note">Nothing flagged for this period.</p>}
              {p.friction && p.friction.pages.length > 0 && (<><h3>Where visitors struggle</h3>{p.friction.pages.slice(0, 3).map((f) => <div class="lever"><b>{f.url}</b>{f.rageClicks} rage clicks · {f.deadClicks} dead clicks · {f.quickbacks} quick-backs in {f.sessions} sessions</div>)}</>)}
            </>)}
          </div>
        ); })}
      </div>
    )}
    <section style="margin-top:18px;">
      <h2>All live and building brands</h2>
      <div class="scroll"><table><tr><th>Brand</th><th>Status</th><th>Terms</th><th>Numbers</th><th>Next</th></tr>
        {brands.filter((b) => b.status === 'live' || b.status === 'building').map((b) => { const l = leads.find((x) => x.id === b.lead_id); return <tr><td><b>{b.name}</b></td><td>{STATUS_LABEL[b.status]}</td><td>{termsLine(b)}</td><td>{liveBrands.some((x) => x.key === b.key) ? <span class="good">connected</span> : <span class="note">store not connected for reporting</span>}</td><td>{l?.next_step ?? b.notes ?? '—'}</td></tr>; })}
      </table></div>
    </section>
  </>)}

  {tab === 'brands' && (
    <section>
      <h2>Brands &amp; contacts <span class="note">· <a href="/retail-os/admin/brands">edit</a></span></h2>
      <div class="scroll"><table><tr><th>Brand</th><th>Status</th><th>Terms</th><th>Contacts</th><th>Links</th></tr>
        {brands.map((b) => <tr><td><b>{b.name}</b>{b.category && <div class="note">{b.category}</div>}</td><td><span class={`chip${b.status === 'live' ? ' hot' : ''}`}>{STATUS_LABEL[b.status]}</span></td><td>{termsLine(b)}</td><td>{b.contacts.length ? b.contacts.map((c) => <div>{c.name}{c.role ? ` (${c.role})` : ''}{c.email ? <> · <a href={`mailto:${c.email}`}>{c.email}</a></> : null}{c.phone ? ` · ${c.phone}` : ''}</div>) : <span class="note">add in admin</span>}</td><td>{b.website && <a href={b.website} target="_blank">site</a>}{b.instagram && <> · <a href={`https://instagram.com/${b.instagram}`} target="_blank">@{b.instagram}</a></>}{b.application_id && <> · <a href={`/retail-os/track/${b.application_id}?edit=1`}>page</a></>}</td></tr>)}
      </table></div>
      <p class="note" style="margin-top:12px;">Missing emails and numbers: fill them in on the <a href="/retail-os/admin/brands">brands admin</a>; they show here and on the CRM at once.</p>
    </section>
  )}
</div>
<script>
  function send(body) {
    return fetch('/retail-os/api/admin/ops-task', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) })
      .then(function (r) { return r.json().catch(function () { return {}; }).then(function (d) { return { ok: r.ok, data: d }; }); });
  }
  function mark(tr, ok) { tr.classList.remove('saved', 'err'); tr.classList.add(ok ? 'saved' : 'err'); setTimeout(function () { tr.classList.remove('saved'); }, 1200); }
  document.querySelectorAll('table.ed tr[data-task]').forEach(function (tr) {
    var id = tr.getAttribute('data-task');
    tr.querySelectorAll('[data-f]').forEach(function (el) {
      el.addEventListener('change', function () {
        var fields = {}; fields[el.getAttribute('data-f')] = el.value;
        send({ action: 'update', taskId: id, fields: fields }).then(function (r) { mark(tr, r.ok); if (!r.ok) alert((r.data && r.data.error) || 'Not saved'); });
      });
    });
    tr.querySelector('.x').addEventListener('click', function () {
      if (!confirm('Remove this task and its notes? This cannot be undone.')) return;
      send({ action: 'delete', taskId: id }).then(function (r) { if (r.ok) tr.remove(); else alert('Not removed'); });
    });
  });
  document.querySelectorAll('.addrow').forEach(function (row) {
    var member = row.closest('[data-member]').getAttribute('data-member');
    row.querySelector('.addbtn').addEventListener('click', function () {
      var fields = {};
      row.querySelectorAll('[data-f]').forEach(function (el) { if (el.value) fields[el.getAttribute('data-f')] = el.value; });
      send({ action: 'create', memberId: member, fields: fields }).then(function (r) { if (r.ok) location.reload(); else alert((r.data && r.data.error) || 'Not added'); });
    });
  });
</script>
</body>
</html>
