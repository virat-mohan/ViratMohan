---
export const prerender = false;
import { getEnv } from '../../../lib/env';
import { serviceDb } from '../../../lib/ledger';

// Leads (gated by src/middleware.ts). Every lead with its stage, next step and
// due date, and the whole conversation: emails in and out, drafts waiting for
// approval, and notes where a message needed Virat.
type Lead = { id: string; brand_name: string; contact_name: string | null; contact_email: string | null; stage: string; next_step: string | null; next_step_due: string | null; source: string | null; updated_at: string };
type Msg = { id: string; lead_id: string; at: string; direction: string; channel: string; status: string; subject: string | null; body: string; gmail_thread_id: string | null };

let leads: Lead[] = [];
let msgs: Msg[] = [];
let loadError = '';
try {
  const sb = serviceDb(getEnv());
  const l = await sb.from('leads').select('id, brand_name, contact_name, contact_email, stage, next_step, next_step_due, source, updated_at').order('updated_at', { ascending: false }).limit(200);
  if (l.error) throw l.error;
  leads = (l.data ?? []) as Lead[];
  if (leads.length) {
    const m = await sb.from('lead_messages').select('id, lead_id, at, direction, channel, status, subject, body, gmail_thread_id').in('lead_id', leads.map((x) => x.id)).order('at');
    if (m.error) throw m.error;
    msgs = (m.data ?? []) as Msg[];
  }
} catch (err) { loadError = err instanceof Error ? err.message : String(err); }

const byLead = new Map<string, Msg[]>();
for (const m of msgs) byLead.set(m.lead_id, [...(byLead.get(m.lead_id) ?? []), m]);
const today = new Date().toISOString().slice(0, 10);
const waiting = msgs.filter((m) => m.status === 'awaiting_approval').length;
const fmt = (d: string) => new Date(d).toLocaleString('en-IN', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Kolkata' });
const day = (d: string) => new Date(d + 'T00:00:00+05:30').toLocaleDateString('en-IN', { day: 'numeric', month: 'short', timeZone: 'Asia/Kolkata' });
const stageLabel = (s: string) => s.replace(/_/g, ' ');
const who = (m: Msg) => m.direction === 'inbound' ? 'They wrote' : m.direction === 'internal' ? 'Note' : m.status === 'awaiting_approval' ? 'Draft, waiting for you' : 'I wrote';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Leads</title>
<meta name="robots" content="noindex">
<link rel="stylesheet" href="/brand/tokens.css">
<style>
body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.6 var(--sans);-webkit-font-smoothing:antialiased;}
.wrap{max-width:860px;margin:0 auto;padding:56px 16px 96px;}
.eyebrow{font:600 11px/1 var(--sans);letter-spacing:.16em;text-transform:uppercase;color:var(--terracotta);margin:0 0 12px;}
h1{font-family:var(--serif);font-weight:400;font-size:clamp(2.2rem,6vw,3rem);line-height:1.05;margin:0 0 10px;}
.sub{color:var(--dim);margin:0 0 40px;}
.sub a{color:var(--ink);text-underline-offset:3px;}
.lead{border-top:1px solid var(--line);padding:26px 0;}
.lead summary{list-style:none;cursor:pointer;display:grid;grid-template-columns:1fr auto;gap:6px 16px;align-items:baseline;}
.lead summary::-webkit-details-marker{display:none;}
.lead summary>*{min-width:0;}
.name{font-family:var(--serif);font-size:1.5rem;line-height:1.2;}
.who{color:var(--dim);font-size:13px;overflow-wrap:anywhere;}
.stage{font:600 11px/1 var(--sans);letter-spacing:.12em;text-transform:uppercase;color:var(--ink);border:1px solid var(--line);border-radius:999px;padding:7px 12px;white-space:nowrap;}
.next{grid-column:1/-1;color:var(--dim);font-size:14px;}
.next b{color:var(--ink);font-weight:600;}
.due.late{color:var(--terracotta);}
.flag{display:inline-block;margin-left:8px;color:var(--gold);font-size:12px;font-weight:600;}
ol{list-style:none;margin:22px 0 0;padding:0 0 0 18px;border-left:1px solid var(--line);}
li{margin:0 0 22px;position:relative;}
li::before{content:'';position:absolute;left:-22px;top:8px;width:7px;height:7px;border-radius:50%;background:var(--line);}
li.inbound::before{background:var(--gold);} li.awaiting_approval::before{background:var(--terracotta);} li.internal::before{background:var(--ink);}
.meta{font-size:12px;color:var(--dim);letter-spacing:.02em;}
.meta a{color:var(--dim);}
.subj{font-weight:600;margin:2px 0 4px;}
.body{white-space:pre-wrap;color:var(--ink);font-size:14px;max-height:14em;overflow:auto;overflow-wrap:anywhere;}
.empty{color:var(--dim);font-family:var(--serif);font-size:1.3rem;padding:40px 0;}
.err{color:var(--terracotta);}
@media (prefers-reduced-motion:no-preference){.lead{animation:rise .45s ease-out both;}@keyframes rise{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}}
</style>
</head>
<body>
<main class="wrap">
  <p class="eyebrow">Retail OS admin</p>
  <h1>Leads</h1>
  <p class="sub">{leads.length} {leads.length === 1 ? 'lead' : 'leads'}{waiting ? `, ${waiting} ${waiting === 1 ? 'reply' : 'replies'} waiting for your approval` : ''}. Replies are drafted in Gmail and sent only when you approve. <a href="/api/admin/gmail/connect">Gmail connection</a></p>
  {loadError && <p class="err">Could not load leads: {loadError}</p>}
  {!loadError && !leads.length && <p class="empty">No leads yet. When someone writes in, they will appear here.</p>}
  {leads.map((l) => {
    const t = byLead.get(l.id) ?? [];
    const pending = t.some((m) => m.status === 'awaiting_approval');
    return (
      <details class="lead" open={pending}>
        <summary>
          <div>
            <div class="name">{l.brand_name}{pending && <span class="flag">Reply waiting</span>}</div>
            <div class="who">{[l.contact_name, l.contact_email, l.source].filter(Boolean).join(' · ')}</div>
          </div>
          <span class="stage">{stageLabel(l.stage)}</span>
          <div class="next">Next: <b>{l.next_step ?? 'Not set'}</b>{l.next_step_due && <span class={`due${l.next_step_due < today ? ' late' : ''}`}> · due {day(l.next_step_due)}</span>}</div>
        </summary>
        {t.length ? (
          <ol>
            {t.map((m) => (
              <li class={`${m.direction} ${m.status}`}>
                <div class="meta">{who(m)} · {m.channel} · {fmt(m.at)}{m.gmail_thread_id && <> · <a href={`https://mail.google.com/mail/u/0/#all/${m.gmail_thread_id}`}>Gmail</a></>}</div>
                {m.subject && <div class="subj">{m.subject}</div>}
                <div class="body">{m.body}</div>
              </li>
            ))}
          </ol>
        ) : <p class="meta">No conversation logged yet.</p>}
      </details>
    );
  })}
</main>
</body>
</html>
