---
export const prerender = false;
import { InMemoryWorkRegistry } from '../../../lib/work/registry';
import { buildControlTowerView } from '../../../lib/control-tower/view';
import { buildMorningBoard } from '../../../lib/ceo/morning-board';
import { AGENT_REGISTRY, CEO_AUTONOMY, findAgent, directReports } from '../../../lib/ceo/types';
import { CONTROL_TOWER_STAGES } from '../../../lib/control-tower/types';
import type { MorningBoardItem } from '../../../lib/ceo/types';
import type { ControlTowerStage, WorkSummary } from '../../../lib/control-tower/types';
import { getEnv } from '../../../lib/env';
import { serviceDb } from '../../../lib/ledger';
import { createSupabaseWorkStore } from '../../../lib/work/db-store';
import { loadRegistry } from '../../../lib/work/db-registry';

const now = new Date();
let registry: InMemoryWorkRegistry;
let dataSource: 'supabase' | 'empty';
let loadError: string | null = null;

const env = getEnv();
if (env.SUPABASE_URL && env.SUPABASE_SERVICE_ROLE_KEY) {
  try {
    const sb = serviceDb(env);
    const store = createSupabaseWorkStore(sb);
    registry = await loadRegistry(store);
    dataSource = 'supabase';
  } catch (err: unknown) {
    loadError = err instanceof Error ? err.message : String(err);
    registry = new InMemoryWorkRegistry();
    dataSource = 'empty';
  }
} else {
  registry = new InMemoryWorkRegistry();
  dataSource = 'empty';
  loadError = 'Supabase not configured';
}

const view = buildControlTowerView(registry);
const closedCount = registry.list().filter((i) => i.state === 'closed').length;

// Lifecycle presentation. RESOLVED and CLOSED are never worded alike: closing needs verification and evidence.
const STATE_MEANING: Record<string, { label: string; note: string }> = {
  new: { label: 'New', note: 'Not triaged yet' },
  triaged: { label: 'Triaged', note: 'Needs an owner' },
  assigned: { label: 'Assigned', note: 'Not started' },
  in_progress: { label: 'In progress', note: 'Being worked on' },
  waiting: { label: 'Waiting', note: 'Held until the wait ends' },
  blocked: { label: 'Blocked', note: 'Held by a blocker' },
  pending_approval: { label: 'Pending approval', note: 'Waiting for a decision' },
  resolved: { label: 'RESOLVED', note: 'Waiting for verification. Not closed.' },
  verification: { label: 'VERIFICATION', note: 'Evidence is needed to close it.' },
  closed: { label: 'CLOSED', note: 'Completed and kept in history.' },
  reopened: { label: 'Reopened', note: 'Back in play' },
};
const NEXT_ACTION: Record<string, { action: string; button: string }> = {
  assigned: { action: 'start', button: 'Start' },
  in_progress: { action: 'resolve', button: 'Mark resolved' },
  resolved: { action: 'verify', button: 'Send to verification' },
  verification: { action: 'close', button: 'Verify and close' },
};
const RANK: Record<string, number> = { P0: 0, P1: 1, P2: 2, P3: 3, P4: 4 };
const MAX_OPEN_SHOWN = 40;
const openWork = registry.list()
  .filter((i) => i.state !== 'closed' && !i.merged_into)
  .sort((a, b) => (RANK[a.priority ?? 'P4'] ?? 4) - (RANK[b.priority ?? 'P4'] ?? 4) || (a.updated_at < b.updated_at ? 1 : -1));
const closedWork = registry.list()
  .filter((i) => i.state === 'closed')
  .sort((a, b) => ((b.closed_at ?? '') > (a.closed_at ?? '') ? 1 : -1))
  .slice(0, 10);
const day = (iso: string) => iso.slice(0, 10);
const board = buildMorningBoard(registry, now);
const dev = findAgent('DS-02')!;
const brandCeos = directReports('DS-02').filter((a) => a.role === 'brand_ceo');
const hods = directReports('DS-02').filter((a) => a.role !== 'brand_ceo');

const CATEGORY_LABEL: Record<string, string> = {
  critical_incident: 'Critical',
  decision_required: 'Decision needed',
  blocked_work: 'Blocked',
  overdue_work: 'Overdue',
  unresolved_approval: 'Unassigned',
  cost_anomaly: 'Cost anomaly',
  brand_risk: 'Brand risk',
  opportunity: 'Opportunity',
  proof_result: 'Proof result',
};

const STAGE_LABEL: Record<string, string> = {
  detect: 'Detect',
  classify: 'Classify',
  prioritise: 'Prioritise',
  assign: 'Assign',
  escalate: 'Escalate',
  track: 'Track',
  verify: 'Verify',
  learn: 'Learn',
};

const BRAND_LABEL: Record<string, string> = {
  caps: 'Travaholic Caps',
  moonglasses: 'Moon Glasses',
  ceremony: 'Ceremony Kitchen',
  freshforpaws: 'Fresh For Paws',
  korbi: 'Korbi',
};

const BRAND_STATUS: Record<string, string> = {
  caps: 'Retail OS Live',
  moonglasses: 'Retail OS Live',
  ceremony: 'Implementation Active',
  freshforpaws: 'Staged — not deployed',
  korbi: 'Retail OS Live',
};

const TAB_NAMES = ['board', 'pipeline', 'agents', 'brands', 'ceo'] as const;
const TAB_LABEL: Record<string, string> = { board: 'Morning Board', pipeline: 'Work Pipeline', agents: 'Agents', brands: 'Brands', ceo: 'Ask the CEO' };
const tab = TAB_NAMES.includes(Astro.url.searchParams.get('tab') as typeof TAB_NAMES[number]) ? Astro.url.searchParams.get('tab')! : 'board';
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{TAB_LABEL[tab]} — Founder Control Tower — DevShop Retail OS</title>
  <link rel="stylesheet" href="/brand/tokens.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=DM+Serif+Display&display=swap" rel="stylesheet" />
  <style>
    :root {
      --paper: #FBF8F2;
      --ink: #1A1A1A;
      --ink-muted: #6B6B6B;
      --gold: #C5A572;
      --terracotta: #C17A56;
      --border: #E8E2D8;
      --card: #FFFFFF;
      --tag-p0: #D94B4B;
      --tag-p1: #E67A33;
      --tag-p2: #C5A572;
      --tag-p3: #8B9D77;
      --tag-p4: #A3A3A3;
      --sans: 'DM Sans', system-ui, sans-serif;
      --display: 'DM Serif Display', serif;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: var(--sans); background: var(--paper); color: var(--ink); line-height: 1.5; -webkit-text-size-adjust: 100%; }
    .shell { max-width: 960px; margin: 0 auto; padding: 24px 16px 64px; }

    /* — Breadcrumbs — */
    .breadcrumbs { display: flex; align-items: center; gap: 6px; font-size: 0.78rem; color: var(--ink-muted); margin-bottom: 12px; flex-wrap: wrap; }
    .breadcrumbs a { color: var(--gold); text-decoration: none; }
    .breadcrumbs a:hover { text-decoration: underline; }
    .breadcrumbs .sep { color: var(--border); }
    .breadcrumbs .current { color: var(--ink); font-weight: 500; }

    h1 { font-family: var(--display); font-size: 1.5rem; font-weight: 400; margin-bottom: 4px; }
    .subtitle { font-size: 0.85rem; color: var(--ink-muted); margin-bottom: 24px; }
    .tabs { display: flex; gap: 4px; margin-bottom: 24px; flex-wrap: wrap; }
    .tab { padding: 8px 14px; border-radius: 6px; font-size: 0.82rem; text-decoration: none; color: var(--ink-muted); border: 1px solid var(--border); background: none; min-height: 44px; display: inline-flex; align-items: center; }
    .tab.active { background: var(--ink); color: var(--paper); border-color: var(--ink); }
    .card { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 20px; margin-bottom: 16px; }
    .card h2 { font-family: var(--display); font-size: 1.1rem; font-weight: 400; margin-bottom: 12px; }
    .card h3 { font-size: 0.85rem; font-weight: 600; color: var(--ink-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px; }
    .empty { color: var(--ink-muted); font-size: 0.85rem; font-style: italic; }
    .kpi-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 16px; }
    .kpi { text-align: center; padding: 12px; border: 1px solid var(--border); border-radius: 8px; background: var(--card); }
    .kpi-val { font-family: var(--display); font-size: 1.6rem; }
    .kpi-label { font-size: 0.72rem; color: var(--ink-muted); text-transform: uppercase; letter-spacing: 0.04em; }
    .item-row { display: flex; gap: 8px; align-items: baseline; padding: 8px 0; border-bottom: 1px solid var(--border); font-size: 0.85rem; }
    .item-row:last-child { border-bottom: none; }
    .tag { display: inline-block; padding: 1px 6px; border-radius: 4px; font-size: 0.72rem; font-weight: 600; color: #fff; white-space: nowrap; }
    .tag-p0 { background: var(--tag-p0); }
    .tag-p1 { background: var(--tag-p1); }
    .tag-p2 { background: var(--tag-p2); }
    .tag-p3 { background: var(--tag-p3); }
    .tag-p4 { background: var(--tag-p4); }
    .tag-cat { background: var(--terracotta); }
    .pipeline { display: grid; grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)); gap: 8px; margin-bottom: 16px; }
    .stage { text-align: center; padding: 12px 8px; border: 1px solid var(--border); border-radius: 8px; background: var(--card); }
    .stage-count { font-family: var(--display); font-size: 1.4rem; }
    .stage-label { font-size: 0.72rem; color: var(--ink-muted); text-transform: uppercase; }
    .agent-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; }
    .agent-card { padding: 14px; border: 1px solid var(--border); border-radius: 8px; background: var(--card); }
    .agent-id { font-size: 0.72rem; color: var(--gold); font-weight: 600; }
    .agent-name { font-weight: 600; }
    .agent-role { font-size: 0.78rem; color: var(--ink-muted); }
    .brand-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; }
    .brand-card { padding: 16px; border: 1px solid var(--border); border-radius: 8px; background: var(--card); }
    .brand-name { font-weight: 600; margin-bottom: 4px; }
    .brand-status { font-size: 0.78rem; padding: 2px 8px; border-radius: 4px; display: inline-block; margin-bottom: 8px; }
    .brand-live { background: #E8F5E9; color: #2E7D32; }
    .brand-staged { background: #FFF3E0; color: #E65100; }
    .brand-impl { background: #E3F2FD; color: #1565C0; }
    .brand-work { font-size: 0.82rem; color: var(--ink-muted); }
    .notice { padding: 12px 16px; border-radius: 8px; background: #FFF8E1; border: 1px solid #FFE082; font-size: 0.82rem; color: #6D5B00; margin-bottom: 16px; }

    /* — Ask the CEO — */
    .ask label { display: block; font-size: 0.8rem; color: var(--ink-muted); margin-bottom: 4px; }
    .ask textarea, .ask select, .ask input { min-height: 44px; width: 100%; font: inherit; font-size: 1rem; padding: 10px 12px; border: 1px solid var(--border); border-radius: 8px; background: var(--paper); color: var(--ink); }
    .ask textarea { min-height: 96px; resize: vertical; }
    .ask .row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 12px 0; }
    .ask button { min-height: 44px; padding: 0 20px; border-radius: 8px; border: 1px solid var(--ink); background: var(--ink); color: var(--paper); font: inherit; font-size: 1rem; cursor: pointer; }
    .ask button[disabled] { opacity: 0.55; cursor: default; }
    .resp dl { display: grid; grid-template-columns: 9rem 1fr; gap: 8px 12px; font-size: 0.88rem; }
    .resp dt { color: var(--ink-muted); }
    .resp dd { overflow-wrap: anywhere; }
    .resp ul { margin: 0; padding-left: 18px; }
    @media (max-width: 600px) { .ask .row { grid-template-columns: 1fr; } .resp dl { grid-template-columns: 1fr; gap: 2px; } .resp dd { margin-bottom: 8px; } }

    /* — Work lifecycle — */
    .work { border-top: 1px solid var(--border); padding: 14px 0; }
    .work:first-of-type { border-top: none; }
    .work-head { display: flex; gap: 8px; align-items: baseline; }
    .work-title { flex: 1; overflow-wrap: anywhere; font-weight: 500; }
    .work-meta { font-size: 0.78rem; color: var(--ink-muted); margin: 2px 0 6px; overflow-wrap: anywhere; }
    .state { font-size: 0.85rem; margin-bottom: 8px; }
    .state b { padding: 1px 8px; border-radius: 4px; background: #F1ECE2; margin-right: 4px; }
    .state-resolved b { background: #FFF3E0; color: #E65100; }
    .state-verification b { background: #E3F2FD; color: #1565C0; }
    .state-closed b { background: #E8F5E9; color: #2E7D32; }
    details.act > summary.btn { display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; border-radius: 8px; border: 1px solid var(--ink); background: var(--ink); color: var(--paper); cursor: pointer; list-style: none; font-size: 1rem; }
    details > summary::-webkit-details-marker { display: none; }
    details.hist > summary { display: flex; align-items: center; min-height: 44px; color: var(--ink-muted); font-size: 0.85rem; cursor: pointer; list-style: none; }
    details.hist ol { padding-left: 20px; font-size: 0.8rem; color: var(--ink-muted); overflow-wrap: anywhere; }
    form.lc { margin-top: 10px; display: grid; gap: 10px; }
    form.lc label { display: block; font-size: 0.8rem; color: var(--ink-muted); }
    form.lc select, form.lc textarea, form.lc input { display: block; width: 100%; margin-top: 4px; min-height: 44px; font: inherit; font-size: 1rem; padding: 10px 12px; border: 1px solid var(--border); border-radius: 8px; background: var(--paper); color: var(--ink); }
    form.lc textarea { min-height: 88px; resize: vertical; }
    form.lc button { min-height: 44px; padding: 0 20px; border-radius: 8px; border: 1px solid var(--ink); background: var(--ink); color: var(--paper); font: inherit; font-size: 1rem; cursor: pointer; justify-self: start; }
    form.lc button[disabled] { opacity: 0.55; cursor: default; }
    .lc-msg { font-size: 0.85rem; min-height: 1.2em; }

    /* — Mobile-first responsive — */
    @media (max-width: 600px) {
      .shell { padding: 16px 16px 48px; }
      h1 { font-size: 1.25rem; }
      .kpi-row { grid-template-columns: repeat(2, 1fr); gap: 8px; }
      .kpi-val { font-size: 1.3rem; }
      .card { padding: 14px; }
      .pipeline { grid-template-columns: repeat(4, 1fr); gap: 6px; }
      .stage { padding: 8px 4px; }
      .stage-count { font-size: 1.1rem; }
      .stage-label { font-size: 0.65rem; }
      .item-row { flex-wrap: wrap; gap: 4px; padding: 10px 0; }
      .item-row span[style*="flex:1"] { width: 100%; flex: none !important; order: -1; font-weight: 500; }
      .agent-grid { grid-template-columns: 1fr; }
      .brand-grid { grid-template-columns: 1fr; }
      .tabs { gap: 6px; }
      .tab { padding: 8px 12px; font-size: 0.8rem; }
    }

    @media (max-width: 390px) {
      .pipeline { grid-template-columns: repeat(2, 1fr); }
      .kpi-row { grid-template-columns: 1fr 1fr; }
    }
  </style>
</head>
<body>
<div class="vm-band"></div>
  <div class="shell">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/retail-os/admin/console">Command Centre</a>
      <span class="sep" aria-hidden="true">›</span>
      {tab === 'board' ? (
        <span class="current">Control Tower</span>
      ) : (
        <a href="?tab=board">Control Tower</a>
      )}
      {tab !== 'board' && (
        <>
          <span class="sep" aria-hidden="true">›</span>
          <span class="current">{TAB_LABEL[tab]}</span>
        </>
      )}
    </nav>

    <h1>Founder Control Tower</h1>
    <p class="subtitle">DevShop Retail OS — {now.toISOString().slice(0, 10)} — Operating view. Only the Ask the CEO tab writes, through the CEO runtime</p>

    <div class="tabs" role="tablist">
      <a class={`tab ${tab === 'board' ? 'active' : ''}`} href="?tab=board" role="tab" aria-selected={tab === 'board'}>Morning Board</a>
      <a class={`tab ${tab === 'pipeline' ? 'active' : ''}`} href="?tab=pipeline" role="tab" aria-selected={tab === 'pipeline'}>Work Pipeline</a>
      <a class={`tab ${tab === 'agents' ? 'active' : ''}`} href="?tab=agents" role="tab" aria-selected={tab === 'agents'}>Agents</a>
      <a class={`tab ${tab === 'brands' ? 'active' : ''}`} href="?tab=brands" role="tab" aria-selected={tab === 'brands'}>Brands</a>
      <a class={`tab ${tab === 'ceo' ? 'active' : ''}`} href="?tab=ceo" role="tab" aria-selected={tab === 'ceo'}>Ask the CEO</a>
    </div>

    {dataSource === 'supabase' ? (
      <div class="notice" style="background:#E8F5E9;border-color:#A5D6A7;color:#1B5E20">
        Data source: control-plane Work Registry (Supabase). {registry.list().length} work items loaded.
      </div>
    ) : (
      <div class="notice">
        {loadError === 'Supabase not configured'
          ? 'Work Registry database not configured. Showing empty state. Configure SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY to connect.'
          : `Work Registry unavailable: ${loadError}. Showing empty state.`}
      </div>
    )}

    {tab === 'board' && (
      <div>
        <div class="kpi-row">
          <div class="kpi">
            <div class="kpi-val">{board.total_open_work}</div>
            <div class="kpi-label">Open work</div>
          </div>
          <div class="kpi">
            <div class="kpi-val" style={board.critical_count > 0 ? 'color:var(--tag-p0)' : ''}>{board.critical_count}</div>
            <div class="kpi-label">Critical</div>
          </div>
          <div class="kpi">
            <div class="kpi-val" style={board.blocked_count > 0 ? 'color:var(--tag-p1)' : ''}>{board.blocked_count}</div>
            <div class="kpi-label">Blocked</div>
          </div>
          <div class="kpi">
            <div class="kpi-val" style={board.pending_approval_count > 0 ? 'color:var(--terracotta)' : ''}>{board.pending_approval_count}</div>
            <div class="kpi-label">Pending approval</div>
          </div>
        </div>

        <div class="card">
          <h2>Material Exceptions</h2>
          {board.items.length === 0 ? (
            <p class="empty">No material exceptions. All clear.</p>
          ) : (
            board.items.map((item: MorningBoardItem) => (
              <div class="item-row">
                <span class={`tag tag-${(item.priority ?? 'p4').toLowerCase()}`}>{item.priority ?? '—'}</span>
                <span class="tag tag-cat">{CATEGORY_LABEL[item.category] ?? item.category}</span>
                <span style="flex:1">{item.title}</span>
                {item.brand && <span style="font-size:0.78rem;color:var(--ink-muted)">{BRAND_LABEL[item.brand] ?? item.brand}</span>}
              </div>
            ))
          )}
        </div>

        {board.brands_with_issues.length > 0 && (
          <div class="card">
            <h3>Brands with issues</h3>
            <p style="font-size:0.85rem">{board.brands_with_issues.map((b: string) => BRAND_LABEL[b] ?? b).join(', ')}</p>
          </div>
        )}
      </div>
    )}

    {tab === 'pipeline' && (
      <div>
        <div class="card">
          <h2>Work Pipeline — {view.total} open items</h2>
          <div class="pipeline">
            {CONTROL_TOWER_STAGES.map((stage: ControlTowerStage) => (
              <div class="stage">
                <div class="stage-count">{stage === 'learn' ? closedCount : view.byStage[stage].length}</div>
                <div class="stage-label">{STAGE_LABEL[stage] ?? stage}</div>
              </div>
            ))}
          </div>
        </div>

        <div class="card">
          <h3>Critical items</h3>
          {view.critical.length === 0 ? (
            <p class="empty">No P0/P1 items.</p>
          ) : (
            view.critical.map((w: WorkSummary) => (
              <div class="item-row">
                <span class={`tag tag-${(w.priority ?? 'p4').toLowerCase()}`}>{w.priority}</span>
                <span style="flex:1">{w.title}</span>
                <span style="font-size:0.78rem;color:var(--ink-muted)">{w.state}</span>
              </div>
            ))
          )}
        </div>

        <div class="card">
          <h3>Blocked</h3>
          {view.blocked.length === 0 ? (
            <p class="empty">Nothing blocked.</p>
          ) : (
            view.blocked.map((w: WorkSummary) => (
              <div class="item-row">
                <span style="flex:1">{w.title}</span>
                <span style="font-size:0.78rem;color:var(--ink-muted)">{BRAND_LABEL[w.brand ?? ''] ?? w.brand ?? 'DevShop'}</span>
              </div>
            ))
          )}
        </div>

        <div class="card">
          <h3>Pending approval</h3>
          {view.pendingApproval.length === 0 ? (
            <p class="empty">No pending approvals.</p>
          ) : (
            view.pendingApproval.map((w: WorkSummary) => (
              <div class="item-row">
                <span style="flex:1">{w.title}</span>
              </div>
            ))
          )}
        </div>

        <div class="card" id="work">
          <h3>Work</h3>
          <p class="empty" style="margin-bottom:8px">Move Work along its lifecycle. Closing needs verification and evidence.</p>
          {openWork.length === 0 ? (
            <p class="empty">No open work.</p>
          ) : (
            openWork.slice(0, MAX_OPEN_SHOWN).map((i) => (
              <article class="work">
                <div class="work-head">
                  <span class={`tag tag-${(i.priority ?? 'p4').toLowerCase()}`}>{i.priority ?? '—'}</span>
                  <strong class="work-title">{i.title}</strong>
                </div>
                <div class="work-meta">{i.ref} · {BRAND_LABEL[i.scope.brand ?? ''] ?? i.scope.brand ?? 'DevShop'} · owner {i.owner?.id ?? 'none'}</div>
                <div class={`state state-${i.state}`}><b>{STATE_MEANING[i.state]?.label ?? i.state}</b> {STATE_MEANING[i.state]?.note}</div>
                {NEXT_ACTION[i.state] && (
                  <details class="act">
                    <summary class="btn">{NEXT_ACTION[i.state].button}</summary>
                    <form class="lc" data-work={i.ref} data-action={NEXT_ACTION[i.state].action}>
                      {NEXT_ACTION[i.state].action === 'resolve' && (
                        <>
                          <label>How it ended
                            <select name="resolution_kind">
                              <option value="completed">Completed</option>
                              <option value="fixed">Fixed</option>
                              <option value="workaround">Workaround</option>
                              <option value="declined">Declined</option>
                              <option value="wont_do">Won't do</option>
                              <option value="not_reproducible">Not reproducible</option>
                            </select>
                          </label>
                          <label>What was done
                            <textarea name="summary" required maxlength="1000"></textarea>
                          </label>
                        </>
                      )}
                      {NEXT_ACTION[i.state].action === 'verify' && (
                        <label>Note (optional)
                          <textarea name="summary" maxlength="1000"></textarea>
                        </label>
                      )}
                      {NEXT_ACTION[i.state].action === 'close' && (
                        <>
                          <label>How it was checked
                            <input name="method" type="text" required maxlength="300" autocomplete="off" />
                          </label>
                          <label>What you saw (the evidence)
                            <textarea name="evidence" required maxlength="1000"></textarea>
                          </label>
                        </>
                      )}
                      <button type="submit">Confirm</button>
                      <p class="lc-msg" role="status"></p>
                    </form>
                  </details>
                )}
                <details class="hist">
                  <summary>History ({i.events.length} events)</summary>
                  <ol>{i.events.slice(-12).map((e) => <li>{day(e.at)} · {e.kind}{e.to ? ` → ${e.to}` : ''} · {e.actor.id}</li>)}</ol>
                </details>
              </article>
            ))
          )}
          {openWork.length > MAX_OPEN_SHOWN && <p class="empty">Showing {MAX_OPEN_SHOWN} of {openWork.length} open items, most urgent first.</p>}

          <h3 style="margin-top:20px">Recently closed</h3>
          {closedWork.length === 0 ? (
            <p class="empty">Nothing closed yet.</p>
          ) : (
            closedWork.map((i) => (
              <article class="work">
                <div class="work-head"><strong class="work-title">{i.title}</strong></div>
                <div class="work-meta">{i.ref} · {BRAND_LABEL[i.scope.brand ?? ''] ?? i.scope.brand ?? 'DevShop'} · closed {i.closed_at ? day(i.closed_at) : ''}{i.closure ? ` · verified by ${i.closure.verified_by.id}` : ''}</div>
                <div class="state state-closed"><b>CLOSED</b> {STATE_MEANING.closed.note}</div>
                <details class="hist">
                  <summary>History ({i.events.length} events)</summary>
                  <ol>{i.events.slice(-12).map((e) => <li>{day(e.at)} · {e.kind}{e.to ? ` → ${e.to}` : ''} · {e.actor.id}</li>)}</ol>
                  {i.closure && <p class="work-meta">Checked: {i.closure.method}</p>}
                </details>
              </article>
            ))
          )}
        </div>
      </div>
    )}

    {tab === 'agents' && (
      <div>
        <div class="card">
          <h2>Agent Organisation</h2>
          <p style="font-size:0.85rem;color:var(--ink-muted);margin-bottom:16px">DS-00 Virat (founder) → DS-01 Myoho (guardian) → DS-02 Dev (CEO)</p>

          <h3>Brand CEOs (report to Dev)</h3>
          <div class="agent-grid" style="margin-bottom:20px">
            {brandCeos.map((a) => (
              <div class="agent-card">
                <div class="agent-id">{a.id}</div>
                <div class="agent-name">{a.name}</div>
                <div class="agent-role">{a.scope?.brand ? (BRAND_LABEL[a.scope.brand] ?? a.scope.brand) : 'Brand CEO'}</div>
                <div style="font-size:0.72rem;color:var(--ink-muted);margin-top:4px">{BRAND_STATUS[a.scope?.brand ?? ''] ?? '—'}</div>
              </div>
            ))}
          </div>

          <h3>Function heads (report to Dev)</h3>
          <div class="agent-grid">
            {hods.map((a) => (
              <div class="agent-card">
                <div class="agent-id">{a.id}</div>
                <div class="agent-name">{a.name}</div>
                <div class="agent-role">{a.capabilities.join(', ')}</div>
              </div>
            ))}
          </div>
        </div>

        <div class="card">
          <h2>CEO Autonomy Grants</h2>
          <div style="font-size:0.82rem">
            {CEO_AUTONOMY.map((g) => (
              <div class="item-row">
                <span style="font-weight:600;min-width:60px">{g.level}</span>
                <span style="flex:1">{g.capability}</span>
                <span style="font-size:0.78rem;color:var(--ink-muted)">{g.holder}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    )}

    {tab === 'brands' && (
      <div>
        <div class="card">
          <h2>Brand Portfolio</h2>
          <div class="brand-grid">
            {Object.entries(BRAND_LABEL).map(([key, name]) => (
              <div class="brand-card">
                <div class="brand-name">{name}</div>
                <div class={`brand-status ${BRAND_STATUS[key]?.includes('Live') ? 'brand-live' : BRAND_STATUS[key]?.includes('Staged') ? 'brand-staged' : 'brand-impl'}`}>
                  {BRAND_STATUS[key]}
                </div>
                <div class="brand-work">{view.byBrand[key]?.length ?? 0} open work items</div>
                {brandCeos.find((a) => a.scope?.brand === key) && (
                  <div style="font-size:0.78rem;color:var(--gold);margin-top:4px">
                    {brandCeos.find((a) => a.scope?.brand === key)!.id} {brandCeos.find((a) => a.scope?.brand === key)!.name}
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>
    )}

    {tab === 'ceo' && (
      <div class="ask">
        <div class="card">
          <h2>Ask the CEO</h2>
          <p class="subtitle" style="margin-bottom:12px">Dev (DS-02) checks existing Work first, then your authority rules. Nothing is sent, deployed or spent from here.</p>
          <form id="ceo-form">
            <label for="ceo-text">Request, question, approval or decision</label>
            <textarea id="ceo-text" maxlength="2000" required></textarea>
            <div class="row">
              <div>
                <label for="ceo-brand">Brand (optional)</label>
                <select id="ceo-brand">
                  <option value="">No brand</option>
                  {Object.entries(BRAND_LABEL).map(([key, name]) => <option value={key}>{name}</option>)}
                </select>
              </div>
              <div>
                <label for="ceo-work">Work reference (optional)</label>
                <input id="ceo-work" type="text" autocomplete="off" />
              </div>
            </div>
            <button type="submit" id="ceo-send">Send to the CEO</button>
          </form>
        </div>
        <div class="card resp" id="ceo-result" hidden aria-live="polite"></div>
      </div>
    )}

    <p style="margin-top:32px;font-size:0.72rem;color:var(--ink-muted);text-align:center">
      Founder Control Tower · DevShop Retail OS · Source: {dataSource === 'supabase' ? 'Control-plane Work Registry' : 'Empty (not connected)'}
    </p>
  </div>

  <script>
    const form = document.getElementById('ceo-form');
    if (form) {
      const out = document.getElementById('ceo-result');
      const btn = document.getElementById('ceo-send');
      const row = (dl, k, v) => { if (v === null || v === undefined || v === '') return; const dt = document.createElement('dt'); dt.textContent = k; const dd = document.createElement('dd'); dd.textContent = v; dl.append(dt, dd); };
      const ref = (w) => w ? `${w.ref} "${w.title}" (${w.state}${w.priority ? ', ' + w.priority : ''}${w.owner ? ', owner ' + w.owner : ''})` : null;
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        btn.disabled = true; btn.textContent = 'Working…';
        out.hidden = false; out.replaceChildren();
        try {
          const res = await fetch('/retail-os/api/admin/ceo-input', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ text: document.getElementById('ceo-text').value, brand: document.getElementById('ceo-brand').value || null, work_id: document.getElementById('ceo-work').value || null }) });
          const d = await res.json();
          if (!res.ok) { out.textContent = d.error || 'Something went wrong'; return; }
          const dl = document.createElement('dl');
          row(dl, 'Understood', `${d.understood.kind}, ${d.understood.urgency}${d.understood.brand ? ', ' + d.understood.brand : ''}`);
          row(dl, 'Result', d.outcome.summary);
          row(dl, 'Work', ref(d.work));
          row(dl, 'Existing Work reused', d.outcome.reusedExistingWork ? 'Yes' : 'No');
          row(dl, 'Authority', `${d.authority.capability} ${d.authority.level}${d.authority.allowed ? ', CEO may act' : ', needs ' + d.authority.holder}`);
          if (d.routing) row(dl, 'Routing', `${d.routing.function} to ${d.routing.roleLabel} (current holder: ${d.routing.currentHolders.join(', ')}); approval ${d.routing.approval.authority} from ${d.routing.approval.from}`);
          if (d.question) row(dl, 'Question', `${d.question.text} (routed to ${d.question.routedTo})`);
          row(dl, 'Escalation', d.escalation.required ? 'Needs your decision' : 'None');
          row(dl, 'Next step', d.nextStep);
          if (d.context.relatedWork.length) row(dl, 'Related Work', d.context.relatedWork.map(ref).join(' | '));
          out.append(dl);
          if (d.audit.length) { const h = document.createElement('h3'); h.textContent = 'Audit'; h.style.marginTop = '12px'; const ul = document.createElement('ul'); for (const a of d.audit) { const li = document.createElement('li'); li.textContent = a; ul.append(li); } out.append(h, ul); }
          if (d.outcome.mutationApplied) { const p = document.createElement('p'); p.style.marginTop = '12px'; const a = document.createElement('a'); a.href = '?tab=pipeline'; a.textContent = 'See it in the Work Pipeline'; p.append(a); out.append(p); }
        } catch { out.textContent = 'Could not reach the CEO runtime. Try again.'; }
        finally { btn.disabled = false; btn.textContent = 'Send to the CEO'; }
      });
    }
  </script>

  <script>
    document.querySelectorAll('form.lc').forEach((form) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = form.querySelector('button');
        const msg = form.querySelector('.lc-msg');
        const f = new FormData(form);
        const action = form.dataset.action;
        const body = { work: form.dataset.work, action };
        const text = (k) => String(f.get(k) || '').trim();
        if (text('summary')) body.summary = text('summary');
        if (text('resolution_kind')) body.resolution_kind = text('resolution_kind');
        if (action === 'close') { body.method = text('method'); body.evidence = [{ kind: 'note', ref: 'founder-review:' + form.dataset.work, summary: text('evidence') }]; }
        btn.disabled = true; msg.textContent = 'Working…';
        try {
          const res = await fetch('/retail-os/api/admin/work-lifecycle', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
          const d = await res.json();
          if (!res.ok) { msg.textContent = d.error || 'Something went wrong'; btn.disabled = false; return; }
          msg.textContent = 'Done: ' + d.work.state;
          window.location.reload();
        } catch { msg.textContent = 'Could not reach the lifecycle service. Try again.'; btn.disabled = false; }
      });
    });
  </script>
</body>
</html>
