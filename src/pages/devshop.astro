---
// /devshop — Fast Tech Dev Shop landing + product prototype.
//
// This page intentionally does NOT use Base.astro / Nav.astro / Footer.astro:
// the source prototype (devshop-prototype.html) specifies its own dark design
// system, distinct from the rest of viratmohan.com's light theme. It is not
// linked from the main site nav per instruction — reachable only by direct URL.
//
// SCOPE NOTE: everything from "Login" onward (Dashboard, Orchestrator,
// Integrations, Activity, Billing) is a UI-only front-end simulation.
// There is no real auth, no Claude API call, no per-tool OAuth, no background
// job execution, and no persistence — see inline comments in the <script>
// below for exactly which parts are fake and what real backend work
// (API orchestration, OAuth per integration, a job execution layer, a DB)
// would be needed to make them real. That work is out of scope for this pass.

import { site } from '../data/site';

// ---- Easily-editable config, per prompt instructions ----
const CURRENCY = '₹'; // TODO: confirm ₹ vs $ before this goes live
const PRICING = {
  buildLow: '1,00,000',
  buildHigh: '10,00,000',
  retainerMin: '50,000',
};

// TODO: confirm these four case studies are cleared for public naming
// (client sign-off) before treating this copy as final.
const proof = [
  { name: 'Travaholic', result: 'D2C infrastructure live in 2 days' },
  { name: 'The Feeling Co.', result: 'Full digital operation — 9 releases, zero external subscriptions' },
  { name: 'India Contemporary', result: 'Two-sided marketplace connecting artists to collectors' },
  { name: 'ClarityHQ', result: 'Internal campaign builder, now licensed to other agencies' },
];

// Full-colour icon marks for the Integrations screen only (per instruction —
// every other screen, especially Proof, stays logo-free). Simple inline SVGs
// evoking each tool's real brand colours/marks; CRM uses a generic mark since
// "CRM" isn't a single product here.
const CRM_LOGO = `<svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"><rect width="40" height="40" rx="6" fill="#91AFC0"/><circle cx="20" cy="15" r="6" fill="#15130F"/><path d="M8 32c0-6.6 5.4-12 12-12s12 5.4 12 12" fill="#15130F"/></svg>`;

const SHEETS_LOGO = `<svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"><rect width="40" height="40" rx="6" fill="#0F9D58"/><rect x="10" y="7" width="20" height="26" rx="2" fill="#F5F5F0"/><rect x="13" y="11" width="14" height="2.2" fill="#0F9D58"/><rect x="13" y="16" width="14" height="2.2" fill="#0F9D58"/><rect x="13" y="21" width="14" height="2.2" fill="#0F9D58"/><rect x="13" y="26" width="14" height="2.2" fill="#0F9D58"/><rect x="18.9" y="11" width="2.2" height="17.2" fill="#0F9D58"/></svg>`;

const SLACK_LOGO = `<svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"><rect width="40" height="40" rx="6" fill="#15130F"/><path d="M15.5 24.5a2.5 2.5 0 1 1-2.5-2.5h2.5v2.5z" fill="#E01E5A"/><path d="M16.75 24.5a2.5 2.5 0 1 1 5 0v6.25a2.5 2.5 0 1 1-5 0V24.5z" fill="#E01E5A"/><path d="M17 15.5a2.5 2.5 0 1 1 2.5-2.5v2.5H17z" fill="#36C5F0"/><path d="M17 16.75a2.5 2.5 0 1 1 0 5h-6.25a2.5 2.5 0 1 1 0-5H17z" fill="#36C5F0"/><path d="M25.5 17a2.5 2.5 0 1 1 2.5 2.5H25.5V17z" fill="#2EB67D"/><path d="M24.25 17a2.5 2.5 0 1 1-5 0v-6.25a2.5 2.5 0 1 1 5 0V17z" fill="#2EB67D"/><path d="M24 25.5a2.5 2.5 0 1 1-2.5 2.5V25.5H24z" fill="#ECB22E"/><path d="M24 24.25a2.5 2.5 0 1 1 0-5h6.25a2.5 2.5 0 1 1 0 5H24z" fill="#ECB22E"/></svg>`;

const EMAIL_LOGO = `<svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"><rect width="40" height="40" rx="6" fill="#F5F5F0"/><path d="M7 12h26v18a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V12z" fill="#EA4335"/><path d="M7 12l13 10 13-10" fill="none" stroke="#F5F5F0" stroke-width="2"/><path d="M7 12l13 10 13-10" fill="#FBBC05"/><path d="M7 12a2 2 0 0 1 2-2h22a2 2 0 0 1 2 2l-13 10L7 12z" fill="#EA4335"/></svg>`;

const title = 'Fast Tech Dev Shop — problem in, demo in 24 hours';
const description =
  "Tell us the P&L, marketing, or ops problem. Demo in 24 hours. Working build in 7 days. Priced monthly, not by project.";
const canonical = new URL('/devshop', site.domain).href;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="noindex, follow" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
</head>
<body>

<header>
  <div class="header-inner">
    <div class="logo">FAST TECH DEV SHOP</div>
    <nav id="marketingNav">
      <a href="#" data-go="how-it-works">How it works</a>
      <a href="#" data-go="proof">Proof</a>
      <a href="#" data-go="pricing">Pricing</a>
      <a href="#" data-go="intake" class="start-link">Start →</a>
    </nav>
    <nav id="appNav" style="display:none;">
      <a href="#" data-go="dashboard">Dashboard</a>
      <a href="#" data-go="orchestrator">Orchestrator</a>
      <a href="#" data-go="integrations">Integrations</a>
      <a href="#" data-go="activity">Activity</a>
      <a href="#" data-go="billing">Billing</a>
      <a href="#" data-go="landing" class="btn-plain" style="margin-left:8px;">Log out</a>
    </nav>
  </div>
  <div class="header-hair"></div>
</header>

<main class="wrap">

  <!-- 01 LANDING -->
  <section class="screen active" id="landing" data-marketing-index="1">
    <div class="eyebrow">AI ORCHESTRATION STUDIO</div>
    <h1 class="hero serif">Tell us the <span class="tint-blue">problem.</span><br />Get a demo in <span class="tint-gold">24 hours.</span></h1>
    <form class="input-row" id="landingForm">
      <input type="text" id="landingProblem" placeholder="What's the problem?" />
      <button class="btn" type="submit">Submit</button>
    </form>
    <p class="sub">No proposal. No scoping call. Just show us what's broken.</p>
    <div class="footer-bar"><span>Built fast / for real business</span><span class="page-count"></span></div>
  </section>

  <!-- 02 HOW IT WORKS -->
  <section class="screen" id="how-it-works" data-marketing-index="2">
    <div class="eyebrow">HOW IT WORKS</div>
    <h1 class="hero serif">From <span class="tint-blue">problem</span><br />to production. <span class="tint-gold">Fast.</span></h1>
    <div class="steps">
      <div class="step"><div class="num">01</div><div class="rule"></div><h3>Problem in</h3><p>Tell us what's broken.<br />No specs. No decks.</p></div>
      <div class="step"><div class="num">02</div><div class="rule"></div><h3><span class="tint-gold">24h</span> demo</h3><p>We build and show you<br />a working demo in 24 hours.</p></div>
      <div class="step"><div class="num">03</div><div class="rule"></div><h3>7-day build</h3><p>You give feedback.<br />We build and ship in 7 days.</p></div>
    </div>
    <div class="footer-bar"><span>Built fast / for real business</span><span class="page-count"></span></div>
  </section>

  <!-- 03 PROOF -->
  <section class="screen" id="proof" data-marketing-index="3">
    <div class="eyebrow">PROOF</div>
    <h1 class="hero serif">Built fast. <span class="tint-blue">Shipped</span> for real.</h1>
    <div class="proof-list">
      {proof.map((p) => (
        <div class="proof-row"><div class="name">{p.name}</div><div class="result">{p.result}</div></div>
      ))}
    </div>
    <div class="footer-bar"><span>Built fast / for real business</span><span class="page-count"></span></div>
  </section>

  <!-- 04 PRICING -->
  <section class="screen" id="pricing" data-marketing-index="4">
    <div class="eyebrow">PRICING</div>
    <div class="pricing-block">
      <h1 class="hero serif" style="font-size:clamp(36px,5vw,72px);">Build once.<br />Run on a <span class="tint-gold">retainer.</span></h1>
      <div style="display:flex; gap:64px; margin-top:48px; flex-wrap:wrap;">
        <div>
          <div class="eyebrow" style="margin-bottom:14px;">ONE-TIME BUILD</div>
          <div class="serif" style="font-size:clamp(28px,3.2vw,44px);">{CURRENCY}{PRICING.buildLow} – {CURRENCY}{PRICING.buildHigh}</div>
          <p class="sub" style="max-width:340px;">Depending on complexity.</p>
        </div>
        <div>
          <div class="eyebrow" style="margin-bottom:14px;">MONTHLY RETAINER</div>
          <div class="serif" style="font-size:clamp(28px,3.2vw,44px);"><span class="tint-gold">{CURRENCY}{PRICING.retainerMin}</span> minimum</div>
          <p class="sub" style="max-width:340px;">Scales with project spec and requirements.</p>
        </div>
      </div>
      <p class="sub" style="margin-top:36px;">Variable / custom pricing available outside this range. No proposals. No scoping calls.</p>
      <div style="margin-top:40px;"><button class="btn" data-go="intake">Start →</button></div>
    </div>
    <div class="footer-bar"><span>Built fast / for real business</span><span class="page-count"></span></div>
  </section>

  <!-- 05 INTAKE -->
  <section class="screen" id="intake" data-marketing-index="5">
    <div class="eyebrow">START</div>
    <h1 class="hero serif" style="max-width:760px;">Describe the problem,<br />not the spec.</h1>
    <form class="intake-form" id="intakeForm">
      <div class="field">
        <textarea name="problem" placeholder="Tell us what isn't working, what takes too long, or what you wish existed. More than one problem? List them all — we'll solve for each." required></textarea>
      </div>
      <div class="field"><label>Company</label><input type="text" name="company" placeholder="Company name" /></div>
      <div class="field"><label>Your website</label><input type="text" name="website" placeholder="company.com — optional, helps us match your brand" /></div>
      <div class="field"><label>What tools do you currently use?</label><input type="text" name="tools" placeholder="CRM, sheets, comms platform, etc." /></div>
      <div class="field"><label>Where should the demo go</label><input type="email" name="email" placeholder="you@company.com" required /></div>
      <div><button type="submit" class="btn" id="intakeSubmitBtn">Submit →</button></div>
      <p class="sub" id="intakeError" style="display:none; color:var(--dev-rose);"></p>
    </form>
    <div class="footer-bar"><span>Built fast / for real business</span><span class="page-count"></span></div>
  </section>

  <!-- 05b CONFIRMATION — real intake landed, no fake login/dashboard after this -->
  <section class="screen" id="confirmation">
    <div class="eyebrow">RECEIVED</div>
    <h1 class="hero serif" style="max-width:760px;">Got it. <span class="tint-gold">Watch your inbox.</span></h1>
    <p class="sub" style="max-width:560px;">We're working the problem through the orchestrator now. A demo — and one round of feedback before we build — lands in your inbox within 24 hours.</p>
    <div style="margin-top:40px;"><a href="#" data-go="landing" class="btn-plain">← Back to start</a></div>
    <div class="footer-bar"><span>Built fast / for real business</span><span class="page-count"></span></div>
  </section>

  <!-- 06 LOGIN (UI-only — no real auth, see script comments) -->
  <section class="screen" id="login" style="justify-content:center;">
    <div class="login-box">
      <h2 class="serif">Welcome back.</h2>
      <form id="loginForm">
        <div class="field"><label>Email</label><input type="email" placeholder="you@company.com" required /></div>
        <button type="submit" class="btn" style="width:100%;">Send magic link →</button>
      </form>
    </div>
  </section>

  <!-- 07 DASHBOARD (UI-only — static demo data, no backend) -->
  <section class="screen" id="dashboard">
    <div class="eyebrow">PROJECT</div>
    <h1 class="hero serif" style="font-size:clamp(32px,4.4vw,52px);">Lead Intelligence Orchestrator</h1>
    <div class="tracker">
      <div class="node"><div class="dot-row"><div class="dot done"></div><div class="line done"></div></div><div class="label done">01 Problem received</div></div>
      <div class="node"><div class="dot-row"><div class="dot now"></div><div class="line"></div></div><div class="label now">02 Demo ready</div></div>
      <div class="node"><div class="dot-row"><div class="dot"></div><div class="line"></div></div><div class="label">03 Building</div></div>
      <div class="node"><div class="dot-row"><div class="dot"></div></div><div class="label">04 Live</div></div>
    </div>
    <div><button class="btn" data-go="orchestrator">View demo →</button></div>
    <p class="sub" style="margin-top:24px; max-width:620px;">One round of feedback before we build. Approving the demo is the scope document — there's no separate proposal.</p>
    <div class="activity-box">
      <div class="h">LAST ACTIVITY</div>
      <div class="line">Connected to CRM</div>
      <div class="line">Demo generated</div>
      <div class="line">Awaiting your feedback</div>
    </div>
  </section>

  <!-- 08 ORCHESTRATOR (UI-only — scripted log, no real Claude API call) -->
  <section class="screen" id="orchestrator">
    <div style="display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:12px;">
      <div class="eyebrow" style="margin-bottom:0;">LEAD INTELLIGENCE ORCHESTRATOR</div>
      <div class="app-status" id="orchStatus">BUILDING</div>
    </div>
    <div class="orch-problem">
      <div class="eyebrow" style="margin-bottom:10px;">ORIGINAL PROBLEM</div>
      <div class="q serif">"We have 90 days of CRM data but our sales team has no clear view of which leads need attention."</div>
    </div>
    <div class="orch-log">
      <div class="h">ORCHESTRATOR ACTIVITY <span class="sim-tag">(simulated)</span></div>
      <div id="logContainer"></div>
    </div>
    <div class="orch-input-row">
      <input type="text" id="orchInput" placeholder="Ask the orchestrator anything…" />
      <button class="btn" id="orchRunBtn">Run →</button>
    </div>
    <p class="sub" style="margin-top:20px; max-width:620px;">One round of feedback before we build — approve this demo and the 7-day build starts against it.</p>
  </section>

  <!-- 09 INTEGRATIONS (UI-only — no real OAuth, connect state is client-side only) -->
  <section class="screen" id="integrations">
    <div class="eyebrow">CONNECT THE TOOLS</div>
    <h1 class="hero serif" style="font-size:clamp(32px,4.4vw,52px);">Connect the tools.</h1>
    <div class="int-list">
      <div class="int-row">
        <div class="int-left">
          <span class="int-logo" aria-hidden="true" set:html={CRM_LOGO} />
          <div><div class="name">CRM</div><div class="desc">Your customer and pipeline data.</div></div>
        </div>
        <button class="btn connect-btn">Connect</button>
      </div>
      <div class="int-row">
        <div class="int-left">
          <span class="int-logo" aria-hidden="true" set:html={SHEETS_LOGO} />
          <div><div class="name">Google Sheets</div><div class="desc">Read and write operational data.</div></div>
        </div>
        <button class="btn connect-btn">Connect</button>
      </div>
      <div class="int-row">
        <div class="int-left">
          <span class="int-logo" aria-hidden="true" set:html={SLACK_LOGO} />
          <div><div class="name">Slack</div><div class="desc">Bring workflows into the team's workspace.</div></div>
        </div>
        <button class="btn connect-btn">Connect</button>
      </div>
      <div class="int-row">
        <div class="int-left">
          <span class="int-logo" aria-hidden="true" set:html={EMAIL_LOGO} />
          <div><div class="name">Email</div><div class="desc">Send updates and trigger workflows.</div></div>
        </div>
        <button class="btn connect-btn">Connect</button>
      </div>
    </div>
  </section>

  <!-- 10 ACTIVITY (UI-only — static log lines, no real job execution layer) -->
  <section class="screen" id="activity">
    <div class="eyebrow">AGENT ACTIVITY <span class="sim-tag">(simulated)</span></div>
    <div class="activity-box" style="max-width:760px;">
      <div class="line" style="color:var(--gold);"><span class="mono">09:42:16&nbsp;&nbsp;RUNNING&nbsp;&nbsp;&nbsp;&nbsp;Opportunity scoring</span></div>
      <div class="line mono">09:42:14&nbsp;&nbsp;COMPLETE&nbsp;&nbsp;&nbsp;Priority summary drafted</div>
      <div class="line mono">09:42:11&nbsp;&nbsp;COMPLETE&nbsp;&nbsp;&nbsp;Inactive opportunities identified</div>
      <div class="line mono">09:42:07&nbsp;&nbsp;COMPLETE&nbsp;&nbsp;&nbsp;Lead records normalized</div>
      <div class="line mono">09:42:04&nbsp;&nbsp;COMPLETE&nbsp;&nbsp;&nbsp;90 days of CRM data pulled</div>
      <div class="line mono">09:42:01&nbsp;&nbsp;COMPLETE&nbsp;&nbsp;&nbsp;CRM connection established</div>
    </div>
  </section>

  <!-- 11 BILLING (UI-only — static rows, no real billing system) -->
  <section class="screen" id="billing">
    <div class="eyebrow">BILLING</div>
    <h1 class="hero serif" style="font-size:clamp(32px,4.4vw,52px);">Fast Tech Dev Shop</h1>
    <div class="billing-summary">
      <div class="item"><div class="l">MONTHLY</div><div class="v">{CURRENCY}{PRICING.retainerMin}</div></div>
      <div class="item"><div class="l">NEXT BILLING</div><div class="v">04 Oct 2026</div></div>
    </div>
    <table>
      <tr><th>Date</th><th>Amount</th><th>Status</th></tr>
      <tr><td>04 Sep 2026</td><td>{CURRENCY}{PRICING.retainerMin}</td><td class="status">Paid</td></tr>
      <tr><td>04 Aug 2026</td><td>{CURRENCY}{PRICING.retainerMin}</td><td class="status">Paid</td></tr>
      <tr><td>04 Jul 2026</td><td>{CURRENCY}{PRICING.retainerMin}</td><td class="status">Paid</td></tr>
    </table>
  </section>

</main>

<style>
  /* Scoped design system for /devshop only — intentionally distinct from the
     rest of viratmohan.com, per the source prototype's dark palette. */
  :root {
    --dev-bg: #15130f;
    --dev-text: #f5f5f0;
    --dev-muted1: #b7b5af;
    --dev-muted2: #85837e;
    --dev-muted3: #625f59;
    --dev-gold: #d4af37;
    --dev-blue: #91afc0;
    --dev-green: #718a78;
    --dev-rose: #a66a62;
    --dev-hair: rgba(245, 245, 240, 0.18);
  }
  html, body { width: 100%; }
  body {
    background: var(--dev-bg);
    color: var(--dev-text);
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    overflow-x: hidden;
    position: relative;
    margin: 0;
  }
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background:
      radial-gradient(ellipse 800px 500px at 15% 0%, rgba(145, 175, 192, 0.06), transparent 60%),
      radial-gradient(ellipse 800px 500px at 85% 100%, rgba(212, 175, 55, 0.05), transparent 60%);
    pointer-events: none;
    z-index: 0;
  }
  a { color: inherit; text-decoration: none; }
  button { font-family: inherit; cursor: pointer; background: none; border: none; color: inherit; }

  header { position: sticky; top: 0; z-index: 50; background: var(--dev-bg); }
  .header-inner { display: flex; align-items: center; justify-content: space-between; padding: 26px 64px; }
  .logo { font-size: 14px; letter-spacing: 0.18em; font-weight: 600; }
  nav { display: flex; align-items: center; gap: 40px; }
  nav a, nav button.navlink {
    font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--dev-muted1); transition: color 0.2s;
  }
  nav a:hover, nav button.navlink:hover { color: var(--dev-text); }
  nav a.active, nav button.navlink.active { color: var(--dev-gold); }
  .start-link { display: flex; align-items: center; gap: 6px; color: var(--dev-gold) !important; }
  .header-hair {
    height: 1px;
    background: linear-gradient(90deg, var(--dev-blue), var(--dev-muted1), var(--dev-gold), var(--dev-rose));
    opacity: 0.55;
  }

  .wrap { max-width: 1360px; margin: 0 auto; padding: 0 64px; position: relative; z-index: 1; }
  .screen { display: none; min-height: calc(100vh - 78px); flex-direction: column; padding-top: 64px; }
  .screen.active { display: flex; }
  .eyebrow { font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--dev-muted2); margin-bottom: 28px; }
  .sim-tag { color: var(--dev-muted3); text-transform: none; letter-spacing: 0.02em; font-size: 10px; }
  .serif { font-family: 'Instrument Serif', Georgia, serif; font-weight: 400; }
  .mono { font-family: 'JetBrains Mono', SFMono-Regular, Consolas, monospace; }
  h1.hero { font-size: clamp(40px, 6.2vw, 100px); line-height: 0.98; letter-spacing: -0.01em; max-width: 920px; margin: 0; }
  .tint-blue { color: var(--dev-blue); }
  .tint-gold { color: var(--dev-gold); }
  .tint-rose { color: var(--dev-rose); }
  p.sub { font-size: 17px; color: var(--dev-muted1); max-width: 520px; margin-top: 20px; line-height: 1.6; }

  .footer-bar {
    margin-top: auto; padding: 28px 0 28px;
    display: flex; justify-content: space-between; align-items: center;
    border-top: 1px solid var(--dev-hair);
    font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--dev-muted3);
  }

  .btn {
    font-size: 14px; letter-spacing: 0.03em; padding: 16px 28px;
    border: 1px solid var(--dev-gold); color: var(--dev-gold); border-radius: 2px;
    transition: background 0.2s; white-space: nowrap;
  }
  .btn:hover { background: rgba(212, 175, 55, 0.08); }
  .btn-plain { color: var(--dev-muted1); font-size: 14px; }
  .btn-plain:hover { color: var(--dev-text); }
  input[type='text'], input[type='email'], textarea {
    font-family: inherit; font-size: 16px; color: var(--dev-text);
    background: transparent; border: 1px solid rgba(245, 245, 240, 0.35);
    padding: 16px 20px; border-radius: 2px; width: 100%;
  }
  input::placeholder, textarea::placeholder { color: var(--dev-muted2); }
  input:focus, textarea:focus { outline: none; border-color: var(--dev-gold); }
  textarea { resize: vertical; min-height: 140px; font-size: 17px; line-height: 1.6; }

  .input-row { display: flex; gap: 16px; max-width: 820px; margin-top: 44px; }
  .input-row input { flex: 1; }

  .steps { display: flex; gap: 56px; margin-top: 70px; flex-wrap: wrap; }
  .step { flex: 1; min-width: 220px; }
  .step .rule { height: 1px; margin: 10px 0 22px; }
  .step .num { font-size: 13px; color: var(--dev-muted2); }
  .step h3 { font-family: 'Instrument Serif', Georgia, serif; font-weight: 400; font-size: 34px; margin: 0 0 14px; }
  .step p { font-size: 15px; color: var(--dev-muted1); line-height: 1.6; margin: 0; }
  .step:nth-child(1) .rule { background: var(--dev-gold); }
  .step:nth-child(2) .rule { background: var(--dev-muted1); }
  .step:nth-child(3) .rule { background: var(--dev-rose); }

  .proof-list { margin-top: 56px; max-width: 980px; }
  .proof-row { display: flex; justify-content: space-between; align-items: baseline; padding: 26px 0; border-bottom: 1px solid var(--dev-hair); gap: 24px; flex-wrap: wrap; }
  .proof-row .name { font-size: 14px; letter-spacing: 0.1em; text-transform: uppercase; }
  .proof-row .result { font-size: 15px; color: var(--dev-muted1); text-align: right; }

  .pricing-block { margin-top: auto; margin-bottom: auto; }

  .intake-form { margin-top: 48px; max-width: 680px; display: flex; flex-direction: column; gap: 22px; }
  .field label { display: block; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--dev-muted2); margin-bottom: 10px; }

  .login-box { max-width: 420px; margin: auto; width: 100%; }
  .login-box h2 { font-family: 'Instrument Serif', Georgia, serif; font-weight: 400; font-size: 38px; margin-bottom: 34px; }
  .login-box .field { margin-bottom: 24px; }

  .app-status { font-size: 11px; letter-spacing: 0.16em; color: var(--dev-gold); }

  .tracker { display: flex; align-items: center; gap: 0; margin: 56px 0 48px; max-width: 900px; }
  .tracker .node { display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .tracker .dot-row { display: flex; align-items: center; }
  .tracker .dot { width: 8px; height: 8px; background: var(--dev-muted3); flex-shrink: 0; }
  .tracker .dot.done { background: var(--dev-muted1); }
  .tracker .dot.now { background: var(--dev-gold); }
  .tracker .line { height: 1px; background: var(--dev-hair); flex: 1; }
  .tracker .line.done { background: var(--dev-muted1); }
  .tracker .label { font-size: 12px; letter-spacing: 0.06em; color: var(--dev-muted3); }
  .tracker .label.done { color: var(--dev-muted1); }
  .tracker .label.now { color: var(--dev-gold); }

  .activity-box { margin-top: 40px; max-width: 640px; }
  .activity-box .h { font-size: 11px; letter-spacing: 0.16em; color: var(--dev-muted2); margin-bottom: 16px; }
  .activity-box .line { font-family: 'JetBrains Mono', SFMono-Regular, Consolas, monospace; font-size: 13px; color: var(--dev-muted1); padding: 8px 0; border-bottom: 1px solid var(--dev-hair); }

  .orch-problem { max-width: 760px; margin-top: 36px; }
  .orch-problem .q { font-family: 'Instrument Serif', Georgia, serif; font-size: 26px; line-height: 1.4; color: var(--dev-text); }
  .orch-log { margin-top: 44px; max-width: 760px; flex: 1; }
  .orch-log .h { font-size: 11px; letter-spacing: 0.16em; color: var(--dev-muted2); margin-bottom: 18px; }
  .log-line {
    font-family: 'JetBrains Mono', SFMono-Regular, Consolas, monospace; font-size: 13px; color: var(--dev-muted3);
    padding: 9px 0; border-bottom: 1px solid var(--dev-hair);
    display: flex; gap: 16px; opacity: 0; transform: translateY(4px);
    transition: opacity 0.35s, transform 0.35s, color 0.3s;
  }
  .log-line.show { opacity: 1; transform: translateY(0); }
  .log-line.running { color: var(--dev-gold); }
  .log-line .ts { color: var(--dev-muted3); flex-shrink: 0; }
  .orch-input-row { display: flex; gap: 14px; max-width: 760px; margin-top: 36px; padding-top: 24px; border-top: 1px solid var(--dev-hair); }
  .orch-input-row input { flex: 1; }

  .int-list { margin-top: 48px; max-width: 820px; }
  .int-row { display: flex; justify-content: space-between; align-items: center; padding: 26px 0; border-bottom: 1px solid var(--dev-hair); gap: 20px; flex-wrap: wrap; }
  .int-left { display: flex; align-items: center; gap: 20px; }
  .int-logo { width: 40px; height: 40px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
  .int-logo :global(svg) { width: 100%; height: 100%; }
  .int-row .name { font-size: 16px; margin-bottom: 6px; }
  .int-row .desc { font-size: 14px; color: var(--dev-muted2); }
  .int-row .btn.connected { color: var(--dev-green); border-color: var(--dev-green); }

  .billing-summary { display: flex; gap: 64px; margin: 44px 0 48px; flex-wrap: wrap; }
  .billing-summary .item .l { font-size: 11px; letter-spacing: 0.16em; color: var(--dev-muted2); margin-bottom: 8px; }
  .billing-summary .item .v { font-family: 'Instrument Serif', Georgia, serif; font-size: 30px; }
  table { width: 100%; border-collapse: collapse; max-width: 640px; }
  table th { text-align: left; font-size: 11px; letter-spacing: 0.14em; color: var(--dev-muted2); padding-bottom: 14px; border-bottom: 1px solid var(--dev-hair); font-weight: 400; }
  table td { padding: 16px 0; border-bottom: 1px solid var(--dev-hair); font-size: 14px; color: var(--dev-muted1); }
  table td.status { color: var(--dev-green); }

  @media (max-width: 860px) {
    .header-inner { padding: 20px 24px; }
    .wrap { padding: 0 24px; }
    nav { gap: 20px; }
    nav a, nav button.navlink { font-size: 11px; letter-spacing: 0.08em; }
    .steps { flex-direction: column; gap: 36px; margin-top: 44px; }
    .proof-row { flex-direction: column; align-items: flex-start; gap: 8px; }
    .proof-row .result { text-align: left; }
    .input-row { flex-direction: column; }
    .tracker { flex-direction: column; align-items: flex-start; gap: 18px; }
    .tracker .line { display: none; }
    .billing-summary { gap: 32px; }
    h1.hero { font-size: clamp(34px, 9vw, 60px); }
  }
</style>

<script is:inline>
  // ============================================================
  // Everything in this file is a FRONT-END SIMULATION.
  //
  // Real (backend, out of scope for this pass):
  //  - Login / magic link: no auth provider is wired up. "Send magic link"
  //    just navigates to the dashboard screen.
  //  - Orchestrator log: hard-coded strings played on a timer. No Claude API
  //    call, no real problem-to-lever mapping, no real agent execution.
  //  - Integrations: "Connect" just flips a button's own local state.
  //    No OAuth flow, no token storage, no live connection to any tool.
  //  - Activity / Billing: static markup, not read from any job queue or
  //    payment system.
  //  - Intake form: does not submit anywhere yet — no endpoint to receive
  //    the problem statement, company, tools-used, or email fields.
  //
  // Making this real needs: an API layer that calls Claude to classify the
  // problem against the P&L lever taxonomy and draft a demo artefact, an
  // OAuth flow per integration (CRM/Sheets/Slack/Email), a background job
  // execution layer for the orchestrator, real auth, and a database.
  // ============================================================

  var marketingScreens = ['landing', 'how-it-works', 'proof', 'pricing', 'intake'];
  var appScreens = ['login', 'dashboard', 'orchestrator', 'integrations', 'activity', 'billing'];

  function showScreen(id) {
    document.querySelectorAll('.screen').forEach(function (s) { s.classList.remove('active'); });
    var el = document.getElementById(id);
    if (!el) return;
    el.classList.add('active');

    var isApp = appScreens.indexOf(id) !== -1;
    document.getElementById('marketingNav').style.display = isApp ? 'none' : 'flex';
    document.getElementById('appNav').style.display = isApp ? 'flex' : 'none';

    document.querySelectorAll('#marketingNav a').forEach(function (a) {
      a.classList.toggle('active', a.dataset.go === id);
    });
    document.querySelectorAll('#appNav a').forEach(function (a) {
      a.classList.toggle('active', a.dataset.go === id);
    });

    var idx = el.dataset.marketingIndex;
    document.querySelectorAll('.page-count').forEach(function (pc) {
      pc.textContent = idx ? (idx.padStart(2, '0') + ' / ' + String(marketingScreens.length).padStart(2, '0')) : '';
    });

    window.scrollTo(0, 0);

    if (id === 'orchestrator') setTimeout(startOrchestrator, 50);
  }

  document.querySelectorAll('[data-go]').forEach(function (el) {
    el.addEventListener('click', function (e) {
      e.preventDefault();
      showScreen(el.dataset.go);
    });
  });

  var landingForm = document.getElementById('landingForm');
  if (landingForm) {
    landingForm.addEventListener('submit', function (e) {
      e.preventDefault();
      showScreen('intake');
    });
  }

  document.getElementById('intakeForm').addEventListener('submit', function (e) {
    e.preventDefault();
    var form = e.target;
    var btn = document.getElementById('intakeSubmitBtn');
    var errorEl = document.getElementById('intakeError');
    errorEl.style.display = 'none';

    var payload = {
      problem: form.problem.value.trim(),
      company: form.company.value.trim(),
      website: form.website.value.trim(),
      tools: form.tools.value.trim(),
      email: form.email.value.trim(),
    };

    btn.disabled = true;
    btn.textContent = 'Submitting…';

    fetch('/devshop/api/intake', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(payload),
    })
      .then(function (res) {
        if (!res.ok) return res.json().then(function (b) { throw new Error(b.error || 'Submission failed'); });
        return res.json();
      })
      .then(function () {
        form.reset();
        showScreen('confirmation');
      })
      .catch(function (err) {
        errorEl.textContent = err.message || 'Something went wrong — try again.';
        errorEl.style.display = 'block';
      })
      .finally(function () {
        btn.disabled = false;
        btn.textContent = 'Submit →';
      });
  });

  document.getElementById('loginForm').addEventListener('submit', function (e) {
    e.preventDefault(); // UI-only: no real auth
    showScreen('dashboard');
  });

  /* ---- orchestrator log simulation (scripted, not a real agent run) ---- */
  var roundOne = [
    'Connected to CRM',
    'Pulling last 90 days of leads',
    'Normalizing lead records',
    'Identifying inactive opportunities',
    'Drafting priority summary',
  ];

  function timestamp(offsetSec) {
    var d = new Date(Date.now() + offsetSec * 1000);
    return d.toTimeString().slice(0, 8);
  }

  function runLog(lines, container, onDone) {
    container.innerHTML = '';
    var i = 0;
    function next() {
      var prevRunning = container.querySelector('.log-line.running');
      if (prevRunning) prevRunning.classList.remove('running');

      if (i >= lines.length) {
        if (onDone) onDone();
        return;
      }
      var row = document.createElement('div');
      row.className = 'log-line running';
      row.innerHTML = '<span class="ts">' + timestamp(i) + '</span><span>' + lines[i] + '</span>';
      container.appendChild(row);
      requestAnimationFrame(function () { row.classList.add('show'); });
      i++;
      setTimeout(next, 850);
    }
    next();
  }

  var orchStarted = false;
  function startOrchestrator() {
    if (orchStarted) return;
    orchStarted = true;
    var container = document.getElementById('logContainer');
    var statusEl = document.getElementById('orchStatus');
    runLog(roundOne, container, function () { statusEl.textContent = 'DEMO READY'; });
  }

  document.getElementById('orchRunBtn').addEventListener('click', function () {
    var input = document.getElementById('orchInput');
    var q = input.value.trim();
    if (!q) return;
    var container = document.getElementById('logContainer');
    var statusEl = document.getElementById('orchStatus');
    statusEl.textContent = 'RUNNING';

    var qRow = document.createElement('div');
    qRow.className = 'log-line show';
    qRow.style.color = 'var(--dev-muted1)';
    qRow.innerHTML = '<span class="ts">' + timestamp(0) + '</span><span>› ' + q.replace(/</g, '&lt;') + '</span>';
    container.appendChild(qRow);

    var roundTwo = [
      'Reviewing follow-up request',
      'Re-scanning relevant records',
      'Cross-referencing with prior summary',
      'Updating output',
    ];
    setTimeout(function () {
      var wrap = document.createElement('div');
      container.appendChild(wrap);
      runLog(roundTwo, wrap, function () { statusEl.textContent = 'DEMO READY'; });
    }, 400);

    input.value = '';
  });

  document.getElementById('orchInput').addEventListener('keydown', function (e) {
    if (e.key === 'Enter') { document.getElementById('orchRunBtn').click(); }
  });

  /* ---- integrations connect toggle (local UI state only) ---- */
  document.querySelectorAll('.connect-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      btn.textContent = 'Connected';
      btn.classList.add('connected');
      btn.disabled = true;
    });
  });

  showScreen('landing');
</script>

</body>
</html>
