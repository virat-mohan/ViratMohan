    .billing-summary { gap: 32px; }
    h1.hero { font-size: clamp(34px, 9vw, 60px); }
  }
</style>

<script is:inline>
  // ============================================================
  // Everything in this file is a FRONT-END SIMULATION.
  //
  // Real (backend, out of scope for this pass):
  //  - Login / magic link: no auth provider is wired up. "Send magic link"
  //    just navigates to the dashboard screen.
  //  - Orchestrator log: hard-coded strings played on a timer. No Claude API
  //    call, no real problem-to-lever mapping, no real agent execution.
  //  - Integrations: "Connect" just flips a button's own local state.
  //    No OAuth flow, no token storage, no live connection to any tool.
  //  - Activity / Billing: static markup, not read from any job queue or
  //    payment system.
  //  - Intake form: does not submit anywhere yet — no endpoint to receive
  //    the problem statement, company, tools-used, or email fields.
  //
  // Making this real needs: an API layer that calls Claude to classify the
  // problem against the P&L lever taxonomy and draft a demo artefact, an
  // OAuth flow per integration (CRM/Sheets/Slack/Email), a background job
  // execution layer for the orchestrator, real auth, and a database.
  // ============================================================

  var marketingScreens = ['landing', 'how-it-works', 'proof', 'pricing', 'intake'];
  var appScreens = ['login', 'dashboard', 'orchestrator', 'integrations', 'activity', 'billing'];

  function showScreen(id) {
    document.querySelectorAll('.screen').forEach(function (s) { s.classList.remove('active'); });
    var el = document.getElementById(id);
    if (!el) return;
    el.classList.add('active');

    var isApp = appScreens.indexOf(id) !== -1;
    document.getElementById('marketingNav').style.display = isApp ? 'none' : 'flex';
    document.getElementById('appNav').style.display = isApp ? 'flex' : 'none';

    document.querySelectorAll('#marketingNav a').forEach(function (a) {
      a.classList.toggle('active', a.dataset.go === id);
    });
    document.querySelectorAll('#appNav a').forEach(function (a) {
      a.classList.toggle('active', a.dataset.go === id);
    });

    var idx = el.dataset.marketingIndex;
    document.querySelectorAll('.page-count').forEach(function (pc) {
      pc.textContent = idx ? (idx.padStart(2, '0') + ' / ' + String(marketingScreens.length).padStart(2, '0')) : '';
    });

    window.scrollTo(0, 0);

    if (id === 'orchestrator') setTimeout(startOrchestrator, 50);
    if (id === 'intake') resetWizard();
  }

  /* ---- intake wizard: one question at a time ---- */
  var wizardSteps = Array.prototype.slice.call(document.querySelectorAll('#intakeForm .wizard-step'));
  var wizardIndex = 0;

  function updateWizardProgress() {
    var el = document.getElementById('wizardProgress');
    if (el) el.textContent = (wizardIndex + 1) + ' / ' + wizardSteps.length;
  }

  function showWizardStep(i) {
    wizardSteps.forEach(function (s, idx) { s.hidden = idx !== i; });
    updateWizardProgress();
    var input = wizardSteps[i].querySelector('.wizard-input');
    if (input) setTimeout(function () { input.focus(); }, 60);
  }

  function resetWizard() {
    wizardIndex = 0;
    showWizardStep(0);
    var errorEl = document.getElementById('intakeError');
    if (errorEl) errorEl.hidden = true;
  }

  function combineToolsChips(step) {
    var selected = Array.prototype.slice.call(step.querySelectorAll('.chip.selected')).map(function (c) {
      return c.dataset.value;
    });
    var otherInput = step.querySelector('input[name="tools"]');
    var otherVal = otherInput.value.trim();
    // Strip any previously-combined chip text so re-visiting the step doesn't duplicate it.
    var combined = selected.concat(otherVal && selected.indexOf(otherVal) === -1 ? [otherVal] : []).join(', ');
    otherInput.value = combined;
  }

  function wizardAdvance() {
    var step = wizardSteps[wizardIndex];
    if (step.dataset.field === 'tools') combineToolsChips(step);
    if (step.dataset.field === 'industry') {
      var industryInput = step.querySelector('input[name="industry"]');
      var industrySelected = step.querySelector('#industryChips .chip.selected');
      if (industrySelected && !industryInput.value.trim()) industryInput.value = industrySelected.dataset.value;
    }

    var required = step.dataset.required === 'true';
    var input = step.querySelector('.wizard-input:not(.wizard-input--secondary)') || step.querySelector('.wizard-input');
    if (required && input && !input.value.trim()) {
      input.classList.add('wizard-input--error');
      input.focus();
      return;
    }
    if (input) input.classList.remove('wizard-input--error');

    if (wizardIndex < wizardSteps.length - 1) {
      wizardIndex++;
      showWizardStep(wizardIndex);
    }
  }

  document.querySelectorAll('.chip').forEach(function (chip) {
    chip.addEventListener('click', function () {
      if (chip.closest('#industryChips')) {
        var siblings = chip.parentElement.querySelectorAll('.chip');
        siblings.forEach(function (c) { if (c !== chip) c.classList.remove('selected'); });
        chip.classList.toggle('selected');
        var input = chip.closest('.wizard-step').querySelector('input[name="industry"]');
        input.value = chip.classList.contains('selected') ? chip.dataset.value : '';
      } else {
        chip.classList.toggle('selected');
      }
    });
  });

  document.querySelectorAll('.wizard-next, .wizard-skip').forEach(function (btn) {
    btn.addEventListener('click', wizardAdvance);
  });

  document.querySelectorAll('.wizard-input').forEach(function (input) {
    input.addEventListener('keydown', function (e) {
      if (e.key !== 'Enter') return;
      if (input.tagName === 'TEXTAREA' && e.shiftKey) return; // allow newlines for multi-problem lists
      e.preventDefault();
      var step = input.closest('.wizard-step');
      if (step.dataset.field === 'email') {
        document.getElementById('intakeForm').requestSubmit();
      } else {
        wizardAdvance();
      }
    });
  });

  document.querySelectorAll('[data-go]').forEach(function (el) {
    el.addEventListener('click', function (e) {
      e.preventDefault();
      showScreen(el.dataset.go);
    });
  });

  var landingForm = document.getElementById('landingForm');
  if (landingForm) {
    landingForm.addEventListener('submit', function (e) {
      e.preventDefault();
      showScreen('intake');
    });
  }

  /* ---- building screen: countdown + contextual rotating messages ---- */
  var BENCHMARK_LIBRARY = [
    { keywords: ['checkout', 'cart', 'abandon', 'ecommerce', 'e-commerce', 'shopify', 'order'],
      lines: [
        'Cart abandonment averages 65–70% across e-commerce — most of it is friction, not disinterest.',
        'Recovering even 10–15% of abandoned checkouts is typical once the right nudge fires at the right moment.',
        'Faster checkout flows routinely lift conversion 5–10 points in direct comparisons.',
      ] },
    { keywords: ['support', 'ticket', 'inbox', 'helpdesk', 'email', 'customer service', 'query', 'queries'],
      lines: [
        'Support teams typically see 40–60% of inbound volume fall into a handful of repeat categories.',
        'Auto-classifying and drafting replies for repeat questions commonly cuts response time from hours to minutes.',
        'A well-scoped triage layer usually absorbs 30–50% of ticket volume without touching complex cases.',
      ] },
    { keywords: ['proposal', 'quote', 'lead', 'sales', 'pipeline', 'crm', 'pricing'],
      lines: [
        'Speed-to-quote is one of the strongest predictors of close rate in B2B sales — hours beat days, consistently.',
        'Teams that automate first-draft proposals typically cut turnaround from hours to minutes, with a human finishing the send.',
        'Lead response within 5 minutes converts several times better than response after an hour, across most benchmarks.',
      ] },
    { keywords: ['budget', 'spreadsheet', 'sheet', 'finance', 'cost', 'vendor', 'invoice', 'expense'],
      lines: [
        'Budget overruns caught at the moment of commitment are far cheaper to fix than ones caught at reconciliation.',
        'Manual spreadsheet reconciliation is one of the most common sources of silent margin leakage in operating businesses.',
        'Real-time budget-vs-committed tracking typically catches overspend 2-4 weeks earlier than periodic review.',
      ] },
    { keywords: ['inventory', 'stock', 'warehouse', 'fulfillment', 'fulfilment', 'supply'],
      lines: [
        'Manual stock counts are one of the highest-friction, highest-error tasks in retail operations.',
        'Automated stock reconciliation typically cuts count time by 70-90% versus manual spreadsheet tracking.',
      ] },
    { keywords: ['schedule', 'booking', 'appointment', 'calendar', 'staffing'],
      lines: [
        'Automated scheduling typically removes 60-80% of the back-and-forth in manual booking coordination.',
        'No-show rates commonly drop 20-30% with automated confirmation and reminder flows.',
      ] },
  ];

  // The actual 8-step methodology, narrated in order — this is what's
  // genuinely happening server-side right now, not filler copy. Framework
  // fit scores themselves stay internal (see the fit-scoring writeup), but
  // the fact that scoring is happening, and roughly how, builds real trust.
  var PROCESS_STEPS = [
    'Reading your problem and identifying the actual root cause — not just the symptom you described.',
    'Shortlisting a handful of proven frameworks that could apply here.',
    'Scoring each candidate on problem fit, evidence strength, and how it\'s worked for businesses in your industry before.',
    'Selecting the strongest-fit framework and setting the runners-up aside, with reasons.',
    'Mapping the fix to the exact line on your P&L it should move — revenue or cost, specifically.',
    'Designing the actual mechanism: what triggers it, what it uses, what happens step by step.',
    'Double-checking the diagnosis, the framework choice, and the numbers before any of it goes further.',
    'Building a real interactive demo of it — not a mockup — in your brand colors.',
  ];

  var GENERIC_LINES = [
    'Fast Tech Dev Shop builds a working demo, not a mockup — every number you\'ll see is either a real assumption or a question we\'ll ask you.',
    'The orchestrator is mapping your problem against a fixed set of P&L levers — revenue or cost, not a vague "AI opportunity."',
    'One round of feedback, then a 30-day build — the demo you\'re about to see is the actual scope document.',
    'Every demo is skinned to your brand where possible, not ours — this isn\'t a generic AI-wrapper pitch.',
  ];

  function buildMessageQueue(problemText, toolsText) {
    var haystack = (problemText + ' ' + toolsText).toLowerCase();
    var matched = [];
    BENCHMARK_LIBRARY.forEach(function (entry) {
      var hit = entry.keywords.some(function (k) { return haystack.indexOf(k) !== -1; });
      if (hit) matched = matched.concat(entry.lines);
    });
    // The real methodology narrative plays first, in order; industry-matched
    // benchmark lines and generic lines fill the rest of the wait.
    return PROCESS_STEPS.concat(matched).concat(GENERIC_LINES);
  }

  var buildTimers = [];
  function startBuildingUi(problemText, toolsText) {
    var countdownEl = document.getElementById('buildCountdown');
    var messageEl = document.getElementById('buildMessage');
    var fillEl = document.getElementById('buildProgressFill');
    var queue = buildMessageQueue(problemText, toolsText);
    var qIndex = 0;
    var ESTIMATE_SECONDS = 75;
    var elapsed = 0;

    function tick() {
      elapsed++;
      var remaining = ESTIMATE_SECONDS - elapsed;
      if (remaining > 0) {
        countdownEl.textContent = 'About ' + remaining + 's left…';
      } else {
        countdownEl.textContent = 'Almost there — the good ones take a little longer.';
      }
      var pct = Math.min(100, Math.round((elapsed / ESTIMATE_SECONDS) * 92)); // never hit 100 until done
      fillEl.style.width = pct + '%';
    }
    tick();
    buildTimers.push(setInterval(tick, 1000));

    function showNextMessage() {
      messageEl.classList.remove('show');
      setTimeout(function () {
        messageEl.textContent = queue[qIndex % queue.length];
        qIndex++;
        messageEl.classList.add('show');
      }, 250);
    }
    showNextMessage();
    buildTimers.push(setInterval(showNextMessage, 4500));
  }

  function stopBuildingUi(success) {
    buildTimers.forEach(function (t) { clearInterval(t); });
    buildTimers = [];
    var fillEl = document.getElementById('buildProgressFill');
    if (fillEl) fillEl.style.width = success ? '100%' : fillEl.style.width;
  }

  document.getElementById('intakeForm').addEventListener('submit', function (e) {
    e.preventDefault();
    var form = e.target;
    var errorEl = document.getElementById('intakeError');
    errorEl.hidden = true;

    var payload = {
      problem: form.problem.value.trim(),
      company: form.company.value.trim(),
      industry: form.industry.value.trim(),
      website: form.website.value.trim(),
      tools: form.tools.value.trim(),
      preferredFramework: form.preferredFramework.value.trim(),
      email: form.email.value.trim(),
    };

    showScreen('building');
    startBuildingUi(payload.problem, payload.tools);

    fetch('/devshop/api/intake', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(payload),
    })
      .then(function (res) {
        if (!res.ok) return res.json().then(function (b) { throw new Error(b.error || 'Submission failed'); });
        return res.json();
      })
      .then(function () {
        stopBuildingUi(true);
        form.reset();
        document.querySelectorAll('.chip.selected').forEach(function (c) { c.classList.remove('selected'); });
        showScreen('confirmation');
      })
      .catch(function (err) {
        stopBuildingUi(false);
        showScreen('intake');
        errorEl.textContent = err.message || 'Something went wrong — try again.';
        errorEl.hidden = false;
      });
  });

  document.getElementById('loginForm').addEventListener('submit', function (e) {
    e.preventDefault(); // UI-only: no real auth
    showScreen('dashboard');
  });

  /* ---- orchestrator log simulation (scripted, not a real agent run) ---- */
  var roundOne = [
    'Connected to CRM',
    'Pulling last 90 days of leads',
    'Normalizing lead records',
    'Identifying inactive opportunities',
    'Drafting priority summary',
  ];

  function timestamp(offsetSec) {
    var d = new Date(Date.now() + offsetSec * 1000);
    return d.toTimeString().slice(0, 8);
  }

  function runLog(lines, container, onDone) {
    container.innerHTML = '';
    var i = 0;
    function next() {
      var prevRunning = container.querySelector('.log-line.running');
      if (prevRunning) prevRunning.classList.remove('running');

      if (i >= lines.length) {
        if (onDone) onDone();
        return;
      }
      var row = document.createElement('div');
      row.className = 'log-line running';
      row.innerHTML = '<span class="ts">' + timestamp(i) + '</span><span>' + lines[i] + '</span>';
      container.appendChild(row);
      requestAnimationFrame(function () { row.classList.add('show'); });
      i++;
      setTimeout(next, 850);
    }
    next();
  }

  var orchStarted = false;
  function startOrchestrator() {
    if (orchStarted) return;
    orchStarted = true;
    var container = document.getElementById('logContainer');
    var statusEl = document.getElementById('orchStatus');
    runLog(roundOne, container, function () { statusEl.textContent = 'DEMO READY'; });
  }

  document.getElementById('orchRunBtn').addEventListener('click', function () {
    var input = document.getElementById('orchInput');
    var q = input.value.trim();
    if (!q) return;
    var container = document.getElementById('logContainer');
    var statusEl = document.getElementById('orchStatus');
    statusEl.textContent = 'RUNNING';

    var qRow = document.createElement('div');
    qRow.className = 'log-line show';
    qRow.style.color = 'var(--dev-muted1)';
    qRow.innerHTML = '<span class="ts">' + timestamp(0) + '</span><span>› ' + q.replace(/</g, '&lt;') + '</span>';
    container.appendChild(qRow);

    var roundTwo = [
      'Reviewing follow-up request',
      'Re-scanning relevant records',
      'Cross-referencing with prior summary',
      'Updating output',
    ];
    setTimeout(function () {
      var wrap = document.createElement('div');
      container.appendChild(wrap);
      runLog(roundTwo, wrap, function () { statusEl.textContent = 'DEMO READY'; });
    }, 400);

    input.value = '';
  });

  document.getElementById('orchInput').addEventListener('keydown', function (e) {
    if (e.key === 'Enter') { document.getElementById('orchRunBtn').click(); }
  });

  /* ---- integrations connect toggle (local UI state only) ---- */
  document.querySelectorAll('.connect-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      btn.textContent = 'Connected';
      btn.classList.add('connected');
      btn.disabled = true;
    });
  });

  showScreen('landing');
</script>

</body>
</html>
