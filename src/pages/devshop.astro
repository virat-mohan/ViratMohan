---
// /devshop — Fast Tech Dev Shop landing + product prototype.
//
// This page intentionally does NOT use Base.astro / Nav.astro / Footer.astro:
// the source prototype (devshop-prototype.html) specifies its own dark design
// system, distinct from the rest of viratmohan.com's light theme. It is not
// linked from the main site nav per instruction — reachable only by direct URL.
//
// SCOPE NOTE: everything from "Login" onward (Dashboard, Orchestrator,
// Integrations, Activity, Billing) is a UI-only front-end simulation.
// There is no real auth, no Claude API call, no per-tool OAuth, no background
// job execution, and no persistence — see inline comments in the <script>
// below for exactly which parts are fake and what real backend work
// (API orchestration, OAuth per integration, a job execution layer, a DB)
// would be needed to make them real. That work is out of scope for this pass.

import { site } from '../data/site';

// ---- Easily-editable config, per prompt instructions ----
const CURRENCY = '₹'; // TODO: confirm ₹ vs $ before this goes live
const PRICING = {
  buildLow: '1,00,000',
  buildHigh: '10,00,000',
  retainerMin: '50,000',
};

// TODO: confirm these four case studies are cleared for public naming
// (client sign-off) before treating this copy as final.
const proof = [
  { name: 'Travaholic', result: 'D2C infrastructure live in 2 days' },
  { name: 'The Feeling Co.', result: 'Full digital operation — 9 releases, zero external subscriptions' },
  { name: 'India Contemporary', result: 'Two-sided marketplace connecting artists to collectors' },
  { name: 'ClarityHQ', result: 'Internal campaign builder, now licensed to other agencies' },
];

// Full-colour icon marks for the Integrations screen only (per instruction —
// every other screen, especially Proof, stays logo-free). Simple inline SVGs
// evoking each tool's real brand colours/marks; CRM uses a generic mark since
// "CRM" isn't a single product here.
const CRM_LOGO = `<svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"><rect width="40" height="40" rx="6" fill="#91AFC0"/><circle cx="20" cy="15" r="6" fill="#15130F"/><path d="M8 32c0-6.6 5.4-12 12-12s12 5.4 12 12" fill="#15130F"/></svg>`;

const SHEETS_LOGO = `<svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"><rect width="40" height="40" rx="6" fill="#0F9D58"/><rect x="10" y="7" width="20" height="26" rx="2" fill="#F5F5F0"/><rect x="13" y="11" width="14" height="2.2" fill="#0F9D58"/><rect x="13" y="16" width="14" height="2.2" fill="#0F9D58"/><rect x="13" y="21" width="14" height="2.2" fill="#0F9D58"/><rect x="13" y="26" width="14" height="2.2" fill="#0F9D58"/><rect x="18.9" y="11" width="2.2" height="17.2" fill="#0F9D58"/></svg>`;

const SLACK_LOGO = `<svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"><rect width="40" height="40" rx="6" fill="#15130F"/><path d="M15.5 24.5a2.5 2.5 0 1 1-2.5-2.5h2.5v2.5z" fill="#E01E5A"/><path d="M16.75 24.5a2.5 2.5 0 1 1 5 0v6.25a2.5 2.5 0 1 1-5 0V24.5z" fill="#E01E5A"/><path d="M17 15.5a2.5 2.5 0 1 1 2.5-2.5v2.5H17z" fill="#36C5F0"/><path d="M17 16.75a2.5 2.5 0 1 1 0 5h-6.25a2.5 2.5 0 1 1 0-5H17z" fill="#36C5F0"/><path d="M25.5 17a2.5 2.5 0 1 1 2.5 2.5H25.5V17z" fill="#2EB67D"/><path d="M24.25 17a2.5 2.5 0 1 1-5 0v-6.25a2.5 2.5 0 1 1 5 0V17z" fill="#2EB67D"/><path d="M24 25.5a2.5 2.5 0 1 1-2.5 2.5V25.5H24z" fill="#ECB22E"/><path d="M24 24.25a2.5 2.5 0 1 1 0-5h6.25a2.5 2.5 0 1 1 0 5H24z" fill="#ECB22E"/></svg>`;

const EMAIL_LOGO = `<svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"><rect width="40" height="40" rx="6" fill="#F5F5F0"/><path d="M7 12h26v18a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V12z" fill="#EA4335"/><path d="M7 12l13 10 13-10" fill="none" stroke="#F5F5F0" stroke-width="2"/><path d="M7 12l13 10 13-10" fill="#FBBC05"/><path d="M7 12a2 2 0 0 1 2-2h22a2 2 0 0 1 2 2l-13 10L7 12z" fill="#EA4335"/></svg>`;

const title = 'Fast Tech Dev Shop — problem in, demo in 24 hours';
const description =
  "Tell us the P&L, marketing, or ops problem. Demo in 24 hours. Working build in 30 days. Priced monthly, not by project.";
const canonical = new URL('/devshop', site.domain).href;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="noindex, follow" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
</head>
<body>

<header>
  <div class="header-inner">
    <div class="logo">DevShop</div>
    <nav id="marketingNav">
      <a href="#" data-go="how-it-works">How it works</a>
      <a href="#" data-go="proof">Proof</a>
      <a href="#" data-go="pricing">Pricing</a>
      <a href="#" data-go="intake" class="start-link">Start →</a>
    </nav>
    <nav id="appNav" style="display:none;">
      <a href="#" data-go="dashboard">Dashboard</a>
      <a href="#" data-go="orchestrator">Orchestrator</a>
      <a href="#" data-go="integrations">Integrations</a>
      <a href="#" data-go="activity">Activity</a>
      <a href="#" data-go="billing">Billing</a>
      <a href="#" data-go="landing" class="btn-plain" style="margin-left:8px;">Log out</a>
    </nav>
  </div>
  <div class="header-hair"></div>
</header>

<main class="wrap">

  <!-- 01 LANDING -->
  <section class="screen active" id="landing" data-marketing-index="1">
    <div class="eyebrow">AI ORCHESTRATION STUDIO</div>
    <h1 class="hero serif">Tell us the <span class="tint-blue">problem.</span><br />Get a demo in <span class="tint-gold">24 hours.</span></h1>
    <form class="input-row" id="landingForm">
      <input type="text" id="landingProblem" placeholder="What's the problem?" />
      <button class="btn" type="submit">Submit</button>
    </form>
    <p class="sub">No proposal. No scoping call. Just show us what's broken.</p>
    <div class="footer-bar"><span>Built fast, for real businesses</span><span class="page-count"></span></div>
  </section>

  <!-- 02 HOW IT WORKS -->
  <section class="screen" id="how-it-works" data-marketing-index="2">
    <div class="eyebrow">HOW IT WORKS</div>
    <h1 class="hero serif">From <span class="tint-blue">problem</span><br />to production. <span class="tint-gold">Fast.</span></h1>
    <div class="steps">
      <div class="step"><div class="num">01</div><div class="rule"></div><h3>Problem in</h3><p>Tell us what's broken.<br />No specs. No decks.</p></div>
      <div class="step"><div class="num">02</div><div class="rule"></div><h3><span class="tint-gold">24h</span> demo</h3><p>We build and show you<br />a working demo in 24 hours.</p></div>
      <div class="step"><div class="num">03</div><div class="rule"></div><h3>30-day build</h3><p>You give feedback.<br />We build and ship in 30 days.</p></div>
    </div>
    <div class="footer-bar"><span>Built fast, for real businesses</span><span class="page-count"></span></div>
  </section>

  <!-- 03 PROOF -->
  <section class="screen" id="proof" data-marketing-index="3">
    <div class="eyebrow">PROOF</div>
    <h1 class="hero serif">Built fast. <span class="tint-blue">Shipped</span> for real.</h1>
    <div class="proof-list">
      {proof.map((p) => (
        <div class="proof-row"><div class="name">{p.name}</div><div class="result">{p.result}</div></div>
      ))}
    </div>
    <div class="footer-bar"><span>Built fast, for real businesses</span><span class="page-count"></span></div>
  </section>

  <!-- 04 PRICING -->
  <section class="screen" id="pricing" data-marketing-index="4">
    <div class="eyebrow">PRICING</div>
    <div class="pricing-block">
      <h1 class="hero serif" style="font-size:clamp(36px,5vw,72px);">Build once.<br />Run on a <span class="tint-gold">retainer.</span></h1>
      <div style="display:flex; gap:64px; margin-top:48px; flex-wrap:wrap;">
        <div>
          <div class="eyebrow" style="margin-bottom:14px;">ONE-TIME BUILD</div>
          <div class="serif" style="font-size:clamp(28px,3.2vw,44px);">{CURRENCY}{PRICING.buildLow} – {CURRENCY}{PRICING.buildHigh}</div>
          <p class="sub" style="max-width:340px;">Depending on complexity.</p>
        </div>
        <div>
          <div class="eyebrow" style="margin-bottom:14px;">MONTHLY RETAINER</div>
          <div class="serif" style="font-size:clamp(28px,3.2vw,44px);"><span class="tint-gold">{CURRENCY}{PRICING.retainerMin}</span> minimum</div>
          <p class="sub" style="max-width:340px;">Scales with project spec and requirements.</p>
        </div>
      </div>
      <p class="sub" style="margin-top:36px;">Variable / custom pricing available outside this range. No proposals. No scoping calls.</p>
      <div style="margin-top:40px;"><button class="btn" data-go="intake">Start →</button></div>
    </div>
    <div class="footer-bar"><span>Built fast, for real businesses</span><span class="page-count"></span></div>
  </section>

  <!-- 05 INTAKE — one question at a time, centered, keyboard-driven -->
  <section class="screen wizard-screen" id="intake" data-marketing-index="5">
    <div class="wizard" id="intakeWizard">
      <div class="wizard-progress" id="wizardProgress" aria-hidden="true"></div>
      <form id="intakeForm" novalidate>
        <div class="wizard-step" data-field="problem" data-required="true">
          <p class="eyebrow">START</p>
          <h1 class="serif wizard-q">What's the problem?</h1>
          <p class="wizard-sub">More than one? List them all — we'll solve for each.</p>
          <textarea
            name="problem"
            class="wizard-input"
            rows="3"
            placeholder="Tell us what isn't working, what takes too long, or what you wish existed…"
          ></textarea>
          <div class="wizard-actions">
            <button type="button" class="btn wizard-next">Next →</button>
            <span class="wizard-hint">shift + enter for a new line, enter to continue</span>
          </div>
        </div>

        <div class="wizard-step" data-field="company" hidden>
          <h1 class="serif wizard-q">Who's asking?</h1>
          <input type="text" name="company" class="wizard-input" placeholder="Company name" />
          <div class="wizard-actions">
            <button type="button" class="btn wizard-next">Next →</button>
            <button type="button" class="btn-plain wizard-skip">Skip</button>
          </div>
        </div>

        <div class="wizard-step" data-field="industry" hidden>
          <h1 class="serif wizard-q">What industry are you in?</h1>
          <p class="wizard-sub">Helps us pick a framework with a real track record for businesses like yours.</p>
          <div class="chip-row" id="industryChips">
            <button type="button" class="chip" data-value="E-commerce / D2C">E-commerce / D2C</button>
            <button type="button" class="chip" data-value="B2B SaaS">B2B SaaS</button>
            <button type="button" class="chip" data-value="Professional services">Professional services</button>
            <button type="button" class="chip" data-value="Hospitality / travel">Hospitality / travel</button>
            <button type="button" class="chip" data-value="Manufacturing">Manufacturing</button>
            <button type="button" class="chip" data-value="Healthcare">Healthcare</button>
            <button type="button" class="chip" data-value="Financial services">Financial services</button>
            <button type="button" class="chip" data-value="Retail (offline)">Retail (offline)</button>
          </div>
          <input type="text" name="industry" class="wizard-input wizard-input--secondary" placeholder="Other — name your industry" />
          <div class="wizard-actions">
            <button type="button" class="btn wizard-next">Next →</button>
            <button type="button" class="btn-plain wizard-skip">Skip</button>
          </div>
        </div>

        <div class="wizard-step" data-field="website" hidden>
          <h1 class="serif wizard-q">Got a website?</h1>
          <p class="wizard-sub">Helps the demo match your brand instead of ours.</p>
          <input type="text" name="website" class="wizard-input" placeholder="company.com" />
          <div class="wizard-actions">
            <button type="button" class="btn wizard-next">Next →</button>
            <button type="button" class="btn-plain wizard-skip">Skip</button>
          </div>
        </div>

        <div class="wizard-step" data-field="tools" hidden>
          <h1 class="serif wizard-q">What do you run on today?</h1>
          <p class="wizard-sub">Pick what applies — whatever the eventual build needs to connect to.</p>
          <div class="chip-row" id="toolsChips">
            <button type="button" class="chip" data-value="CRM">CRM</button>
            <button type="button" class="chip" data-value="Spreadsheets">Spreadsheets</button>
            <button type="button" class="chip" data-value="Slack">Slack</button>
            <button type="button" class="chip" data-value="Email">Email</button>
            <button type="button" class="chip" data-value="Accounting / ERP">Accounting / ERP</button>
            <button type="button" class="chip" data-value="Project management">Project management</button>
            <button type="button" class="chip" data-value="E-commerce platform">E-commerce platform</button>
            <button type="button" class="chip" data-value="Support / helpdesk">Support / helpdesk</button>
          </div>
          <input type="text" name="tools" class="wizard-input wizard-input--secondary" placeholder="Other — name the specific tool(s)" />
          <div class="wizard-actions">
            <button type="button" class="btn wizard-next">Next →</button>
            <button type="button" class="btn-plain wizard-skip">Skip</button>
          </div>
        </div>

        <div class="wizard-step" data-field="preferredFramework" hidden>
          <h1 class="serif wizard-q">Want a specific framework applied?</h1>
          <p class="wizard-sub">Optional — name it and we'll use it. Otherwise we'll pick the best fit for your problem.</p>
          <input type="text" name="preferredFramework" class="wizard-input" placeholder="e.g. Lean Six Sigma, OKRs, Jobs to Be Done…" />
          <div class="wizard-actions">
            <button type="button" class="btn wizard-next">Next →</button>
            <button type="button" class="btn-plain wizard-skip">Skip</button>
          </div>
        </div>

        <div class="wizard-step" data-field="email" data-required="true" hidden>
          <h1 class="serif wizard-q">Where should the demo go?</h1>
          <input type="email" name="email" class="wizard-input" placeholder="you@company.com" />
          <div class="wizard-actions">
            <button type="submit" class="btn" id="intakeSubmitBtn">Submit →</button>
          </div>
        </div>
      </form>
      <p class="wizard-error" id="intakeError" hidden></p>
    </div>
  </section>

  <!-- 05a BUILDING — shown while the synchronous Claude classify+build call runs (~60-90s) -->
  <section class="screen wizard-screen" id="building">
    <div class="wizard">
      <div class="eyebrow">BUILDING</div>
      <h1 class="serif wizard-q" style="margin-bottom:8px;">Working the problem through the orchestrator.</h1>
      <p class="wizard-sub" id="buildCountdown">Usually takes about a minute.</p>
      <div class="build-progress"><div class="build-progress-fill" id="buildProgressFill"></div></div>
      <p class="build-message" id="buildMessage"></p>
    </div>
  </section>

  <!-- 05b CONFIRMATION — real intake landed, no fake login/dashboard after this -->
  <section class="screen" id="confirmation">
    <div class="eyebrow">RECEIVED</div>
    <h1 class="hero serif" style="max-width:760px;">Got it. <span class="tint-gold">Watch your inbox.</span></h1>
    <p class="sub" style="max-width:560px;">We're working the problem through the orchestrator now. A demo — and one round of feedback before we build — lands in your inbox within 24 hours.</p>
    <div style="margin-top:40px;"><a href="#" data-go="landing" class="btn-plain">← Back to start</a></div>
    <div class="footer-bar"><span>Built fast, for real businesses</span><span class="page-count"></span></div>
  </section>

  <!-- 06 LOGIN (UI-only — no real auth, see script comments) -->
  <section class="screen" id="login" style="justify-content:center;">
    <div class="login-box">
      <h2 class="serif">Welcome back.</h2>
      <form id="loginForm">
        <div class="field"><label>Email</label><input type="email" placeholder="you@company.com" required /></div>
        <button type="submit" class="btn" style="width:100%;">Send magic link →</button>
      </form>
    </div>
  </section>

  <!-- 07 DASHBOARD (UI-only — static demo data, no backend) -->
  <section class="screen" id="dashboard">
    <div class="eyebrow">PROJECT</div>
    <h1 class="hero serif" style="font-size:clamp(32px,4.4vw,52px);">Lead Intelligence Orchestrator</h1>
    <div class="tracker">
      <div class="node"><div class="dot-row"><div class="dot done"></div><div class="line done"></div></div><div class="label done">01 Problem received</div></div>
      <div class="node"><div class="dot-row"><div class="dot now"></div><div class="line"></div></div><div class="label now">02 Demo ready</div></div>
      <div class="node"><div class="dot-row"><div class="dot"></div><div class="line"></div></div><div class="label">03 Building</div></div>
      <div class="node"><div class="dot-row"><div class="dot"></div></div><div class="label">04 Live</div></div>
    </div>
    <div><button class="btn" data-go="orchestrator">View demo →</button></div>
    <p class="sub" style="margin-top:24px; max-width:620px;">One round of feedback before we build. Approving the demo is the scope document — there's no separate proposal.</p>
    <div class="activity-box">
      <div class="h">LAST ACTIVITY</div>
      <div class="line">Connected to CRM</div>
      <div class="line">Demo generated</div>
      <div class="line">Awaiting your feedback</div>
    </div>
  </section>

  <!-- 08 ORCHESTRATOR (UI-only — scripted log, no real Claude API call) -->
  <section class="screen" id="orchestrator">
    <div style="display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:12px;">
      <div class="eyebrow" style="margin-bottom:0;">LEAD INTELLIGENCE ORCHESTRATOR</div>
      <div class="app-status" id="orchStatus">BUILDING</div>
    </div>
    <div class="orch-problem">
      <div class="eyebrow" style="margin-bottom:10px;">ORIGINAL PROBLEM</div>
      <div class="q serif">"We have 90 days of CRM data but our sales team has no clear view of which leads need attention."</div>
    </div>
    <div class="orch-log">
      <div class="h">ORCHESTRATOR ACTIVITY <span class="sim-tag">(simulated)</span></div>
      <div id="logContainer"></div>
    </div>
    <div class="orch-input-row">
      <input type="text" id="orchInput" placeholder="Ask the orchestrator anything…" />
      <button class="btn" id="orchRunBtn">Run →</button>
    </div>
    <p class="sub" style="margin-top:20px; max-width:620px;">One round of feedback before we build — approve this demo and the 30-day build starts against it.</p>
  </section>

  <!-- 09 INTEGRATIONS (UI-only — no real OAuth, connect state is client-side only) -->
  <section class="screen" id="integrations">
    <div class="eyebrow">CONNECT THE TOOLS</div>
    <h1 class="hero serif" style="font-size:clamp(32px,4.4vw,52px);">Connect the tools.</h1>
    <div class="int-list">
      <div class="int-row">
        <div class="int-left">
          <span class="int-logo" aria-hidden="true" set:html={CRM_LOGO} />
          <div><div class="name">CRM</div><div class="desc">Your customer and pipeline data.</div></div>
        </div>
        <button class="btn connect-btn">Connect</button>
      </div>
      <div class="int-row">
        <div class="int-left">
          <span class="int-logo" aria-hidden="true" set:html={SHEETS_LOGO} />
          <div><div class="name">Google Sheets</div><div class="desc">Read and write operational data.</div></div>
        </div>
        <button class="btn connect-btn">Connect</button>
      </div>
      <div class="int-row">
        <div class="int-left">
          <span class="int-logo" aria-hidden="true" set:html={SLACK_LOGO} />
          <div><div class="name">Slack</div><div class="desc">Bring workflows into the team's workspace.</div></div>
        </div>
        <button class="btn connect-btn">Connect</button>
      </div>
      <div class="int-row">
        <div class="int-left">
          <span class="int-logo" aria-hidden="true" set:html={EMAIL_LOGO} />
          <div><div class="name">Email</div><div class="desc">Send updates and trigger workflows.</div></div>
        </div>
        <button class="btn connect-btn">Connect</button>
      </div>
    </div>
  </section>

  <!-- 10 ACTIVITY (UI-only — static log lines, no real job execution layer) -->
  <section class="screen" id="activity">
    <div class="eyebrow">AGENT ACTIVITY <span class="sim-tag">(simulated)</span></div>
    <div class="activity-box" style="max-width:760px;">
      <div class="line" style="color:var(--gold);"><span class="mono">09:42:16&nbsp;&nbsp;RUNNING&nbsp;&nbsp;&nbsp;&nbsp;Opportunity scoring</span></div>
      <div class="line mono">09:42:14&nbsp;&nbsp;COMPLETE&nbsp;&nbsp;&nbsp;Priority summary drafted</div>
      <div class="line mono">09:42:11&nbsp;&nbsp;COMPLETE&nbsp;&nbsp;&nbsp;Inactive opportunities identified</div>
      <div class="line mono">09:42:07&nbsp;&nbsp;COMPLETE&nbsp;&nbsp;&nbsp;Lead records normalized</div>
      <div class="line mono">09:42:04&nbsp;&nbsp;COMPLETE&nbsp;&nbsp;&nbsp;90 days of CRM data pulled</div>
      <div class="line mono">09:42:01&nbsp;&nbsp;COMPLETE&nbsp;&nbsp;&nbsp;CRM connection established</div>
    </div>
  </section>

  <!-- 11 BILLING (UI-only — static rows, no real billing system) -->
  <section class="screen" id="billing">
    <div class="eyebrow">BILLING</div>
    <h1 class="hero serif" style="font-size:clamp(32px,4.4vw,52px);">Fast Tech Dev Shop</h1>
    <div class="billing-summary">
      <div class="item"><div class="l">MONTHLY</div><div class="v">{CURRENCY}{PRICING.retainerMin}</div></div>
      <div class="item"><div class="l">NEXT BILLING</div><div class="v">04 Oct 2026</div></div>
    </div>
    <table>
      <tr><th>Date</th><th>Amount</th><th>Status</th></tr>
      <tr><td>04 Sep 2026</td><td>{CURRENCY}{PRICING.retainerMin}</td><td class="status">Paid</td></tr>
      <tr><td>04 Aug 2026</td><td>{CURRENCY}{PRICING.retainerMin}</td><td class="status">Paid</td></tr>
      <tr><td>04 Jul 2026</td><td>{CURRENCY}{PRICING.retainerMin}</td><td class="status">Paid</td></tr>
    </table>
  </section>

</main>

<style>
  /* Scoped design system for /devshop only — intentionally distinct from the
     rest of viratmohan.com, per the source prototype's dark palette. */
  :root {
    --dev-bg: #15130f;
    --dev-text: #f5f5f0;
    --dev-muted1: #b7b5af;
    --dev-muted2: #85837e;
    --dev-muted3: #625f59;
    --dev-gold: #d4af37;
