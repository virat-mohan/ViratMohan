  .log-line .ts { color: var(--dev-muted3); flex-shrink: 0; }
  .orch-input-row { display: flex; gap: 14px; max-width: 760px; margin-top: 36px; padding-top: 24px; border-top: 1px solid var(--dev-hair); }
  .orch-input-row input { flex: 1; }

  .int-list { margin-top: 48px; max-width: 820px; }
  .int-row { display: flex; justify-content: space-between; align-items: center; padding: 26px 0; border-bottom: 1px solid var(--dev-hair); gap: 20px; flex-wrap: wrap; }
  .int-left { display: flex; align-items: center; gap: 20px; }
