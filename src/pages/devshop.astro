---
// /devshop — Fast Tech Dev Shop landing + product prototype.
//
// This page intentionally does NOT use Base.astro / Nav.astro / Footer.astro:
// the source prototype (devshop-prototype.html) specifies its own dark design
// system, distinct from the rest of viratmohan.com's light theme. It is not
// linked from the main site nav per instruction — reachable only by direct URL.
//
// SCOPE NOTE: everything from "Login" onward (Dashboard, Orchestrator,
// Integrations, Activity, Billing) is a UI-only front-end simulation.
// There is no real auth, no Claude API call, no per-tool OAuth, no background
// job execution, and no persistence — see inline comments in the <script>
// below for exactly which parts are fake and what real backend work
// (API orchestration, OAuth per integration, a job execution layer, a DB)
// would be needed to make them real. That work is out of scope for this pass.

import { Image } from 'astro:assets';
import { site } from '../data/site';
import { devshopVerticals } from '../data/devshop-verticals';
import PortalHeader from '../components/devshop/PortalHeader.astro';

import travaholicLogo from '../assets/logos/travaholic.png';
import travaholicStaysLogo from '../assets/logos/travaholic-stays.png';
import feelingCoLogo from '../assets/logos/thefeelingco.png';

import travaholicShot from '../assets/screenshots/travaholic.png';
import travaholicStaysShot from '../assets/screenshots/travaholic-stays.png';
import feelingCoShot from '../assets/screenshots/thefeelingco.png';
import indiaContemporaryShot from '../assets/screenshots/india-contemporary.png';
import clarityhqShot from '../assets/screenshots/Clarityhq.png';
import contentmentShot from '../assets/screenshots/Contentment.png';
import coachYourPsycheShot from '../assets/screenshots/Coachyourpsyche.png';

// ---- Easily-editable config, per prompt instructions ----
const CURRENCY = '₹'; // INR is the standard currency for this product.
const PRICING = {
  buildFirst: '1,50,000',
  buildAdditional: '75,000',
  careMin: '50,000',
};

// Problem Library — leads every card with the business problem, never the
// technology behind it, so a visitor can recognize their own situation
// before knowing anything about how it gets solved.
const problemLibrary = [
  { name: 'Marketplace reconciliation', desc: 'Payments come in from five marketplaces, and no one can say what’s actually settled without a spreadsheet marathon.' },
  { name: 'Missed hotel enquiries', desc: 'Guest enquiries land across email, WhatsApp, and OTAs, and go cold before anyone replies.' },
  { name: 'Founder reporting', desc: 'Someone loses every Monday morning stitching numbers together for a report the founder still has to read like a detective.' },
  { name: 'Manual customer follow-up', desc: 'Leads go quiet because no one remembers to follow up until it’s already too late.' },
  { name: 'Inventory leakage', desc: 'Stock on the shelf drifts from stock on the books, and nobody notices until the audit.' },
  { name: 'Slow approvals', desc: 'A request sits in someone’s inbox for days because there’s no clear owner or deadline.' },
];

// TODO: confirm these case studies are cleared for public naming
// (client sign-off) before treating this copy as final. logo is omitted (not
// `undefined`-assigned) where no logo file exists yet — India Contemporary,
// ClarityHQ, Content-ment, and Coach Your Psyche don't have one; href is
// omitted for the same reason on the latter three (not live yet).
const proof = [
  { name: 'Travaholic', industry: 'D2C E-Commerce', result: 'D2C infrastructure live in 2 days', href: 'https://travaholic.in', logo: travaholicLogo, screenshot: travaholicShot },
  { name: 'Travaholic Stays', industry: 'Hospitality / Travel', result: 'Direct booking system replacing Airbnb, WhatsApp, and a spreadsheet', href: 'https://travaholicstays.com', logo: travaholicStaysLogo, screenshot: travaholicStaysShot },
  { name: 'The Feeling Co.', industry: 'Events / Hospitality', result: 'Full digital operation — 9 releases, zero external subscriptions', href: 'https://thefeelingco.online', logo: feelingCoLogo, screenshot: feelingCoShot },
  { name: 'India Contemporary', industry: 'Retail / Marketplace', result: 'Two-sided marketplace connecting artists to collectors', href: 'https://indiacontemporary.net', screenshot: indiaContemporaryShot },
  { name: 'ClarityHQ', industry: 'Marketing / Growth', result: 'AI-native growth agency — acquisition, conversion, and retention run on one shared Brand Intelligence layer', href: site.clarityhq, screenshot: clarityhqShot, fit: 'contain' },
  { name: 'Content-ment', industry: 'Content / Marketing Tech', result: 'AI content operating system — drafting, approval, and export, entirely in-browser with zero backend', screenshot: contentmentShot, fit: 'contain' },
  { name: 'Coach Your Psyche', industry: 'Health & Wellness', result: 'AI mental wellness coaching — 4 personality-styled therapists, pay-per-message via Stripe', screenshot: coachYourPsycheShot, fit: 'contain' },
];

// Full-colour icon marks for the Integrations screen only (per instruction —
// every other screen, especially Proof, stays logo-free). Simple inline SVGs
// evoking each tool's real brand colours/marks; CRM uses a generic mark since
// "CRM" isn't a single product here.
const CRM_LOGO = `<svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"><rect width="40" height="40" rx="6" fill="#91AFC0"/><circle cx="20" cy="15" r="6" fill="#15130F"/><path d="M8 32c0-6.6 5.4-12 12-12s12 5.4 12 12" fill="#15130F"/></svg>`;

const SHEETS_LOGO = `<svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"><rect width="40" height="40" rx="6" fill="#0F9D58"/><rect x="10" y="7" width="20" height="26" rx="2" fill="#F5F5F0"/><rect x="13" y="11" width="14" height="2.2" fill="#0F9D58"/><rect x="13" y="16" width="14" height="2.2" fill="#0F9D58"/><rect x="13" y="21" width="14" height="2.2" fill="#0F9D58"/><rect x="13" y="26" width="14" height="2.2" fill="#0F9D58"/><rect x="18.9" y="11" width="2.2" height="17.2" fill="#0F9D58"/></svg>`;

const SLACK_LOGO = `<svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"><rect width="40" height="40" rx="6" fill="#15130F"/><path d="M15.5 24.5a2.5 2.5 0 1 1-2.5-2.5h2.5v2.5z" fill="#E01E5A"/><path d="M16.75 24.5a2.5 2.5 0 1 1 5 0v6.25a2.5 2.5 0 1 1-5 0V24.5z" fill="#E01E5A"/><path d="M17 15.5a2.5 2.5 0 1 1 2.5-2.5v2.5H17z" fill="#36C5F0"/><path d="M17 16.75a2.5 2.5 0 1 1 0 5h-6.25a2.5 2.5 0 1 1 0-5H17z" fill="#36C5F0"/><path d="M25.5 17a2.5 2.5 0 1 1 2.5 2.5H25.5V17z" fill="#2EB67D"/><path d="M24.25 17a2.5 2.5 0 1 1-5 0v-6.25a2.5 2.5 0 1 1 5 0V17z" fill="#2EB67D"/><path d="M24 25.5a2.5 2.5 0 1 1-2.5 2.5V25.5H24z" fill="#ECB22E"/><path d="M24 24.25a2.5 2.5 0 1 1 0-5h6.25a2.5 2.5 0 1 1 0 5H24z" fill="#ECB22E"/></svg>`;

const EMAIL_LOGO = `<svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"><rect width="40" height="40" rx="6" fill="#F5F5F0"/><path d="M7 12h26v18a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V12z" fill="#EA4335"/><path d="M7 12l13 10 13-10" fill="none" stroke="#F5F5F0" stroke-width="2"/><path d="M7 12l13 10 13-10" fill="#FBBC05"/><path d="M7 12a2 2 0 0 1 2-2h22a2 2 0 0 1 2 2l-13 10L7 12z" fill="#EA4335"/></svg>`;

// Contact screen icons — thin currentColor line marks (not the branded
// boxed logos above) so they tint with the page's own accent tokens.
const WHATSAPP_ICON = `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20 6C12.3 6 6 12.3 6 20c0 2.7.8 5.2 2.1 7.3L6.5 34l6.9-1.6C15.4 33.4 17.6 34 20 34c7.7 0 14-6.3 14-14S27.7 6 20 6z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M14.5 15.8c.3-.7.7-.7 1-.7h.8c.3 0 .6 0 .8.6.3.7 1 2.4 1 2.6.1.2.1.4 0 .6-.1.2-.2.4-.4.6l-.6.6c-.2.2-.4.4-.2.8.2.4 1 1.6 2.1 2.6 1.4 1.3 2.6 1.7 3 1.9.4.2.6.1.8-.1l.9-1c.2-.3.5-.2.8-.1.3.1 2.1 1 2.4 1.2.3.2.5.3.6.4.1.2.1 1-.3 1.9-.4.9-2.1 1.8-2.9 1.9-.8.1-1.5.4-4.8-1-3.9-1.6-6.3-5.6-6.5-5.9-.2-.3-1.5-2-1.5-3.7 0-1.7.9-2.6 1.2-2.9z" fill="currentColor"/></svg>`;
const EMAIL_ICON = `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="6" y="9" width="28" height="22" rx="3" stroke="currentColor" stroke-width="1.6"/><path d="M7.5 11.5L20 22 32.5 11.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const LINKEDIN_ICON = `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="7" y="16" width="6" height="17" fill="currentColor"/><circle cx="10" cy="9.5" r="3.3" fill="currentColor"/><path d="M19 16h6v3.2c1-1.9 3-3.7 6.3-3.7 6 0 6.7 4.3 6.7 9.4V33h-6V25c0-2 0-4.6-3-4.6s-3.5 2.2-3.5 4.5V33h-6.5V16z" fill="currentColor"/></svg>`;
const INSTAGRAM_ICON = `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="6" y="6" width="28" height="28" rx="8" stroke="currentColor" stroke-width="1.6"/><circle cx="20" cy="20" r="7" stroke="currentColor" stroke-width="1.6"/><circle cx="28.5" cy="11.5" r="1.6" fill="currentColor"/></svg>`;

// Compact landing-page teaser of the same 8-stage pipeline explained in
// full on /devshop/methodology — same icon marks, same gold-to-blue
// progression, just numbers + labels here (no sublines/prose) since this
// is a glance, not a read.
const PROCESS_STEPS = [
  { n: '01', key: 'diagnose', label: 'Diagnose' },
  { n: '02', key: 'framework', label: 'Framework' },
  { n: '03', key: 'pnl', label: 'P&L Map' },
  { n: '04', key: 'mechanism', label: 'Mechanism' },
  { n: '05', key: 'validate', label: 'Validate' },
  { n: '06', key: 'demo', label: 'Demo' },
  { n: '07', key: 'feedback', label: 'Feedback' },
  { n: '08', key: 'build', label: 'Build' },
];
const PROCESS_ICONS: Record<string, string> = {
  diagnose: `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="4" cy="24" r="2" fill="currentColor"/><path d="M4 24C10 24 12 12 18 12C24 12 24 24 32 24H36" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  framework: `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="18" cy="20" r="11" stroke="currentColor" stroke-width="1.6"/><path d="M18 20L23 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M32 14L37 10M33 20H38M32 26L37 30" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity="0.6"/></svg>`,
  pnl: `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20 8L34 16L20 24L6 16L20 8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M6 23L20 31L34 23" stroke="currentColor" stroke-width="1.4" opacity="0.6"/><path d="M6 30L20 38L34 30" stroke="currentColor" stroke-width="1.2" opacity="0.35"/></svg>`,
  mechanism: `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="5" cy="20" r="3" stroke="currentColor" stroke-width="1.6"/><circle cx="15" cy="20" r="3" stroke="currentColor" stroke-width="1.6"/><circle cx="25" cy="20" r="3" stroke="currentColor" stroke-width="1.6"/><circle cx="35" cy="20" r="4" fill="currentColor" class="mech-tip"/><path d="M8 20H12M18 20H22M28 20H31" stroke="currentColor" stroke-width="1.6"/></svg>`,
  validate: `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="11" width="9" height="18" stroke="currentColor" stroke-width="1.6"/><rect x="28" y="11" width="9" height="18" stroke="currentColor" stroke-width="1.6"/><path d="M13 20H27" stroke="currentColor" stroke-width="1.4" stroke-dasharray="3 3"/></svg>`,
  demo: `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="8" width="34" height="24" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M3 14H37" stroke="currentColor" stroke-width="1.6"/><circle cx="7.5" cy="11" r="0.9" fill="currentColor"/><circle cx="11" cy="11" r="0.9" fill="currentColor"/><path d="M15 20L23 26L15 28V20Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>`,
  feedback: `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M32 14C29 9 23 7 17 9C11 11 7 17 8 23" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M8 8V15H15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 26C11 31 17 33 23 31C29 29 33 23 32 17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M32 32V25H25" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  build: `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20 6L34 13V27L20 34L6 27V13L20 6Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M6 13L20 20L34 13M20 20V34" stroke="currentColor" stroke-width="1.4" opacity="0.6"/></svg>`,
};

const title = 'Fast Tech Dev Shop — problem in, working demo on the spot';
const description =
  "Tell us the business problem. Get a working demo on the spot, built around a proven framework. One round of feedback, then a 30-day build from deposit — priced monthly, not by project.";
const canonical = new URL('/devshop', site.domain).href;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="noindex, follow" />
  <link rel="icon" href="/devshop-favicon.svg" type="image/svg+xml" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="DevShop" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL('/devshop-og.png', site.domain).href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL('/devshop-og.png', site.domain).href} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Crimson+Text:wght@400;600&family=DM+Sans:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
</head>
<body>

<PortalHeader homeHref="/devshop" spa={true} currentSlug={null} theme="light">
  <a href="#" data-go="proof" slot="extra-nav">Proof</a>
  <a href="#" data-go="contact" slot="extra-nav-2">Contact</a>
</PortalHeader>

<main class="wrap">

  <!-- 01 LANDING -->
  <section class="screen screen--scroll active" id="landing" data-marketing-index="1">
    <div class="eyebrow">FAST TECH DEV SHOP</div>
    <h1 class="hero serif">Give us a <span class="tint-gold">business&nbsp;problem.</span></h1>
    <p class="sub" style="max-width:560px; margin-top:8px;">We'll figure out what's actually causing it, ground the fix in the right researched framework — real credibility, not a guess — show you the mechanism we'd build, and put a working version in front of you before you buy anything.</p>
    <form class="input-row" id="landingForm">
      <input type="text" id="landingProblem" placeholder="What's the business problem?" />
      <button class="btn" type="submit">Give us a problem →</button>
    </form>
    <p class="sub" style="margin-top:16px;"><a href="#" data-go="proof" class="btn-plain">See what we've built →</a></p>

    <div class="hero-visual">
      <div class="hero-visual-backdrop"></div>
      <div class="hero-device">
        <div class="hero-device-scene" aria-hidden="true">
          <svg viewBox="0 0 800 420" preserveAspectRatio="xMidYMax slice" xmlns="http://www.w3.org/2000/svg">
            <rect width="800" height="420" fill="#a9c2cf" />
            <ellipse cx="180" cy="80" rx="110" ry="26" fill="#c7dae2" opacity="0.7" />
            <ellipse cx="560" cy="50" rx="140" ry="22" fill="#c7dae2" opacity="0.6" />
            <path d="M0 300 Q200 190 400 260 T800 230 V420 H0 Z" fill="#7f9c68" />
            <path d="M0 340 Q220 260 420 310 T800 280 V420 H0 Z" fill="#6a8a55" />
          </svg>
        </div>
        <div class="hero-device-overlay">
          <div class="hero-device-crumb">Solution brief &gt; Business impact</div>
          <div class="hero-device-stat">
            <span class="hero-device-num serif">32<span class="hero-device-unit">hrs/mo</span></span>
            <span class="hero-device-label">Manual work recovered — one real build</span>
          </div>
          <div class="hero-device-chart" role="presentation">
            {[38, 52, 46, 61, 58, 70, 66, 78, 74, 88].map((h, i) => (
              <span class="hero-device-bar" style={`height:${h}%; animation-delay:${i * 70}ms;`}></span>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="industry-pick">
      <p class="industry-pick-label">Or pick from common problems in your industry</p>
      <div class="industry-chips">
        {devshopVerticals.map((v) => (
          v.status === 'live' ? (
            <a href={`/devshop/${v.slug}`} class="industry-chip" style={`--chip-color:${v.color};`}>
              <span class="industry-chip-tag">{v.tag}</span>{v.name}
            </a>
          ) : (
            <span class="industry-chip industry-chip--soon" style={`--chip-color:${v.color};`}>
              <span class="industry-chip-tag">{v.tag}</span>{v.name}<em>Coming soon</em>
            </span>
          )
        ))}
      </div>
    </div>

    <div class="process-teaser">
      <p class="process-teaser-label">Our process</p>
      <div class="process-strip">
        {PROCESS_STEPS.map((s, i) => (
          <div class={`process-item ${i === 4 ? 'is-transition' : i >= 5 ? 'is-blue' : 'is-gold'}`}>
            <span class="process-icon" set:html={PROCESS_ICONS[s.key]} />
            <span class="process-label">{s.n} {s.label}</span>
          </div>
        ))}
      </div>
      <a class="process-more" href="/devshop/methodology">See the full methodology &rarr;</a>
    </div>

  </section>

  <!-- 02 HOW IT WORKS -->
  <section class="screen screen--scroll" id="how-it-works" data-marketing-index="2">
    <div class="eyebrow">HOW IT WORKS</div>
    <h1 class="hero serif">From <span class="tint-blue">problem</span><br />to production. <span class="tint-gold">Fast.</span></h1>
    <div class="steps">
      <div class="step"><div class="num">01</div><div class="rule"></div><h3>Problem in</h3><p>Tell us what's broken.<br />No specs. No decks.</p></div>
      <div class="step"><div class="num">02</div><div class="rule"></div><h3><span class="tint-gold">Instant</span> demo</h3><p>We diagnose and show you<br />a working demo right there.</p></div>
      <div class="step"><div class="num">03</div><div class="rule"></div><h3>Approve & staff</h3><p>You approve the demo and pay the deposit.<br /><br />We staff your build — an FDE/client lead, a solution architect, engineers, and a <span class="tint-gold">subject matter expert in your industry and business function</span>, not just an engineering team guessing at your domain.</p></div>
      <div class="step"><div class="num">04</div><div class="rule"></div><h3>Build & handover</h3><p>We ship within 30 days, walk your team<br />through it live, then DevShop Care + Optimisation starts.</p></div>
    </div>
  </section>

  <!-- 03 PROOF -->
  <section class="screen screen--scroll" id="proof" data-marketing-index="3">
    <div class="eyebrow">PROOF</div>
    <h1 class="hero serif">Built fast. <span class="tint-blue">Shipped</span> for real.</h1>
    <div class="proof-grid">
      {proof.map((p) => (
        <a
          class="proof-card"
          {...(p.href ? { href: p.href, target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {p.screenshot && (
            <div class:list={['proof-shot', p.fit === 'contain' && 'proof-shot--contain']}>
              <Image src={p.screenshot} alt={`${p.name} screenshot`} width={960} height={600} />
              {p.industry && <span class="proof-industry-tag">{p.industry}</span>}
            </div>
          )}
          <div class="proof-card-body">
            {p.logo ? (
              <Image class="proof-logo-img" src={p.logo} alt={`${p.name} logo`} width={28} height={28} />
            ) : (
              <span class="proof-logo-text serif">{p.name}</span>
            )}
            <div class="proof-card-text">
              {p.logo && <div class="name">{p.name}</div>}
              <div class="result">{p.result}</div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 04 PROBLEM LIBRARY — leads with the business problem, not the
       technology behind it. Deliberately no "AI use case" framing. -->
  <section class="screen screen--scroll" id="problems" data-marketing-index="4">
    <div class="eyebrow">PROBLEMS WE'VE WORKED ON</div>
    <h1 class="hero serif">Real business problems.<br /><span class="tint-blue">Not</span> <span class="tint-gold">AI use cases.</span></h1>
    <p class="sub" style="max-width:560px;">If one of these sounds familiar, you already know enough to start — the technology is our problem, not yours.</p>
    <div class="problem-grid">
      {problemLibrary.map((p) => (
        <button type="button" class="problem-card" data-go="intake">
          <div class="problem-name serif">{p.name}</div>
          <div class="problem-desc">{p.desc}</div>
          <div class="problem-cta">Give us this problem →</div>
        </button>
      ))}
    </div>
  </section>

  <!-- 05 INDUSTRIES — one page per vertical, same architecture, re-skinned
       and re-populated per industry (see verticals config above). -->
  <section class="screen screen--scroll" id="verticals" data-marketing-index="5">
    <div class="eyebrow">INDUSTRIES</div>
    <h1 class="hero serif" style="font-size:clamp(32px,4.4vw,52px);">Same method. <span class="tint-blue">Every</span> <span class="tint-gold">industry.</span></h1>
    <p class="sub" style="max-width:600px;">Each industry gets its own common-problem library and its own starting point — the same diagnosis-first process underneath.</p>
    <div class="vertical-grid">
      {devshopVerticals.map((v) => (
        v.status === 'live' ? (
          <a class="vertical-card" href={`/devshop/${v.slug}`} style={`--chip-color:${v.color};`}>
            <div class="vertical-dot"></div>
            <div class="vertical-name">{v.name}</div>
            <div class="vertical-blurb">{v.blurb}</div>
            <div class="vertical-cta">Enter →</div>
