---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import PhotoBlock from '../components/PhotoBlock.astro';
import virat from '../assets/virat.png';
---

<Base
  title="About Virat Mohan — operator and founder"
  description="Virat Mohan is an operator, chartered accountant and founder based in Gurugram — the full career arc lives on the homepage."
  path="/about"
>
  <article class="about section">
    <div class="container">
      <div class="about__grid">
        <header class="about__head" data-reveal>
          <p class="eyebrow" style="color: var(--terracotta)">About</p>
          <h1 class="about__title">Virat Mohan</h1>
          <hr class="about__rule" />
          <p class="about__standfirst dim">
            Two decades across finance, hospitality and technology. LSE,
            then KPMG London, then operator, then CEO, now building
            AI-native services from Gurugram.
          </p>

          <p class="about__body">
            Virat Mohan is an operator, chartered accountant and founder
            based in Gurugram, Haryana, India. Over roughly twenty years he
            has moved from statutory audit in the City of London to running
            restaurant estates across five countries, to building
            cloud-kitchen infrastructure at scale, to raising and deploying
            capital, and finally to founding a set of AI-native growth
            services. The full chronology — every turn, in order — lives on
            the <a class="link-underline" href="/">homepage</a>.
          </p>

          <p class="about__body">
            He studied at The Shri Ram School and Don Bosco School, then LSE
            and Bayes Business School (formerly Cass), and qualified as a
            chartered accountant (ACA). That training was not incidental to
            what came later; it was the foundation. The habit of tying every
            claim back to a verifiable number, of reading a business through
            its statements rather than its story, has shaped every role
            since.
          </p>

          <p class="about__body">
            He advises founders, investors and operating teams on the seam
            between capital and execution — commercial due diligence,
            unit economics, capital allocation, GCC and India market entry,
            operational turnarounds, and DRHP/IPO readiness. More on{' '}
            <a class="link-underline" href="/advisory">Advisory</a>.
          </p>

          <p class="about__contact">
            To discuss an engagement, write to
            <a class="link-underline" href={`mailto:${site.email}`}
              >{site.email}</a
            >.
          </p>
        </header>

        <div class="about__photo" data-reveal style="--reveal-delay: 100ms">
          <PhotoBlock
            src={virat}
            alt="Virat Mohan"
            aspect="4 / 5"
            objectPosition="62% 12%"
          />
        </div>
      </div>
    </div>
  </article>
</Base>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .about__title {
    margin: 1rem 0 1.5rem;
  }
  .about__rule {
    border: 0;
    height: 4px;
    width: 4rem;
    background: var(--terracotta);
    margin: 0 0 1.5rem;
  }
  .about__standfirst {
    font-family: var(--serif);
    font-size: clamp(1.35rem, 2.4vw, 1.9rem);
    line-height: 1.25;
    margin: 0 0 2rem;
  }
  .about__body {
    max-width: 60ch;
    line-height: 1.75;
    margin: 0 0 1.5rem;
  }
  .about__contact {
    margin-top: 1rem;
  }
  .about__photo {
    max-width: 26rem;
    position: sticky;
    top: 7rem;
  }
  @media (max-width: 860px) {
    .about__grid {
      grid-template-columns: 1fr;
    }
    .about__photo {
      max-width: 22rem;
      position: static;
      order: -1;
      margin-bottom: 2.5rem;
    }
  }
</style>
