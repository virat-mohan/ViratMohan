---
// Shared header for every /devshop* page — main portal, every industry
// vertical, and the static methodology page. Always black, regardless of
// the host page's own colour tokens (this file hardcodes its palette
// instead of reading --dev-* variables), so the chrome reads as one
// consistent portal no matter which vertical's body content sits below it.
//
// `spa` pages (devshop.astro, devshop/restaurants.astro, and any future
// vertical) run their own client-side screen-switcher keyed by `data-go` —
// for those, nav items that name a screen ("How it works", "Pricing",
// "Start") render as `data-go` links intercepted by that page's own script.
// `spa={false}` pages (methodology.astro) have no screens of their own, so
// the same nav items render as real links back to `homeHref`'s screens.
import { Image } from 'astro:assets';
import { devshopVerticals } from '../../data/devshop-verticals';
import devshopLogo from '../../assets/screenshots/devshop-logo-transparent.png';
import { site } from '../../data/site';

export interface Props {
  homeHref: string; // the SPA page these nav items' screens belong to, e.g. "/devshop" or "/devshop/restaurants"
  spa: boolean; // true if THIS page is that SPA (renders data-go); false if it's a static page linking back to homeHref
  currentSlug?: string | null; // vertical slug this page belongs to, e.g. "restaurants" — highlights it in the Industries dropdown
  industryLabel?: string | null; // e.g. "Food & Beverage" — renders "Built for {industryLabel}"; omit on the main portal page
  verticalTag?: string | null; // e.g. "F&B" — short badge next to the wordmark
  theme?: 'dark' | 'light'; // 'dark' (default) is the existing black/gold portal chrome; 'light' is the cream/sage palette trial (see devshop.astro) — everything else about the header is identical between the two.
}

const { homeHref, spa, currentSlug = null, industryLabel = null, verticalTag = null, theme = 'dark' } = Astro.props;

const navItems = [
  { label: 'How it works', screenId: 'how-it-works' },
  { label: 'Pricing', screenId: 'pricing' },
];
---

<header class="ds-portal-header" data-theme={theme}>
  <div class="ds-alpha-banner" id="dsAlphaBanner" hidden>
    <p class="ds-alpha-text">
      <span class="ds-alpha-tag">ALPHA</span>
      DevShop is early &mdash; still being built in the open. If this is the kind of thing that interests you,
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer">DM me &rarr;</a>
    </p>
    <button type="button" class="ds-alpha-close" id="dsAlphaClose" aria-label="Dismiss">&times;</button>
  </div>
  <div class="ds-header-inner">
    <a class="ds-logo" href="/devshop">
      {verticalTag && <span class="ds-logo-tag">{verticalTag}</span>}
      <Image class="ds-logo-mark" src={devshopLogo} width={devshopLogo.width} height={devshopLogo.height} alt="DevShop — built fast, for real businesses" loading="eager" fetchpriority="high" format="png" />
    </a>
    {industryLabel && <div class="ds-industry-badge">Built for {industryLabel}</div>}

    <nav class="ds-nav" id="marketingNav">
      <div class="ds-nav-side ds-nav-side--left">
        <div class="ds-dropdown">
          <button type="button" class="ds-dropdown-trigger" id="dsIndustriesTrigger">Industries ▾</button>
          <div class="ds-dropdown-menu" id="dsIndustriesMenu">
            {devshopVerticals.map((v) => (
              v.status === 'live' ? (
                <a href={`/devshop/${v.slug}`} class:list={{ active: currentSlug === v.slug }} style={`--chip-color:${v.color}; --band-color:${v.bg};`}><span class="ds-dropdown-dot"></span>{v.tag} — {v.name}</a>
              ) : (
                <span class="ds-dropdown-soon"><span class="ds-dropdown-dot"></span>{v.tag} — {v.name} <em>(coming soon)</em></span>
              )
            ))}
          </div>
        </div>
      </div>

      <div class="ds-nav-center">
        {spa ? (
          <a href="#" data-go={navItems[0].screenId}>{navItems[0].label}</a>
        ) : (
          <a href={`${homeHref}#${navItems[0].screenId}`}>{navItems[0].label}</a>
        )}

        <a href="/devshop/methodology" class:list={{ active: !spa && homeHref === '/devshop' && currentSlug === null }}>Methodology</a>

        <slot name="extra-nav" />

        {spa ? (
          <a href="#" data-go={navItems[1].screenId}>{navItems[1].label}</a>
        ) : (
          <a href={`${homeHref}#${navItems[1].screenId}`}>{navItems[1].label}</a>
        )}

        <slot name="extra-nav-2" />

        <a href="https://www.viratmohan.com" target="_blank" rel="noopener noreferrer">Founder</a>

        {spa ? (
          <a href="#" data-go="intake" class="ds-start">Start →</a>
        ) : (
          <a href={`${homeHref}#intake`} class="ds-start">Start →</a>
        )}
      </div>

      <div class="ds-nav-side ds-nav-side--right" aria-hidden="true"></div>
    </nav>

    <nav class="ds-nav ds-app-nav" id="appNav" style="display:none;">
      <a href="#" data-go="dashboard">Dashboard</a>
      <a href="#" data-go="orchestrator">Orchestrator</a>
      <a href="#" data-go="integrations">Integrations</a>
      <a href="#" data-go="activity">Activity</a>
      <a href="#" data-go="billing">Billing</a>
      <a href="#" data-go="landing" class="ds-plain" style="margin-left:8px;">Log out</a>
    </nav>
  </div>
  <div class="ds-header-hair"></div>
</header>

<a
  class="ds-whatsapp-float"
  href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent("Hi — I have a question about DevShop.")}`}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat on WhatsApp"
  title="Questions? Chat on WhatsApp"
>
  <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M20 6C12.3 6 6 12.3 6 20c0 2.7.8 5.2 2.1 7.3L6.5 34l6.9-1.6C15.4 33.4 17.6 34 20 34c7.7 0 14-6.3 14-14S27.7 6 20 6z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
    <path d="M14.5 15.8c.3-.7.7-.7 1-.7h.8c.3 0 .6 0 .8.6.3.7 1 2.4 1 2.6.1.2.1.4 0 .6-.1.2-.2.4-.4.6l-.6.6c-.2.2-.4.4-.2.8.2.4 1 1.6 2.1 2.6 1.4 1.3 2.6 1.7 3 1.9.4.2.6.1.8-.1l.9-1c.2-.3.5-.2.8-.1.3.1 2.1 1 2.4 1.2.3.2.5.3.6.4.1.2.1 1-.3 1.9-.4.9-2.1 1.8-2.9 1.9-.8.1-1.5.4-4.8-1-3.9-1.6-6.3-5.6-6.5-5.9-.2-.3-1.5-2-1.5-3.7 0-1.7.9-2.6 1.2-2.9z" fill="currentColor"/>
  </svg>
  <span class="ds-whatsapp-tooltip">Quick question? Chat with me directly</span>
</a>

<script>
  // Alpha banner — dismissible, remembered per browser via localStorage so
  // a repeat visitor doesn't see it re-appear on every page. Starts
  // `hidden` in the markup and only gets shown here (rather than the
  // reverse: visible-by-default, hidden by script) so a returning visitor
  // who already dismissed it never sees a flash of it before JS removes it.
  const alphaBanner = document.getElementById('dsAlphaBanner');
  const alphaClose = document.getElementById('dsAlphaClose');
  if (alphaBanner && alphaClose) {
    let dismissed = false;
    try { dismissed = localStorage.getItem('ds-alpha-dismissed') === '1'; } catch (e) {}
    if (!dismissed) alphaBanner.hidden = false;
    alphaClose.addEventListener('click', () => {
      alphaBanner.hidden = true;
      try { localStorage.setItem('ds-alpha-dismissed', '1'); } catch (e) {}
      syncHeaderHeight();
    });
  }

  // Publish the header's real rendered height as a CSS variable so any
  // page using an anchor-scroll layout (devshop.astro's `.screen--scroll`,
  // scroll-margin-top) can offset against the *actual* sticky header —
  // including the alpha banner, which changes height depending on
  // whether it's shown, dismissed, or wrapped to two lines on mobile.
  // A hardcoded px offset silently goes stale the moment the header's
  // own content changes (exactly what happened when the banner was added).
  const dsHeaderEl = document.querySelector('.ds-portal-header');
  function syncHeaderHeight() {
    if (!dsHeaderEl) return;
    document.documentElement.style.setProperty('--ds-header-h', dsHeaderEl.offsetHeight + 'px');
  }
  syncHeaderHeight();
  window.addEventListener('resize', syncHeaderHeight);
  if (dsHeaderEl && 'ResizeObserver' in window) {
    new ResizeObserver(syncHeaderHeight).observe(dsHeaderEl);
  }

  // Industries dropdown — click-to-toggle, closes on outside click or Escape.
  // Scoped to this component's own ids so it can't collide with any host
  // page's own script (each host page's `data-go` handlers still see these
  // anchors via a plain document-wide querySelectorAll, unaffected by this).
  const trigger = document.getElementById('dsIndustriesTrigger');
  const menu = document.getElementById('dsIndustriesMenu');
  if (trigger && menu) {
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const opening = !menu.classList.contains('open');
      menu.classList.toggle('open');
      if (!opening) return;
      // The CSS centers/left-aligns the menu on the trigger, which is a
      // reasonable default but can still push it past the viewport edge on
      // narrow screens depending on where "Industries" happens to land in
      // that page's nav (varies per vertical page's own item set/widths).
      // Clamp it back on-screen after layout, without disturbing the CSS
      // default (centered under the trigger via left:50%+translateX) when
      // it already fits. getBoundingClientRect() is viewport-relative but
      // CSS `left` is relative to the offsetParent (.ds-dropdown), so
      // convert between the two coordinate spaces rather than assigning
      // the viewport value directly.
      const margin = 12;
      const rect = menu.getBoundingClientRect();
      let targetViewportLeft = rect.left;
      const overflowRight = rect.right - (document.documentElement.clientWidth - margin);
      if (overflowRight > 0) targetViewportLeft -= overflowRight;
      if (targetViewportLeft < margin) targetViewportLeft = margin;
      if (targetViewportLeft !== rect.left) {
        const parentLeft = (menu.offsetParent || document.body).getBoundingClientRect().left;
        menu.style.transform = 'none';
        menu.style.left = `${targetViewportLeft - parentLeft}px`;
      } else {
        menu.style.left = '';
        menu.style.transform = '';
      }
    });
    document.addEventListener('click', () => menu.classList.remove('open'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') menu.classList.remove('open');
    });
  }
</script>

<style>
  /* Theme tokens — 'dark' is the original black/gold portal chrome (the
     default, used everywhere except the light-theme trial); 'light' is the
     cream/sage palette pulled from the Figma design-system reference,
     currently only used on devshop.astro. Same structure/markup either way,
     only these tokens change. */
  .ds-portal-header[data-theme='dark'] {
    --ds-bg: #15130f; --ds-scheme: dark;
    --ds-logo: #d4af37; --ds-tag: #a66a62; --ds-badge: #85837e;
    --ds-nav: #b7b5af; --ds-nav-hover: #f5f5f0; --ds-nav-active: #d4af37;
    --ds-start: #d4af37; --ds-start-hover-bg: rgba(212, 175, 55, 0.1);
    --ds-dropdown-bg: #1c1a15; --ds-dropdown-border: rgba(245,245,240,0.15);
    --ds-dropdown-hover-bg: rgba(245,245,240,0.06); --ds-dropdown-soon: #625f59;
    --ds-hair-gradient: linear-gradient(90deg, #91afc0, #b7b5af, #d4af37, #a66a62);
  }
  .ds-portal-header[data-theme='light'] {
    --ds-bg: #f5f2ea; --ds-scheme: light;
    --ds-logo: #4f5f42; --ds-tag: #a3573f; --ds-badge: #82806f;
    --ds-nav: #1e211a; --ds-nav-hover: #4f5f42; --ds-nav-active: #4f5f42;
    --ds-start: #4f5f42; --ds-start-hover-bg: rgba(79, 95, 66, 0.08);
    --ds-dropdown-bg: #ffffff; --ds-dropdown-border: rgba(30,33,26,0.12);
    --ds-dropdown-hover-bg: rgba(30,33,26,0.05); --ds-dropdown-soon: #9a9d90;
    --ds-hair-gradient: linear-gradient(90deg, #b08a63, #82806f, #4f5f42, #a3573f);
    /* Nav typography: DM Sans Medium, small-caps-style tracking — clean and
       legible rather than a loud bold sans or an unexpected serif (both
       tried and rejected). The dark theme's uppercase mono-spaced look
       stays the default everywhere else. */
    --ds-nav-font: 'DM Sans', system-ui, sans-serif; --ds-nav-weight: 600;
    --ds-nav-case: uppercase; --ds-nav-spacing: 0.08em; --ds-nav-size: 12px;
  }
  .ds-portal-header {
    position: sticky; top: 0; z-index: 50;
    background: var(--ds-bg); color-scheme: var(--ds-scheme);
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
  }
  /* Alpha banner — one thin strip, distinct from the portal chrome's own
     palette (a warm gold-on-ink band) so it reads as a notice rather than
     part of the nav, in either theme. */
  .ds-alpha-banner {
    display: flex; align-items: center; justify-content: center; gap: 14px;
    background: #15130f; color: #d4af37; padding: 9px 48px;
    text-align: center;
  }
  .ds-alpha-text { margin: 0; font-size: 12.5px; line-height: 1.5; font-family: 'Inter', system-ui, sans-serif; color: #d9c9a3; }
  .ds-alpha-tag {
    display: inline-block; font-size: 10px; font-weight: 700; letter-spacing: 0.08em;
    color: #15130f; background: #d4af37; border-radius: 3px; padding: 1px 6px; margin-right: 8px;
    vertical-align: middle;
  }
  .ds-alpha-text a { color: #f5e6c3; font-weight: 600; text-decoration: underline; text-underline-offset: 2px; margin-left: 2px; }
  .ds-alpha-text a:hover { color: #fff; }
  .ds-alpha-close {
    flex: none; background: none; border: none; color: #85837e; font-size: 18px; line-height: 1;
    cursor: pointer; padding: 2px 4px;
  }
  .ds-alpha-close:hover { color: #f5f5f0; }
  @media (max-width: 640px) {
    .ds-alpha-banner { padding: 8px 14px; gap: 8px; }
    .ds-alpha-text { font-size: 11px; text-align: left; }
    .ds-alpha-tag { display: block; width: max-content; margin: 0 0 3px; }
  }

  .ds-header-inner { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 20px 64px; }
  .ds-logo {
    display: flex; align-items: baseline; gap: 4px;
    font-family: 'Instrument Serif', Georgia, serif; font-style: italic;
    font-size: 34px; letter-spacing: 0.01em; color: var(--ds-logo); font-weight: 400; line-height: 1;
    text-decoration: none;
  }
  .ds-logo-tag {
    font-family: 'JetBrains Mono', monospace; font-style: normal;
    font-size: 15px; font-weight: 600; letter-spacing: 0.02em; color: var(--ds-badge); opacity: 0.85;
  }
  .ds-logo-mark { display: block; height: 132px; width: auto; }
  @media (max-width: 560px) { .ds-logo-mark { height: 84px; } }
  .ds-industry-badge {
    font-family: 'Crimson Text', Georgia, serif; font-size: 22px; font-weight: 600; letter-spacing: 0;
    color: var(--ds-nav-active, var(--ds-logo)); text-transform: none;
  }
  @media (max-width: 560px) { .ds-industry-badge { font-size: 17px; } }
  .ds-nav { display: flex; align-items: center; width: 100%; gap: 16px; }
  .ds-nav-side { flex: 1; display: flex; align-items: center; }
  .ds-nav-side--left { justify-content: flex-start; }
  .ds-nav-side--right { justify-content: flex-end; }
  .ds-nav-center { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 24px 34px; flex: none; max-width: 100%; }
  @media (max-width: 860px) {
    .ds-nav { flex-wrap: wrap; justify-content: center; }
    .ds-nav-side { flex: none; }
    .ds-nav-side--right { display: none; }
  }
  /* :global — the extra-nav slot's <a> is defined in the HOST page's file,
     not this component's, so a normally-scoped rule here would never match
     it (Astro scopes don't cross a slot boundary). Unscope just the nav
     link look so every page's slotted item inherits it too. */
  .ds-nav :global(a), .ds-dropdown-trigger, .ds-plain {
    font-size: var(--ds-nav-size, 13px); letter-spacing: var(--ds-nav-spacing, 0.12em); text-transform: var(--ds-nav-case, uppercase);
    color: var(--ds-nav); text-decoration: none; background: none; border: none; cursor: pointer;
    font-family: var(--ds-nav-font, inherit); font-weight: var(--ds-nav-weight, 400); padding: 0;
  }
  .ds-nav :global(a:hover), .ds-dropdown-trigger:hover { color: var(--ds-nav-hover); }
  .ds-nav :global(a.active) { color: var(--ds-nav-active); }
  .ds-start {
    color: var(--ds-start) !important; font-size: 15px !important; font-weight: 600;
    border: 1px solid var(--ds-start) !important; border-radius: 4px; padding: 8px 18px !important;
    transition: background 0.2s;
  }
  .ds-start:hover { background: var(--ds-start-hover-bg); color: var(--ds-start) !important; }

  .ds-dropdown { position: relative; }
  .ds-dropdown-menu {
    display: none; position: absolute; top: calc(100% + 14px); left: 50%; transform: translateX(-50%);
    background: var(--ds-dropdown-bg); border: 1px solid var(--ds-dropdown-border); border-radius: 6px;
    padding: 8px; min-width: 260px; flex-direction: column; gap: 2px; z-index: 60;
  }
  .ds-dropdown-menu.open { display: flex; }
  .ds-dropdown-menu .ds-dropdown-soon {
    display: flex; align-items: center; gap: 9px; font-size: 12.5px; letter-spacing: 0.02em; text-transform: none;
    color: var(--ds-nav); text-decoration: none; padding: 9px 12px; border-radius: 4px; white-space: nowrap;
  }
  /* Live verticals get their own page's actual background tint as a full
     row color, not just a dot — the color you see here is literally the
     color of the page you're about to land on. These tints are always
     pale, so text stays a fixed dark ink regardless of the dropdown's own
     light/dark theme. */
  .ds-dropdown-menu a {
    display: flex; align-items: center; gap: 9px; font-size: 12.5px; letter-spacing: 0.02em; text-transform: none;
    text-decoration: none; padding: 9px 12px; border-radius: 4px; white-space: nowrap;
    background: var(--band-color, transparent); color: #1a1410;
  }
  .ds-dropdown-dot { flex: none; width: 7px; height: 7px; border-radius: 50%; background: var(--chip-color, currentColor); border: 1px solid rgba(30,33,26,0.15); opacity: 1; }
  .ds-dropdown-menu a:hover { filter: brightness(0.95); color: var(--chip-color, #1a1410); }
  .ds-dropdown-menu a.active { color: var(--chip-color, #1a1410); font-weight: 600; }
  .ds-dropdown-soon { color: var(--ds-dropdown-soon); cursor: default; }
  .ds-dropdown-soon .ds-dropdown-dot { opacity: 0.4; }
  .ds-dropdown-soon em { font-style: normal; }

  .ds-header-hair {
    height: 1px;
    background: var(--ds-hair-gradient);
    opacity: 0.55;
  }

  @media (max-width: 860px) {
    .ds-header-inner { padding: 18px 24px; }
    .ds-nav { gap: 16px 20px; }
    .ds-nav a, .ds-dropdown-trigger, .ds-plain { font-size: 11px; letter-spacing: 0.08em; }
  }
  @media (max-width: 560px) {
    .ds-header-inner { padding: 14px 20px; gap: 8px; }
    .ds-logo { font-size: 24px; }
    /* Centering the menu on the trigger's own position (the default,
       desktop-safe behavior) pushes it off-screen on mobile whenever the
       trigger itself sits near an edge — "Industries" is usually the
       leftmost nav item once the row wraps. Anchor to the dropdown
       container's left edge instead and cap the width to the viewport. */
    .ds-dropdown-menu {
      left: 0; right: auto; transform: none;
      min-width: 0; width: max-content; max-width: calc(100vw - 40px);
    }
  }

  /* Floating WhatsApp button — always reachable regardless of scroll
     position or which DevShop screen is showing, for a visitor who just
     wants a quick human answer instead of working through the whole
     site. Fixed to the viewport (not the header), so it sits above
     every page's own content. */
  .ds-whatsapp-float {
    position: fixed; right: 22px; bottom: 22px; z-index: 200;
    width: 56px; height: 56px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: #25d366; color: #fff; text-decoration: none;
    box-shadow: 0 8px 20px -4px rgba(0,0,0,0.35), 0 0 0 1px rgba(255,255,255,0.15);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .ds-whatsapp-float svg { width: 28px; height: 28px; }
  .ds-whatsapp-float:hover { transform: scale(1.06); box-shadow: 0 10px 26px -4px rgba(0,0,0,0.4), 0 0 0 1px rgba(255,255,255,0.2); }
  .ds-whatsapp-tooltip {
    position: absolute; right: calc(100% + 12px); top: 50%; transform: translateY(-50%);
    background: #15130f; color: #f5f5f0; font-family: 'Inter', system-ui, sans-serif;
    font-size: 12.5px; font-weight: 500; white-space: nowrap; padding: 8px 12px; border-radius: 6px;
    opacity: 0; pointer-events: none; transition: opacity 0.15s ease;
  }
  .ds-whatsapp-float:hover .ds-whatsapp-tooltip { opacity: 1; }
  @media (max-width: 560px) {
    .ds-whatsapp-float { right: 16px; bottom: 16px; width: 52px; height: 52px; }
    .ds-whatsapp-float svg { width: 26px; height: 26px; }
    .ds-whatsapp-tooltip { display: none; }
  }
</style>
