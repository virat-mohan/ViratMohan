---
const links = [
  { href: '/devshop', label: 'Dev Shop' },
  { href: '/about', label: 'About' },
  { href: '/advisory', label: 'Advisory' },
  { href: '/work', label: 'Work' },
  { href: '/writing', label: 'Writing' },
  { href: '/clarityhq', label: 'ClarityHQ' },
];
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="nav">
  <div class="container nav__inner">
    <a href="/" class="nav__mark" aria-label="Virat Mohan — home">VM</a>
    <nav aria-label="Primary">
      <ul class="nav__list">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                class="nav__link link-underline"
                aria-current={here === l.href ? 'page' : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 4.5rem;
  }
  .nav__mark {
    font-family: var(--display);
    font-weight: 400;
    font-size: 1.25rem;
    letter-spacing: 0.01em;
    text-decoration: none;
    color: var(--fg);
    line-height: 1;
  }
  nav {
    margin-left: auto;
  }
  .nav__list {
    display: flex;
    gap: clamp(1rem, 3vw, 2.25rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__link {
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--fg);
  }
  .nav__link[aria-current='page'] {
    color: var(--muted);
  }
  @media (max-width: 540px) {
    .nav__inner {
      flex-wrap: wrap;
      justify-content: space-between;
      height: auto;
      padding-top: 1rem;
      padding-bottom: 1rem;
      row-gap: 0.75rem;
    }
    .nav__mark {
      order: 1;
    }
    nav {
      order: 2;
      margin-left: 0;
      flex: 1 0 100%;
    }
    .nav__list {
      flex-wrap: wrap;
      gap: 0.6rem 1rem;
    }
    .nav__link {
      font-size: 0.75rem;
    }
  }
</style>
