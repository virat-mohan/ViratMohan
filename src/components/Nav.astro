---
const links = [
  { href: '/devshop', label: 'Dev Shop', c: 'var(--gold)' },
  { href: '/clarityhq', label: 'ClarityHQ', c: 'var(--magenta)' },
  { href: '/advisory', label: 'Advisory', c: 'var(--cobalt)' },
  { href: '/writing', label: 'My Writing', c: 'var(--terracotta)' },
];
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="nav">
  <div class="container nav__inner">
    <a href="/" class="nav__mark" aria-label="Virat Mohan — home">VM</a>
    <nav aria-label="Primary">
      <ul class="nav__list">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                class="nav__link"
                style={`--c: ${l.c}`}
                aria-current={here === l.href ? 'page' : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="nav__bar" aria-hidden="true">
    <span style="background: var(--gold)"></span>
    <span style="background: var(--magenta)"></span>
    <span style="background: var(--cobalt)"></span>
    <span style="background: var(--terracotta)"></span>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 5.5rem;
  }
  .nav__mark {
    font-family: var(--display);
    font-weight: 400;
    font-size: 1.75rem;
    letter-spacing: 0.01em;
    text-decoration: none;
    color: var(--fg);
    line-height: 1;
  }
  nav {
    margin-left: auto;
  }
  .nav__list {
    display: flex;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__link {
    position: relative;
    font-family: var(--sans);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.01em;
    color: var(--fg);
    text-decoration: none;
    padding-bottom: 4px;
    border-bottom: 3px solid transparent;
    transition: border-color 0.25s ease, color 0.25s ease;
  }
  .nav__link:hover,
  .nav__link:focus-visible,
  .nav__link[aria-current='page'] {
    color: var(--c);
    border-bottom-color: var(--c);
  }
  .nav__bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    height: 5px;
  }
  @media (max-width: 620px) {
    .nav__inner {
      flex-wrap: wrap;
      justify-content: space-between;
      height: auto;
      padding-top: 1.25rem;
      padding-bottom: 1.25rem;
      row-gap: 1rem;
    }
    .nav__mark {
      order: 1;
    }
    nav {
      order: 2;
      margin-left: 0;
      flex: 1 0 100%;
    }
    .nav__list {
      flex-wrap: wrap;
      gap: 0.9rem 1.25rem;
    }
    .nav__link {
      font-size: 0.9rem;
    }
  }
</style>
