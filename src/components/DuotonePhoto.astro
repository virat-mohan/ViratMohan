---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
}

const { src, alt } = Astro.props;
---

<figure class="duotone">
  <Image
    class="duotone__img"
    src={src}
    alt={alt}
    width={640}
    format="webp"
    quality={82}
    decoding="async"
    fetchpriority="high"
    loading="eager"
  />
  <div class="duotone__map" aria-hidden="true"></div>
  <div class="halftone" aria-hidden="true"></div>
</figure>

<style>
  .duotone {
    position: relative;
    margin: 0;
    height: 100%;
    width: 100%;
    overflow: hidden;
  }
  .duotone__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 35% 30%;
    filter: grayscale(1) contrast(1.15) brightness(1.05);
  }
  /* Duotone: shadows -> ink, highlights -> cream, via a blended gradient
     over the grayscale photo. */
  .duotone__map {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      160deg,
      var(--poster-ink) 0%,
      var(--terracotta) 55%,
      var(--poster-cream) 100%
    );
    mix-blend-mode: color;
    pointer-events: none;
  }
  .duotone .halftone {
    opacity: 0.5;
  }
</style>
