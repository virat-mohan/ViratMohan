---
// Shared frame for the lead access checklist and plan pages: homepage look via /brand/tokens.css.
interface Props { title: string; description?: string }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="referrer" content="no-referrer" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <meta name="theme-color" content="#f4ead4" />
  <meta name="color-scheme" content="light" />
  <link rel="stylesheet" href="/brand/tokens.css" />
</head>
<body class="vm-page lead">
  <header class="vm-head">
    <div class="vm-head__in"><a class="vm-mark" href="/">VM</a></div>
    <div class="vm-band"></div>
  </header>
  <main class="wrap"><slot /></main>
  <footer class="vm-signature">Taking something good you made and building the machine that gets it to the world. <a href="/mission"><b>Why I do this</b></a></footer>
  <style is:global>
    .lead { min-height: 100vh; line-height: 1.6; overflow-x: hidden; }
    .lead .wrap { max-width: 760px; margin: 0 auto; padding: clamp(2.5rem, 7vw, 5rem) 16px clamp(3rem, 8vw, 6rem); }
    @media (min-width: 640px) { .lead .wrap { padding-inline: 24px; } }
    .lead section { margin-top: clamp(3rem, 8vw, 5rem); }
    .lead h1 { font-size: clamp(2.6rem, 9vw, 4.75rem); }
    .lead h2 { font-family: var(--display); font-weight: 400; text-transform: uppercase; font-size: clamp(1.8rem, 5vw, 2.6rem); line-height: .95; margin: .5rem 0 1rem; }
    .lead h3 { font: 600 1.15rem/1.3 var(--sans); margin: 0; }
    .lead p { margin: .75rem 0; }
    .lead .lede { margin-top: 1.25rem; }
    .lead .muted { color: var(--dim); font-size: .92rem; }
    .lead .src { color: var(--dim); font-size: .78rem; letter-spacing: .02em; }
    .lead .vm-card { margin-top: 1.25rem; min-width: 0; }
    .lead .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; }
    .lead .grid > * { min-width: 0; }
    .lead .num { font-family: var(--serif); font-size: clamp(2rem, 6vw, 2.6rem); line-height: 1.05; display: block; overflow-wrap: anywhere; }
    .lead .btn { appearance: none; border: 1px solid var(--ink); background: var(--ink); color: var(--paper); font: 600 .95rem var(--sans); padding: .8rem 1.3rem; min-height: 44px; cursor: pointer; transition: opacity .25s ease; text-decoration: none; display: inline-block; }
    .lead .btn:hover { opacity: .85; }
    .lead .btn.ghost { background: transparent; color: var(--ink); border-color: var(--line); }
    .lead .btn[disabled] { opacity: .5; cursor: default; }
    .lead input[type=text], .lead input[type=password] { width: 100%; box-sizing: border-box; font: 400 1rem var(--sans); padding: .75rem .9rem; border: 1px solid var(--line); background: rgba(255,255,255,.35); color: var(--ink); min-height: 44px; }
    .lead label { display: block; font-size: .85rem; color: var(--dim); margin: .9rem 0 .3rem; }
    .lead ol, .lead ul { padding-left: 1.2rem; }
    .lead li { margin: .6rem 0; }
    .lead .why { display: block; color: var(--dim); font-family: var(--serif); font-style: italic; font-size: 1.02rem; }
    .lead details summary { cursor: pointer; color: var(--dim); font-size: .92rem; margin-top: 1rem; }
    .lead .fade { animation: vmfade .6s ease both; }
    @keyframes vmfade { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
    @media (prefers-reduced-motion: reduce) { .lead .fade { animation: none; } }
  </style>
</body>
</html>
