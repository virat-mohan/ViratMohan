---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  logo?: ImageMetadata;
  brand: string;
  accent: string;
  size?: 'sm' | 'lg';
  // for brands whose real mark is a wordmark, not an image (e.g. a
  // client-rendered site with no fetchable logo file) — recreated as real
  // text rather than a screenshot, so it stays crisp and theme-aware.
  founder?: string;
}

const { logo, brand, accent, size = 'sm', founder } = Astro.props;

const initials = brand
  .split(' ')
  .filter((w) => w.length && w[0] === w[0].toUpperCase())
  .map((w) => w[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

{
  logo ? (
    <span class={`logo logo--${size}`} style={`--accent: ${accent}`}>
      <Image
        class="logo__img"
        src={logo}
        width={logo.width}
        height={logo.height}
        alt={`${brand} logo`}
      />
    </span>
  ) : founder ? (
    <span
      class={`logo logo--word logo--${size}`}
      style={`--accent: ${accent}`}
    >
      <span class="logo__brand" aria-hidden="true">
        {brand}
      </span>
      <span class="logo__founder" aria-hidden="true">
        by {founder}
      </span>
    </span>
  ) : (
    <span class={`logo logo--${size}`} style={`--accent: ${accent}`}>
      <span class="logo__initials" aria-hidden="true">
        {initials}
      </span>
    </span>
  )
}

<style>
  .logo {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    border-radius: 10px;
    /* Always a fixed light backdrop, regardless of site theme — these are
       external brand marks (several monochrome-dark) that assume a light
       ground, not the page's own light/dark mode. */
    background: color-mix(in srgb, var(--accent) 14%, var(--paper));
    box-shadow: inset 0 0 0 1px
      color-mix(in srgb, var(--accent) 26%, rgba(26, 20, 16, 0.12));
  }
  .logo--sm {
    width: 6.5rem;
    height: 6.5rem;
  }
  .logo--lg {
    width: 11rem;
    height: 11rem;
    border-radius: 20px;
  }
  .logo__img {
    max-width: 68%;
    max-height: 68%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .logo__initials {
    font-family: var(--serif);
    font-size: 2.2rem;
    letter-spacing: -0.01em;
    color: color-mix(in srgb, var(--accent) 65%, var(--ink));
  }
  .logo--lg .logo__initials {
    font-size: 3.6rem;
  }

  /* Wordmark variant — auto-width, not forced into a square. */
  .logo--word {
    width: auto;
    height: auto;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
    padding: 1.35rem 1.6rem;
    border-radius: 12px;
  }
  .logo--word.logo--lg {
    padding: 2.1rem 2.5rem;
  }
  .logo__brand {
    font-family: var(--serif);
    font-size: 1.4rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--accent) 55%, var(--ink));
    white-space: nowrap;
  }
  .logo--lg .logo__brand {
    font-size: 2.5rem;
  }
  .logo__founder {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--dim);
    white-space: nowrap;
  }
  .logo--lg .logo__founder {
    font-size: 1.85rem;
  }
</style>
