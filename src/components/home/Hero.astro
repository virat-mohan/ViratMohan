---
import { Image } from 'astro:assets';
import { site } from '../../data/site';
import Portrait from '../Portrait.astro';
import devshopLogo from '../../assets/devshop-logo.png';
---

<section class="hero" aria-labelledby="hero-name">
  <div class="hero__grid container">
    <div class="hero__copy">
      <p class="eyebrow" data-reveal>Virat Mohan</p>
      <h1 id="hero-name" data-reveal style="--reveal-delay: 80ms">
        Virat<br />Mohan
      </h1>
      <p class="hero__line dim" data-reveal style="--reveal-delay: 160ms">
        {site.positioning}
      </p>
      <a
        class="hero__devshop"
        href="/devshop"
        data-reveal
        style="--reveal-delay: 220ms"
        aria-label="DevShop — built fast, for real businesses. Describe a problem, get a demo."
      >
        <Image
          class="hero__devshop-logo"
          src={devshopLogo}
          width={devshopLogo.width}
          height={devshopLogo.height}
          alt="DevShop — built fast, for real businesses"
        />
        <span class="hero__devshop-text link-underline"
          >Latest — describe a problem, get a demo →</span
        >
      </a>
    </div>
    <div class="hero__portrait">
      <div class="hero__portrait-reveal" data-reveal style="--reveal-delay: 120ms">
        <Portrait />
      </div>
    </div>
  </div>
  <hr class="rule-gold hero__hair" />
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 60% 40%;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    width: 100%;
    padding-block: 6rem 4rem;
  }
  .hero__copy {
    max-width: 40ch;
  }
  .hero h1 {
    margin: 0.5rem 0 1.75rem;
  }
  .hero__line {
    font-size: clamp(1.125rem, 1.8vw, 1.4rem);
    line-height: 1.4;
    max-width: 30ch;
    margin: 0;
  }
  .hero__devshop {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
    margin-top: 2.5rem;
    text-decoration: none;
  }
  .hero__devshop-logo {
    display: block;
    height: clamp(3.25rem, 6vw, 4.5rem);
    width: auto;
  }
  .hero__devshop-text {
    font-family: var(--sans);
    font-size: 0.9375rem;
    color: var(--fg);
  }

  /* Portrait sits inset as a smaller, softly framed card. */
  .hero__portrait {
    position: absolute;
    top: 3.5rem;
    right: 3.5rem;
    bottom: 3.5rem;
    width: min(36vw, 540px);
  }
  .hero__portrait-reveal {
    width: 100%;
    height: 100%;
  }

  .hero__hair {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
  }

  @media (max-width: 860px) {
    .hero {
      min-height: auto;
    }
    .hero__grid {
      grid-template-columns: 1fr;
      padding-block: 0 3rem;
    }
    /* Portrait moves above the name, inset within the container as a card. */
    .hero__portrait {
      position: relative;
      top: auto;
      right: auto;
      bottom: auto;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 10;
      order: -1;
      margin-bottom: 2.5rem;
    }
    .hero__copy {
      max-width: none;
    }
  }
</style>
