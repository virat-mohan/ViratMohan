---
import { Image } from 'astro:assets';
import { site } from '../../data/site';
import DuotonePhoto from '../DuotonePhoto.astro';
import devshopLogo from '../../assets/devshop-logo.png';
import virat from '../../assets/virat.png';
---

<section class="hero" aria-labelledby="hero-name">
  <div class="halftone" aria-hidden="true"></div>
  <div class="hero__grid container">
    <div class="hero__copy">
      <p class="eyebrow hero__eyebrow" data-reveal>Virat Mohan</p>
      <h1 id="hero-name" data-reveal style="--reveal-delay: 60ms">
        <span class="hero__name-line">
          Virat
          <span class="hero__ghost" aria-hidden="true">Virat</span>
        </span>
        <span class="hero__name-line hero__name-line--two">
          Mohan
          <span class="hero__ghost hero__ghost--two" aria-hidden="true"
            >Mohan</span
          >
        </span>
      </h1>
      <p class="hero__sash" data-reveal style="--reveal-delay: 140ms">
        {site.positioning}
      </p>
      <a
        class="hero__devshop"
        href="/devshop"
        data-reveal
        style="--reveal-delay: 220ms"
        aria-label="DevShop — built fast, for real businesses. Describe a problem, get a demo."
      >
        <Image
          class="hero__devshop-logo"
          src={devshopLogo}
          width={devshopLogo.width}
          height={devshopLogo.height}
          alt="DevShop — built fast, for real businesses"
        />
        <span class="hero__devshop-text link-underline"
          >Latest — describe a problem, get a demo →</span
        >
      </a>
    </div>
    <div class="hero__portrait">
      <div class="hero__portrait-reveal" data-reveal style="--reveal-delay: 120ms">
        <DuotonePhoto src={virat} alt="Virat Mohan" />
      </div>
    </div>
  </div>
  <div class="hero__swatches" aria-hidden="true">
    <span class="hero__swatch" style="--c: var(--terracotta)"></span>
    <span class="hero__swatch" style="--c: var(--cobalt)"></span>
    <span class="hero__swatch" style="--c: var(--magenta)"></span>
    <span class="hero__swatch" style="--c: var(--bronze)"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--terracotta);
    color: var(--poster-cream);
    overflow: hidden;
  }
  .hero__grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 60% 40%;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    width: 100%;
    padding-block: 7rem 4rem;
  }
  .hero__copy {
    max-width: 42ch;
  }
  .hero__eyebrow {
    color: var(--poster-cream);
    opacity: 0.85;
  }

  .hero h1 {
    font-family: var(--display);
    font-weight: 400;
    text-transform: uppercase;
    line-height: 0.86;
    letter-spacing: 0.005em;
    font-size: clamp(3.4rem, 8vw, 6.2rem);
    margin: 0.6rem 0 2rem;
  }
  .hero__name-line {
    position: relative;
    display: block;
  }
  .hero__name-line--two {
    color: var(--poster-ink);
  }
  .hero__ghost {
    position: absolute;
    inset: 0;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--cobalt);
    transform: translate(5px, 5px);
    z-index: -1;
    opacity: 0.8;
  }
  .hero__ghost--two {
    -webkit-text-stroke: 1.5px var(--magenta);
  }

  .hero__sash {
    font-size: clamp(1.0625rem, 1.7vw, 1.3rem);
    line-height: 1.4;
    max-width: 30ch;
    margin: 0;
    color: var(--poster-cream);
    opacity: 0.94;
  }

  .hero__devshop {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
    margin-top: 2.5rem;
    text-decoration: none;
  }
  .hero__devshop-logo {
    display: block;
    height: clamp(3.25rem, 6vw, 4.5rem);
    width: auto;
  }
  .hero__devshop-text {
    font-family: var(--sans);
    font-size: 0.9375rem;
    color: var(--poster-cream);
  }
  .hero__devshop-text.link-underline {
    background-image: linear-gradient(var(--poster-cream), var(--poster-cream));
  }

  .hero__portrait {
    position: relative;
    aspect-ratio: 4 / 5;
    width: 100%;
    box-shadow: 0 24px 48px -20px rgba(23, 19, 15, 0.5);
  }
  .hero__portrait-reveal {
    width: 100%;
    height: 100%;
  }

  .hero__swatches {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .hero__swatch {
    height: 10px;
    background: var(--c);
  }

  @media (max-width: 860px) {
    .hero__grid {
      grid-template-columns: 1fr;
      padding-block: 3rem 3rem;
    }
    .hero__portrait {
      order: -1;
      aspect-ratio: 16 / 11;
      margin-bottom: 2.5rem;
    }
    .hero__copy {
      max-width: none;
    }
    .hero h1 {
      font-size: clamp(3rem, 15vw, 4.5rem);
    }
  }
</style>
