---
import { getCollection } from 'astro:content';

const projects = (await getCollection('work')).sort(
  (a, b) => a.data.order - b.data.order
);
const rotations = ['-1.1deg', '0.8deg', '-0.6deg', '1.2deg'];
---

<section class="work-teaser section" aria-labelledby="work-teaser-h">
  <div class="container">
    <p class="eyebrow" data-reveal>Recent projects</p>
    <h2
      id="work-teaser-h"
      class="work-teaser__h"
      data-reveal
      style="--reveal-delay: 60ms"
    >
      Products, proven in production.
    </h2>
    <p
      class="work-teaser__intro dim"
      data-reveal
      style="--reveal-delay: 120ms"
    >
      Eight systems, built end to end for real businesses — most of them
      licensable for yours.
    </p>

    <ul class="work-teaser__list">
      <li
        class="work-teaser__item"
        data-reveal
        style={`--c: var(--gold); --rot: ${rotations[0]}`}
      >
        <a class="work-teaser__link" href="/devshop">
          <span class="eyebrow work-teaser__category">
            AI Orchestration Studio
          </span>
          <span class="work-teaser__brand">Dev Shop</span>
        </a>
      </li>
      {
        projects.map((p, i) => (
          <li
            class="work-teaser__item"
            data-reveal
            style={`--c: ${p.data.accent}; --rot: ${rotations[(i + 1) % rotations.length]}`}
          >
            <a class="work-teaser__link" href={`/work/${p.id}`}>
              <span class="eyebrow work-teaser__category">
                {p.data.category}
              </span>
              <span class="work-teaser__brand">{p.data.brand}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="work-teaser__more" data-reveal>
      <a class="link-underline" href="/work">See all work and pricing →</a>
    </p>
  </div>
</section>

<style>
  .work-teaser__h {
    margin: 0.75rem 0 1rem;
    max-width: 18ch;
  }
  .work-teaser__intro {
    max-width: 48ch;
    font-size: 1.0625rem;
    margin: 0 0 3rem;
  }
  .work-teaser__list {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 2rem 1.75rem;
  }
  .work-teaser__item {
    transform: rotate(var(--rot));
    transition: transform 0.3s ease;
  }
  .work-teaser__item:hover {
    transform: rotate(0deg) scale(1.03);
  }
  .work-teaser__link {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-decoration: none;
    background: var(--c);
    padding: 2.25rem 1.75rem 2.5rem;
    height: 100%;
    min-height: 11rem;
    transition: filter 0.3s ease;
  }
  .work-teaser__link:hover,
  .work-teaser__link:focus-visible {
    filter: brightness(1.08);
  }
  .work-teaser__category {
    margin: 0;
    color: var(--poster-cream);
    opacity: 0.85;
  }
  .work-teaser__brand {
    font-family: var(--display);
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(1.5rem, 2.6vw, 1.9rem);
    letter-spacing: 0.01em;
    color: var(--poster-cream);
  }
  .work-teaser__more {
    margin: 0;
    font-size: 1rem;
  }
  @media (max-width: 620px) {
    .work-teaser__list {
      grid-template-columns: 1fr;
    }
    .work-teaser__item {
      transform: none;
    }
  }
</style>
