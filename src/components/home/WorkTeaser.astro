---
import { getCollection } from 'astro:content';

const projects = (await getCollection('work')).sort(
  (a, b) => a.data.order - b.data.order
);
const groups = [
  { key: 'd2c', title: 'D2C', formats: ['d2c'] },
  { key: 'marketplace', title: 'Marketplace', formats: ['marketplace'] },
  { key: 'subscription', title: 'Subscription', formats: ['subscription'] },
  { key: 'other', title: 'Products & other builds', formats: ['product', 'other', undefined] },
].map((g) => ({ ...g, items: projects.filter((p) => g.formats.includes(p.data.format)) }))
 .filter((g) => g.items.length);
const linkOf = (p) => p.data.href ?? `/work/${p.id}`;
const isExt = (u) => /^https?:/.test(u);
---

<section class="work-teaser section" aria-labelledby="work-teaser-h">
  <div class="container">
    <p class="eyebrow" data-reveal style="color: var(--terracotta)">Recent projects</p>
    <h2
      id="work-teaser-h"
      class="work-teaser__h"
      data-reveal
      style="--reveal-delay: 60ms"
    >
      Products, proven in production.
    </h2>
    <p
      class="work-teaser__intro dim"
      data-reveal
      style="--reveal-delay: 120ms"
    >
      My live projects, grouped by how they sell, then the products and
      other builds behind them.
    </p>

    <ul class="work-teaser__list">
      <li class="work-teaser__item" data-reveal style="--c: var(--gold)">
        <a class="work-teaser__link" href="/devshop">
          <div class="work-teaser__top">
            <span class="eyebrow work-teaser__category">
              AI Orchestration Studio
            </span>
          </div>
          <span class="work-teaser__brand">Dev Shop</span>
        </a>
      </li>
      <li class="work-teaser__item" data-reveal style="--c: #D9714B">
        <a class="work-teaser__link" href="/retail-os/">
          <span class="work-teaser__live"><span class="work-teaser__live-dot"></span>Actively building</span>
          <div class="work-teaser__top">
            <span class="work-teaser__badge">New</span>
            <span class="eyebrow work-teaser__category">
              Plug-In Commerce Platform
            </span>
          </div>
          <span class="work-teaser__brand">Retail OS</span>
        </a>
      </li>
    </ul>

    {groups.map((g) => (
      <div class="work-group">
        <h3 class="work-group__h" id={`wg-${g.key}`}>{g.title}</h3>
        <ul class="work-teaser__list" aria-labelledby={`wg-${g.key}`}>
          {g.items.map((p) => (
            <li class="work-teaser__item" data-reveal style={`--c: ${p.data.accent}`}>
              <a class="work-teaser__link" href={linkOf(p)} {...(isExt(linkOf(p)) ? { target: '_blank', rel: 'noopener' } : {})}>
                
                <span class="work-teaser__brand">{p.data.brand}</span>
                <span class="work-teaser__line">{p.data.tagline}</span>
                {p.data.status && <span class="work-teaser__badge">{p.data.status}</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .work-group { margin-top: 1rem; }
  .work-group__h {
    font-family: var(--sans, inherit);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--terracotta);
    margin: 0 0 1.25rem;
  }
  .work-teaser__shot {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--ink, #1a1410);
    background: var(--poster-cream);
  }
  .work-teaser__line {
    font-size: 1rem;
    line-height: 1.45;
    color: var(--poster-cream);
    opacity: 0.92;
  }
  .work-teaser__h {
    margin: 0.75rem 0 1rem;
    max-width: 18ch;
  }
  .work-teaser__intro {
    max-width: 48ch;
    font-size: 1.0625rem;
    margin: 0 0 3rem;
  }
  .work-teaser__list {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 2rem 1.75rem;
  }
  .work-teaser__item {
    transition: transform 0.3s ease;
  }
  .work-teaser__item:hover {
    transform: scale(1.03);
  }
  .work-teaser__link {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-decoration: none;
    background: var(--c);
    padding: 2.25rem 1.75rem 2.5rem;
    height: 100%;
    min-height: 11rem;
    position: relative;
    transition: filter 0.3s ease;
  }
  .work-teaser__top {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: 0.4rem;
    min-height: 4.75rem;
  }
  .work-teaser__badge {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--poster-cream);
    background: rgba(0, 0, 0, 0.28);
    border: 1px solid rgba(255, 255, 255, 0.4);
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
  }
  .work-teaser__link:hover,
  .work-teaser__link:focus-visible {
    filter: brightness(1.08);
  }
  .work-teaser__live {
    position: absolute;
    top: 0.9rem;
    right: 1.1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--poster-cream);
    opacity: 0.9;
  }
  .work-teaser__live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--poster-cream);
    flex: none;
    position: relative;
  }
  .work-teaser__live-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--poster-cream);
    animation: work-live-ping 1.8s ease-out infinite;
  }
  @keyframes work-live-ping {
    from { transform: scale(1); opacity: 0.7; }
    to { transform: scale(2.6); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .work-teaser__live-dot::after { animation: none; }
  }
  @media (max-width: 480px) {
    .work-teaser__live { display: none; }
  }
  .work-teaser__category {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.35;
    letter-spacing: 0.1em;
    color: var(--poster-cream);
    opacity: 0.9;
  }
  .work-teaser__status {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1rem;
    color: var(--poster-cream);
    opacity: 0.85;
    margin-top: 0.25rem;
  }
  .work-teaser__brand {
    font-family: var(--display);
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(1.5rem, 2.6vw, 1.9rem);
    letter-spacing: 0.01em;
    color: var(--poster-cream);
  }
  @media (max-width: 620px) {
    .work-teaser__list {
      grid-template-columns: 1fr;
    }
  }
</style>
