---
import { getCollection } from 'astro:content';

const projects = (await getCollection('work')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<section class="work-teaser section" aria-labelledby="work-teaser-h">
  <div class="container">
    <p class="eyebrow" data-reveal style="color: var(--terracotta)">Recent projects</p>
    <h2
      id="work-teaser-h"
      class="work-teaser__h"
      data-reveal
      style="--reveal-delay: 60ms"
    >
      Products, proven in production.
    </h2>
    <p
      class="work-teaser__intro dim"
      data-reveal
      style="--reveal-delay: 120ms"
    >
      Ten systems, built end to end for real businesses — most of them
      licensable for yours.
    </p>

    <ul class="work-teaser__list">
      <li class="work-teaser__item" data-reveal style="--c: var(--gold)">
        <a class="work-teaser__link" href="/devshop">
          <span class="eyebrow work-teaser__category">
            AI Orchestration Studio
          </span>
          <span class="work-teaser__brand">Dev Shop</span>
        </a>
      </li>
      <li class="work-teaser__item" data-reveal style="--c: #D9714B">
        <a class="work-teaser__link" href="/retail-os/">
          <span class="work-teaser__badge">New</span>
          <span class="eyebrow work-teaser__category">
            Plug-In Commerce Platform
          </span>
          <span class="work-teaser__brand">Retail OS</span>
        </a>
      </li>
      {
        projects.map((p) => (
          <li class="work-teaser__item" data-reveal style={`--c: ${p.data.accent}`}>
            <a class="work-teaser__link" href={p.data.href ?? `/work/${p.id}`}>
              {p.data.badge && (
                <span class="work-teaser__badge">{p.data.badge}</span>
              )}
              <span class="eyebrow work-teaser__category">
                {p.data.category}
              </span>
              <span class="work-teaser__brand">{p.data.brand}</span>
              {p.data.status && <span class="work-teaser__status">{p.data.status}</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .work-teaser__h {
    margin: 0.75rem 0 1rem;
    max-width: 18ch;
  }
  .work-teaser__intro {
    max-width: 48ch;
    font-size: 1.0625rem;
    margin: 0 0 3rem;
  }
  .work-teaser__list {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 2rem 1.75rem;
  }
  .work-teaser__item {
    transition: transform 0.3s ease;
  }
  .work-teaser__item:hover {
    transform: scale(1.03);
  }
  .work-teaser__link {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-decoration: none;
    background: var(--c);
    padding: 2.25rem 1.75rem 2.5rem;
    height: 100%;
    min-height: 11rem;
    position: relative;
    transition: filter 0.3s ease;
  }
  .work-teaser__badge {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--poster-cream);
    background: rgba(0, 0, 0, 0.28);
    border: 1px solid rgba(255, 255, 255, 0.4);
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    margin-bottom: 0.15rem;
  }
  .work-teaser__link:hover,
  .work-teaser__link:focus-visible {
    filter: brightness(1.08);
  }
  .work-teaser__category {
    margin: 0;
    font-size: 0.9375rem;
    letter-spacing: 0.1em;
    color: var(--poster-cream);
    opacity: 0.9;
  }
  .work-teaser__status {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1rem;
    color: var(--poster-cream);
    opacity: 0.85;
    margin-top: 0.25rem;
  }
  .work-teaser__brand {
    font-family: var(--display);
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(1.5rem, 2.6vw, 1.9rem);
    letter-spacing: 0.01em;
    color: var(--poster-cream);
  }
  @media (max-width: 620px) {
    .work-teaser__list {
      grid-template-columns: 1fr;
    }
  }
</style>
