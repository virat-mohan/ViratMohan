---
import { arc } from '../../data/site';
---

<section class="arc section" aria-labelledby="arc-h">
  <div class="container">
    <p class="eyebrow" data-reveal>The arc</p>
    <h2 id="arc-h" class="arc__h" data-reveal style="--reveal-delay: 60ms">
      Two decades, five turns.
    </h2>

    <div class="arc__list">
      {
        arc.map((block, i) => (
          <>
            {i > 0 && <hr class="rule-gold arc__rule" />}
            <article class="arc__block" data-reveal>
              <p class="eyebrow arc__range">{block.range}</p>
              <div class="arc__copy">
                <h3 class="arc__title">{block.title}</h3>
                <p class="arc__text dim">{block.body}</p>
              </div>
            </article>
          </>
        ))
      }
    </div>
  </div>
</section>

<style>
  .arc__h {
    margin: 0.75rem 0 3.5rem;
    max-width: 16ch;
  }
  .arc__list {
    display: flex;
    flex-direction: column;
  }
  .arc__rule {
    width: 100%;
    margin-block: 2.75rem;
  }
  .arc__block {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: clamp(1rem, 4vw, 3rem);
    align-items: baseline;
  }
  .arc__range {
    margin: 0;
    padding-top: 0.4rem;
  }
  .arc__title {
    margin: 0 0 0.75rem;
  }
  .arc__text {
    margin: 0;
    max-width: 60ch;
    font-size: 1.0625rem;
  }
  @media (max-width: 680px) {
    .arc__block {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .arc__range {
      padding-top: 0;
    }
  }
</style>
