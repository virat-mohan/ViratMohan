---
import { arc } from '../../data/site';

const swatches = ['terracotta', 'cobalt', 'magenta', 'bronze', 'ink'];
const rotations = ['-1.2deg', '0.9deg', '-0.7deg', '1.3deg', '-1deg'];
---

<section class="arc section" aria-labelledby="arc-h">
  <div class="container">
    <p class="eyebrow" data-reveal style="color: var(--terracotta)">The arc</p>
    <h2 id="arc-h" class="arc__h" data-reveal style="--reveal-delay: 60ms">
      Twenty-plus years, eleven turns.
    </h2>

    <div class="arc__grid">
      {
        arc.map((block, i) => (
          <article
            class="arc__tile"
            data-reveal
            style={`--reveal-delay: ${(i % 5) * 40}ms; --c: var(--${swatches[i % swatches.length]}); --rot: ${rotations[i % rotations.length]}`}
          >
            <p class="arc__range">{block.range}</p>
            <h3 class="arc__title">{block.title}</h3>
            <p class="arc__text">{block.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .arc__h {
    margin: 0.75rem 0 3.5rem;
    max-width: 18ch;
  }
  .arc__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem 1.75rem;
  }
  .arc__tile {
    background: var(--c);
    padding: 2.25rem 1.75rem 2.5rem;
    transform: rotate(var(--rot));
    transition: transform 0.3s ease;
    min-height: 14rem;
  }
  .arc__tile:hover {
    transform: rotate(0deg) scale(1.03);
  }
  .arc__range {
    font-family: var(--sans);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--poster-cream);
    opacity: 0.8;
    margin: 0 0 0.75rem;
  }
  .arc__title {
    font-family: var(--display);
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(1.4rem, 2.2vw, 1.75rem);
    letter-spacing: 0.01em;
    margin: 0 0 0.9rem;
    color: var(--poster-cream);
  }
  .arc__text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--poster-cream);
    opacity: 0.92;
  }
  @media (max-width: 980px) {
    .arc__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .arc__grid {
      grid-template-columns: 1fr;
    }
    .arc__tile {
      transform: none;
    }
  }
</style>
