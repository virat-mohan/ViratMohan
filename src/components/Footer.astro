---
const year = new Date().getFullYear();
---

<footer class="footer">
  <hr class="rule-hair" />
  <div class="container footer__inner">
    <p class="dim footer__meta">
      <span>© {year} Virat Mohan</span>
      <span aria-hidden="true">·</span>
      <span>India</span>
      <span aria-hidden="true">·</span>
      <a class="footer__mission" href="/mission">Read my mission →</a>
    </p>
  </div>
  <p class="vm-signature footer__sig"><a href="https://viratmohan.com/mission"><b>Virat Mohan</b> · I build the machine that gets good products to the world. →</a></p>
</footer>

<style>
  .footer__mission {
    color: var(--terracotta);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1.5px solid var(--gold);
  }
  .footer__meta { flex-wrap: wrap; }
  .footer__sig {
    margin: 0;
  }
  .footer {
    margin-top: 0;
  }
  .footer__inner {
    padding-block: 2.5rem;
  }
  .footer__meta {
    display: flex;
    gap: 0.6rem;
    font-size: 0.8125rem;
    margin: 0;
  }
</style>
