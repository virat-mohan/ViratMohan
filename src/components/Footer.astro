  <div class="container footer__inner">
    <p class="dim footer__meta">
      <span>© {year} Virat Mohan</span>
      <span aria-hidden="true">·</span>
      <span>India</span>
      <span aria-hidden="true">·</span>
      <a href="/mission">Mission, vision &amp; how I work</a>
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-top: 0;
  }
  .footer__inner {
    padding-block: 2.5rem;
  }
  .footer__meta {
    display: flex;
    gap: 0.6rem;
    font-size: 0.8125rem;
    margin: 0;
  }
</style>
